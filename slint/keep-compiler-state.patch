+/// Harbor: whether compiled definitions keep the compiler's state (the
+/// TypeLoader after the passes, a copy from before them, the object tree and
+/// the LLR's debug info). Only highlight, live preview and the LSP read it,
+/// and it is most of a large UI's memory. `SLINT_KEEP_COMPILER_STATE=1`
+/// keeps it, as upstream always does.
+pub fn keep_compiler_state() -> bool {
+    std::env::var_os("SLINT_KEEP_COMPILER_STATE").is_some_and(|v| v == "1")
+}
