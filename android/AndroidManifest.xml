<?xml version="1.0" encoding="utf-8"?>
<!-- Hub for Android (applicationId dev.hub.app, set by android/build.sh's aapt2
     rename-manifest-package; the Java classes stay in dev.harbor.app): Harbor's Android app
     rebranded and in a world of its own. It pairs with Hub on the PC (hub://pair, Pair.java), never
     with Harbor's account service or PCs, and installs beside Harbor and Person Hub.
     What follows is Harbor's description: a chat-only client of the desktop Harbors (hubs) of its account.
     Hubs signs in with Google (Account; the browser comes back as hub://oauth) and lists the
     account's workspaces, each with its PCs; Chats lists one workspace's
     chats (the same list slides in as a drawer inside Chat and NewChat), Chat shows and drives
     one (its team slides in from the right), NewChat starts one, GhList and GhItem show the
     PC's pull requests and issues, Settings updates the app and sets the color mode. Other apps
     and browsers open a chat with its link (hub://chat/<gid>?pc=<PC name>) through Hubs.
     This file is part of the shell (android/README.md, "Shell and code"): a change here needs
     android/shell/lock.sh bump, and phones get it only by installing the new APK. The app's
     components below are made by dev.harbor.shell.Factory from the newest good app code the phone
     has (Android 9+), so their class names must stay. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.harbor.app">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tailnet: finds Tailscale's VPN network, the only way to a hub -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Settings › Update installs the APK the hub serves ("Install unknown apps" for Harbor) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: updates of itself install without the system dialog (also in the
         background: Settings › Update automatically) -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Attach › Camera: asked for only when used -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Devices › Send on a PC: "saved to Download/Harbor" notifications; asked for the first time
         something arrives -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The background ping job (Alive) survives a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Dictation in the composer (Voice): the phone's recogniser, or a recording the PC
         transcribes; asked for the first time the mic is tapped -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Instant notifications (Listen, off by default): a silent foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Routine's GPS rides (RideService) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Harbor talks plain HTTP, but only inside the tailnet (WireGuard encrypts every hop):
         Tailnet.java checks that; the platform HTTP stack gets no cleartext at all -->
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:appComponentFactory="dev.harbor.shell.Factory"
        android:allowBackup="false" android:networkSecurityConfig="@xml/network"
        android:theme="@style/Harbor">
        <activity android:name=".Hubs" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hub" android:host="pair" />
            </intent-filter>
            <!-- The Google sign-in's answer, bounced by the account service (Account) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hub" android:host="oauth" />
            </intent-filter>
            <!-- A chat's link, harbor://chat/<gid>?pc=<PC name>, as agents write them, from another
                 app or a browser (shell 2): Hubs opens that chat (ChatLink) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hub" android:host="chat" />
            </intent-filter>
        </activity>
        <activity android:name=".Chats" android:exported="false" />
        <activity android:name=".Chat" android:exported="false" android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden" />
        <activity android:name=".NewChat" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Palette" android:exported="false" android:windowSoftInputMode="adjustResize|stateVisible" />
        <activity android:name=".NewProject" android:exported="false" android:windowSoftInputMode="adjustResize|stateVisible" />
        <activity android:name=".Settings" android:exported="false" />
        <!-- Hub's other tabs (Tabs.java): Persons, Routine; a GPS ride records in RideService -->
        <activity android:name=".Persons" android:exported="false" />
        <activity android:name=".Routine" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Collector" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <service android:name=".RideService" android:exported="false" android:foregroundServiceType="location" />
        <!-- A Discord captcha for a person to solve (Settings › Apps › Discord, or its notification);
             turning the phone just lays the frame out again -->
        <activity android:name=".DiscordCaptcha" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />
        <activity android:name=".GhList" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".GhItem" android:exported="false" />
        <!-- The shell's: opens Harbor again in a fresh process after an update of its code tapped
             on a screen (Shell.restart), from a process of its own that runs no app code -->
        <activity android:name="dev.harbor.shell.Restart" android:exported="false" android:process=":restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:noHistory="true"
            android:excludeFromRecents="true" />
        <!-- The install's result; and MY_PACKAGE_REPLACED, after an update: jobs and Listen again -->
        <receiver android:name=".Update" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Tells the PCs every 15 minutes that this phone is reachable (Devices: online) -->
        <service android:name=".Alive" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- A notification's Reply and Continue (Notes) -->
        <receiver android:name=".NoteAction" android:exported="false" />
        <service android:name=".Listen" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps one connection to the user's own PC to show its notifications at once (no push service)" />
        </service>
        <!-- Attach › Camera: the camera app writes its photo into a file of ours; on Android 9
             and older it also shares what the PCs send (Inbox) -->
        <provider android:name=".CamProvider" android:authorities="dev.hub.app.cam"
            android:exported="false" android:grantUriPermissions="true" />
        <!-- What Play services' client libraries read (play-services-basement 18.9.0's
             google_play_services_version; android/build.sh pins that library). -->
        <meta-data android:name="com.google.android.gms.version" android:value="12451000" />
    </application>
</manifest>
