<?xml version="1.0" encoding="utf-8"?>
<!-- Harbor for Android: a chat-only client of a desktop Harbor (the hub) on the tailnet.
     Hubs pairs and lists PCs (also from harbor://pair links and QR codes), Chats lists one hub's
     chats (the same list slides in as a drawer inside Chat and NewChat), Chat shows and drives
     one (its team slides in from the right), NewChat starts one, GhList and GhItem show the
     PC's pull requests and issues, Settings updates the app and sets the color mode. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.harbor.app">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tailnet: finds Tailscale's VPN network, the only way to a hub -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Settings › Update installs the APK the hub serves ("Install unknown apps" for Harbor) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: updates of itself install without the system dialog (also in the
         background: Settings › Update automatically) -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Pairing: the in-app QR scanner (QrScan) reads the PC's code; asked for only when used -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Devices › Send on a PC: "saved to Download/Harbor" notifications; asked for the first time
         something arrives -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The third factor: the fingerprint or screen lock unlocks the sign-in key (Presence) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The background ping job (Alive) survives a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Dictation in the composer (Voice): the phone's recogniser, or a recording the PC
         transcribes; asked for the first time the mic is tapped -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Instant notifications (Listen, off by default): a silent foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Harbor talks plain HTTP, but only inside the tailnet (WireGuard encrypts every hop):
         Tailnet.java checks that; the platform HTTP stack gets no cleartext at all -->
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:allowBackup="false" android:networkSecurityConfig="@xml/network"
        android:theme="@style/Harbor">
        <activity android:name=".Hubs" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="harbor" android:host="pair" />
            </intent-filter>
        </activity>
        <activity android:name=".Chats" android:exported="false" />
        <!-- The built-in browser (Servo, libharborservo.so) in a process of its own: its memory
             goes with the screen, and an engine crash leaves the chats running -->
        <activity android:name=".Browser" android:exported="false" android:process=":browser"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden" />
        <activity android:name=".Chat" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".NewChat" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".Palette" android:exported="false" android:windowSoftInputMode="adjustResize|stateVisible" />
        <activity android:name=".Settings" android:exported="false" />
        <activity android:name=".GhList" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".GhItem" android:exported="false" />
        <activity android:name=".QrScan" android:exported="false" android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />
        <!-- Asks for the fingerprint or screen lock when a PC wants the third factor -->
        <activity android:name=".Presence" android:exported="false" android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- The install's result; and MY_PACKAGE_REPLACED, after an update: jobs and Listen again -->
        <receiver android:name=".Update" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Tells the PCs every 15 minutes that this phone is reachable (Devices: online) -->
        <service android:name=".Alive" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Downloads dictation's offline model on Wi-Fi, resuming across runs (Asr) -->
        <service android:name=".ModelJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- A notification's Reply and Continue (Notes) -->
        <receiver android:name=".NoteAction" android:exported="false" />
        <service android:name=".Listen" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps one connection to the user's own PC to show its notifications at once (no push service)" />
        </service>
        <!-- Attach › Camera: the camera app writes its photo into a file of ours; on Android 9
             and older it also shares what the PCs send (Inbox) -->
        <provider android:name=".CamProvider" android:authorities="dev.harbor.app.cam"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
