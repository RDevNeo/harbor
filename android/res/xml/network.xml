<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext through the platform HTTP stack, for any host. Hub traffic is plain HTTP, but
     only over Tailnet.java's sockets, bound to Tailscale's VPN and tailnet addresses. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
