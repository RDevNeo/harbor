# The Windows test VM's host tools on a boat.dev sandbox (windows.sh): QEMU/KVM, qemu-img, an ISO
# writer for the answer file's disc, an SSH client to drive the VM, and Python for QMP (screenshots,
# keys, the mouse).
FROM ubuntu:24.04
RUN sed -i 's#http://[a-z.]*archive.ubuntu.com#http://fr.archive.ubuntu.com#g' /etc/apt/sources.list.d/ubuntu.sources \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      qemu-system-x86 qemu-utils xorriso openssh-client python3 python3-pil curl ca-certificates unzip \
 && rm -rf /var/lib/apt/lists/*
