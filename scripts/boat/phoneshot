#!/bin/bash
set -euo pipefail
usage() {
  cat <<'EOF2'
Usage: scripts/boat/phoneshot [options]

Screenshots of the phone app (android/) from this working tree (tracked files with their
uncommitted changes, plus new files git does not ignore), taken on a fresh `large` boat.dev
sandbox (.github/boat/phoneshot.sh): a test APK (android/build.sh
with HARBOR_RIG_PORT, see android/src/dev/harbor/app/Rig.java) on an Android 14 emulator (KVM,
headless, a 1080x2400 phone at 420 dpi), connected to a hub with made-up data (ts/rig/phonehub.ts:
projects, a chat with every kind of card, a lead with its team; never anyone's real chats).
Nothing runs on this PC but this script. The PNGs come back to ~/.cache/harbor-shots/phone-<time>/
and their paths are printed last. Fails loudly when the app crashed, wasn't in front or showed no
text. The sandbox is always deleted, also on error, Ctrl+C or kill.

Screens and steps run in the order given; each --screen opens a screen and shoots it:
  --screen NAME    chats (the chat list), chat (the chat with every card kind), chat:lead (a lead
                   with its team), chat:composer (two images in its shared draft), chat:GID,
                   settings, new (new chat), palette, collector, persons, routine (those tabs), routine:sleep (a Routine page), persons:ana (Ana's
                   chat in Persons › Stores), home (the app's first screen). Several:
                   --screen chats,chat,settings. Default: chats.
  --tap X,Y        a tap, in the PNG's pixels (1080x2400)
  --tap-text TEXT  a tap on the middle of the first view on screen whose text matches TEXT
                   (a Python regex, from the text's start: --tap-text Going, --tap-text '[0-9]+:')
                   (uiautomator's dump; fails when there is none)
  --press X,Y      a long press there (a message's sheet, a text box's Paste)
  --swipe X1,Y1,X2,Y2
  --text WORDS     types into the focused field
  --key NAME       an Android key: BACK, ENTER, DEL, TAB…
  --broadcast ACTION  a broadcast to the app, for a test build's hooks (Rig.java):
                   dev.harbor.app.RIG_KEYBOARD_PASTE types the clipboard's text as a keyboard's
                   clipboard does, dev.harbor.app.RIG_TEXT_CLIP leaves only its text on it;
                   dev.harbor.app.RIG_INCOMING has new messages come in (2 from Ana in Persons, 2 replies
                   in the cards chat: ts/rig/phonehub.ts /rig/incoming)
  --view CHAT[@PC]  opens a chat link as another app or a browser does (an ACTION_VIEW intent of
                   harbor://chat/<gid>?pc=<PC>, through the manifest's filter, not by class):
                   CHAT is a rig chat (cards, lead, composer, waiting…) or a made-up gid
  --context TEXT   with the next --view: &context=TEXT (percent-encoded here, as
                   encodeURIComponent does), the text another app hands the chat
  --from LABEL     with the next --view: &from=LABEL
  --approve CODE   with the next --view: &approve=CODE, a local API pairing's approval link
                   (a test build pairs with code 0123456789abcdef0123456789abcdef: --broadcast
                   dev.harbor.app.RIG_LOCAL_PAIR first, RIG_LOCAL_ALLOW / RIG_LOCAL_DENY tap Allow /
                   Don't allow, RIG_LOCAL_CLOSE closes Harbor's screens; LocalRig.java)
  --via plain|shared  the next --view is opened by a test app, "Shift Planner"
                   (android/rigcaller), not by adb: plain = new Intent(ACTION_VIEW, uri) and
                   startActivity, as a Capacitor WebView app does; shared = with Android 14's
                   ActivityOptions.setShareIdentityEnabled(true)
  --front          prints the activity in front now (did Harbor step back to the app?)
  --alarms         prints the alarm clocks Android knows (dumpsys alarm: the Clock app's next alarm) and the
                   Clock app's own alarms (its provider, when readable), and keeps a PNG of the screen as it
                   is, whichever app is in front (Routine › Sleep's alarm landed in the Clock app?)
  --cold           Harbor's process ends, the test caller comes in front, then Harbor's notification
                   service (Listen) alone starts it again: no Harbor screen in that process, as on a
                   phone where Android restarted it in the background (--broadcast
                   dev.harbor.app.RIG_LOCAL_BG then runs the local API's chat calls there)
  --wait SECONDS
  --shot NAME      a shot of what is on the screen now (after it stops changing)
  --record NAME[:SECONDS]  records the screen from now on for SECONDS (default 5) while the next steps
                   run (Android's screenrecord), as NAME.mp4 next to the PNGs, e.g. --record open
                   --tap-text "Ana Souza" (a later --shot or --record waits for it to end); for frame by
                   frame checks that nothing moves (ffmpeg -i NAME.mp4 -vf mpdecimate …)
  --gfx NAME       the app's frame times since the last --gfx (Android's gfxinfo: frames drawn, janky
                   ones, 50th/90th/95th/99th percentile), printed under NAME; `--gfx reset` only starts
                   counting (e.g. --gfx reset --swipe … --swipe … --gfx scroll)
Options:
  --dark           the phone's dark theme
  --leads N        Collector's made-up data gets N more Available leads (each with a picture and 3
                   thumbnails the size real ones are), for timing long lists
  --code           run the app from downloaded app code, as a phone on Android 9+ does after an
                   update (android/README.md, "Shell and code"): the build's hub-phone-code.zip,
                   one patch version newer than its APK, is put where the shell keeps staged code
                   before the first screen; the shell's log lines (harbor-shell) are printed after
                   the shots, and Settings says the code's version
  --from NAME      the snapshot to start from. Default: harbor-phone (the emulator, its system image
                   and a booted phone already in it) when it exists, else harbor-build (they install
                   first, minutes)
  --save-snapshot  make harbor-phone anew from harbor-build: a whole run (its shots must pass), then
                   the sandbox is saved under that name. After a release changed the build images,
                   or when the emulator should be newer. Default shots: chats,chat,settings
  --rm-snapshot    remove harbor-phone (runs then start from harbor-build)
  -q, --quiet      only progress and the summary; the full output stays in /tmp/<sandbox name>.log
  -h, --help       this help

Example: scripts/boat/phoneshot --screen chat --swipe 540,1800,540,600 --shot chat-end
Time: 3 to 7 minutes from harbor-phone (most of it waits for the restored sandbox's disk to load),
5 to 12 from harbor-build (the emulator and its system image install first). PHONESHOT_IMAGE /
PHONESHOT_GPU try another system image / -gpu mode (installed on the spot). Prerequisites: as scripts/boat/check (the boat CLI logged in, jq, git, GNU tar).
EOF2
}
steps=() quiet="" dark="" leads="" from="" save="" drop="" code="" extra="" via=""
while [ $# -gt 0 ]; do
  case "$1" in
    --screen) IFS=, read -ra sc <<< "$2"; for x in "${sc[@]}"; do steps+=("screen:$x"); done; shift ;;
    # A link's query rides along base64'd (its & % = and quotes reach the phone as they are).
    --context|--from|--approve) [ $# -ge 2 ] || { echo "$1 needs a value" >&2; exit 2; }
      extra="${extra:+$extra&}${1#--}=$(jq -rn --arg t "$2" '$t|@uri')"; shift ;;
    --via) case "${2:-}" in plain|shared) via=$2 ;; *) echo "--via plain or --via shared" >&2; exit 2 ;; esac; shift ;;
    --view) [ $# -ge 2 ] || { echo "$1 needs a value" >&2; exit 2; }
      steps+=("${via:+via-}${via:-view}:$2${extra:+~$(printf %s "$extra" | base64 -w0)}"); extra="" via=""; shift ;;
    --front) steps+=("front:now") ;;
    --alarms) steps+=("alarms:now") ;;
    --cold) steps+=("cold:now") ;;
    --tap-text) [ $# -ge 2 ] || { echo "$1 needs a value" >&2; exit 2; }; steps+=("taptext:$2"); shift ;;
    --tap|--press|--swipe|--text|--key|--broadcast|--wait|--shot|--gfx|--record) [ $# -ge 2 ] || { echo "$1 needs a value" >&2; exit 2; }; steps+=("${1#--}:$2"); shift ;;
    --dark) dark=1 ;;
    --leads) leads=$2; shift ;;
    --code) code=1 ;;
    --from) from=$2; shift ;;
    --save-snapshot) save=1 ;;
    --rm-snapshot) drop=1 ;;
    -q|--quiet) quiet=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1 (see --help)" >&2; exit 2 ;;
  esac
  shift
done
phone=harbor-phone
[ -z "$save" ] || [ -z "$from$drop" ] || { echo "--save-snapshot makes $phone from harbor-build: no --from or --rm-snapshot with it" >&2; exit 2; }
[ ${#steps[@]} -gt 0 ] || { [ -n "$save" ] && steps=(screen:chats screen:chat screen:settings); } || steps=(screen:chats)
dest=$HOME/.cache/harbor-shots/phone-$(date +%Y%m%d-%H%M%S)
. "$(dirname "$0")/lib.sh"

named_snapshot() { "$boat" snapshots --json | jq -e --arg n "$1" '.named[]? | select(.name == $n)' 2>/dev/null; }
if [ -n "$drop" ]; then
  named_snapshot "$phone" >/dev/null || { say "there is no $phone"; exit 0; }
  "$boat" snapshot rm "$phone" --json >/dev/null
  say "removed $phone: runs start from harbor-build"
  exit 0
fi
if [ -n "$save" ]; then snapshot=harbor-build
elif [ -n "$from" ]; then snapshot=$from
elif named_snapshot "$phone" >/dev/null; then snapshot=$phone
else snapshot=harbor-build; say "no $phone snapshot: from harbor-build, the emulator installs first (scripts/boat/phoneshot --save-snapshot makes $phone)"
fi

pngs="" saved=""
summary() {
  [ -f "$log" ] || return 0
  [ -z "$quiet" ] || sed 's/\x1b\[[0-9;]*[mK]//g' "$log" | grep -E -A40 '^THE APP|^error:|: error: |FAILED' | head -120
  echo
  say "summary"
  echo "  from the snapshot $snapshot: sandbox up at ${t_ready:-?}s, tree copied at ${t_up:-?}s, phone done at ${t_run:-?}s, shots here at ${t_back:-?}s"
  grep -E '^<== |^shot |^booted |^kept: |^home: |^note: |^disk loaded|^cpu: ' "$log" | sed 's/^<== //; s/^/  /'
  [ -z "$saved" ] || echo "  $saved"
  [ ! -d "$dest/logs" ] || echo "  logs (hub, emulator, logcat, screen dumps): $dest/logs"
}
last_words() { [ -z "$pngs" ] || echo "$pngs"; }

at() { echo "$(( $(date +%s) - started ))"; }
sandbox; t_ready=$(at)
upload; t_up=$(at)
set +e
remote DARK="$dark" LEADS="$leads" CODE="$code" IMAGE="${PHONESHOT_IMAGE:-}" GPU="${PHONESHOT_GPU:-}" \
  SAVE="$save" -- bash .github/boat/phoneshot.sh "${steps[@]}"
code=$?
set -e
t_run=$(at)
# The shots taken, also when a later step failed, and the logs (hub, emulator, logcat).
mkdir -p "$dest"
if "$boat" scp "$id:/home/user/out/shots.tgz" "$work/shots.tgz" > "$work/scp.log" 2>&1 || { sed 's/^/  scp: /' "$work/scp.log" >&2; false; }; then
  tar -xzf "$work/shots.tgz" -C "$dest"
  mv "$dest"/shots/*.png "$dest"/ 2>/dev/null || true
  mv "$dest"/shots/*.mp4 "$dest"/ 2>/dev/null || true
  rmdir "$dest/shots" 2>/dev/null || true
  pngs=$(find "$dest" -maxdepth 1 -name '*.png' | sort)
fi
t_back=$(at)
if [ -n "$save" ] && [ "$code" = 0 ]; then
  "$boat" exec "$id" -- bash -c 'rm -rf src src.tgz out' >/dev/null
  say "saving the sandbox as $phone"
  "$boat" snapshot "$id" "$phone" --json >/dev/null
  saved="saved $phone (its newest layer: $(named_snapshot "$phone" | jq -r '.sizeBytes / 1e9 * 10 | round / 10') GB)"
fi
exit "$code"
