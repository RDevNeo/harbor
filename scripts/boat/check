#!/bin/bash
set -euo pipefail
usage() {
  cat <<'EOF'
Usage: scripts/boat/check [options] [-- <test args>]

Checks this working tree (tracked files with their uncommitted changes, plus new files git does
not ignore) on a fresh `large` boat.dev sandbox from the snapshot `harbor-build`, in the release
build's ubuntu:22.04 image, with the Bun version ts/package.json pins (.github/boat/check.sh):
  1. bun install --frozen-lockfile, then tsc --noEmit   in ts/
  2. bun test <test args>                             all tests unless filtered, e.g. `-- packages/ui`
  3. bun scripts/build.ts single                      the release executable, unless --no-release
Output streams here; a summary ends it (steps, tests, time, cost). Exits non-zero when a step
fails. The sandbox is always deleted, also on error, Ctrl+C or kill; sandboxes left behind by a
killed -9 run are swept by the next run (this PC's at once, anyone's after 3 h).

Options:
  --no-release    skip the release build
  --out DIR       copy the release executable to DIR/harbor
  -q, --quiet     print only progress, the summary and what failed; the full output stays in
                  /tmp/<sandbox name>.log. Best for agents.
  -h, --help      this help

Prerequisites (any PC of the mesh): the boat CLI (`curl -fsSL https://boat.dev/install | sh`, on
PATH or at ~/.ascii/bin/boat), logged in to the account that holds the snapshot `harbor-build`
(`boat login`, or `boat login --key-stdin` with an API key); jq, git, GNU tar.
Nothing to build with locally.
Cost: a large sandbox bills about $0.07 per hour; a run takes a few minutes.
EOF
}
release=1 out="" quiet="" args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --no-release) release=0 ;;
    -q|--quiet) quiet=1 ;;
    --out) out=$(mkdir -p "$2" && cd "$2" && pwd); shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; args=("$@"); break ;;
    *) echo "unknown option: $1 (see --help)" >&2; exit 2 ;;
  esac
  shift
done
[ -z "$out" ] || [ "$release" = 1 ] || { echo "--out needs the release build" >&2; exit 2; }
. "$(dirname "$0")/lib.sh"

summary() {
  local plain="$work/plain"
  [ -f "$log" ] || return 0
  sed 's/\x1b\[[0-9;]*[mK]//g' "$log" > "$plain"
  if [ -n "$quiet" ]; then
    # What failed: type errors and the failing tests with the lines before them.
    grep -E '^[^ ].*\.ts\([0-9]+,[0-9]+\): error' "$plain" | head -100
    grep -B30 -E '^\(fail\) ' "$plain" | head -300
  fi
  echo
  say "summary"
  grep -E '^<== ' "$plain" | sed 's/^<== /  /'
  awk '/^ *[0-9]+ pass$/ { p = $1 } /^ *[0-9]+ fail$/ { f = $1 } /^ *[0-9]+ skip$/ { k = $1 }
       END { if (p != "") printf "  tests: %d passed, %d failed, %d skipped\n", p, f, k }' "$plain"
  grep -E '^\(fail\) ' "$plain" | sed -E 's/^\(fail\) (.*) \[[0-9.]+m?s\]$/    failed: \1/' | sort -u
  [ -z "$out" ] || [ ! -f "$out/harbor" ] || echo "  binary: $out/harbor"
}

sandbox
upload
remote RELEASE="$release" NO_COLOR=1 -- bash .github/boat/check.sh "${args[@]}"
if [ -n "$out" ]; then
  "$boat" scp "$id:/home/user/out/harbor" "$out/harbor" >/dev/null
  chmod +x "$out/harbor"
fi
