// Split chat panes (logic/splitpanes.ts): up to four chats side by side in the centre, each drawn here with its own
// transcript; the focused one has the window's composer under it (app.slint puts it there), the others the same
// Composer, compact, which hands the keyboard to them with a click.
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Glyph, Spinner, Btn, TipArea, StatusData, StatusView } from "widgets.slint";
import { Transcript, CardData } from "chat.slint";
import { ChatCaptchaData } from "captcha.slint";
import { MdBlock } from "markdown.slint";
import { SideRow } from "sidebar.slint";
import { Composer, ComposerState, WorkBarData, StripRow } from "composer.slint";

/** A pane's header and place: x, y, w, h are shares of the centre. */
export struct PaneHead {
    chat: int,
    title: string,
    // The status pill: "" none; tone "blue" (with a spinner), "amber", "green", "red", "gray".
    pill: string,
    tone: string,
    focused: bool,
    shown: bool,
    maxed: bool,
    x: float,
    y: float,
    w: float,
    h: float,
    running: bool,
    live-seq: int,
    // Its composer, the same as the focused pane's (composer.slint), with this chat's draft, model, footer and agents.
    draft: string,
    composer: ComposerState,
    logo: image,
    badge-photo: image,
    has-badge-photo: bool,
    bar: WorkBarData,
    strip-title: string,
    strip-names: string,
    strip-header: bool,
    strip-folded: bool,
    strip-open: bool,
}

/** A pane's transcript and its agents strip (the strip empty for the focused one: the window's composer shows it). Set
 * once per pane, filled in place. */
export struct PaneBody {
    cards: [CardData],
    live: [MdBlock],
    strip: [StripRow],
}

/** A divider between the two sides of a split: at (share of the centre) on x ("h") or y ("v"), over its split's area. */
export struct PaneDiv {
    path: string,
    dir: string,
    at: float,
    ax: float,
    ay: float,
    aw: float,
    ah: float,
}

/** Where a chat dragged from the sidebar, or a pane dragged by its header, would land (splitpanes.ts Drop). */
export struct PaneDrop {
    kind: string,
    pane: int,
    x: float,
    y: float,
    w: float,
    h: float,
    label: string,
    sub: string,
    cap: bool,
}

// The header's height; a split pane's composer: its one-line card, the footer under it, and the room both take.
export global PaneMetrics {
    out property <length> head: 34px;
    // Near the centre's outer edge (px), a drop goes beside the whole layout.
    out property <length> band: 28px;
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <string> tone;
    property <color> ink: tone == "blue" ? Theme.blue-900 : tone == "amber" ? Theme.amber-900 : tone == "green" ? Theme.green-900 : tone == "red" ? Theme.red-900 : Theme.subtle;
    height: 19px;
    width: row.preferred-width;
    border-radius: 10px;
    border-width: 1px;
    border-color: tone == "blue" ? Theme.blue-500 : tone == "amber" ? Theme.amber-500 : tone == "green" ? Theme.green-500 : tone == "red" ? Theme.red-500 : Theme.gray-400;
    background: tone == "blue" ? Theme.blue-100 : tone == "amber" ? Theme.amber-100 : tone == "green" ? Theme.green-100 : tone == "red" ? Theme.red-100 : Theme.gray-100;
    row := HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 5px;
        if root.tone == "blue": Rectangle {
            width: 11px;
            Spinner {
                radius: 5px;
                color: root.ink;
            }
        }
        Text {
            text: root.text;
            font-size: 11.5px;
            font-weight: 500;
            color: root.ink;
            vertical-alignment: center;
        }
    }
}

// The pane's slim head: its chat's name and status; maximize and close on the right. The whole head is the grip: dragged
// past 6px it moves the pane (onto another to swap, onto an edge to go there); clicked without moving, it focuses.
export component PaneHeader inherits Rectangle {
    in property <PaneHead> head;
    callback take();
    callback close();
    callback maximize();
    // The pointer in window coordinates while the head is dragged, and where it was let go.
    callback drag(length, length);
    callback dropped(length, length);
    property <bool> far;
    height: round(PaneMetrics.head / 1phx) * 1phx;
    background: Theme.bg100;
    grip := TouchArea {
        mouse-cursor: root.far ? MouseCursor.grabbing : MouseCursor.default;
        clicked => {
            if !root.far {
                root.take();
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.far = false;
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.far {
                root.dropped(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        moved => {
            root.far = root.far || abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px;
            if root.far {
                root.drag(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    Rectangle {
        y: parent.height - 1phx;
        height: 1phx;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 8px;
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            // The focused pane's name at full strength, the others' a little dimmer: focus shown, quietly.
            Text {
                min-width: 24px;
                max-width: self.preferred-width;
                horizontal-stretch: 1;
                text: root.head.title;
                font-size: 13px;
                font-weight: 500;
                color: root.head.focused ? Theme.fg : Theme.fg.mix(Theme.subtle, 0.45);
                overflow: elide;
                vertical-alignment: center;
            }
            if root.head.pill != "": VerticalLayout {
                alignment: center;
                Pill {
                    text: root.head.pill;
                    tone: root.head.tone;
                }
            }
            Rectangle {
                horizontal-stretch: 0.001;
            }
        }
        HorizontalLayout {
            spacing: 0px;
            VerticalLayout {
                alignment: center;
                Btn {
                    icon: root.head.maxed ? Icons.minimize : Icons.maximize;
                    size: icon-xs;
                    variant: ghost-muted;
                    tip: root.head.maxed ? "Show every pane" : "Show this pane alone";
                    clicked => {
                        root.maximize();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    icon: Icons.x;
                    size: icon-xs;
                    variant: ghost-muted;
                    tip: "Close pane · chat keeps running · Ctrl+W";
                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }
}

// A pane: its header, its transcript, and (without the keyboard) a one-line composer, as the focused pane's, that
// gives it the keyboard. The focused pane is the same element, only its composer is the window's own one under it: a
// pane taking the keyboard builds nothing again, its transcript stays as it was.
export component SidePane inherits Rectangle {
    in property <PaneHead> head;
    in property <PaneBody> body;
    in property <length> content-w: 760px;
    // The focused pane's captcha (a chat's own browser step), as the usual view shows it.
    in property <ChatCaptchaData> captcha;
    in property <image> captcha-frame;
    // To the shell: the transcript's distance from its end and whether it follows it, kept as the pane takes the keyboard.
    callback take(bool, length, bool);
    callback close();
    callback maximize();
    callback drag(length, length);
    callback dropped(length, length);
    callback toggle(int);
    callback act(int, string);
    callback link(string);
    callback open-url(string);
    callback open-media(string);
    callback copy-text(string);
    callback near-top();
    callback queue-menu(int, length, length);
    callback captcha-seen(string, bool, float);
    callback captcha-pointer(string, string, float, float);
    callback captcha-cancel(string);
    // Its transcript, for the window (the focused pane's is the one the shell scrolls).
    out property <bool> at-end: tr.at-end;
    out property <length> content-height: tr.content-height;
    out property <length> view-height: tr.height;
    out property <bool> follow: tr.follow;
    out property <length> from-end-now: tr.from-end-now;
    public function scroll-to-end() {
        tr.scroll-to-end();
    }
    public function page(dir: int) {
        tr.page(dir);
    }
    public function scroll-to-top() {
        tr.scroll-to-top();
    }
    public function grew-above(before: length) {
        tr.grew-above(before);
    }
    public function anchor-off() {
        tr.anchor-off();
    }
    public function keep-from-end(d: length) {
        tr.keep-from-end(d);
    }
    clip: true;
    background: Theme.bg100;
    property <length> box: root.head.focused ? 0px : cbox.height;
    property <length> head-h: round(PaneMetrics.head / 1phx) * 1phx;
    // Behind everything: a click on the pane where nothing else takes it gives it the keyboard.
    TouchArea {
        clicked => {
            root.take(false, tr.from-end-now, tr.at-end);
        }
    }
    PaneHeader {
        x: 0;
        y: 0;
        width: parent.width;
        head: root.head;
        take => {
            root.take(false, tr.from-end-now, tr.at-end);
        }
        close => {
            root.close();
        }
        maximize => {
            root.maximize();
        }
        drag(x, y) => {
            root.drag(x, y);
        }
        dropped(x, y) => {
            root.dropped(x, y);
        }
    }
    property <length> side: max((root.width - root.content-w) / 2, root.width < 520px ? 12px : 24px);
    // Every card reads these two: bound to the header (which changes with the focus, a title, a status), each change
    // there would lay every card out again. They're set only when they really change.
    property <int> head-live-seq: root.head.live-seq;
    property <bool> head-running: root.head.running;
    property <int> live-seq: -1;
    property <bool> running;
    changed head-live-seq => {
        root.live-seq = self.head-live-seq;
    }
    changed head-running => {
        root.running = self.head-running;
    }
    tr := Transcript {
        x: 0;
        y: root.head-h;
        width: root.width;
        height: max(0px, root.height - root.head-h - root.box);
        cards: root.body.cards;
        live-blocks: root.body.live;
        live-seq: root.live-seq;
        running: root.running;
        content-w: root.content-w;
        captcha: root.captcha;
        captcha-frame: root.captcha-frame;
        toggle(seq) => {
            root.toggle(seq);
        }
        act(seq, a) => {
            root.act(seq, a);
        }
        link(u) => {
            root.link(u);
        }
        open-url(u) => {
            root.open-url(u);
        }
        open-media(p) => {
            root.open-media(p);
        }
        copy-text(t) => {
            root.copy-text(t);
        }
        near-top => {
            if root.head.focused {
                root.near-top();
            }
        }
        queue-menu(seq, x, y) => {
            root.queue-menu(seq, x, y);
        }
        captcha-seen(id, on, w) => {
            root.captcha-seen(id, on, w);
        }
        captcha-pointer(id, kind, fx, fy) => {
            root.captcha-pointer(id, kind, fx, fy);
        }
        captcha-cancel(id) => {
            root.captcha-cancel(id);
        }
    }
    // Over the transcript: the first click on a pane without the keyboard gives it the keyboard (the wheel still
    // scrolls it); a pane is acted on once it's the focused one.
    TouchArea {
        visible: !root.head.focused;
        x: 0;
        y: root.head-h;
        width: root.width;
        height: max(0px, root.height - root.head-h - root.box);
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.take(false, tr.from-end-now, tr.at-end);
            }
        }
    }
    // Its composer: the focused pane's own Composer, fed with this chat's state, so a pane looks the same with or
    // without the keyboard. What's typed waits there; a click anywhere on it hands the pane the keyboard.
    cbox := VerticalLayout {
        visible: !root.head.focused;
        x: root.side;
        y: root.height - self.height;
        width: max(0px, root.width - 2 * root.side);
        height: self.preferred-height;
        padding-top: 8px;
        padding-bottom: 2px;
        Composer {
            compact: true;
            text: root.head.draft;
            state: root.head.composer;
            logo: root.head.logo;
            badge-photo: root.head.badge-photo;
            has-badge-photo: root.head.has-badge-photo;
            bar: root.head.bar;
            strip-rows: root.body.strip;
            strip-title: root.head.strip-title;
            strip-names: root.head.strip-names;
            strip-header: root.head.strip-header;
            strip-folded: root.head.strip-folded;
            strip-open: root.head.strip-open;
        }
    }
    TouchArea {
        visible: !root.head.focused;
        x: cbox.x;
        y: cbox.y;
        width: cbox.width;
        height: cbox.height;
        mouse-cursor: text;
        clicked => {
            root.take(true, tr.from-end-now, tr.at-end);
        }
    }
}

// The split panes, all four places drawn by the same SidePane (unused ones hidden): each keeps its own transcript,
// so the keyboard going to another pane moves only the focus (its header's brightness, which composer is the
// window's). Not repeated, so the window reaches the focused pane's transcript (scrolling, its place, its end).
export component Panes {
    in property <[PaneHead]> heads;
    in property <[PaneBody]> bodies;
    in property <length> content-w: 760px;
    // The window's composer under the focused pane: that pane ends above it.
    in property <length> focus-box;
    in property <ChatCaptchaData> captcha;
    in property <image> captcha-frame;
    callback take(int, bool, length, bool);
    callback close(int);
    callback maximize(int);
    callback drag(int, length, length);
    callback dropped(int, length, length);
    callback toggle(int, int);
    callback act(int, int, string);
    callback link(string);
    callback open-url(string);
    callback open-media(string);
    callback copy-text(string);
    callback near-top();
    callback queue-menu(int, length, length);
    callback captcha-seen(string, bool, float);
    callback captcha-pointer(string, string, float, float);
    callback captcha-cancel(string);
    property <PaneHead> none;
    property <PaneBody> nobody;
    property <ChatCaptchaData> nocap;
    // The focused pane (0 when none is, as the window then shows no panes).
    property <int> fi: root.heads.length > 1 && root.heads[1].focused ? 1 : root.heads.length > 2 && root.heads[2].focused ? 2 : root.heads.length > 3 && root.heads[3].focused ? 3 : 0;
    out property <bool> at-end: fi == 1 ? p1.at-end : fi == 2 ? p2.at-end : fi == 3 ? p3.at-end : p0.at-end;
    out property <length> content-height: fi == 1 ? p1.content-height : fi == 2 ? p2.content-height : fi == 3 ? p3.content-height : p0.content-height;
    out property <length> view-height: fi == 1 ? p1.view-height : fi == 2 ? p2.view-height : fi == 3 ? p3.view-height : p0.view-height;
    out property <bool> follow: fi == 1 ? p1.follow : fi == 2 ? p2.follow : fi == 3 ? p3.follow : p0.follow;
    out property <length> from-end-now: fi == 1 ? p1.from-end-now : fi == 2 ? p2.from-end-now : fi == 3 ? p3.from-end-now : p0.from-end-now;
    public function scroll-to-end() {
        if fi == 1 {
            p1.scroll-to-end();
        } else if fi == 2 {
            p2.scroll-to-end();
        } else if fi == 3 {
            p3.scroll-to-end();
        } else {
            p0.scroll-to-end();
        }
    }
    public function page(dir: int) {
        if fi == 1 {
            p1.page(dir);
        } else if fi == 2 {
            p2.page(dir);
        } else if fi == 3 {
            p3.page(dir);
        } else {
            p0.page(dir);
        }
    }
    public function scroll-to-top() {
        if fi == 1 {
            p1.scroll-to-top();
        } else if fi == 2 {
            p2.scroll-to-top();
        } else if fi == 3 {
            p3.scroll-to-top();
        } else {
            p0.scroll-to-top();
        }
    }
    public function grew-above(before: length) {
        if fi == 1 {
            p1.grew-above(before);
        } else if fi == 2 {
            p2.grew-above(before);
        } else if fi == 3 {
            p3.grew-above(before);
        } else {
            p0.grew-above(before);
        }
    }
    public function anchor-off() {
        if fi == 1 {
            p1.anchor-off();
        } else if fi == 2 {
            p2.anchor-off();
        } else if fi == 3 {
            p3.anchor-off();
        } else {
            p0.anchor-off();
        }
    }
    public function keep-from-end(d: length) {
        if fi == 1 {
            p1.keep-from-end(d);
        } else if fi == 2 {
            p2.keep-from-end(d);
        } else if fi == 3 {
            p3.keep-from-end(d);
        } else {
            p0.keep-from-end(d);
        }
    }
    p0 := SidePane {
        property <PaneHead> h: root.heads.length > 0 ? root.heads[0] : root.none;
        visible: root.heads.length > 0 && self.h.shown;
        x: floor(self.h.x * root.width / 1phx) * 1phx;
        y: floor(self.h.y * root.height / 1phx) * 1phx;
        width: floor((self.h.x + self.h.w) * root.width / 1phx) * 1phx - self.x;
        height: floor((self.h.y + self.h.h) * root.height / 1phx) * 1phx - self.y - (self.h.focused ? root.focus-box : 0px);
        head: self.h;
        body: root.bodies.length > 0 ? root.bodies[0] : root.nobody;
        content-w: root.content-w;
        captcha: self.h.focused ? root.captcha : root.nocap;
        captcha-frame: root.captcha-frame;
        take(composer, from-end, follow) => {
            root.take(0, composer, from-end, follow);
        }
        close => {
            root.close(0);
        }
        maximize => {
            root.maximize(0);
        }
        drag(x, y) => {
            root.drag(0, x, y);
        }
        dropped(x, y) => {
            root.dropped(0, x, y);
        }
        toggle(seq) => {
            root.toggle(0, seq);
        }
        act(seq, a) => {
            root.act(0, seq, a);
        }
        link(u) => {
            root.link(u);
        }
        open-url(u) => {
            root.open-url(u);
        }
        open-media(p) => {
            root.open-media(p);
        }
        copy-text(t) => {
            root.copy-text(t);
        }
        near-top => {
            root.near-top();
        }
        queue-menu(seq, x, y) => {
            root.queue-menu(seq, x, y);
        }
        captcha-seen(id, on, w) => {
            root.captcha-seen(id, on, w);
        }
        captcha-pointer(id, kind, fx, fy) => {
            root.captcha-pointer(id, kind, fx, fy);
        }
        captcha-cancel(id) => {
            root.captcha-cancel(id);
        }
    }
    p1 := SidePane {
        property <PaneHead> h: root.heads.length > 1 ? root.heads[1] : root.none;
        visible: root.heads.length > 1 && self.h.shown;
        x: floor(self.h.x * root.width / 1phx) * 1phx;
        y: floor(self.h.y * root.height / 1phx) * 1phx;
        width: floor((self.h.x + self.h.w) * root.width / 1phx) * 1phx - self.x;
        height: floor((self.h.y + self.h.h) * root.height / 1phx) * 1phx - self.y - (self.h.focused ? root.focus-box : 0px);
        head: self.h;
        body: root.bodies.length > 1 ? root.bodies[1] : root.nobody;
        content-w: root.content-w;
        captcha: self.h.focused ? root.captcha : root.nocap;
        captcha-frame: root.captcha-frame;
        take(composer, from-end, follow) => {
            root.take(1, composer, from-end, follow);
        }
        close => {
            root.close(1);
        }
        maximize => {
            root.maximize(1);
        }
        drag(x, y) => {
            root.drag(1, x, y);
        }
        dropped(x, y) => {
            root.dropped(1, x, y);
        }
        toggle(seq) => {
            root.toggle(1, seq);
        }
        act(seq, a) => {
            root.act(1, seq, a);
        }
        link(u) => {
            root.link(u);
        }
        open-url(u) => {
            root.open-url(u);
        }
        open-media(p) => {
            root.open-media(p);
        }
        copy-text(t) => {
            root.copy-text(t);
        }
        near-top => {
            root.near-top();
        }
        queue-menu(seq, x, y) => {
            root.queue-menu(seq, x, y);
        }
        captcha-seen(id, on, w) => {
            root.captcha-seen(id, on, w);
        }
        captcha-pointer(id, kind, fx, fy) => {
            root.captcha-pointer(id, kind, fx, fy);
        }
        captcha-cancel(id) => {
            root.captcha-cancel(id);
        }
    }
    p2 := SidePane {
        property <PaneHead> h: root.heads.length > 2 ? root.heads[2] : root.none;
        visible: root.heads.length > 2 && self.h.shown;
        x: floor(self.h.x * root.width / 1phx) * 1phx;
        y: floor(self.h.y * root.height / 1phx) * 1phx;
        width: floor((self.h.x + self.h.w) * root.width / 1phx) * 1phx - self.x;
        height: floor((self.h.y + self.h.h) * root.height / 1phx) * 1phx - self.y - (self.h.focused ? root.focus-box : 0px);
        head: self.h;
        body: root.bodies.length > 2 ? root.bodies[2] : root.nobody;
        content-w: root.content-w;
        captcha: self.h.focused ? root.captcha : root.nocap;
        captcha-frame: root.captcha-frame;
        take(composer, from-end, follow) => {
            root.take(2, composer, from-end, follow);
        }
        close => {
            root.close(2);
        }
        maximize => {
            root.maximize(2);
        }
        drag(x, y) => {
            root.drag(2, x, y);
        }
        dropped(x, y) => {
            root.dropped(2, x, y);
        }
        toggle(seq) => {
            root.toggle(2, seq);
        }
        act(seq, a) => {
            root.act(2, seq, a);
        }
        link(u) => {
            root.link(u);
        }
        open-url(u) => {
            root.open-url(u);
        }
        open-media(p) => {
            root.open-media(p);
        }
        copy-text(t) => {
            root.copy-text(t);
        }
        near-top => {
            root.near-top();
        }
        queue-menu(seq, x, y) => {
            root.queue-menu(seq, x, y);
        }
        captcha-seen(id, on, w) => {
            root.captcha-seen(id, on, w);
        }
        captcha-pointer(id, kind, fx, fy) => {
            root.captcha-pointer(id, kind, fx, fy);
        }
        captcha-cancel(id) => {
            root.captcha-cancel(id);
        }
    }
    p3 := SidePane {
        property <PaneHead> h: root.heads.length > 3 ? root.heads[3] : root.none;
        visible: root.heads.length > 3 && self.h.shown;
        x: floor(self.h.x * root.width / 1phx) * 1phx;
        y: floor(self.h.y * root.height / 1phx) * 1phx;
        width: floor((self.h.x + self.h.w) * root.width / 1phx) * 1phx - self.x;
        height: floor((self.h.y + self.h.h) * root.height / 1phx) * 1phx - self.y - (self.h.focused ? root.focus-box : 0px);
        head: self.h;
        body: root.bodies.length > 3 ? root.bodies[3] : root.nobody;
        content-w: root.content-w;
        captcha: self.h.focused ? root.captcha : root.nocap;
        captcha-frame: root.captcha-frame;
        take(composer, from-end, follow) => {
            root.take(3, composer, from-end, follow);
        }
        close => {
            root.close(3);
        }
        maximize => {
            root.maximize(3);
        }
        drag(x, y) => {
            root.drag(3, x, y);
        }
        dropped(x, y) => {
            root.dropped(3, x, y);
        }
        toggle(seq) => {
            root.toggle(3, seq);
        }
        act(seq, a) => {
            root.act(3, seq, a);
        }
        link(u) => {
            root.link(u);
        }
        open-url(u) => {
            root.open-url(u);
        }
        open-media(p) => {
            root.open-media(p);
        }
        copy-text(t) => {
            root.copy-text(t);
        }
        near-top => {
            root.near-top();
        }
        queue-menu(seq, x, y) => {
            root.queue-menu(seq, x, y);
        }
        captcha-seen(id, on, w) => {
            root.captcha-seen(id, on, w);
        }
        captcha-pointer(id, kind, fx, fy) => {
            root.captcha-pointer(id, kind, fx, fy);
        }
        captcha-cancel(id) => {
            root.captcha-cancel(id);
        }
    }
}

// The layout glyphs (the "4 panes is the most" notice draws one): drawn, so no font glyph has to be added for them. "cols" three columns, "rows"
// three rows, "main" one tall beside two stacked, "2x2" two by two.
export component LayoutGlyph {
    in property <string> id;
    in property <color> ink;
    width: 14px;
    height: 12px;
    property <length> t: 1.3px;
    Rectangle {
        border-width: root.t;
        border-color: root.ink;
        border-radius: 2px;
    }
    for k in root.id == "cols" ? 2 : 0: Rectangle {
        x: round((parent.width - root.t) * (k + 1) / 3 / 1px) * 1px;
        width: root.t;
        background: root.ink;
    }
    for k in root.id == "rows" ? 2 : 0: Rectangle {
        y: round((parent.height - root.t) * (k + 1) / 3 / 1px) * 1px;
        height: root.t;
        background: root.ink;
    }
    if root.id == "main" || root.id == "2x2": Rectangle {
        x: (parent.width - root.t) / 2;
        width: root.t;
        background: root.ink;
    }
    if root.id == "main": Rectangle {
        x: parent.width / 2;
        y: (parent.height - root.t) / 2;
        width: parent.width / 2;
        height: root.t;
        background: root.ink;
    }
    if root.id == "2x2": Rectangle {
        y: (parent.height - root.t) / 2;
        height: root.t;
        background: root.ink;
    }
}


// While a chat (or a pane, by its header) is dragged over the centre: a dim scrim, the zone it would land in, and (a
// chat with four panes open) each pane's Replace target. `heads` give the panes' places; `from` is the dragged pane
// (-1: a chat), dimmed further; the zone and labels come from the shell.
export component DropOverlay {
    in property <PaneDrop> drop;
    in property <[PaneHead]> heads;
    in property <int> from: -1;
    property <bool> replace: drop.kind == "replace" || drop.kind == "swap";
    Rectangle {
        background: #000000.with-alpha(Theme.dark ? 0.55 : 0.3);
    }
    // One pane: its outline (any of its four sides splits it).
    if root.heads.length == 0: Rectangle {
        x: 12px;
        y: 12px;
        width: root.width - 24px;
        height: root.height - 24px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.fg.with-alpha(0.14);
    }
    // Every pane's outline, so the places to drop show at a glance.
    for h[i] in root.heads: Rectangle {
        visible: h.shown;
        x: h.x * root.width + 12px;
        y: h.y * root.height + 12px;
        width: max(0px, h.w * root.width - 24px);
        height: max(0px, h.h * root.height - 24px);
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.fg.with-alpha(0.14);
        background: i == root.from ? #000000.with-alpha(0.25) : transparent;
        // Four open: each pane is a Replace target with what keeps running.
        if root.drop.cap && !(root.drop.kind == "replace" && root.drop.pane == i): Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: cap-col.preferred-width;
            height: cap-col.preferred-height;
            border-radius: 10px;
            background: Theme.bg100.with-alpha(0.92);
            border-width: 1px;
            border-color: Theme.border;
            cap-col := VerticalLayout {
                padding: 14px;
                spacing: 8px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: cap-row.preferred-width;
                        height: 32px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: Theme.gray-500;
                        background: Theme.gray-100;
                        cap-row := HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            Glyph {
                                width: 13px;
                                icon: Icons.refresh;
                                size: 13px;
                                color: Theme.subtle;
                            }
                            Text {
                                text: "Replace this pane";
                                font-size: 13.5px;
                                color: Theme.subtle;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    max-width: 320px;
                    text: h.title + " keeps running";
                    font-size: 12.5px;
                    color: Theme.subtle;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
    if root.drop.kind != "none" && root.drop.kind != "": Rectangle {
        x: root.drop.x * root.width + 12px;
        y: root.drop.y * root.height + 12px;
        width: max(0px, root.drop.w * root.width - 24px);
        height: max(0px, root.drop.h * root.height - 24px);
        border-radius: 10px;
        border-width: 1.5px;
        border-color: Theme.blue-700;
        background: Theme.blue-700.with-alpha(0.12);
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: label-col.preferred-width;
            height: label-col.preferred-height;
            border-radius: 10px;
            background: root.replace ? Theme.bg100.with-alpha(0.92) : transparent;
            border-width: root.replace ? 1px : 0px;
            border-color: Theme.border;
            label-col := VerticalLayout {
                padding: root.replace ? 14px : 0px;
                spacing: 8px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: label-row.preferred-width;
                        height: 32px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: root.replace ? Theme.blue-700 : Theme.blue-600;
                        background: root.replace ? Theme.blue-700 : Theme.blue-200;
                        label-row := HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            Glyph {
                                width: 13px;
                                icon: root.drop.kind == "swap" ? Icons.arrow-down-up : root.replace ? Icons.refresh : root.drop.kind == "here" ? Icons.check : Icons.panel-right;
                                size: 13px;
                                color: root.replace ? #ffffff : Theme.blue-1000;
                            }
                            Text {
                                text: root.drop.label;
                                font-size: 13.5px;
                                font-weight: 500;
                                color: root.replace ? #ffffff : Theme.blue-1000;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                if root.drop.sub != "": Text {
                    max-width: 320px;
                    text: root.drop.sub;
                    font-size: 12.5px;
                    color: Theme.subtle;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

// The chat being dragged, following the pointer.
export component DragGhost inherits Rectangle {
    in property <SideRow> chat;
    width: 290px;
    height: 54px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.gray-500;
    background: Theme.bg200;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000066;
    drop-shadow-offset-y: 4px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Glyph {
            width: 16px;
            icon: Icons.message;
            size: 14px;
            color: Theme.subtle;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.chat.title;
                    font-size: 13.5px;
                    font-weight: 500;
                    color: Theme.fg;
                    overflow: elide;
                }
                StatusView {
                    status: root.chat.status;
                }
            }
            Text {
                text: root.chat.branch != "" ? root.chat.branch : root.chat.kind == "thread" ? "Chat" : "Thread";
                font-size: 12px;
                color: Theme.subtle;
                overflow: elide;
            }
        }
    }
}

// A pane being dragged by its header, following the pointer: its name and status.
export component PaneGhost inherits Rectangle {
    in property <PaneHead> head;
    width: min(290px, row.preferred-width);
    height: 40px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.gray-500;
    background: Theme.bg200;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000066;
    drop-shadow-offset-y: 4px;
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            LayoutGlyph {
                id: "cols";
                ink: Theme.subtle;
            }
        }
        Text {
            min-width: 40px;
            max-width: 200px;
            text: root.head.title;
            font-size: 13.5px;
            font-weight: 500;
            color: Theme.fg;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.head.pill != "": VerticalLayout {
            alignment: center;
            Pill {
                text: root.head.pill;
                tone: root.head.tone;
            }
        }
    }
}
