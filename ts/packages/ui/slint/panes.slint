// Split chat panes (logic/splitpanes.ts): up to four chats side by side in the centre. The focused pane is the usual
// chat view (app.slint moves it into its place under its header); the others are drawn here, each with its own
// transcript and a one-line composer that hands the keyboard to it with a click.
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Glyph, Spinner, Btn, TipArea, StatusData, StatusView } from "widgets.slint";
import { Transcript, CardData } from "chat.slint";
import { MdBlock } from "markdown.slint";
import { SideRow } from "sidebar.slint";

/** A pane's header and place: x, y, w, h are shares of the centre. */
export struct PaneHead {
    chat: int,
    title: string,
    // Under its composer, small and muted: where the agent works ("Worktree · name"), its branch.
    ws: string,
    branch: string,
    // The status pill: "" none; tone "blue" (with a spinner), "amber", "green", "red", "gray".
    pill: string,
    tone: string,
    focused: bool,
    shown: bool,
    maxed: bool,
    x: float,
    y: float,
    w: float,
    h: float,
    running: bool,
    live-seq: int,
    // The one-line composer of a pane without the keyboard: its draft, its model.
    draft: string,
    model: string,
}

/** A pane's transcript (empty for the focused one: the usual view shows it). Set once per pane, filled in place. */
export struct PaneBody {
    cards: [CardData],
    live: [MdBlock],
}

/** A divider between the two sides of a split: at (share of the centre) on x ("h") or y ("v"), over its split's area. */
export struct PaneDiv {
    path: string,
    dir: string,
    at: float,
    ax: float,
    ay: float,
    aw: float,
    ah: float,
}

/** Where a chat dragged from the sidebar, or a pane dragged by its header, would land (splitpanes.ts Drop). */
export struct PaneDrop {
    kind: string,
    pane: int,
    x: float,
    y: float,
    w: float,
    h: float,
    label: string,
    sub: string,
    cap: bool,
}

export struct PanePreset {
    id: string,
    on: bool,
    enabled: bool,
    tip: string,
}

// The header's height; a split pane's composer: its one-line card, the footer under it, and the room both take.
export global PaneMetrics {
    out property <length> head: 34px;
    out property <length> card: 44px;
    out property <length> foot: 24px;
    // The composer box's room under the transcript: 8px over the card, the footer (or 10px) under it.
    out property <length> box: 8px + card + foot + 2px;
    // Near the centre's outer edge (px), a drop goes beside the whole layout.
    out property <length> band: 28px;
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <string> tone;
    property <color> ink: tone == "blue" ? Theme.blue-900 : tone == "amber" ? Theme.amber-900 : tone == "green" ? Theme.green-900 : tone == "red" ? Theme.red-900 : Theme.subtle;
    height: 19px;
    width: row.preferred-width;
    border-radius: 10px;
    border-width: 1px;
    border-color: tone == "blue" ? Theme.blue-500 : tone == "amber" ? Theme.amber-500 : tone == "green" ? Theme.green-500 : tone == "red" ? Theme.red-500 : Theme.gray-400;
    background: tone == "blue" ? Theme.blue-100 : tone == "amber" ? Theme.amber-100 : tone == "green" ? Theme.green-100 : tone == "red" ? Theme.red-100 : Theme.gray-100;
    row := HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 5px;
        if root.tone == "blue": Rectangle {
            width: 11px;
            Spinner {
                radius: 5px;
                color: root.ink;
            }
        }
        Text {
            text: root.text;
            font-size: 11.5px;
            font-weight: 500;
            color: root.ink;
            vertical-alignment: center;
        }
    }
}

// The pane's slim head: its chat's name and status; maximize and close on the right. The whole head is the grip: dragged
// past 6px it moves the pane (onto another to swap, onto an edge to go there); clicked without moving, it focuses.
export component PaneHeader inherits Rectangle {
    in property <PaneHead> head;
    callback take();
    callback close();
    callback maximize();
    // The pointer in window coordinates while the head is dragged, and where it was let go.
    callback drag(length, length);
    callback dropped(length, length);
    property <bool> far;
    height: PaneMetrics.head;
    background: Theme.bg100;
    grip := TouchArea {
        mouse-cursor: root.far ? MouseCursor.grabbing : MouseCursor.default;
        clicked => {
            if !root.far {
                root.take();
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.far = false;
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.far {
                root.dropped(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        moved => {
            root.far = root.far || abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px;
            if root.far {
                root.drag(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 8px;
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            // The focused pane's name at full strength, the others' a little dimmer: focus shown, quietly.
            Text {
                min-width: 24px;
                max-width: self.preferred-width;
                horizontal-stretch: 1;
                text: root.head.title;
                font-size: 13px;
                font-weight: 500;
                color: root.head.focused ? Theme.fg : Theme.fg.mix(Theme.subtle, 0.45);
                overflow: elide;
                vertical-alignment: center;
            }
            if root.head.pill != "": VerticalLayout {
                alignment: center;
                Pill {
                    text: root.head.pill;
                    tone: root.head.tone;
                }
            }
            Rectangle {
                horizontal-stretch: 0.001;
            }
        }
        HorizontalLayout {
            spacing: 0px;
            VerticalLayout {
                alignment: center;
                Btn {
                    icon: root.head.maxed ? Icons.minimize : Icons.maximize;
                    size: icon-xs;
                    variant: ghost-muted;
                    tip: root.head.maxed ? "Show every pane" : "Show this pane alone";
                    clicked => {
                        root.maximize();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    icon: Icons.x;
                    size: icon-xs;
                    variant: ghost-muted;
                    tip: "Close pane · chat keeps running · Ctrl+W";
                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }
}

// Under a split pane's composer: where its agent works on the left, its branch on the right; small and muted.
export component PaneFoot {
    in property <string> ws;
    in property <string> branch;
    height: PaneMetrics.foot;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        if root.ws != "": HorizontalLayout {
            spacing: 5px;
            horizontal-stretch: 0;
            min-width: min(self.preferred-width, 60px);
            Glyph {
                width: 12px;
                icon: Icons.folder-git;
                size: 11px;
                color: Theme.gray-700;
            }
            Text {
                text: root.ws;
                font-size: 11.5px;
                color: Theme.gray-700;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        if root.branch != "": HorizontalLayout {
            spacing: 4px;
            horizontal-stretch: 0;
            min-width: min(self.preferred-width, 60px);
            Glyph {
                width: 12px;
                icon: Icons.branch;
                size: 11px;
                color: Theme.gray-700;
            }
            Text {
                text: root.branch;
                font-family: "Geist Mono";
                font-size: 11px;
                color: Theme.gray-700;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
}

// A pane without the keyboard: its header, its transcript, and a one-line composer (as the focused pane's, compact)
// that gives it the keyboard.
export component SidePane inherits Rectangle {
    in property <PaneHead> head;
    in property <PaneBody> body;
    in property <length> content-w: 760px;
    // To the shell: the transcript's distance from its end and whether it follows it, kept as the pane takes the keyboard.
    callback take(bool, length, bool);
    callback close();
    callback maximize();
    callback drag(length, length);
    callback dropped(length, length);
    callback toggle(int);
    callback act(int, string);
    callback link(string);
    callback open-url(string);
    callback open-media(string);
    callback copy-text(string);
    clip: true;
    background: Theme.bg100;
    property <bool> foot: root.head.ws != "" || root.head.branch != "";
    property <length> box: PaneMetrics.box;
    // Behind everything: a click on the pane where nothing else takes it gives it the keyboard.
    TouchArea {
        clicked => {
            root.take(false, tr.from-end-now, tr.at-end);
        }
    }
    PaneHeader {
        x: 0;
        y: 0;
        width: parent.width;
        head: root.head;
        take => {
            root.take(false, tr.from-end-now, tr.at-end);
        }
        close => {
            root.close();
        }
        maximize => {
            root.maximize();
        }
        drag(x, y) => {
            root.drag(x, y);
        }
        dropped(x, y) => {
            root.dropped(x, y);
        }
    }
    property <length> side: max((root.width - root.content-w) / 2, root.width < 520px ? 12px : 24px);
    tr := Transcript {
        visible: !root.head.focused;
        x: 0;
        y: PaneMetrics.head;
        width: root.width;
        height: max(0px, root.height - PaneMetrics.head - root.box);
        cards: root.body.cards;
        live-blocks: root.body.live;
        live-seq: root.head.live-seq;
        running: root.head.running;
        content-w: root.content-w;
        toggle(seq) => {
            root.toggle(seq);
        }
        act(seq, a) => {
            root.act(seq, a);
        }
        link(u) => {
            root.link(u);
        }
        open-url(u) => {
            root.open-url(u);
        }
        open-media(p) => {
            root.open-media(p);
        }
        copy-text(t) => {
            root.copy-text(t);
        }
    }
    // Over the transcript: the first click on a pane without the keyboard gives it the keyboard (the wheel still
    // scrolls it); a pane is acted on once it's the focused one, the usual view.
    TouchArea {
        visible: !root.head.focused;
        x: 0;
        y: PaneMetrics.head;
        width: root.width;
        height: max(0px, root.height - PaneMetrics.head - root.box);
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.take(false, tr.from-end-now, tr.at-end);
            }
        }
    }
    // The one-line composer: what's typed in it waits there; a click hands it the keyboard. Drawn as the focused
    // pane's compact Composer is (composer.slint), so focusing a pane moves nothing.
    Rectangle {
        visible: !root.head.focused;
        x: root.side;
        y: root.height - root.box + 8px;
        width: max(0px, root.width - 2 * root.side);
        height: PaneMetrics.card;
        border-radius: 12px;
        border-width: 1px;
        border-color: field-area.has-hover ? Theme.gray-600 : Theme.border;
        background: Theme.dark ? Theme.bg200 : Theme.bg100;
        field-area := TouchArea {
            mouse-cursor: text;
            clicked => {
                root.take(true, tr.from-end-now, tr.at-end);
            }
        }
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 6px;
            spacing: 4px;
            Text {
                horizontal-stretch: 1;
                text: root.head.draft != "" ? root.head.draft : "Message…";
                font-size: 14px;
                color: root.head.draft != "" ? Theme.fg : Theme.gray-900;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.head.model != "" && root.width - 2 * root.side - 20px > 420px: HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 4px;
                Text {
                    max-width: 120px;
                    text: root.head.model;
                    font-size: 12.5px;
                    color: Theme.subtle;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Glyph {
                    width: 11px;
                    icon: Icons.down;
                    size: 11px;
                    color: Theme.subtle;
                }
            }
            for g in [Icons.mic, Icons.clip]: Rectangle {
                width: 30px;
                Glyph {
                    icon: g;
                    size: 15px;
                    color: Theme.subtle;
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.gray-200;
                    Glyph {
                        icon: Icons.arrow-up;
                        size: 14px;
                        color: Theme.subtle;
                    }
                }
            }
        }
    }
    if !root.head.focused && root.foot: PaneFoot {
        x: root.side;
        y: root.height - PaneMetrics.foot - 2px;
        width: max(0px, root.width - 2 * root.side);
        ws: root.head.ws;
        branch: root.head.branch;
    }
}

// The top bar's layout buttons' glyphs: drawn, so no font glyph has to be added for them. "cols" three columns, "rows"
// three rows, "main" one tall beside two stacked, "2x2" two by two.
export component LayoutGlyph {
    in property <string> id;
    in property <color> ink;
    width: 14px;
    height: 12px;
    property <length> t: 1.3px;
    Rectangle {
        border-width: root.t;
        border-color: root.ink;
        border-radius: 2px;
    }
    for k in root.id == "cols" ? 2 : 0: Rectangle {
        x: round((parent.width - root.t) * (k + 1) / 3 / 1px) * 1px;
        width: root.t;
        background: root.ink;
    }
    for k in root.id == "rows" ? 2 : 0: Rectangle {
        y: round((parent.height - root.t) * (k + 1) / 3 / 1px) * 1px;
        height: root.t;
        background: root.ink;
    }
    if root.id == "main" || root.id == "2x2": Rectangle {
        x: (parent.width - root.t) / 2;
        width: root.t;
        background: root.ink;
    }
    if root.id == "main": Rectangle {
        x: parent.width / 2;
        y: (parent.height - root.t) / 2;
        width: parent.width / 2;
        height: root.t;
        background: root.ink;
    }
    if root.id == "2x2": Rectangle {
        y: (parent.height - root.t) / 2;
        height: root.t;
        background: root.ink;
    }
}

// The layout buttons and "N of 4", in place of the breadcrumb while the centre is split.
export component LayoutBar {
    in property <[PanePreset]> presets;
    in property <int> count;
    callback pick(string);
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: seg.preferred-width;
            height: 28px;
            border-radius: 7px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.bg200;
            seg := HorizontalLayout {
                padding: 2px;
                spacing: 2px;
                for p in root.presets: Rectangle {
                    width: 28px;
                    height: 22px;
                    border-radius: 5px;
                    background: p.on ? Theme.gray-300 : area.has-hover && p.enabled ? Theme.gray-200 : transparent;
                    LayoutGlyph {
                        id: p.id;
                        ink: p.on ? Theme.fg : p.enabled ? Theme.gray-900 : Theme.gray-600;
                    }
                    area := TipArea {
                        tip: p.tip;
                        mouse-cursor: p.enabled ? pointer : default;
                        clicked => {
                            if p.enabled {
                                root.pick(p.id);
                            }
                        }
                    }
                }
            }
        }
        Text {
            text: root.count + " of 4";
            font-size: 13px;
            color: Theme.subtle;
            vertical-alignment: center;
        }
    }
}

// While a chat (or a pane, by its header) is dragged over the centre: a dim scrim, the zone it would land in, and (a
// chat with four panes open) each pane's Replace target. `heads` give the panes' places; `from` is the dragged pane
// (-1: a chat), dimmed further; the zone and labels come from the shell.
export component DropOverlay {
    in property <PaneDrop> drop;
    in property <[PaneHead]> heads;
    in property <int> from: -1;
    property <bool> replace: drop.kind == "replace" || drop.kind == "swap";
    Rectangle {
        background: #000000.with-alpha(Theme.dark ? 0.55 : 0.3);
    }
    // One pane: its outline (any of its four sides splits it).
    if root.heads.length == 0: Rectangle {
        x: 12px;
        y: 12px;
        width: root.width - 24px;
        height: root.height - 24px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.fg.with-alpha(0.14);
    }
    // Every pane's outline, so the places to drop show at a glance.
    for h[i] in root.heads: Rectangle {
        visible: h.shown;
        x: h.x * root.width + 12px;
        y: h.y * root.height + 12px;
        width: max(0px, h.w * root.width - 24px);
        height: max(0px, h.h * root.height - 24px);
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.fg.with-alpha(0.14);
        background: i == root.from ? #000000.with-alpha(0.25) : transparent;
        // Four open: each pane is a Replace target with what keeps running.
        if root.drop.cap && !(root.drop.kind == "replace" && root.drop.pane == i): Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: cap-col.preferred-width;
            height: cap-col.preferred-height;
            border-radius: 10px;
            background: Theme.bg100.with-alpha(0.92);
            border-width: 1px;
            border-color: Theme.border;
            cap-col := VerticalLayout {
                padding: 14px;
                spacing: 8px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: cap-row.preferred-width;
                        height: 32px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: Theme.gray-500;
                        background: Theme.gray-100;
                        cap-row := HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            Glyph {
                                width: 13px;
                                icon: Icons.refresh;
                                size: 13px;
                                color: Theme.subtle;
                            }
                            Text {
                                text: "Replace this pane";
                                font-size: 13.5px;
                                color: Theme.subtle;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    max-width: 320px;
                    text: h.title + " keeps running";
                    font-size: 12.5px;
                    color: Theme.subtle;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
    if root.drop.kind != "none" && root.drop.kind != "": Rectangle {
        x: root.drop.x * root.width + 12px;
        y: root.drop.y * root.height + 12px;
        width: max(0px, root.drop.w * root.width - 24px);
        height: max(0px, root.drop.h * root.height - 24px);
        border-radius: 10px;
        border-width: 1.5px;
        border-color: Theme.blue-700;
        background: Theme.blue-700.with-alpha(0.12);
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: label-col.preferred-width;
            height: label-col.preferred-height;
            border-radius: 10px;
            background: root.replace ? Theme.bg100.with-alpha(0.92) : transparent;
            border-width: root.replace ? 1px : 0px;
            border-color: Theme.border;
            label-col := VerticalLayout {
                padding: root.replace ? 14px : 0px;
                spacing: 8px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: label-row.preferred-width;
                        height: 32px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: root.replace ? Theme.blue-700 : Theme.blue-600;
                        background: root.replace ? Theme.blue-700 : Theme.blue-200;
                        label-row := HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            Glyph {
                                width: 13px;
                                icon: root.drop.kind == "swap" ? Icons.arrow-down-up : root.replace ? Icons.refresh : root.drop.kind == "here" ? Icons.check : Icons.panel-right;
                                size: 13px;
                                color: root.replace ? #ffffff : Theme.blue-1000;
                            }
                            Text {
                                text: root.drop.label;
                                font-size: 13.5px;
                                font-weight: 500;
                                color: root.replace ? #ffffff : Theme.blue-1000;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                if root.drop.sub != "": Text {
                    max-width: 320px;
                    text: root.drop.sub;
                    font-size: 12.5px;
                    color: Theme.subtle;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

// The chat being dragged, following the pointer.
export component DragGhost inherits Rectangle {
    in property <SideRow> chat;
    width: 290px;
    height: 54px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.gray-500;
    background: Theme.bg200;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000066;
    drop-shadow-offset-y: 4px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Glyph {
            width: 16px;
            icon: Icons.message;
            size: 14px;
            color: Theme.subtle;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.chat.title;
                    font-size: 13.5px;
                    font-weight: 500;
                    color: Theme.fg;
                    overflow: elide;
                }
                StatusView {
                    status: root.chat.status;
                }
            }
            Text {
                text: root.chat.branch != "" ? root.chat.branch : root.chat.kind == "thread" ? "Chat" : "Thread";
                font-size: 12px;
                color: Theme.subtle;
                overflow: elide;
            }
        }
    }
}

// A pane being dragged by its header, following the pointer: its name and status.
export component PaneGhost inherits Rectangle {
    in property <PaneHead> head;
    width: min(290px, row.preferred-width);
    height: 40px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.gray-500;
    background: Theme.bg200;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000066;
    drop-shadow-offset-y: 4px;
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            LayoutGlyph {
                id: "cols";
                ink: Theme.subtle;
            }
        }
        Text {
            min-width: 40px;
            max-width: 200px;
            text: root.head.title;
            font-size: 13.5px;
            font-weight: 500;
            color: Theme.fg;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.head.pill != "": VerticalLayout {
            alignment: center;
            Pill {
                text: root.head.pill;
                tone: root.head.tone;
            }
        }
    }
}
