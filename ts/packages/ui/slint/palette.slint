import "fonts/Geist-Regular.ttf";
import "fonts/Geist-Medium.ttf";
import "fonts/Geist-SemiBold.ttf";
import "fonts/GeistMono-Regular.ttf";
import "fonts/lucide.ttf";
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Glyph, SearchField, Separator } from "widgets.slint";

export struct PaletteRow {
    icon: string,
    title: string,
    detail: string,
    index: int,
}

export struct PaletteSection {
    title: string,
    rows: [PaletteRow],
}

// palette.rs `palette_ui`: the box pinned near the top over a dimmed window; Esc or a click outside closes it.
export component PaletteOverlay inherits Rectangle {
    in property <[PaletteSection]> sections;
    in property <int> selected;
    in-out property <string> query <=> field.text;
    callback edited(string);
    callback move(int);
    callback pick(int);
    callback close();
    public function focus-field() {
        field.focus-field();
    }
    background: #00000060;
    TouchArea {
        clicked => {
            root.close();
        }
    }
    box := Rectangle {
        x: (root.width - self.width) / 2;
        y: clamp(root.height * 0.12, 24px, 120px);
        width: min(616px, root.width - 32px);
        height: col.preferred-height;
        background: Theme.bg100;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius-xl;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;
        TouchArea { }
        col := VerticalLayout {
            padding: 8px;
            field := SearchField {
                hint: "Search projects, chats, agents, pages and actions";
                edited(t) => {
                    root.edited(t);
                }
                key(e) => {
                    if e.text == Key.UpArrow {
                        root.move(-1);
                        return accept;
                    }
                    if e.text == Key.DownArrow {
                        root.move(1);
                        return accept;
                    }
                    if e.text == Key.Return {
                        root.pick(root.selected);
                        return accept;
                    }
                    if e.text == Key.Escape {
                        root.close();
                        return accept;
                    }
                    reject
                }
            }
            Rectangle {
                height: 6px;
            }
            Separator { }
            Rectangle {
                height: 4px;
            }
            if root.sections.length == 0: Text {
                height: 68px;
                text: "Nothing matches";
                font-size: 13px;
                color: Theme.subtle;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.sections.length > 0: ScrollView {
                height: min(list.preferred-height, clamp(root.height * 0.6, 160px, 460px));
                list := VerticalLayout {
                    for s in root.sections: VerticalLayout {
                        HorizontalLayout {
                            height: 26px;
                            padding-left: 10px;
                            padding-bottom: 7px;
                            Text {
                                text: s.title;
                                font-size: 11.5px;
                                font-weight: 500;
                                color: Theme.subtle;
                                vertical-alignment: bottom;
                            }
                        }
                        for r in s.rows: row := Rectangle {
                            height: 34px;
                            property <bool> on: r.index == root.selected;
                            Rectangle {
                                background: row.on ? Theme.accent : transparent;
                                border-radius: Theme.radius-md;
                            }
                            area := TouchArea {
                                mouse-cursor: pointer;
                                moved => {
                                    if self.has-hover && !row.on {
                                        root.move(r.index - root.selected);
                                    }
                                }
                                clicked => {
                                    root.pick(r.index);
                                }
                            }
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 10px;
                                spacing: 0px;
                                Glyph {
                                    width: 24px;
                                    text: r.icon;
                                    font-size: 15px;
                                    color: row.on ? Theme.fg : Theme.subtle;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: 4px;
                                }
                                Text {
                                    text: r.title;
                                    font-size: 13.5px;
                                    font-weight: 500;
                                    color: Theme.fg;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle {
                                    width: 10px;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: r.detail;
                                    font-size: 12.5px;
                                    color: Theme.subtle;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 4px;
            }
            Separator { }
            HorizontalLayout {
                height: 26px;
                padding-left: 10px;
                padding-top: 4px;
                Text {
                    text: "↑↓ to move  ·  Enter to open  ·  Esc to close";
                    font-size: 11.5px;
                    color: Theme.subtle;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component PaletteWindow inherits Window {
    in-out property <bool> dark <=> Theme.dark;
    in property <[PaletteSection]> sections;
    in property <int> selected;
    callback edited(string);
    callback move(int);
    callback pick(int);
    callback close();
    width: 1400px;
    height: 900px;
    background: Theme.bg100;
    default-font-family: "Geist";
    overlay := PaletteOverlay {
        width: root.width;
        height: root.height;
        sections: root.sections;
        selected: root.selected;
        edited(t) => {
            root.edited(t);
        }
        move(d) => {
            root.move(d);
        }
        pick(i) => {
            root.pick(i);
        }
        close => {
            root.close();
        }
    }
    init => {
        overlay.focus-field();
    }
}
