import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Badge, Btn, Card, Input, Separator, TipArea, Toggle, Tone } from "widgets.slint";
import { FullRow } from "settings-rows.slint";

export struct WhHook {
    id: string,
    name: string,
    url: string,
    meta: string,
}

export struct WhData {
    public: bool,
    public-desc: string,
    status-title: string,
    status-desc: string,
    badge: string,
    badge-tone: int,
    error: string,
    name: string,
    name-hint: string,
    cert: string,
    funnel-show: bool,
    funnel-badge: string,
    funnel-tone: int,
    funnel-text: string,
    funnel-mono: bool,
    funnel-action: string,
    funnel-action-text: string,
    hooks: [WhHook],
}

component Section {
    in property <string> title;
    in property <length> top: 16px;
    VerticalLayout {
        padding-top: root.top;
        padding-bottom: 14px;
        Text {
            height: 24px;
            text: root.title;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: -0.32px;
            color: Theme.fg;
            vertical-alignment: center;
        }
    }
}

component Small inherits Text {
    font-size: 12px;
    color: Theme.subtle;
    wrap: word-wrap;
}

component Hook {
    in property <WhHook> hook;
    in property <bool> first;
    in property <bool> last;
    callback act(string, string);
    height: first ? 82px : last ? 84px : 91px;
    VerticalLayout {
        alignment: start;
        if !root.first: Separator { }
        Rectangle {
            height: root.first ? 10px : 18px;
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 1px;
                Text {
                    height: 20px;
                    text: root.hook.name;
                    font-size: 14px;
                    font-weight: 500;
                    color: Theme.fg;
                    vertical-alignment: center;
                }
                Text {
                    height: 17px;
                    text: root.hook.url;
                    font-size: 12px;
                    font-family: "Geist Mono";
                    color: Theme.subtle;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    height: 16px;
                    text: root.hook.meta;
                    font-size: 12px;
                    color: Theme.subtle;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    icon: Icons.copy;
                    text: "Copy";
                    size: sm;
                    variant: ghost;
                    clicked => {
                        root.act("copy", root.hook.url);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    text: "Delete";
                    size: sm;
                    variant: ghost-destructive;
                    clicked => {
                        root.act("delete", root.hook.id);
                    }
                }
            }
        }
    }
}

export component WebhooksTab {
    in property <WhData> data;
    callback act(string, string);
    VerticalLayout {
        alignment: start;
        Text {
            text: "Leads create webhooks so other services can wake them. Harbor answers only /hooks/<secret-token> on this machine; anything else gets 404.";
            font-size: 14px;
            color: Theme.subtle;
            wrap: word-wrap;
        }
        Section {
            title: "Public URL";
            top: 19px;
        }
        Card {
            VerticalLayout {
                FullRow {
                    title: "Reachable from the internet";
                    desc: root.data.public-desc;
                    Toggle {
                        on: root.data.public;
                        toggled(v) => {
                            root.act("public", v ? "1" : "0");
                        }
                    }
                }
                if root.data.public: VerticalLayout {
                    Separator { }
                    FullRow {
                        title: root.data.status-title;
                        desc: root.data.status-desc;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Badge {
                                    text: root.data.badge;
                                    tone: root.data.badge-tone == 1 ? green : root.data.badge-tone == 2 ? amber : gray;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    icon: Icons.refresh;
                                    text: "Check";
                                    size: sm;
                                    variant: ghost;
                                    clicked => {
                                        root.act("check", "");
                                    }
                                }
                            }
                        }
                    }
                    if root.data.error != "": VerticalLayout {
                        Separator { }
                        Small {
                            text: "  " + root.data.error;
                        }
                    }
                    Separator { }
                    FullRow {
                        title: "Name";
                        desc: "Empty: your public address as an sslip.io name (it changes when your address does). Or a name of yours that points at it.";
                        Input {
                            width: 260px;
                            mono: true;
                            text: root.data.name;
                            hint: root.data.name-hint;
                            edited(t) => {
                                root.act("name", t);
                            }
                        }
                    }
                    if root.data.cert == "": Rectangle {
                        height: 12px;
                    }
                    if root.data.cert != "": VerticalLayout {
                        Separator { }
                        Small {
                            text: "  " + root.data.cert;
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 14px;
        }
        Text {
            text: "GitHub: set the webhook's secret to its token (the last part of its URL); Harbor then checks every delivery's signature.";
            font-size: 12px;
            color: Theme.subtle;
            wrap: word-wrap;
        }
        if root.data.funnel-show: VerticalLayout {
            padding-top: 16px;
            Card {
                VerticalLayout {
                    padding: 16px;
                    HorizontalLayout {
                        height: 32px;
                        spacing: 8px;
                        if root.data.funnel-badge != "": VerticalLayout {
                            alignment: center;
                            Badge {
                                text: root.data.funnel-badge;
                                tone: root.data.funnel-tone == 1 ? green : amber;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.data.funnel-text;
                            font-size: 13px;
                            font-family: root.data.funnel-mono ? "Geist Mono" : "Geist";
                            color: root.data.funnel-mono ? Theme.fg : Theme.subtle;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                icon: Icons.refresh;
                                text: "Check";
                                size: sm;
                                variant: ghost;
                                clicked => {
                                    root.act("funnel-check", "");
                                }
                            }
                        }
                        if root.data.funnel-action != "": VerticalLayout {
                            alignment: center;
                            Btn {
                                text: root.data.funnel-action-text;
                                size: sm;
                                variant: root.data.funnel-action == "funnel-disable" ? ghost-destructive : outline;
                                clicked => {
                                    root.act("funnel", root.data.funnel-action);
                                }
                            }
                        }
                    }
                }
            }
        }
        Section {
            title: "Webhooks";
        }
        Card {
            VerticalLayout {
                if root.data.hooks.length == 0: Text {
                    height: 49px;
                    x: 16px;
                    text: "None yet. Ask a project's lead to create one.";
                    font-size: 13px;
                    color: Theme.subtle;
                    vertical-alignment: center;
                }
                for h[i] in root.data.hooks: Hook {
                    hook: h;
                    first: i == 0;
                    last: i == root.data.hooks.length - 1;
                    act(w, a) => {
                        root.act(w, a);
                    }
                }
            }
        }
    }
}
