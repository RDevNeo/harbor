import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Btn, Glyph, Spinner } from "widgets.slint";

// What the Discord app's hidden page shows while a join waits on a captcha.
export struct CaptchaData {
    image: image,
    // The page's size in its own pixels; 0 until the first frame.
    width: length,
    height: length,
    // Where the captcha is on the page, in the page's pixels: the only place clicks go.
    rect-x: length,
    rect-y: length,
    rect-w: length,
    rect-h: length,
    guild: string,
}

// The captcha for a person to solve, over the window: the page's frames, the person's pointer
// back to the page. The shell itself drops anything outside the captcha.
export component CaptchaView inherits Rectangle {
    in property <CaptchaData> data;
    // kind ("move", "down", "up"), then the page's own coordinates.
    callback pointer(string, float, float);
    callback wheel(float, float, float);
    callback hide();
    callback cancel();
    background: black.with-alpha(220 / 255);
    TouchArea { }
    property <length> room-x: 48px;
    property <length> room-y: 96px;
    property <length> room-w: root.width - 96px;
    property <length> room-h: root.height - 140px;
    property <float> scale: min(root.room-w / max(root.data.width, 1px), root.room-h / max(root.data.height, 1px), 1);
    Text {
        x: 48px;
        y: 24px;
        width: root.width - 300px;
        text: "Discord needs a captcha";
        font-size: 18px;
        font-weight: 600;
        color: white;
    }
    Text {
        x: 48px;
        y: 52px;
        width: root.width - 300px;
        text: "To join " + (root.data.guild != "" ? root.data.guild : "a server") + ", Discord wants a person to solve this. Only the captcha takes your clicks; Harbor never answers it for you.";
        font-size: 13px;
        color: #d2d2d2;
        wrap: word-wrap;
    }
    if root.data.width > 0px: Rectangle {
        width: root.data.width * root.scale;
        height: root.data.height * root.scale;
        x: root.room-x + (root.room-w - self.width) / 2;
        y: root.room-y + (root.room-h - self.height) / 2;
        border-radius: Theme.radius-md;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.data.image;
            image-fit: fill;
        }
        // The page around the captcha, dimmed: nothing there takes a click.
        Rectangle {
            background: black.with-alpha(0.35);
        }
        Rectangle {
            x: root.data.rect-x * root.scale;
            y: root.data.rect-y * root.scale;
            width: root.data.rect-w * root.scale;
            height: root.data.rect-h * root.scale;
            clip: true;
            Image {
                x: -parent.x;
                y: -parent.y;
                width: root.data.width * root.scale;
                height: root.data.height * root.scale;
                source: root.data.image;
                image-fit: fill;
            }
        }
        TouchArea {
            moved => {
                root.pointer("move", self.mouse-x / root.scale / 1px, self.mouse-y / root.scale / 1px);
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.move && !self.pressed {
                    root.pointer("move", self.mouse-x / root.scale / 1px, self.mouse-y / root.scale / 1px);
                }
                if (e.kind == PointerEventKind.down || e.kind == PointerEventKind.up) && e.button == PointerEventButton.left {
                    root.pointer(e.kind == PointerEventKind.down ? "down" : "up", self.mouse-x / root.scale / 1px, self.mouse-y / root.scale / 1px);
                }
            }
            scroll-event(e) => {
                root.wheel(self.mouse-x / root.scale / 1px, self.mouse-y / root.scale / 1px, e.delta-y / 1px);
                accept
            }
        }
    }
    if root.data.width == 0px: Spinner {
        x: root.width / 2 - self.width / 2;
        y: root.room-y + root.room-h / 2 - self.height / 2;
        radius: 12px;
        color: white;
    }
    HorizontalLayout {
        x: root.width - 12px - self.width;
        y: 12px;
        width: self.preferred-width;
        height: 32px;
        spacing: 6px;
        Btn {
            y: 2px;
            text: "Hide";
            tip: "The captcha keeps waiting: the button at the bottom brings it back";
            size: xs;
            variant: secondary;
            clicked => {
                root.hide();
            }
        }
        Btn {
            y: 2px;
            text: "Don't join";
            size: xs;
            variant: secondary;
            clicked => {
                root.cancel();
            }
        }
    }
}

// The captcha, hidden: still waiting, one click from coming back.
export component CaptchaPill inherits Rectangle {
    in property <string> guild;
    callback show();
    width: row.preferred-width + 24px;
    height: 36px;
    border-radius: 18px;
    background: Theme.bg200;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: black.with-alpha(0.3);
    row := HorizontalLayout {
        x: 12px;
        spacing: 8px;
        alignment: center;
        Text {
            vertical-alignment: center;
            text: "Discord captcha waiting" + (root.guild != "" ? " · " + root.guild : "");
            font-size: 13px;
            color: Theme.fg;
        }
        Btn {
            y: 4px;
            text: "Solve";
            size: xs;
            variant: primary;
            clicked => {
                root.show();
            }
        }
    }
}

// The newest frame of the open chat's captcha card (chatcaptcha.ts): the card whose captcha is `id` draws it.
export struct ChatCaptchaData {
    id: string,
    has-frame: bool,
    // The first frame's size: the image's slot keeps this aspect while frames swap in (chat-cap-frame).
    width: float,
    height: float,
    // The captcha on the image, as fractions of it: the rest is dimmed and takes no clicks.
    rx: float,
    ry: float,
    rw: float,
    rh: float,
    // "Being solved on <PC>" while another device holds it.
    solving: string,
}

// A Discord join in this chat waits on a captcha: its frames in the transcript, the person's pointer back
// to it from here, from another PC of the mesh, or from the phone. `gone`: the host has none waiting.
export component CaptchaCard {
    in property <string> id;
    in property <string> text;
    in property <bool> gone;
    in property <ChatCaptchaData> data;
    in property <length> avail;
    // On screen in the transcript: frames flow only then.
    in property <bool> on-screen;
    // The newest frame alone: it changes many times a second, nothing else does.
    in property <image> frame;
    // On screen or not, and the frame's width (logical px): the PC sends frames that wide.
    callback seen(bool, float);
    // kind ("move", "down", "up"), then fractions of the image.
    callback pointer(string, float, float);
    callback cancel();
    property <bool> mine: root.data.id == root.id && root.id != "";
    property <length> frame-w: min(root.avail - 26px, 460px);
    changed on-screen => {
        root.seen(root.on-screen, root.frame-w / 1px);
    }
    changed frame-w => {
        root.seen(root.on-screen, root.frame-w / 1px);
    }
    init => {
        root.seen(root.on-screen, root.frame-w / 1px);
    }
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    inner := VerticalLayout {
        padding-bottom: Theme.compact ? 8px : 12px;
        if root.gone: HorizontalLayout {
            alignment: center;
            spacing: 6px;
            height: 26px;
            Glyph {
                width: 13px;
                icon: Icons.user-check;
                size: 13px;
                color: Theme.subtle;
            }
            Text {
                text: "This captcha isn't waiting any more.";
                font-size: 13px;
                color: Theme.subtle;
                vertical-alignment: center;
            }
        }
        if !root.gone: HorizontalLayout {
            alignment: start;
            Rectangle {
                width: root.frame-w + 26px;
                min-height: box.min-height;
                preferred-height: box.preferred-height;
                background: Theme.bg200;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: Theme.radius-lg;
                box := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        height: 28px;
                        Glyph {
                            width: 14px;
                            icon: Icons.user-check;
                            size: 14px;
                            color: Theme.amber-900;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "Discord needs a captcha";
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.fg;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Btn {
                            text: "Don't join";
                            tip: "Closes the captcha: the server isn't joined";
                            size: xs;
                            variant: secondary;
                            clicked => {
                                root.cancel();
                            }
                        }
                    }
                    Text {
                        text: root.text;
                        font-size: 13px;
                        color: Theme.subtle;
                        wrap: word-wrap;
                    }
                    if root.mine && root.data.solving != "": HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Glyph {
                            width: 13px;
                            icon: Icons.monitor;
                            size: 13px;
                            color: Theme.amber-900;
                        }
                        Text {
                            text: root.data.solving;
                            font-size: 13px;
                            color: Theme.amber-900;
                            vertical-alignment: center;
                        }
                    }
                    frame := Rectangle {
                        width: root.frame-w;
                        height: root.mine && root.data.has-frame ? root.frame-w * root.data.height / max(root.data.width, 1) : 160px;
                        border-radius: Theme.radius-md;
                        background: Theme.gray-100;
                        clip: true;
                        if !(root.mine && root.data.has-frame): Spinner {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            radius: 10px;
                            color: Theme.subtle;
                        }
                        if root.mine && root.data.has-frame: Rectangle {
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.frame;
                                image-fit: fill;
                            }
                            // The page around the captcha, dimmed: nothing there takes a click.
                            Rectangle {
                                background: black.with-alpha(0.35);
                            }
                            Rectangle {
                                x: root.data.rx * parent.width;
                                y: root.data.ry * parent.height;
                                width: root.data.rw * parent.width;
                                height: root.data.rh * parent.height;
                                clip: true;
                                Image {
                                    x: -parent.x;
                                    y: -parent.y;
                                    width: frame.width;
                                    height: frame.height;
                                    source: root.frame;
                                    image-fit: fill;
                                }
                            }
                            TouchArea {
                                mouse-cursor: self.mouse-x >= root.data.rx * self.width && self.mouse-x < (root.data.rx + root.data.rw) * self.width && self.mouse-y >= root.data.ry * self.height && self.mouse-y < (root.data.ry + root.data.rh) * self.height ? MouseCursor.pointer : MouseCursor.default;
                                moved => {
                                    root.pointer("move", self.mouse-x / self.width, self.mouse-y / self.height);
                                }
                                pointer-event(e) => {
                                    if e.kind == PointerEventKind.move && !self.pressed {
                                        root.pointer("move", self.mouse-x / self.width, self.mouse-y / self.height);
                                    }
                                    if (e.kind == PointerEventKind.down || e.kind == PointerEventKind.up) && e.button == PointerEventButton.left {
                                        root.pointer(e.kind == PointerEventKind.down ? "down" : "up", self.mouse-x / self.width, self.mouse-y / self.height);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
