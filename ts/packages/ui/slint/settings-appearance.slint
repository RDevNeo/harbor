import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Glyph, Ui } from "widgets.slint";

component IconTabs inherits Rectangle {
    in property <[string]> labels;
    in property <[string]> icons;
    in property <int> selected;
    callback picked(int);
    height: 36px;
    width: row.preferred-width + 6px;
    background: Theme.gray-100;
    border-radius: Theme.radius-lg;
    row := HorizontalLayout {
        padding: 3px;
        for l[i] in root.labels: Rectangle {
            property <bool> active: i == root.selected;
            width: content.preferred-width + 18px;
            background: active ? (Theme.dark ? Ui.mix(Theme.bg100, Theme.border, 0.3) : Theme.bg100) : transparent;
            border-width: active && Theme.dark ? 1px : 0px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            content := HorizontalLayout {
                alignment: center;
                spacing: 7px;
                if i < root.icons.length && root.icons[i] != "": Glyph {
                    icon: root.icons[i];
                    size: 14px;
                    color: Theme.fg;
                }
                Text {
                    text: l;
                    font-size: 14px;
                    font-weight: 500;
                    color: Theme.fg;
                    vertical-alignment: center;
                }
            }
            area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if !active {
                        root.picked(i);
                    }
                }
            }
        }
    }
}

component Heading inherits VerticalLayout {
    alignment: start;
    in property <string> text;
    in property <length> top: 17px;
    padding-top: top;
    padding-bottom: 15px;
    Text {
        text: root.text;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: -0.32px;
        color: Theme.fg;
    }
}

component Caption inherits VerticalLayout {
    alignment: start;
    in property <string> text;
    padding-top: 14px;
    Text {
        text: root.text;
        font-size: 13px;
        color: Theme.subtle;
        wrap: word-wrap;
    }
}

export struct AppearanceView {
    modes: [string],
    mode: int,
    densities: [string],
    density: int,
    mode-note: string,
    density-note: string,
}

export component AppearanceTab inherits VerticalLayout {
    alignment: start;
    in property <AppearanceView> view;
    callback mode-picked(int);
    callback density-picked(int);
    Heading {
        text: "Theme";
        top: 11px;
    }
    HorizontalLayout {
        alignment: start;
        IconTabs {
            labels: root.view.modes;
            icons: [Icons.sun-moon, Icons.sun, Icons.moon];
            selected: root.view.mode;
            picked(n) => {
                root.mode-picked(n);
            }
        }
    }
    Caption {
        text: root.view.mode-note;
    }
    Rectangle {
        height: 24px;
    }
    Heading {
        text: "Density";
    }
    HorizontalLayout {
        alignment: start;
        IconTabs {
            labels: root.view.densities;
            selected: root.view.density;
            picked(n) => {
                root.density-picked(n);
            }
        }
    }
    Caption {
        text: root.view.density-note;
    }
}
