import { Theme } from "theme.slint";
import { TipArea } from "widgets.slint";

// Lucide "memory-stick", drawn: the bundled lucide.ttf subset has no such glyph.
export component MemIcon {
    in property <color> color: Theme.subtle;
    in property <length> size: 14px;
    width: size;
    height: size;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.color;
        stroke-width: root.size >= 15px ? 1.6px : 1.35px;
        fill: transparent;
        commands: "M 12 12 V 10 M 12 18 V 16 M 16 12 V 10 M 16 18 V 16 M 2 11 H 3.5 M 20 18 V 16 M 20.5 11 H 22 M 4 18 V 16 M 8 12 V 10 M 8 18 V 16 M 4 6 H 20 A 2 2 0 0 1 22 8 V 14 A 2 2 0 0 1 20 16 H 4 A 2 2 0 0 1 2 14 V 8 A 2 2 0 0 1 4 6 Z";
    }
}

export component MiniBar {
    in property <float> frac;
    in property <bool> neutral;
    in property <bool> low;
    property <float> f: max(0, min(1, frac));
    height: 4px;
    Rectangle {
        border-radius: self.height / 2;
        background: Theme.gray-300;
    }
    Rectangle {
        x: 0;
        width: parent.width * root.f;
        border-radius: self.height / 2;
        background: root.neutral ? Theme.gray-900 : root.low || root.f >= 0.9 ? Theme.red-800 : root.f >= 0.8 ? Theme.amber-800 : Theme.gray-900;
    }
}

// The chat's memory in the top bar: icon and figure; `open` while its popover shows.
export component MemPill {
    in property <string> text;
    in property <string> tip;
    in property <bool> open;
    callback clicked(length, length);
    property <bool> hover: area.has-hover || open;
    height: 24px;
    width: label.preferred-width + 14px + 6px + 18px;
    Rectangle {
        background: root.hover ? Theme.accent : Theme.gray-100;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 12px;
    }
    MemIcon {
        x: 9px;
        size: 14px;
        color: root.hover ? Theme.fg : Theme.subtle;
    }
    label := Text {
        x: 9px + 14px + 6px;
        text: root.text;
        font-size: 12px;
        color: root.hover ? Theme.fg : Theme.gray-900;
        vertical-alignment: center;
    }
    area := TipArea {
        tip: root.tip;
        clicked => {
            root.clicked(self.absolute-position.x, self.absolute-position.y + self.height);
        }
    }
}

// This PC's memory in the sidebar's footer: icon, how much is used and a bar; the mesh's PCs on click.
export component MemGauge inherits TipArea {
    in property <string> text;
    in property <float> frac;
    in property <bool> low;
    in property <bool> open;
    width: row.preferred-width + 12px;
    // As tall as the row's buttons: the icon on its middle, the figure over it and the bar under it.
    height: 28px;
    Rectangle {
        background: root.has-hover || root.open ? Theme.accent : transparent;
        border-radius: Theme.radius-md;
    }
    row := HorizontalLayout {
        x: 6px;
        height: root.height;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            MemIcon {
                size: 14px;
                color: root.low ? Theme.red-900 : root.has-hover || root.open ? Theme.fg : Theme.subtle;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: root.text;
                font-size: 11.5px;
                color: root.low ? Theme.red-900 : root.has-hover || root.open ? Theme.fg : Theme.subtle;
                horizontal-alignment: center;
            }
            MiniBar {
                width: 40px;
                height: 3px;
                frac: root.frac;
                low: root.low;
            }
        }
    }
}

// A chat's process, or a PC's chat: name, kind, figure and its share as a thin bar (the memory popovers' "mem-row").
export component MemLine inherits VerticalLayout {
    in property <string> icon;
    in property <string> label;
    in property <string> badge;
    in property <string> desc;
    in property <float> frac;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    spacing: 5px;
    HorizontalLayout {
        spacing: 8px;
        if root.icon != "": Text {
            width: 14px;
            text: root.icon;
            font-family: "lucide";
            font-size: 13px;
            color: Theme.subtle;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            font-size: 13px;
            color: Theme.fg;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.badge != "": Text {
            text: root.badge;
            font-size: 12px;
            color: Theme.subtle;
            vertical-alignment: center;
        }
        Text {
            text: root.desc;
            font-size: 12px;
            color: Theme.gray-900;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    MiniBar {
        height: 3px;
        frac: root.frac;
        neutral: true;
    }
}
