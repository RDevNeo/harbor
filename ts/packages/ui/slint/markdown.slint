import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Btn, MenuItem, PopoverFrame, TipArea } from "widgets.slint";

// One word of a link, by UTF-8 byte offsets in a block's plain text (markdown.ts `MdLinkData`).
export struct MdLink {
    link: int,
    from: int,
    to: int,
    next: int,
    url: string,
    tip: string,
}

export struct MdCell {
    text: styled-text,
    plain: string,
    links: [MdLink],
    // Its column's share of the shrinking when the table is wider than the reply (cards.ts `columnWeights`).
    weight: float,
}

export struct MdRow {
    cells: [MdCell],
}

export struct MdBlock {
    kind: string,
    text: styled-text,
    links: [MdLink],
    code: string,
    level: int,
    marker: string,
    depth: int,
    quote: int,
    table: [MdRow],
    gap: length,
    after: length,
    bar-top: length,
    bar-bottom: length,
    trim: length,
    plain: string,
    key: string,
}

component Inline inherits StyledText {
    in property <length> size: 16px;
    in property <color> ink: Theme.fg;
    default-font-size: size;
    default-font-family: "Geist";
    default-color: ink;
    link-color: Theme.blue-900;
}

// egui_commonmark's sizes for a reply (theme.rs `reply_text`): headings from the 16px body up to 23px.
export global MdSizes {
    pure public function heading(level: int) -> length {
        return level <= 1 ? 23px : level == 2 ? 21.845px : level == 3 ? 20.676px : level == 4 ? 19.507px : level == 5 ? 18.338px : 17.169px;
    }
}

// Where one word of a link lies on one of its lines: the hand cursor and the tip there, and the hover look
// while any word of its link is under the pointer (`lit`): a tint, and the underline drawn again thicker.
component LinkSpot {
    in property <bool> lit;
    // The text's baseline, from the spot's top.
    in property <length> base;
    in property <string> tip;
    out property <bool> over: area.has-hover;
    callback clicked;
    callback menu(length, length);
    callback hover(bool);
    changed over => {
        root.hover(self.over);
    }
    Rectangle {
        x: -1px;
        width: parent.width + 2px;
        border-radius: 3px;
        background: root.lit ? Theme.blue-900.with-alpha(Theme.dark ? 0.16 : 0.1) : transparent;
    }
    if root.lit: Rectangle {
        y: Math.round(root.base / 1px) * 1px + 1px;
        height: 2px;
        background: Theme.blue-900;
    }
    area := TipArea {
        tip: root.tip;
        clicked => {
            root.clicked();
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                root.menu(self.mouse-x, self.mouse-y);
            }
        }
    }
}

// A block's links, over its text. StyledText finds the link under the pointer itself, but under the selectable
// text it never gets the pointer (and it counted a wrapped link's last line only). So each word of a link is
// found where it is drawn, from a hidden TextInput laid out as the selectable one: where its cursor goes at the
// word's ends. Only over a link's own words is the pointer a hand; a click opens the link (once, a double click
// too), a right click offers to open or copy it, a `[text](url)` shows its address as a tip, and a drag that
// starts off a link still selects across it.
component LinkLayer {
    in property <string> plain;
    in property <[MdLink]> links;
    in property <length> size: 16px;
    in property <TextWrap> wrap: word-wrap;
    callback open(string);
    // The hovered link (`MdLink.link`) and the spot that hovered it (word * 3 + line), -1 for none: a spot
    // leaving clears them only if it's still the one, whichever of two neighbours hears of the move first.
    property <int> hot: -1;
    property <int> hot-spot: -1;
    property <Point> at;
    property <length> line: one.preferred-height;
    property <length> ascent: one.font-metrics.ascent;
    property <string> menu-url;
    property <length> menu-x;
    property <length> menu-y;
    function where(offset: int) -> Point {
        probe.set-selection-offsets(offset, offset);
        return root.at;
    }
    function hover(link: int, spot: int, on: bool) {
        if on {
            root.hot = link;
            root.hot-spot = spot;
        } else if root.hot-spot == spot {
            root.hot = -1;
            root.hot-spot = -1;
        }
    }
    function click(url: string) {
        if !cooldown.running {
            cooldown.running = true;
            root.open(url);
        }
    }
    function menu(url: string, x: length, y: length) {
        root.menu-url = url;
        root.menu-x = x;
        root.menu-y = y;
        menu-popup.show();
    }
    one := Text {
        visible: false;
        text: "X";
        font-size: root.size;
        font-family: "Geist";
    }
    probe := TextInput {
        visible: false;
        enabled: false;
        read-only: true;
        width: root.width;
        height: root.height;
        text: root.plain;
        font-size: root.size;
        font-family: "Geist";
        wrap: root.wrap;
        cursor-position-changed(p) => {
            root.at = p;
        }
    }
    clip := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
    }
    cooldown := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
        }
    }
    for w[i] in root.links: word := Rectangle {
        // Where the word starts and where it ends: at the link's next word when that's on the same line.
        property <Point> a;
        property <Point> b;
        property <bool> placed;
        property <bool> same: self.b.y == self.a.y;
        // Laid out again when any of these change.
        property <length> w-now: root.width;
        property <length> size-now: root.size;
        property <string> text-now: root.plain;
        property <int> from-now: w.from;
        property <int> next-now: w.next;
        function place() {
            self.a = root.where(w.from);
            let end = root.where(w.to);
            let next = root.where(w.next);
            self.b = next.y == end.y ? next : end;
            // Before the window can lay text out, every offset is at 0,0: try again shortly.
            self.placed = root.width > 0 && (self.b.x != self.a.x || self.b.y != self.a.y);
        }
        init => {
            self.place();
        }
        changed w-now => {
            self.place();
        }
        changed size-now => {
            self.place();
        }
        changed text-now => {
            self.place();
        }
        changed from-now => {
            self.place();
        }
        changed next-now => {
            self.place();
        }
        Timer {
            interval: 100ms;
            running: !word.placed && root.width > 0;
            triggered => {
                word.place();
            }
        }
        // Its first line, to the line's end when it goes on.
        if word.placed: LinkSpot {
            x: word.a.x;
            y: word.a.y;
            width: (word.same ? word.b.x : root.width) - word.a.x;
            height: root.line;
            lit: root.hot == w.link;
            base: root.ascent;
            tip: w.tip;
            clicked => {
                root.click(w.url);
            }
            menu(x, y) => {
                root.menu(w.url, self.x + x, self.y + y);
            }
            hover(on) => {
                root.hover(w.link, i * 3, on);
            }
        }
        // Whole lines between (a long address broken across lines).
        if word.placed && word.b.y > word.a.y + root.line: LinkSpot {
            x: 0;
            y: word.a.y + root.line;
            width: root.width;
            height: word.b.y - word.a.y - root.line;
            lit: root.hot == w.link;
            base: root.ascent;
            tip: w.tip;
            clicked => {
                root.click(w.url);
            }
            menu(x, y) => {
                root.menu(w.url, self.x + x, self.y + y);
            }
            hover(on) => {
                root.hover(w.link, i * 3 + 1, on);
            }
        }
        // Its last line.
        if word.placed && !word.same && word.b.x > 0: LinkSpot {
            x: 0;
            y: word.b.y;
            width: word.b.x;
            height: root.line;
            lit: root.hot == w.link;
            base: root.ascent;
            tip: w.tip;
            clicked => {
                root.click(w.url);
            }
            menu(x, y) => {
                root.menu(w.url, self.x + x, self.y + y);
            }
            hover(on) => {
                root.hover(w.link, i * 3 + 2, on);
            }
        }
    }
    menu-popup := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 180px;
        PopoverFrame {
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    icon: Icons.external;
                    label: "Open link";
                    clicked => {
                        root.open(root.menu-url);
                    }
                }
                MenuItem {
                    icon: Icons.link;
                    label: "Copy link";
                    clicked => {
                        clip.text = root.menu-url;
                        clip.select-all();
                        clip.copy();
                        clip.text = "";
                    }
                }
            }
        }
    }
}

// A read-only TextInput holds the drawn words invisibly, for selecting; the links lie over both (`LinkLayer`).
// Also a user's bubble: its text selects and copies, its links open.
export component Selectable inherits Rectangle {
    in property <styled-text> text;
    in property <string> plain;
    in property <[MdLink]> links;
    in property <string> key;
    in property <length> size: 16px;
    in property <color> ink: Theme.fg;
    callback link(string);
    min-height: shown.min-height;
    preferred-height: shown.preferred-height;
    property <bool> chose: field.has-focus && field.anchor-position-byte-offset != field.cursor-position-byte-offset;
    changed chose => {
        if !self.chose && root.key != "" {
            root.told = "";
            root.link("sel:");
        }
    }
    // A selection settles once it rests for a tick: then it can be mentioned, above the block's start
    // (Slint doesn't say where the drag ended). Only a block with a key can be.
    property <string> seen;
    property <string> told;
    Timer {
        interval: 250ms;
        running: root.chose && root.key != "";
        triggered => {
            let now = field.anchor-position-byte-offset + ":" + field.cursor-position-byte-offset;
            if now == root.seen && now != root.told {
                root.told = now;
                root.link("sel:" + root.key + ":" + now + ":" + root.absolute-position.x / 1px + ":" + root.absolute-position.y / 1px);
            }
            root.seen = now;
        }
    }
    shown := Inline {
        width: parent.width;
        text: root.text;
        size: root.size;
        ink: root.ink;
    }
    field := TextInput {
        width: parent.width;
        height: parent.height;
        read-only: true;
        text: root.plain;
        font-size: root.size;
        font-family: "Geist";
        // Not fully transparent: Slint then skips drawing the selection too.
        color: root.ink.with-alpha(0.01);
        wrap: word-wrap;
        // egui's selection colour, see-through: here it lies over the words.
        selection-background-color: (Theme.dark ? #004287 : #90d1ff).with-alpha(0.6);
        selection-foreground-color: transparent;
        key-pressed(e) => {
            if e.modifiers.control || e.modifiers.shift || e.modifiers.alt || e.modifiers.meta {
                return reject;
            }
            if e.text == Key.PageUp || e.text == Key.PageDown || e.text == Key.Home || e.text == Key.End {
                root.link("scroll:" + (e.text == Key.PageUp ? "up" : e.text == Key.PageDown ? "down" : e.text == Key.Home ? "home" : "end"));
                return accept;
            }
            reject
        }
    }
    if root.links.length > 0: LinkLayer {
        width: parent.width;
        height: parent.height;
        plain: root.plain;
        links: root.links;
        size: root.size;
        open(u) => {
            root.link(u);
        }
    }
}

// A table cell: its text and its links, not selectable; it wraps when its column is narrowed.
component Linked inherits Rectangle {
    in property <MdCell> cell;
    in property <length> size: 16px;
    in property <color> ink: Theme.fg;
    callback link(string);
    preferred-width: shown.preferred-width;
    preferred-height: shown.preferred-height;
    shown := Inline {
        width: parent.width;
        height: parent.height;
        text: root.cell.text;
        size: root.size;
        ink: root.ink;
    }
    if root.cell.links.length > 0: LinkLayer {
        width: parent.width;
        height: parent.height;
        plain: root.cell.plain;
        links: root.cell.links;
        size: root.size;
        open(u) => {
            root.link(u);
        }
    }
}

export component MdBlockView {
    in property <MdBlock> block;
    in property <length> size: 16px;
    callback link(string);
    callback copy(string);
    property <length> indent: block.quote * 10px;
    property <color> ink: block.quote > 0 ? Theme.subtle : Theme.fg;
    property <length> box: block.depth * 16px;
    // A reply's last line: egui's row ends at the text, Slint's line box a few pixels below it.
    min-height: inner.min-height - root.block.trim;
    preferred-height: inner.preferred-height - root.block.trim;
    for q in root.block.quote: Rectangle {
        x: q * 10px - 1px;
        y: root.block.bar-top;
        width: 3px;
        height: max(0px, root.height - root.block.bar-top - root.block.bar-bottom);
        background: Theme.gray-500;
    }
    // egui wraps a line that would reach the column's edge exactly; Slint keeps it.
    inner := VerticalLayout {
        padding-left: root.indent;
        padding-right: 1px;
        padding-top: root.block.gap;
        padding-bottom: root.block.after;
        if root.block.kind == "p": Selectable {
            text: root.block.text;
            plain: root.block.plain;
            links: root.block.links;
            key: root.block.key;
            size: root.size;
            ink: root.ink;
            link(u) => {
                root.link(u);
            }
        }
        if root.block.kind == "h": Selectable {
            text: root.block.text;
            plain: root.block.plain;
            links: root.block.links;
            key: root.block.key;
            size: MdSizes.heading(root.block.level);
            ink: root.ink;
            link(u) => {
                root.link(u);
            }
        }
        if root.block.kind == "li": Rectangle {
            min-height: li-text.min-height;
            preferred-height: li-text.preferred-height;
            if root.block.marker == "•": Rectangle {
                x: root.box + 4px;
                y: 7px;
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.ink;
            }
            if root.block.marker == "◦": Rectangle {
                x: root.box + 3.5px;
                y: 6.5px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                border-width: 1px;
                border-color: root.ink;
            }
            if root.block.marker != "•" && root.block.marker != "◦": Text {
                x: root.box;
                y: 0;
                width: 15px;
                text: root.block.marker;
                font-size: root.size;
                color: root.ink;
                horizontal-alignment: TextHorizontalAlignment.right;
            }
            li-text := VerticalLayout {
                padding-left: root.box + 21px;
                Selectable {
                    text: root.block.text;
                    plain: root.block.plain;
                    links: root.block.links;
                    key: root.block.key;
                    size: root.size;
                    ink: root.ink;
                    link(u) => {
                        root.link(u);
                    }
                }
            }
        }
        // egui strokes the frame outside the code's rect: a pixel past it on every side.
        if root.block.kind == "code": Rectangle {
            min-height: box0.min-height;
            preferred-height: box0.preferred-height;
            Rectangle {
                x: -1px;
                y: -1px;
                width: parent.width + 2px;
                height: parent.height + 2px;
                background: Theme.bg200;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: Theme.radius-md;
            }
            box0 := VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 7px;
                padding-bottom: 6px;
                Text {
                    text: root.block.code;
                    font-family: "Geist Mono";
                    font-size: root.size - 1px;
                    color: Theme.fg;
                    wrap: word-wrap;
                }
            }
            code-area := TouchArea { }
            Btn {
                x: parent.width - 32px;
                y: 4px;
                visible: code-area.has-hover || self.hovered;
                icon: Icons.copy;
                size: icon-xs;
                variant: ghost-muted;
                tip: "Copy";
                clicked => {
                    root.copy(root.block.code);
                }
            }
        }
        if root.block.kind == "hr": Rectangle {
            height: 20px;
            Rectangle {
                y: 17px;
                height: 1px;
                background: Theme.border;
            }
        }
        // As wide as its cells' text, but never wider than the reply: then its columns narrow (the longest the
        // most, by `weight`, no cell below a few words' width) and their cells wrap onto more lines.
        if root.block.kind == "table": HorizontalLayout {
            alignment: start;
            Rectangle {
                horizontal-stretch: 1;
                max-width: grid.preferred-width;
                min-height: grid.min-height;
                preferred-height: grid.preferred-height;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 4px;
                grid := GridLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 5px;
                    padding-bottom: 12px;
                    for row[i] in root.block.table: Row {
                        for cell[j] in row.cells: Rectangle {
                            property <length> pad: j == 0 ? 1px : 8px;
                            property <length> natural: cell-text.preferred-width;
                            min-width: self.pad + min(self.natural, root.size * 7);
                            preferred-width: self.pad + self.natural;
                            horizontal-stretch: cell.weight;
                            min-height: 26px;
                            background: Math.mod(i, 2) == 1 ? Theme.bg200 : transparent;
                            VerticalLayout {
                                alignment: start;
                                padding-left: parent.pad;
                                padding-top: 3px;
                                padding-bottom: 3px;
                                cell-text := Linked {
                                    cell: cell;
                                    size: root.size;
                                    ink: root.ink;
                                    link(u) => {
                                        root.link(u);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
