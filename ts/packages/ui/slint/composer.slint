import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Btn, Glyph, Trigger, VSep, RoundButton, StopButton, FileChip, PopoverFrame, TipArea, AccountMark, Variant, Spinner } from "widgets.slint";

export struct MenuEntry {
    icon: string,
    tone: string,
    label: string,
    desc: string,
    section: string,
}

export struct StripRow {
    id: int,
    name: string,
    logo: image,
    badge: string,
    tip: string,
}

component WorkingDot {
    in property <float> offset;
    property <float> phase;
    width: 22px;
    height: 22px;
    Timer {
        interval: 80ms;
        running: true;
        triggered => {
            root.phase = Math.mod(root.phase + 0.05, 1.0);
        }
    }
    property <float> p: Math.mod(root.phase + root.offset, 1.0);
    property <float> ease: 1 - (1 - p) * (1 - p) * (1 - p);
    Rectangle {
        width: 2 * 6px * (0.6 + 1.4 * root.ease);
        height: self.width;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: Theme.blue-900.with-alpha(0.5 * (1 - root.ease));
    }
    Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.blue-900;
    }
}

component AgentStrip inherits Rectangle {
    in property <[StripRow]> rows;
    in property <string> title;
    in property <string> names;
    in property <bool> header;
    in property <bool> folded;
    in property <bool> open;
    callback open-agent(int);
    callback head-clicked();
    callback stop-all();
    background: Theme.bg200;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;
    height: ((root.open ? root.rows.length : 0) + (root.header ? 1 : 0)) * 30px + 8px;
    VerticalLayout {
        padding: 4px;
        if root.header: Rectangle {
            height: 30px;
            border-radius: 8px;
            background: head-area.has-hover ? Theme.gray-100 : transparent;
            head-area := TouchArea {
                width: parent.width - 30px;
                x: 0;
                mouse-cursor: pointer;
                clicked => {
                    root.head-clicked();
                }
            }
            HorizontalLayout {
                x: 8px;
                width: parent.width - 46px;
                spacing: 8px;
                Text {
                    text: root.title;
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.fg;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: "·  " + root.names;
                    font-size: 13px;
                    color: Theme.subtle;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.folded: Glyph {
                    width: 12px;
                    icon: root.open ? Icons.up : Icons.down;
                    size: 12px;
                    color: Theme.subtle;
                }
            }
            Btn {
                x: parent.width - 30px;
                y: 1px;
                icon: Icons.stop;
                size: icon-xs;
                variant: Variant.stop;
                tip: "Stop all: every running sub-agent, and clear their queues";
                clicked => {
                    root.stop-all();
                }
            }
        }
        if root.open: VerticalLayout {
            for r[nth] in root.rows: Rectangle {
                height: 30px;
                border-radius: 8px;
                background: row-area.has-hover ? Theme.gray-100 : transparent;
                row-area := TipArea {
                    tip: r.tip;
                    clicked => {
                        root.open-agent(r.id);
                    }
                }
                AccountMark {
                    x: 7px;
                    y: 6px;
                    width: 18px;
                    height: 18px;
                    logo: r.logo;
                    badge: r.badge;
                }
                name := Text {
                    x: 34px;
                    width: min(self.preferred-width, parent.width - 34px - 30px);
                    text: r.name;
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.fg;
                    overflow: elide;
                    vertical-alignment: center;
                }
                WorkingDot {
                    x: 34px + name.width;
                    y: 4px;
                    offset: nth * 0.37;
                }
            }
        }
    }
}

export struct MentionChip {
    head: string,
    snippet: string,
    tip: string,
    note: string,
    hint: string,
    focus: bool,
}

export struct FileItem {
    name: string,
    image: bool,
    // An image shown as its picture (`thumb` once decoded; a blank tile until then). False: the chip.
    tile: bool,
    thumb: image,
    // Its number among the message's images: `[Image #N]` in the text.
    number: int,
    // Its place among the tiles, or among the chips.
    slot: int,
}

// An attached image above the text (the phone's Attach `tile`): the picture cropped square and rounded,
// its number on it, the remove button over its top-right corner.
component ImageTile {
    in property <image> thumb;
    in property <string> name;
    in property <int> number;
    callback remove();
    callback open();
    width: 70px;
    height: 70px;
    Rectangle {
        x: 0;
        y: 6px;
        width: 64px;
        height: 64px;
        border-radius: 12px;
        background: Theme.gray-100;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.thumb;
            image-fit: cover;
        }
        Rectangle {
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
        }
        if root.number > 0: Rectangle {
            x: 4px;
            y: parent.height - 4px - self.height;
            width: num.preferred-width + 10px;
            height: 16px;
            border-radius: 6px;
            background: #000000b4;
            num := Text {
                text: "#" + root.number;
                font-size: 11px;
                color: #ffffff;
                vertical-alignment: center;
            }
        }
    }
    TipArea {
        width: root.width;
        height: root.height;
        tip: root.name;
        clicked => {
            root.open();
        }
    }
    Rectangle {
        x: parent.width - 21px;
        y: 0;
        width: 21px;
        height: 21px;
        border-radius: 10.5px;
        background: x-area.has-hover ? Theme.gray-800 : Theme.fg;
        border-width: 1.5px;
        border-color: Theme.dark ? Theme.bg200 : Theme.bg100;
        Glyph {
            icon: Icons.x;
            size: 11px;
            color: Theme.dark ? Theme.bg200 : Theme.bg100;
        }
        x-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.remove();
            }
        }
    }
}

// The footer under the composer (logic/workbar.ts): where the agent works, its branch and its pull request.
export struct WorkChip {
    shown: bool,
    icon: string,
    text: string,
    // "", "red", "green", "purple" or "muted".
    tone: string,
    tip: string,
}

export struct WorkBarData {
    shown: bool,
    // The chips do something here (the PC's own git): their chevrons.
    live: bool,
    ws: WorkChip,
    branch: WorkChip,
    pr: WorkChip,
}

// A quiet chip of the tray: a glyph, one line of muted text and, where it opens a menu, a small chevron (no box).
component WorkBarChip {
    in property <WorkChip> chip;
    in property <bool> chevron;
    in property <length> max-text: 260px;
    callback clicked(length, length);
    property <color> tint: chip.tone == "red" ? Theme.red-900 : chip.tone == "green" ? Theme.green-900 : chip.tone == "purple" ? #a371f7 : Theme.gray-700;
    property <color> ink: area.has-hover && chip.tone != "red" ? Theme.fg.mix(Theme.gray-700, 0.45) : Theme.gray-700;
    height: 25px;
    preferred-width: row.preferred-width + 8px;
    min-width: min(row.preferred-width + 8px, 80px);
    Rectangle {
        border-radius: 6px;
        background: area.has-hover ? Theme.accent : transparent;
    }
    row := HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 5px;
        alignment: start;
        Glyph {
            icon: root.chip.icon;
            size: 12px;
            color: root.chip.tone == "" || root.chip.tone == "muted" ? root.ink : root.tint;
        }
        Text {
            text: root.chip.text;
            font-size: 12px;
            color: root.chip.tone == "red" ? root.tint : root.ink;
            vertical-alignment: center;
            overflow: elide;
            max-width: root.max-text;
        }
        if root.chevron: Glyph {
            icon: Icons.down;
            size: 10px;
            color: root.ink;
        }
    }
    area := TipArea {
        tip: root.chip.tip;
        clicked => {
            root.clicked(self.absolute-position.x, self.absolute-position.y);
        }
    }
}

export struct ComposerState {
    model: string,
    model-tip: string,
    badge: string,
    has-effort: bool,
    effort: string,
    access: string,
    access-icon: string,
    device: string,
    // The device chip's glyph; "" is the house.
    device-icon: string,
    action: string,
    action-tip: string,
    hint: string,
    typing: string,
    notice: string,
    place: string,
    error: string,
}

// slash.rs, tags.rs and chatmention.rs `row`: 32px rows; a command's source as a pill on the right.
component ComposerMenu inherits PopoverFrame {
    in property <[MenuEntry]> entries;
    in property <int> selected;
    callback pick(int);
    callback hover(int);
    height: min(entries.length * 32px, 288px) + 10px;
    Flickable {
        x: 5px;
        y: 5px;
        width: parent.width - 10px;
        height: parent.height - 10px;
        content-y: min(0px, max(-root.selected * 32px + self.height / 2 - 16px, self.height - root.entries.length * 32px));
        VerticalLayout {
            alignment: start;
            for e[i] in root.entries: Rectangle {
                property <bool> on: i == root.selected;
                property <length> pill: e.section == "" ? 0px : pill-measure.preferred-width + 30px;
                property <length> x0: e.section != "" ? 10px : 32px;
                height: 32px;
                background: self.on ? Theme.accent : transparent;
                border-radius: Theme.radius-md;
                pill-measure := Text {
                    visible: false;
                    text: e.section;
                    font-size: 11.5px;
                    font-weight: 500;
                }
                if e.section == "": Glyph {
                    x: 11px;
                    width: 14px;
                    icon: e.icon;
                    size: 14px;
                    color: e.tone == "blue" ? Theme.blue-700 : e.tone == "amber" ? Theme.amber-700 : e.tone == "red" ? Theme.red-700 : e.tone == "green" ? Theme.green-700 : Theme.subtle;
                }
                name := Text {
                    x: parent.x0;
                    width: min(self.preferred-width, e.section != "" ? min(parent.width - parent.pill - 20px - parent.x0, parent.width * 0.45) : (parent.width - 10px - parent.x0) * 0.6);
                    text: e.label;
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.fg;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    x: name.x + name.width + 10px;
                    width: max(0px, parent.width - self.x - (e.section != "" ? parent.pill + 20px : 10px));
                    visible: self.width > 30px;
                    text: e.desc;
                    font-size: 12.5px;
                    color: Theme.subtle;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if e.section != "": Rectangle {
                    x: parent.width - 8px - self.width;
                    width: parent.pill;
                    height: 20px;
                    border-radius: 10px;
                    background: parent.on ? Theme.gray-300 : Theme.gray-200;
                    Glyph {
                        x: 7.5px;
                        width: 11px;
                        icon: e.icon;
                        size: 11px;
                        color: Theme.subtle;
                    }
                    Text {
                        x: 22px;
                        text: e.section;
                        font-size: 11.5px;
                        font-weight: 500;
                        color: Theme.subtle;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.pick(i);
                    }
                    changed has-hover => {
                        if self.has-hover {
                            root.hover(i);
                        }
                    }
                }
            }
        }
    }
}

export component Composer {
    in-out property <string> text <=> field.text;
    in property <ComposerState> state;
    in property <image> logo;
    in property <length> max-h: 280px;
    in property <[FileItem]> files;
    // How many of `files` are tiles.
    in property <int> file-tiles;
    in property <[MenuEntry]> menu;
    in property <int> menu-selected;
    in property <string> open-popup;
    in property <string> voice;
    in property <float> voice-level;
    in property <string> voice-time;
    in property <string> voice-note;
    in property <string> mic-tip: "Dictate (Ctrl+Shift+Space)";
    out property <bool> focused: field.has-focus;
    out property <int> cursor: field.cursor-position-byte-offset;
    out property <int> anchor: field.anchor-position-byte-offset;
    callback edited(string);
    callback key(KeyEvent) -> bool;
    callback send();
    callback stop();
    callback attach();
    callback mic();
    callback remove-file(int);
    callback open-file(int);
    callback menu-pick(int);
    callback menu-hover(int);
    callback popup(string, length, length);
    in property <[StripRow]> strip-rows;
    in property <string> strip-title;
    in property <string> strip-names;
    in property <bool> strip-header;
    in property <bool> strip-folded;
    in property <bool> strip-open;
    callback strip-open-agent(int);
    callback strip-head();
    callback strip-stop-all();
    in property <bool> untrusted;
    callback trust();
    in property <WorkBarData> bar;
    in property <[MentionChip]> mentions;
    callback remove-mention(int);
    callback note-edited(int, string);
    callback note-done();
    public function focus-text() {
        field.focus();
    }
    public function set-cursor(at: int) {
        field.set-selection-offsets(at, at);
    }
    public function copy-text(t: string) {
        clip.text = t;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }
    property <length> line: 20px;
    property <length> who-w: root.state.typing == "" ? 0px : who.preferred-width + 12px;
    property <length> text-h: min(max(field.preferred-height, 3 * line + 2px), root.max-h);
    VerticalLayout {
        spacing: 8px;
        if root.strip-rows.length > 0: AgentStrip {
            rows: root.strip-rows;
            title: root.strip-title;
            names: root.strip-names;
            header: root.strip-header;
            folded: root.strip-folded;
            open: root.strip-open;
            open-agent(id) => {
                root.strip-open-agent(id);
            }
            head-clicked => {
                root.strip-head();
            }
            stop-all => {
                root.strip-stop-all();
            }
        }
        if root.untrusted: Rectangle {
            background: Theme.bg200;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 12px;
            min-height: trust-row.min-height;
            preferred-height: trust-row.preferred-height;
            trust-row := HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: "Cloned project: agents ignore its own agent settings and hooks until you trust it.";
                    font-size: 13px;
                    color: Theme.subtle;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Btn {
                    text: "Trust project";
                    size: xs;
                    variant: primary;
                    clicked => {
                        root.trust();
                    }
                }
            }
        }
        if root.state.error != "": HorizontalLayout {
            padding-left: 6px;
            Text {
                text: root.state.error;
                font-size: 12px;
                color: Theme.red-900;
                wrap: word-wrap;
            }
        }
        if root.state.place != "": HorizontalLayout {
            padding-left: 6px;
            Text {
                text: root.state.place;
                font-size: 12px;
                color: Theme.subtle;
                wrap: word-wrap;
            }
        }
        if root.state.notice != "": Rectangle {
            background: Theme.bg200;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 12px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                Text {
                    text: root.state.notice;
                    font-size: 13px;
                    color: Theme.subtle;
                    wrap: word-wrap;
                }
            }
        }
        card := VerticalLayout {
            spacing: 0px;
            frame := Rectangle {
                background: Theme.dark ? Theme.bg200 : Theme.bg100;
                border-width: 1px;
                border-color: field.has-focus ? Theme.gray-600 : Theme.border;
                border-radius: 16px;
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 17px;
                    padding-bottom: 14px;
                    spacing: 0px;
                    if root.mentions.length > 0: VerticalLayout {
                        padding-bottom: 14px;
                        spacing: 4px;
                        // mentions.rs `draft`: the chip heads a card, its note box under it.
                        for m[i] in root.mentions: Rectangle {
                            background: Theme.gray-100;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: Theme.radius-md;
                            VerticalLayout {
                                padding-bottom: 4px;
                                Rectangle {
                                    height: 26px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 2px;
                                        spacing: 6px;
                                        Glyph {
                                            width: 13px;
                                            icon: Icons.at-sign;
                                            size: 13px;
                                            color: Theme.subtle;
                                        }
                                        Text {
                                            text: m.head;
                                            font-size: 13px;
                                            font-weight: 500;
                                            color: Theme.fg;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: m.snippet;
                                            font-size: 13px;
                                            color: Theme.subtle;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        Btn {
                                            y: 1px;
                                            icon: Icons.x;
                                            size: icon-xs;
                                            variant: ghost-muted;
                                            tip: "Remove";
                                            clicked => {
                                                root.remove-mention(i);
                                            }
                                        }
                                    }
                                    TipArea {
                                        width: parent.width - 32px;
                                        x: 0;
                                        tip: m.tip;
                                        mouse-cursor: default;
                                    }
                                }
                                // egui's one-row TextEdit: its own 2px margin over the text, 15px under it.
                                HorizontalLayout {
                                    padding-left: 22px;
                                    padding-right: 10px;
                                    padding-top: 2px;
                                    Rectangle {
                                        min-height: note.preferred-height + 15px;
                                        if note.text == "": Text {
                                            x: 0;
                                            y: 0;
                                            text: m.hint;
                                            font-size: 13px;
                                            color: Theme.subtle;
                                        }
                                        note := TextInput {
                                            x: 0;
                                            y: 0;
                                            width: parent.width;
                                            font-size: 13px;
                                            color: Theme.fg;
                                            wrap: word-wrap;
                                            single-line: false;
                                            init => {
                                                self.text = m.note;
                                                if m.focus {
                                                    self.focus();
                                                }
                                            }
                                            edited => {
                                                root.note-edited(i, self.text);
                                            }
                                            key-pressed(e) => {
                                                if e.text == "\n" && !e.modifiers.shift {
                                                    root.note-done();
                                                    return accept;
                                                }
                                                reject
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // The pictures first, in rows of 70 px tiles; then the other files, in rows of equal cells where
                    // a long name elides. Rows wrap at the composer's width, so nothing runs past its edge.
                    if root.files.length > 0: Rectangle {
                        property <length> gap: 8px;
                        property <int> tiles: root.file-tiles;
                        property <int> chip-count: root.files.length - root.file-tiles;
                        property <int> tile-cols: max(1, floor((self.width + gap) / (70px + gap)));
                        property <int> chip-cols: max(1, floor((self.width + gap) / (200px + gap)));
                        property <length> chip-w: min(200px, self.width);
                        property <length> tiles-h: tiles == 0 ? 0 : ceil(tiles / tile-cols) * (70px + gap) - gap;
                        property <length> chips-top: tiles-h + (tiles > 0 && chip-count > 0 ? gap : 0px);
                        property <length> content-h: chips-top + (chip-count == 0 ? 0px : ceil(chip-count / chip-cols) * (26px + gap) - gap);
                        height: min(content-h, root.max-h) + 6px;
                        Flickable {
                            width: parent.width;
                            height: parent.height - 6px;
                            content-width: self.width;
                            content-height: parent.content-h;
                            for f[i] in root.files: Rectangle {
                                x: f.tile ? mod(f.slot, tile-cols) * (70px + gap) : mod(f.slot, chip-cols) * (chip-w + gap);
                                y: f.tile ? floor(f.slot / tile-cols) * (70px + gap) : chips-top + floor(f.slot / chip-cols) * (26px + gap);
                                width: f.tile ? 70px : chip-w;
                                height: f.tile ? 70px : 26px;
                                if f.tile: ImageTile {
                                    x: 0;
                                    y: 0;
                                    thumb: f.thumb;
                                    name: f.name;
                                    number: f.number;
                                    remove => {
                                        root.remove-file(i);
                                    }
                                    open => {
                                        root.open-file(i);
                                    }
                                }
                                if !f.tile: FileChip {
                                    x: 0;
                                    y: 0;
                                    limit: chip-w;
                                    name: f.name;
                                    image: f.image;
                                    remove => {
                                        root.remove-file(i);
                                    }
                                }
                            }
                        }
                    }
                    text-box := Rectangle {
                        height: root.text-h;
                        if field.text == "": Text {
                            x: 0;
                            y: 0;
                            width: parent.width - root.who-w;
                            text: root.state.hint;
                            font-size: 14px;
                            color: Theme.gray-900;
                            wrap: word-wrap;
                        }
                        FocusScope {
                            x: 0;
                            width: parent.width - root.who-w;
                            capture-key-pressed(e) => {
                                if root.key(e) {
                                    return accept;
                                }
                                reject
                            }
                            field := TextInput {
                                font-size: 14px;
                                color: Theme.fg;
                                single-line: false;
                                wrap: word-wrap;
                                selection-background-color: Theme.dark ? Theme.blue-500 : Theme.blue-400;
                                selection-foreground-color: Theme.fg;
                                edited => {
                                    root.edited(self.text);
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 10px;
                    }
                    HorizontalLayout {
                        height: 34px;
                        spacing: 8px;
                        // The chips take what the buttons on the right leave (never pushing them out of the frame):
                        // labels elide, the least needed first (device, access, effort, model), and drop to the icon
                        // alone (its name in the tip) once even a short one doesn't fit.
                        chips := Rectangle {
                            min-width: 0px;
                            preferred-width: 0px;
                            max-width: 100000px;
                            horizontal-stretch: 1;
                            clip: true;
                            property <length> chip: 52px;
                            property <length> sep: 9px;
                            property <length> gap: 2px;
                            property <int> n: root.state.has-effort ? 4 : 3;
                            property <length> base: self.n * self.chip + (self.n - 1) * (self.sep + 2 * self.gap);
                            property <length> room: max(0px, self.width - self.base);
                            property <length> pm: root.state.model == "" ? 0px : m-model.preferred-width;
                            property <length> pe: !root.state.has-effort || root.state.effort == "" ? 0px : m-effort.preferred-width;
                            property <length> pa: root.state.access == "" ? 0px : m-access.preferred-width;
                            property <length> pd: root.state.device == "" ? 0px : m-device.preferred-width;
                            // A label's least room: up to 56px of text, plus the 4px before the chevron.
                            property <length> lm: self.pm == 0 ? 0px : min(self.pm, 56px) + 4px;
                            property <length> le: self.pe == 0 ? 0px : min(self.pe, 56px) + 4px;
                            property <length> la: self.pa == 0 ? 0px : min(self.pa, 56px) + 4px;
                            property <length> ld: self.pd == 0 ? 0px : min(self.pd, 56px) + 4px;
                            property <bool> show-m: self.pm > 0 && self.lm <= self.room;
                            property <bool> show-e: self.pe > 0 && self.show-m && self.lm + self.le <= self.room;
                            property <bool> show-a: self.pa > 0 && self.show-m && (self.show-e || self.pe == 0) && self.lm + (self.show-e ? self.le : 0px) + self.la <= self.room;
                            property <bool> show-d: self.pd > 0 && self.show-a && self.lm + (self.show-e ? self.le : 0px) + self.la + self.ld <= self.room;
                            // What's left past the least rooms goes to the labels in the same order, each up to its full width.
                            property <length> spare: self.room - (self.show-m ? self.lm : 0px) - (self.show-e ? self.le : 0px) - (self.show-a ? self.la : 0px) - (self.show-d ? self.ld : 0px);
                            property <length> gm: !self.show-m ? 0px : min(self.pm + 4px - self.lm, self.spare);
                            property <length> ge: !self.show-e ? 0px : min(self.pe + 4px - self.le, self.spare - self.gm);
                            property <length> ga: !self.show-a ? 0px : min(self.pa + 4px - self.la, self.spare - self.gm - self.ge);
                            // Where the effort chip ends (the model chip's end without one); the chips' VSeps sit between.
                            property <length> after-e: root.state.has-effort ? model.width + 2 * self.gap + self.sep + self.e-width : model.width;
                            property <length> e-width: !root.state.has-effort ? 0px : 52px + (self.show-e ? min(self.pe, self.le + self.ge - 4px) + 4px : 0px);
                            property <length> gd: !self.show-d ? 0px : min(self.pd + 4px - self.ld, self.spare - self.gm - self.ge - self.ga);
                            m-model := Text {
                                visible: false;
                                text: root.state.model;
                                font-size: 14px;
                            }
                            m-effort := Text {
                                visible: false;
                                text: root.state.effort;
                                font-size: 14px;
                            }
                            m-access := Text {
                                visible: false;
                                text: root.state.access;
                                font-size: 14px;
                            }
                            m-device := Text {
                                visible: false;
                                text: root.state.device;
                                font-size: 14px;
                            }
                            model := Trigger {
                                x: 0px;
                                y: 2px;
                                has-logo: true;
                                logo: root.logo;
                                badge: root.state.badge;
                                label: chips.show-m ? root.state.model : "";
                                label-max: chips.lm + chips.gm - 4px;
                                tip: chips.show-m ? root.state.model-tip : root.state.model + " · " + root.state.model-tip;
                                open: root.open-popup == "model";
                                clicked => {
                                    root.popup("model", self.absolute-position.x, self.absolute-position.y);
                                }
                            }
                            if root.state.has-effort: VSep {
                                x: model.x + model.width + chips.gap;
                                y: 8px;
                            }
                            if root.state.has-effort: Trigger {
                                x: model.x + model.width + chips.sep + 2 * chips.gap;
                                y: 2px;
                                icon: Icons.brain;
                                label: chips.show-e ? root.state.effort : "";
                                label-max: chips.le + chips.ge - 4px;
                                tip: chips.show-e && chips.ge >= chips.pe + 4px - chips.le ? "" : root.state.effort;
                                open: root.open-popup == "effort";
                                clicked => {
                                    root.popup("effort", self.absolute-position.x, self.absolute-position.y);
                                }
                            }
                            VSep {
                                x: chips.after-e + chips.gap;
                                y: 8px;
                            }
                            access := Trigger {
                                x: chips.after-e + chips.sep + 2 * chips.gap;
                                y: 2px;
                                icon: root.state.access-icon;
                                label: chips.show-a ? root.state.access : "";
                                label-max: chips.la + chips.ga - 4px;
                                tip: chips.show-a && chips.ga >= chips.pa + 4px - chips.la ? "" : root.state.access;
                                open: root.open-popup == "access";
                                clicked => {
                                    root.popup("access", self.absolute-position.x, self.absolute-position.y);
                                }
                            }
                            VSep {
                                x: access.x + access.width + chips.gap;
                                y: 8px;
                            }
                            Trigger {
                                x: access.x + access.width + chips.sep + 2 * chips.gap;
                                y: 2px;
                                icon: root.state.device-icon == "" ? Icons.house : root.state.device-icon;
                                label: chips.show-d ? root.state.device : "";
                                label-max: chips.ld + chips.gd - 4px;
                                tip: chips.show-d && chips.gd >= chips.pd + 4px - chips.ld ? "" : root.state.device;
                                open: root.open-popup == "device";
                                clicked => {
                                    root.popup("device", self.absolute-position.x, self.absolute-position.y);
                                }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 0;
                            spacing: 6px;
                            alignment: end;
                            // voice.rs `voice_button`: the mic; while recording the stop button, a level
                            // meter and the time; while transcribing a spinner and what it waits for.
                            if root.voice == "rec" && root.voice-note != "": Text {
                                horizontal-stretch: 0;
                                text: root.voice-note;
                                font-size: 12.5px;
                                color: Theme.subtle;
                                vertical-alignment: center;
                            }
                            if root.voice == "rec": Text {
                                horizontal-stretch: 0;
                                text: root.voice-time;
                                font-family: "Geist Mono";
                                font-size: 12.5px;
                                color: Theme.subtle;
                                vertical-alignment: center;
                            }
                            if root.voice == "rec": Rectangle {
                                width: 40px;
                                for i in 5: Rectangle {
                                    property <float> shape: i == 2 ? 1.0 : i == 1 || i == 3 ? 0.8 : 0.55;
                                    property <float> v: min(root.voice-level * self.shape, 1.0);
                                    x: i * 40px / 5 + 40px / 9 / 2 - self.width / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 40px / 9;
                                    height: max(20px * (0.18 + 0.82 * self.v), 3px);
                                    background: root.voice-level * self.shape > 0.06 ? Theme.red-900 : Theme.gray-500;
                                }
                            }
                            if root.voice == "rec": StopButton {
                                tip: root.mic-tip;
                                clicked => {
                                    root.mic();
                                }
                            }
                            if root.voice == "busy": Rectangle {
                                width: 18px;
                                Spinner {
                                    radius: 6px;
                                    color: Theme.subtle;
                                }
                            }
                            if root.voice == "busy": Text {
                                horizontal-stretch: 0;
                                text: root.voice-note;
                                font-size: 12.5px;
                                color: Theme.subtle;
                                vertical-alignment: center;
                            }
                            if root.voice == "": Btn {
                                y: 1px;
                                icon: Icons.mic;
                                size: icon-sm;
                                variant: ghost-muted;
                                tip: root.mic-tip;
                                clicked => {
                                    root.mic();
                                }
                            }
                            Btn {
                                y: 1px;
                                icon: Icons.clip;
                                size: icon-sm;
                                variant: ghost-muted;
                                tip: "Attach files or images (or drop them here)";
                                clicked => {
                                    root.attach();
                                }
                            }
                            if root.state.action == "stop": StopButton {
                                tip: "Stop (Esc)";
                                clicked => {
                                    root.stop();
                                }
                            }
                            if root.state.action != "stop": RoundButton {
                                icon: root.state.action == "steer" ? Icons.corner-up-right : root.state.action == "queue" ? Icons.list-plus : root.state.action == "update" ? Icons.check : root.state.action == "resume" ? Icons.play : Icons.arrow-up;
                                enabled: root.state.action != "send" || field.text != "" || root.files.length > 0;
                                tip: root.state.action-tip;
                                clicked => {
                                    root.send();
                                }
                            }
                        }
                    }
                }
                // Who else types: in the corner, on the first line, at the card's inner padding; the text gives it room
                // instead of moving down for it.
                who := Text {
                    x: parent.width - 18px - self.width;
                    y: text-box.y + (root.line - self.height) / 2;
                    visible: root.state.typing != "";
                    text: root.state.typing;
                    font-size: 12px;
                    color: Theme.subtle;
                }
            }
            // The tray under the card (as the reference composer's): tucked under its bottom edge, a little narrower,
            // one quiet row: where the agent works on the left; its pull request and branch on the right.
            if root.bar.shown: HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                Rectangle {
                    height: 32px;
                    border-bottom-left-radius: 10px;
                    border-bottom-right-radius: 10px;
                    // Its stroke is the card's, brighter while you type as the card's is.
                    background: field.has-focus ? Theme.gray-600 : Theme.border;
                    Rectangle {
                        x: 1px;
                        y: 0;
                        width: parent.width - 2px;
                        height: parent.height - 1px;
                        border-bottom-left-radius: 9px;
                        border-bottom-right-radius: 9px;
                        background: Theme.dark ? #0d0d0d : #fafafa;
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 3px;
                        padding-bottom: 4px;
                        spacing: 2px;
                        if root.bar.ws.shown: WorkBarChip {
                            chip: root.bar.ws;
                            chevron: root.bar.live && root.bar.ws.tone == "";
                            max-text: 320px;
                            clicked(x, y) => {
                                root.popup("ws-bar", x, y);
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        if root.bar.pr.shown: WorkBarChip {
                            chip: root.bar.pr;
                            clicked(x, y) => {
                                root.popup("pr-bar", x, y);
                            }
                        }
                        if root.bar.branch.shown: WorkBarChip {
                            chip: root.bar.branch;
                            chevron: root.bar.live && root.bar.branch.tone == "";
                            clicked(x, y) => {
                                root.popup("branch-bar", x, y);
                            }
                        }
                    }
                }
            }
        }
    }
    if root.menu.length > 0: ComposerMenu {
        x: 0px;
        y: card.y + frame.y - self.height - 6px;
        width: root.width - 4px;
        entries: root.menu;
        selected: root.menu-selected;
        pick(i) => {
            root.menu-pick(i);
        }
        hover(i) => {
            root.menu-hover(i);
        }
    }
    clip := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
    }
}
