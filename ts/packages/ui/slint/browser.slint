import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Btn, Glyph, Input } from "widgets.slint";

export enum BrowserState { page, stopped, starting, build, absent }

export struct BrowserData {
    state: BrowserState,
    url: string,
    loading: bool,
    back: bool,
    forward: bool,
    external: bool,
    has-frame: bool,
    frame: image,
    cursor: string,
    error-host: string,
    error-local: bool,
    // Why the engine stopped, for BrowserState.stopped.
    why: string,
}

component Missing {
    in property <BrowserData> data;
    callback act();
    callback close();
    property <string> title: data.state == BrowserState.stopped ? "The browser engine stopped" : data.state == BrowserState.starting ? "Starting the browser…" : data.state == BrowserState.build ? "Browser engine not built" : "Browser engine not found";
    property <string> note: data.state == BrowserState.stopped ? "It quit right after starting" + (data.why == "" ? "" : ": " + data.why) : data.state == BrowserState.build ? "It's a separate program (Servo), so Harbor stays small. The first build takes a while." : data.state == BrowserState.absent ? "This copy of Harbor has no harbor-browser beside it: install Harbor with install.sh, or set HARBOR_BROWSER." : "";
    property <string> button: data.state == BrowserState.stopped ? "Try again" : data.state == BrowserState.build ? "Build engine" : "";
    VerticalLayout {
        alignment: start;
        padding-top: 40px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 8px;
        Glyph {
            height: 38px;
            icon: Icons.globe;
            size: 28px;
            color: Theme.subtle;
        }
        Text {
            text: root.title;
            height: 24px;
            font-size: 16px;
            font-weight: 600;
            color: Theme.fg;
            horizontal-alignment: center;
        }
        if root.note != "": Text {
            text: root.note;
            font-size: 13px;
            color: Theme.subtle;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            padding-top: 8px;
            spacing: 8px;
            if root.button != "": Btn {
                icon: root.data.state == BrowserState.build ? Icons.hammer : Icons.rotate-cw;
                text: root.button;
                size: sm;
                variant: primary;
                clicked => {
                    root.act();
                }
            }
            Btn {
                text: "Close";
                size: sm;
                variant: outline;
                clicked => {
                    root.close();
                }
            }
        }
    }
}

// browser.rs `Browser::ui`: the toolbar, then the page at 1:1 device pixels from its top left.
export component BrowserView inherits Rectangle {
    in property <BrowserData> data;
    in property <[string]> servers;
    callback nav(string);
    callback go(string);
    callback missing-act();
    callback close();
    // Device pixels, as the engine takes them.
    callback page-resized(float, float);
    callback pointer(string, float, float, int);
    callback wheel(float, float, float, float);
    callback key(string, bool, bool, bool, bool, bool);
    property <length> page-top: 6px + 35px + 6px + 8px;
    property <string> url: data.url;
    changed url => {
        if !field.focused {
            field.text = root.url;
        }
    }
    if root.data.state != BrowserState.page: Missing {
        width: root.width;
        height: root.height;
        data: root.data;
        act => {
            root.missing-act();
        }
        close => {
            root.close();
        }
    }
    HorizontalLayout {
        visible: root.data.state == BrowserState.page;
        y: 6px;
        height: 35px;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 2px;
        Btn {
            y: (35px - self.height) / 2;
            icon: Icons.arrow-left;
            size: icon-xs;
            variant: ghost-muted;
            enabled: root.data.back;
            tip: "Back";
            clicked => {
                root.nav("back");
            }
        }
        Btn {
            y: (35px - self.height) / 2;
            icon: Icons.arrow-right;
            size: icon-xs;
            variant: ghost-muted;
            enabled: root.data.forward;
            tip: "Forward";
            clicked => {
                root.nav("forward");
            }
        }
        Btn {
            y: (35px - self.height) / 2;
            icon: root.data.loading ? Icons.x : Icons.rotate-cw;
            size: icon-xs;
            variant: ghost-muted;
            tip: root.data.loading ? "Loading…" : "Reload";
            clicked => {
                root.nav("reload");
            }
        }
        field := Input {
            width: root.width - 16px - 3 * (28px + 2px) - 64px;
            height: 35px;
            mono: true;
            hint: "localhost:3000 or a URL";
            init => {
                self.text = root.url;
            }
            accepted(t) => {
                root.go(t);
            }
        }
        Btn {
            y: (35px - self.height) / 2;
            icon: Icons.external;
            size: icon-xs;
            variant: ghost-muted;
            enabled: root.data.external;
            tip: "Open in my browser";
            clicked => {
                root.nav("external");
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
    if root.data.state == BrowserState.page: Rectangle {
        y: root.page-top;
        height: root.height - self.y;
        background: white;
        clip: true;
        changed width => {
            root.page-resized(self.width / 1phx, self.height / 1phx);
        }
        changed height => {
            root.page-resized(self.width / 1phx, self.height / 1phx);
        }
        init => {
            root.page-resized(self.width / 1phx, self.height / 1phx);
        }
        if root.data.has-frame: Image {
            x: 0;
            y: 0;
            width: self.source.width * 1phx;
            height: self.source.height * 1phx;
            source: root.data.frame;
        }
        if !root.data.has-frame: Text {
            text: "Loading…";
            font-size: 14px;
            color: Theme.gray-700;
        }
        page := FocusScope {
            key-pressed(e) => {
                root.key(e.text, true, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta);
                accept
            }
            key-released(e) => {
                root.key(e.text, false, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta);
                accept
            }
            TouchArea {
                mouse-cursor: root.data.cursor == "pointer" ? MouseCursor.pointer : root.data.cursor == "text" ? MouseCursor.text : root.data.cursor == "grab" ? MouseCursor.grab : root.data.cursor == "grabbing" ? MouseCursor.grabbing : root.data.cursor == "move" ? MouseCursor.move : root.data.cursor == "not-allowed" ? MouseCursor.not-allowed : root.data.cursor == "wait" ? MouseCursor.wait : root.data.cursor == "progress" ? MouseCursor.progress : root.data.cursor == "crosshair" ? MouseCursor.crosshair : root.data.cursor == "ew-resize" ? MouseCursor.ew-resize : root.data.cursor == "col-resize" ? MouseCursor.col-resize : root.data.cursor == "ns-resize" ? MouseCursor.ns-resize : root.data.cursor == "row-resize" ? MouseCursor.row-resize : root.data.cursor == "none" ? MouseCursor.none : MouseCursor.default;
                moved => {
                    root.pointer("move", self.mouse-x / 1phx, self.mouse-y / 1phx, 0);
                }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.move && !self.pressed {
                        root.pointer("move", self.mouse-x / 1phx, self.mouse-y / 1phx, 0);
                    }
                    if e.kind == PointerEventKind.down || e.kind == PointerEventKind.up {
                        if e.kind == PointerEventKind.down {
                            page.focus();
                        }
                        root.pointer(e.kind == PointerEventKind.down ? "down" : "up", self.mouse-x / 1phx, self.mouse-y / 1phx, e.button == PointerEventButton.right ? 1 : e.button == PointerEventButton.middle ? 2 : 0);
                    }
                }
                scroll-event(e) => {
                    root.wheel(self.mouse-x / 1phx, self.mouse-y / 1phx, e.delta-x / 1phx, e.delta-y / 1phx);
                    accept
                }
            }
        }
        // Servo's own error page is bare text; this one shows what is reachable instead.
        if root.data.error-host != "": Rectangle {
            background: Theme.bg100;
            VerticalLayout {
                alignment: start;
                padding-top: 24px + (root.height - root.page-top) * 0.18;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 8px;
                Glyph {
                    height: 38px;
                    icon: Icons.globe;
                    size: 28px;
                    color: Theme.subtle;
                }
                Text {
                    text: "Can't reach " + root.data.error-host;
                    height: 24px;
                    font-size: 16px;
                    font-weight: 600;
                    color: Theme.fg;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.data.error-local ? "Nothing is running there." : "The site didn't respond.";
                    font-size: 13px;
                    color: Theme.subtle;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    padding-top: 10px;
                    Btn {
                        icon: Icons.rotate-cw;
                        text: "Retry";
                        size: sm;
                        variant: outline;
                        clicked => {
                            root.nav("reload");
                        }
                    }
                }
                if root.servers.length > 0: VerticalLayout {
                    padding-top: 14px;
                    Text {
                        text: "Running on this machine";
                        font-size: 12px;
                        color: Theme.subtle;
                        horizontal-alignment: center;
                    }
                }
                for s in root.servers: HorizontalLayout {
                    alignment: center;
                    Btn {
                        icon: Icons.globe;
                        text: s;
                        size: xs;
                        variant: ghost;
                        clicked => {
                            root.go("http://" + s + "/");
                        }
                    }
                }
            }
        }
    }
}
