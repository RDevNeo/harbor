import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Btn, Glyph, Spinner, StatusData, StatusView, SearchField, Empty, TipArea } from "widgets.slint";
import { MemGauge } from "memory.slint";

export struct SideRow {
    kind: string,
    id: int,
    title: string,
    active: bool,
    status: StatusData,
    letter: string,
    avatar: image,
    has-avatar: bool,
    settled: bool,
    snoozed: bool,
    worktree: string,
    worktree-tip: string,
    pr: string,
    pr-tip: string,
    tip: string,
    // A project row's hint after its name: the PC that holds its folder when it isn't here.
    place: string,
    // `place` names a PC (else it's this PC's folder, for two projects with one name).
    place-pc: bool,
    // Share with workspace…: "" not shared, "shared", "here" (shown only because it's shared with a picked workspace).
    shared: string,
    shared-tip: string,
    // A project row's fold: "" no chats under it, "open", "folded".
    fold: string,
    // A chat row's last activity ("13m ago"), on its right while nothing else is to say.
    ago: string,
    // The branch it works on (its worktree's, else its project's checkout's; no "harbor/"), on a line under the title.
    branch: string,
    // The last chat under its project: the guide line ends with it.
    last: bool,
    // Someone else's chat: their initials ("" yours), name and photo.
    owner: string,
    owner-tip: string,
    owner-photo: image,
    has-owner-photo: bool,
    // Open in a split pane: its number (0: none), and that pane has the keyboard.
    pane: int,
    pane-focus: bool,
}

// A chat's status before its title: the spinner while it works, amber while it waits or is limited, blue while unread,
// red when its turn failed.
component LeadMark {
    in property <StatusData> status;
    width: 12px;
    if root.status.kind == "working": Spinner {
        radius: 5px;
        color: Theme.blue-900;
    }
    if root.status.kind == "waiting" || root.status.kind == "limited": Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.amber-700;
    }
    if root.status.kind == "done": Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.blue-700;
    }
    if root.status.kind == "failed": Glyph {
        icon: Icons.circle-x;
        size: 12px;
        color: Theme.red-900;
    }
}

// What a chat row says on its right: Working, Waiting, Limited or Failed in their colours; a snooze's clock or another
// mark as the status says it; else when it was last active ("13m ago").
component RowStatus {
    in property <StatusData> status;
    in property <string> ago;
    property <bool> word: status.kind == "working" || status.kind == "waiting" || status.kind == "limited" || status.kind == "failed";
    property <bool> mark: status.kind == "text" && (status.icon != "" || status.text == "●");
    width: self.preferred-width;
    HorizontalLayout {
        alignment: end;
        if root.word: Text {
            text: root.status.kind == "working" ? "Working" : root.status.kind == "waiting" ? (root.status.text == "" ? "Waiting" : root.status.text) : root.status.kind == "limited" ? "Limited" : "Failed";
            font-size: 12.5px;
            color: root.status.kind == "working" ? Theme.blue-900 : root.status.kind == "failed" ? Theme.red-900 : Theme.amber-900;
            vertical-alignment: center;
        }
        if root.mark: StatusView {
            status: root.status;
        }
        if !root.word && !root.mark: Text {
            text: root.ago;
            font-size: 12.5px;
            color: Theme.gray-800;
            vertical-alignment: center;
        }
    }
}

// The branch a chat works on: the branch glyph and its name, small and dim (red when its worktree is gone).
component BranchLabel inherits HorizontalLayout {
    in property <string> branch;
    in property <bool> gone;
    spacing: 3px;
    Glyph {
        width: 11px;
        icon: Icons.branch;
        size: 11px;
        color: root.gone ? Theme.red-900 : Theme.gray-800;
    }
    Text {
        text: root.branch;
        font-family: "Geist Mono";
        font-size: 11.5px;
        color: root.gone ? Theme.red-900 : Theme.gray-800;
        overflow: elide;
        vertical-alignment: center;
    }
}

// Someone else's chat: their round photo, else their initials.
component OwnerMark inherits TipArea {
    in property <string> letters;
    in property <image> photo;
    in property <bool> has-photo;
    width: 16px;
    height: 16px;
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.gray-400;
        clip: true;
        if root.has-photo: Image {
            width: 16px;
            height: 16px;
            source: root.photo;
            image-fit: cover;
        }
        if !root.has-photo: Text {
            text: root.letters;
            font-size: 7.5px;
            font-weight: 600;
            color: Theme.fg;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Share with workspace…'s mark: a link glyph, blue when the filter shows the row only because it's shared.
component SharedMark inherits TipArea {
    in property <string> kind;
    in property <bool> active;
    width: 16px;
    Glyph {
        icon: Icons.link;
        size: 12px;
        color: root.kind == "here" ? Theme.blue-900 : root.active ? Theme.fg : Theme.subtle;
    }
}

component ThreadRow {
    in property <SideRow> data;
    callback open();
    // Dragged past egui's click distance (window coordinates), and let go: a chat dropped on the centre splits it.
    callback drag(length, length);
    callback dropped(length, length);
    property <bool> far;
    callback settle(bool);
    // Under the clock button, in window coordinates.
    callback snooze(length, length);
    // At the pointer, in window coordinates.
    callback menu(length, length);
    // The marks after the title count too: they sit over `area`, and without them pointing at one
    // drops the hover, the title widens, the mark slides off the pointer, the hover comes back and
    // the title narrows under it again, over and over.
    property <bool> hovering: area.has-hover || worktree.has-hover || pr.has-hover || shared.has-hover || owner.has-hover || settle-btn.hovered || snooze-btn.hovered;
    property <bool> indented: data.kind == "thread";
    // A loose chat (Threads, Settled) keeps its chat glyph until it has a status to show there.
    property <bool> lead-status: data.status.kind == "working" || data.status.kind == "waiting" || data.status.kind == "limited" || data.status.kind == "done" || data.status.kind == "failed";
    // The branch it works on, on a second line under the title.
    property <bool> two-lines: data.branch != "";
    // The hover buttons' width: the clock and Settle, icons only.
    property <length> act-w: root.data.settled ? 28px : 56px;
    // The worktree glyph stands in for a branch that isn't known.
    property <bool> wt-glyph: data.worktree != "" && data.branch == "";
    height: two-lines ? 46px : Theme.row-h;
    // The guide line down the project's chats: through the gap to the next one, unless this is the last.
    if root.indented: Rectangle {
        x: 9px;
        y: 0;
        width: 1px;
        height: root.data.last ? root.height : root.height + 2px;
        background: Theme.gray-300;
    }
    Rectangle {
        x: root.indented ? 18px : 0px;
        width: parent.width - self.x;
        background: root.data.active || root.hovering ? Theme.accent : transparent;
        border-radius: Theme.radius-md;
        area := TouchArea {
            mouse-cursor: root.far ? MouseCursor.grabbing : MouseCursor.pointer;
            clicked => {
                if !root.far {
                    root.open();
                }
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                    root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    root.far = false;
                }
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.far {
                    root.dropped(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                root.far = root.far || abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px;
                if root.far {
                    root.drag(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
        // The title's line: the whole row, or its top with the branch under it.
        property <length> line-y: root.two-lines ? 4px : 0px;
        property <length> line-h: root.two-lines ? 22px : Theme.row-h;
        if root.indented || root.lead-status: LeadMark {
            x: root.indented ? 6px : 10px;
            y: parent.line-y;
            height: parent.line-h;
            status: root.data.status;
        }
        if !root.indented && !root.lead-status: Glyph {
            x: 8px;
            y: parent.line-y;
            width: 16px;
            height: parent.line-h;
            icon: root.data.kind == "settled-project" ? Icons.folder : Icons.message;
            size: 14px;
            color: root.data.active ? Theme.fg : Theme.subtle;
        }
        // The title, then its marks: the PR, the share mark. Hovered, the last mark keeps 30px (glyph to glyph) before
        // the clock, as the clock does before Settle.
        // Hovered, nothing moves: the clock and Settle sit over the title's end, which fades out under them.
        property <length> pane-w: root.data.pane > 0 ? 21px : 0px;
        property <length> right-w: status.width + 16px + (root.data.owner != "" ? 22px : 0px) + self.pane-w;
        property <length> marks-w: (root.wt-glyph ? 20px : 0px) + (root.data.pr != "" ? 20px : 0px) + (root.data.shared != "" ? 20px : 0px) + (root.data.place != "" ? place.width + 6px : 0px);
        property <length> room: self.width - title.x - self.right-w - self.marks-w;
        title := Text {
            x: root.indented ? 24px : 32px;
            y: parent.line-y;
            height: parent.line-h;
            width: min(self.preferred-width, max(parent.room, 10px));
            text: root.data.title;
            font-size: 14px;
            font-weight: root.data.active || root.data.status.kind == "done" ? 500 : 400;
            // Snoozed: it stays in its place, muted, its status saying when it wakes.
            color: root.data.snoozed ? Theme.gray-800 : Theme.fg;
            overflow: elide;
            vertical-alignment: center;
        }
        // Under the title, from where it starts, as far as the row goes.
        if root.two-lines: BranchLabel {
            x: title.x;
            y: parent.line-y + parent.line-h;
            height: 16px;
            width: parent.width - title.x - 10px;
            branch: root.data.branch;
            gone: root.data.worktree == "gone";
        }
        property <length> marks-x: title.x + title.width + 5px;
        // A settled project's PC, when its folder isn't here (the project row's hint).
        place := HorizontalLayout {
            visible: root.data.place != "";
            x: parent.marks-x + 1px;
            y: parent.line-y;
            height: parent.line-h;
            width: root.data.place != "" ? min(self.preferred-width, 106px) : 0px;
            spacing: 3px;
            Glyph {
                width: 12px;
                icon: root.data.place-pc ? Icons.monitor : Icons.folder;
                size: 12px;
                color: Theme.subtle;
            }
            Text {
                text: root.data.place;
                font-size: 12px;
                color: Theme.subtle;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        worktree := TipArea {
            visible: root.wt-glyph;
            x: parent.marks-x;
            y: parent.line-y;
            height: parent.line-h;
            width: 16px;
            tip: root.data.worktree-tip;
            Glyph {
                icon: Icons.folder-git;
                size: 13px;
                color: root.data.worktree == "gone" ? Theme.red-900 : root.data.active ? Theme.fg : Theme.subtle;
            }
        }
        pr := TipArea {
            visible: root.data.pr != "";
            x: parent.marks-x + (root.wt-glyph ? 20px : 0px);
            y: parent.line-y;
            height: parent.line-h;
            width: 16px;
            tip: root.data.pr-tip;
            Glyph {
                icon: root.data.pr == "merged" ? Icons.git-merge : root.data.pr == "draft" ? Icons.pr-draft : root.data.pr == "closed" ? Icons.pr-closed : Icons.pr-open;
                size: 13px;
                color: root.data.pr == "open" ? Theme.green-900 : root.data.pr == "draft" ? Theme.gray-800 : root.data.pr == "closed" ? Theme.red-900 : Theme.dark ? #c4b5fd : #7c3aed;
            }
        }
        shared := SharedMark {
            visible: root.data.shared != "";
            x: parent.marks-x + (root.wt-glyph ? 20px : 0px) + (root.data.pr != "" ? 20px : 0px);
            y: parent.line-y;
            height: parent.line-h;
            kind: root.data.shared;
            active: root.data.active;
            tip: root.data.shared-tip;
        }
        // Its split pane's number: blue while that pane has the keyboard.
        if root.data.pane > 0 && !root.hovering: Rectangle {
            x: parent.width - parent.right-w + 6px;
            y: parent.line-y + (parent.line-h - self.height) / 2;
            width: 15px;
            height: 15px;
            border-radius: 4px;
            background: root.data.pane-focus ? Theme.blue-700 : Theme.gray-300;
            Text {
                text: root.data.pane;
                font-size: 10px;
                font-weight: 600;
                color: root.data.pane-focus ? #ffffff : Theme.fg;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        owner := OwnerMark {
            visible: root.data.owner != "" && !root.hovering;
            x: parent.width - parent.right-w + 6px + parent.pane-w;
            y: parent.line-y + (parent.line-h - self.height) / 2;
            letters: root.data.owner;
            photo: root.data.owner-photo;
            has-photo: root.data.has-owner-photo;
            tip: root.data.owner-tip;
        }
        status := RowStatus {
            visible: !root.hovering;
            x: parent.width - 8px - self.width;
            y: parent.line-y;
            height: parent.line-h;
            status: root.data.status;
            ago: root.data.ago;
        }
        // The title's end fades out under the buttons, on its line only.
        if root.hovering: Rectangle {
            x: actions.x - 30px;
            y: parent.line-y;
            width: parent.width - self.x;
            height: parent.line-h;
            background: @linear-gradient(90deg, Theme.accent.transparentize(1) 0%, Theme.accent 45%, Theme.accent 100%);
        }
        actions := HorizontalLayout {
            visible: root.hovering;
            // On the title's line, centred on it as the title is.
            x: parent.width - 4px - root.act-w;
            y: parent.line-y + (parent.line-h - 28px) / 2;
            height: 28px;
            width: root.act-w;
            spacing: 0px;
            snooze-btn := Btn {
                visible: !root.data.settled;
                width: root.data.settled ? 0px : 28px;
                icon: Icons.clock;
                size: icon-xs;
                variant: ghost-muted;
                pressed: root.data.snoozed;
                tip: "Snooze";
                clicked => {
                    root.snooze(self.absolute-position.x, self.absolute-position.y + self.height);
                }
            }
            settle-btn := Btn {
                width: 28px;
                icon: root.data.settled ? Icons.unarchive : Icons.check;
                tip: root.data.settled ? "Unsettle" : "Settle";
                size: icon-xs;
                variant: ghost-muted;
                clicked => {
                    root.settle(!root.data.settled);
                }
            }
        }
    }
}

component ProjectRow {
    in property <SideRow> data;
    callback open();
    // The chevron: fold or unfold its chats.
    callback fold();
    callback new-chat();
    callback snooze(length, length);
    callback menu(length, length);
    in property <bool> grip;
    // The project dragged across the sidebar (-1: none) and the pointer's window y.
    in property <int> drag-id: -1;
    in property <length> drag-y;
    callback drag(length);
    callback dropped();
    property <bool> pointed: drag-y >= self.absolute-position.y && drag-y < self.absolute-position.y + self.height;
    out property <bool> under: drag-id >= 0 && drag-id != data.id && pointed;
    out property <bool> above: drag-y < self.absolute-position.y + self.height / 2;
    property <bool> dragging: drag-id == data.id;
    property <bool> far;
    // While a drag runs the pressed handle keeps the hover, so the pointer's row shows it instead.
    property <bool> hovering: drag-id >= 0 ? pointed : area.has-hover || handle.has-hover || chevron.has-hover || shared.has-hover || plus.hovered || snooze.hovered;
    // Its icon, after the fold's chevron; its name after that.
    property <length> icon-x: 22px;
    property <length> name-x: 46px;
    height: Theme.row-h + 2px;
    Rectangle {
        background: root.data.active || root.hovering ? Theme.accent : transparent;
        border-radius: Theme.radius-md;
    }
    // sidebar.rs: egui draws the drop line as a 2px stroke 1px outside the target row.
    if root.under: Rectangle {
        y: root.above ? -2px : parent.height;
        height: 2px;
        background: Theme.gray-1000;
    }
    area := TipArea {
        tip: root.data.tip;
        clicked => {
            root.open();
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    handle := TouchArea {
        x: root.icon-x - 4px;
        width: 24px;
        enabled: root.grip;
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.far = false;
            }
            if e.kind == PointerEventKind.up && root.dragging {
                root.dropped();
            }
        }
        moved => {
            // egui's click distance: further than 6px is a drag.
            root.far = root.far || abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px;
            if root.far {
                root.drag(self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            if !root.far {
                root.open();
            }
        }
    }
    // The fold: down while its chats show, right while they're folded away.
    chevron := TouchArea {
        x: 0;
        width: root.icon-x - 2px;
        enabled: root.data.fold != "";
        mouse-cursor: pointer;
        clicked => {
            root.fold();
        }
        if root.data.fold != "": Glyph {
            x: 5px;
            width: 14px;
            icon: root.data.fold == "folded" ? Icons.right : Icons.down;
            size: 12px;
            color: chevron.has-hover ? Theme.fg : Theme.gray-800;
        }
    }
    if root.grip && (root.hovering || root.dragging): Glyph {
        x: root.icon-x;
        width: 16px;
        icon: Icons.grip;
        size: 16px;
        color: root.data.active ? Theme.fg : Theme.subtle;
    }
    if root.data.has-avatar && !(root.grip && (root.hovering || root.dragging)): Image {
        x: root.icon-x;
        width: 16px;
        height: 16px;
        source: root.data.avatar;
        opacity: root.data.snoozed ? 0.45 : 1;
    }
    if !root.data.has-avatar && !(root.grip && (root.hovering || root.dragging)): Rectangle {
        x: root.icon-x;
        width: 16px;
        height: 16px;
        border-radius: 4px;
        background: root.data.active || root.hovering ? Theme.gray-400 : Theme.gray-300;
        opacity: root.data.snoozed ? 0.45 : 1;
        Text {
            text: root.data.letter;
            font-size: 10.5px;
            font-weight: 600;
            color: Theme.fg;
        }
    }
    // The name, then its marks right after it (as on a chat row): the room left of the status,
    // or of the hover buttons, is what the name and its place hint share.
    property <length> room: self.width - root.name-x - (root.hovering ? actions.preferred-width + 9px : status.preferred-width + 16px) - (root.data.shared != "" ? 22px : 0px);
    title := Text {
        x: root.name-x;
        width: min(self.preferred-width, max(root.room - (root.data.place != "" ? place.width + 6px : 0px), 10px));
        text: root.data.title;
        font-size: 14px;
        font-weight: root.data.active ? 600 : 500;
        // Snoozed: it stays in its place, muted (its icon too), its status saying when it wakes.
        color: root.data.snoozed ? Theme.gray-800 : Theme.fg;
        overflow: elide;
        vertical-alignment: center;
    }
    shared := SharedMark {
        visible: root.data.shared != "";
        x: title.x + title.width + 6px;
        kind: root.data.shared;
        active: root.data.active;
        tip: root.data.shared-tip;
    }
    // The hint gets what the name leaves, and at least 106px of it before the name elides.
    place := HorizontalLayout {
        visible: root.data.place != "";
        x: title.x + title.width + 6px + (root.data.shared != "" ? 22px : 0px);
        width: root.data.place != "" ? max(0px, min(self.preferred-width, max(106px, root.room - title.preferred-width - 6px))) : 0px;
        spacing: 3px;
        Glyph {
            width: 12px;
            icon: root.data.place-pc ? Icons.monitor : Icons.folder;
            size: 12px;
            color: Theme.subtle;
        }
        Text {
            text: root.data.place;
            font-size: 12px;
            color: Theme.subtle;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    status := StatusView {
        visible: !root.hovering;
        x: parent.width - 8px - self.width;
        width: self.preferred-width;
        status: root.data.status;
    }
    // The clock's glyph ends where the status text does (8px in), and the marks before it keep
    // the buttons' step: 30px from glyph to glyph, as the clock and Settle on a chat row.
    actions := HorizontalLayout {
        visible: root.hovering;
        x: parent.width - 1px - self.preferred-width;
        y: (parent.height - 28px) / 2;
        height: 28px;
        spacing: 2px;
        plus := Btn {
            icon: Icons.plus;
            size: icon-xs;
            variant: ghost-muted;
            tip: "New chat in this project";
            clicked => {
                root.new-chat();
            }
        }
        snooze := Btn {
            icon: Icons.clock;
            size: icon-xs;
            variant: ghost-muted;
            pressed: root.data.snoozed;
            tip: "Snooze";
            clicked => {
                root.snooze(self.absolute-position.x, self.absolute-position.y + self.height);
            }
        }
    }
}

// The bottom bar's light/dark button, beside your photo: one round button, a sun in dark (to light) and a moon in light
// (to dark); a click flips the theme at once.
component ThemeBtn {
    callback toggled;
    width: 28px;
    height: 28px;
    Rectangle {
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: area.has-hover ? Theme.gray-300 : Theme.gray-200;
        border-width: 1px;
        border-color: Theme.border;
        Glyph {
            width: parent.width;
            height: parent.height;
            icon: Theme.dark ? Icons.sun : Icons.moon;
            size: 13px;
            color: Theme.fg;
        }
    }
    area := TipArea {
        tip: Theme.dark ? "Light theme" : "Dark theme";
        clicked => {
            root.toggled();
        }
    }
}

// The bottom bar's first button: your round photo (or initial; the gear when signed out), opening Settings.
component MeBtn {
    in property <image> photo;
    in property <bool> has-photo;
    in property <string> letter;
    callback clicked;
    width: 34px;
    height: 34px;
    // A ring around you, so your photo stands out in the bar.
    Rectangle {
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: area.has-hover ? Theme.accent : transparent;
        border-width: root.has-photo || root.letter != "" ? 2px : 0px;
        border-color: area.has-hover ? Theme.fg : Theme.border;
    }
    if root.has-photo: Image {
        width: 28px;
        height: 28px;
        source: root.photo;
    }
    if !root.has-photo && root.letter != "": Rectangle {
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: #7a6ad8;
        Text {
            text: root.letter;
            font-size: 14px;
            font-weight: 600;
            color: white;
        }
    }
    if !root.has-photo && root.letter == "": Glyph {
        icon: Icons.settings;
        size: 14px;
        color: area.has-hover ? Theme.fg : Theme.subtle;
    }
    area := TipArea {
        tip: "Settings (Ctrl+,)";
        clicked => {
            root.clicked();
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[SideRow]> rows;
    in property <[SideRow]> settled;
    in property <int> settled-count;
    in-out property <bool> settled-open;
    in-out property <string> search <=> search-field.text;
    in property <string> empty-kind;
    in property <string> empty-desc;
    in property <bool> workspaces;
    in property <bool> ws-on;
    in property <string> ws-tip;
    in property <string> pop-id;
    in property <bool> pages-back;
    // The row Alt+Up / Alt+Down opened ("kind:id"): scrolled into view.
    in property <string> reveal;
    in-out property <length> scroll-y <=> list.viewport-y;
    callback open-chat(int);
    callback open-project(int);
    callback fold-project(int);
    callback new-chat(int);
    callback new-thread();
    callback add-project();
    callback settle(int, bool);
    callback settle-project(int, bool);
    callback snooze(string, length, length);
    callback chat-menu(int, length, length);
    callback project-menu(int, length, length);
    callback searched(string);
    callback hide();
    callback palette();
    // The bottom bar's light/dark button, beside your photo: flips at once (kv `theme`; Settings has no Appearance).
    callback toggle-theme();
    // You, in the bottom bar's first place (opens Settings): your photo, else your initial; neither (signed out): the gear.
    in property <image> me-photo;
    in property <bool> me-has-photo;
    in property <string> me-letter;
    callback filter(length, length);
    // Over the gauge, in window coordinates.
    callback usage(length, length);
    // This PC's memory ("" hides the gauge): figure, share used, low on memory, tooltip.
    in property <string> mem;
    in property <float> mem-frac;
    in property <bool> mem-low;
    in property <string> mem-tip;
    // Over the memory gauge, in window coordinates.
    callback mem-pop(length, length);
    callback ws-filter(length, length);
    callback ws-all();
    in property <bool> can-drag;
    callback reorder(int, int, bool);
    // A chat row dragged (its row, the pointer in window coordinates) and let go: the centre's split panes.
    callback chat-drag(SideRow, length, length);
    callback chat-drop(SideRow, length, length);
    in-out property <int> drag-id: -1;
    in-out property <length> drag-y;
    property <int> drop-id: -1;
    property <bool> drop-above;
    callback settings();
    callback back();
    callback refresh();
    background: Theme.bg200;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 11px;
        padding-top: 13px;
        spacing: 2px;
        HorizontalLayout {
            height: 28px;
            spacing: 6px;
            Btn {
                icon: Icons.panel-left-close;
                size: icon-xs;
                variant: ghost-muted;
                tip: "Hide sidebar (Ctrl+B)";
                clicked => {
                    root.hide();
                }
            }
            Text {
                horizontal-stretch: 1;
                text: "Harbor";
                font-size: 16px;
                font-weight: 600;
                letter-spacing: -0.32px;
                color: Theme.fg;
                vertical-alignment: center;
            }
            Btn {
                icon: Icons.refresh;
                size: icon-xs;
                variant: ghost-muted;
                tip: "Refresh providers, projects and git";
                clicked => {
                    root.refresh();
                }
            }
            Btn {
                icon: Icons.search;
                size: icon-xs;
                variant: ghost-muted;
                tip: "Search everything (Ctrl+K)";
                clicked => {
                    root.palette();
                }
            }
        }
        Rectangle {
            height: 3px;
        }
        HorizontalLayout {
            height: 32px;
            spacing: 2px;
            search-field := SearchField {
                horizontal-stretch: 1;
                hint: "Search";
                edited(t) => {
                    root.searched(t);
                }
            }
            if root.workspaces: Btn {
                y: (parent.height - self.height) / 2;
                icon: Icons.users;
                size: icon-xs;
                variant: ghost-muted;
                pressed: root.pop-id == "workspace" || root.ws-on;
                tip: root.ws-tip;
                clicked => {
                    root.ws-filter(self.absolute-position.x, self.absolute-position.y + self.height);
                }
            }
            filter-btn := Btn {
                y: (parent.height - self.height) / 2;
                icon: Icons.filter;
                size: icon-xs;
                variant: ghost-muted;
                pressed: root.pop-id == "filter";
                tip: "Order and view";
                clicked => {
                    root.filter(self.absolute-position.x, self.absolute-position.y + self.height);
                }
            }
            Btn {
                y: (parent.height - self.height) / 2;
                icon: Icons.folder-plus;
                size: icon-xs;
                variant: ghost-muted;
                tip: "Add project";
                clicked => {
                    root.add-project();
                }
            }
            Btn {
                y: (parent.height - self.height) / 2;
                icon: Icons.compose;
                size: icon-xs;
                variant: ghost-muted;
                tip: "New thread (Ctrl+N)";
                clicked => {
                    root.new-thread();
                }
            }
        }
        Rectangle {
            height: 7px;
        }
        // The wheel scrolls it; a drag doesn't, so a chat row can be dragged out to the centre (split panes).
        list := Flickable {
            interactive: false;
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: 2px;
                if root.empty-kind != "": VerticalLayout {
                    padding-top: 24px;
                    Empty {
                        icon: root.empty-kind == "search" ? Icons.search : root.empty-kind == "ws" ? Icons.users : Icons.folder-plus;
                        title: root.empty-kind == "search" ? "No match" : root.empty-kind == "ws" ? "Nothing here" : "No projects yet";
                        desc: root.empty-desc;
                        action: root.empty-kind == "search" ? "" : root.empty-kind == "ws" ? "Show all" : "Add project";
                        act => {
                            if root.empty-kind == "ws" {
                                root.ws-all();
                            } else {
                                root.add-project();
                            }
                        }
                    }
                }
                for r in root.rows: VerticalLayout {
                    property <bool> revealed: root.reveal == r.kind + ":" + r.id;
                    changed revealed => {
                        if self.revealed {
                            list.viewport-y = max(min(list.viewport-y, list.height - self.y - self.height), -self.y);
                        }
                    }
                    if r.kind == "project": VerticalLayout {
                        padding-bottom: 2px;
                        ProjectRow {
                            data: r;
                            grip: root.can-drag;
                            drag-id: root.drag-id;
                            drag-y: root.drag-y;
                            drag(y) => {
                                root.drag-id = r.id;
                                root.drag-y = y;
                            }
                            dropped => {
                                if root.drop-id >= 0 {
                                    root.reorder(r.id, root.drop-id, root.drop-above);
                                }
                                root.drag-id = -1;
                                root.drop-id = -1;
                            }
                            changed under => {
                                if self.under {
                                    root.drop-id = r.id;
                                    root.drop-above = self.above;
                                } else if root.drop-id == r.id {
                                    root.drop-id = -1;
                                }
                            }
                            changed above => {
                                if self.under {
                                    root.drop-above = self.above;
                                }
                            }
                            open => {
                                root.open-project(r.id);
                            }
                            fold => {
                                root.fold-project(r.id);
                            }
                            new-chat => {
                                root.new-chat(r.id);
                            }
                            snooze(x, y) => {
                                root.snooze("r" + r.id, x, y);
                            }
                            menu(x, y) => {
                                root.project-menu(r.id, x, y);
                            }
                        }
                    }
                    if r.kind == "thread" || r.kind == "loose": ThreadRow {
                        data: r;
                        open => {
                            root.open-chat(r.id);
                        }
                        drag(x, y) => {
                            root.chat-drag(r, x, y);
                        }
                        dropped(x, y) => {
                            root.chat-drop(r, x, y);
                        }
                        settle(on) => {
                            root.settle(r.id, on);
                        }
                        snooze(x, y) => {
                            root.snooze("c" + r.id, x, y);
                        }
                        menu(x, y) => {
                            root.chat-menu(r.id, x, y);
                        }
                    }
                    // "PROJECTS", "THREADS": a section's small head.
                    if r.kind == "label": VerticalLayout {
                        padding-top: r.id == 1 ? 2px : 10px;
                        padding-bottom: 2px;
                        Text {
                            x: 6px;
                            height: 18px;
                            text: r.title;
                            font-size: 11px;
                            font-weight: 500;
                            letter-spacing: 0.6px;
                            color: Theme.gray-800;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        // "Settled (N)", a hairline to the edge and the fold's chevron: up while open, down while folded.
        if root.settled-count > 0: Rectangle {
            height: Theme.row-h;
            property <color> ink: settled-area.has-hover ? Theme.fg.mix(Theme.gray-700, 0.5) : Theme.gray-700;
            settled-label := Text {
                x: 8px;
                text: "Settled (" + root.settled-count + ")";
                font-size: 12px;
                font-weight: 500;
                color: parent.ink;
                vertical-alignment: center;
            }
            Rectangle {
                x: settled-label.x + settled-label.preferred-width + 10px;
                width: max(0px, parent.width - self.x - 34px);
                height: 1px;
                background: settled-area.has-hover ? Theme.gray-600 : Theme.gray-500;
            }
            Glyph {
                x: parent.width - 21px;
                width: 14px;
                icon: root.settled-open ? Icons.up : Icons.down;
                size: 12px;
                color: parent.ink;
            }
            settled-area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.settled-open = !root.settled-open;
                }
            }
        }
        if root.settled-count > 0 && root.settled-open: settled-list := Flickable {
            interactive: false;
            height: min(root.settled-count * 46px, 230px);
            VerticalLayout {
                alignment: start;
                spacing: 2px;
                for r in root.settled: ThreadRow {
                    data: r;
                    property <bool> revealed: root.reveal == r.kind + ":" + r.id;
                    changed revealed => {
                        if self.revealed {
                            settled-list.viewport-y = max(min(settled-list.viewport-y, settled-list.height - self.y - self.height), -self.y);
                        }
                    }
                    open => {
                        if r.kind == "settled-project" {
                            root.open-project(r.id);
                        } else {
                            root.open-chat(r.id);
                        }
                    }
                    drag(x, y) => {
                        if r.kind != "settled-project" {
                            root.chat-drag(r, x, y);
                        }
                    }
                    dropped(x, y) => {
                        if r.kind != "settled-project" {
                            root.chat-drop(r, x, y);
                        }
                    }
                    settle(on) => {
                        if r.kind == "settled-project" {
                            root.settle-project(r.id, on);
                        } else {
                            root.settle(r.id, on);
                        }
                    }
                    menu(x, y) => {
                        if r.kind == "settled-project" {
                            root.project-menu(r.id, x, y);
                        } else {
                            root.chat-menu(r.id, x, y);
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            height: 46px;
            padding-top: 9px;
            padding-bottom: 3px;
            spacing: 4px;
            if root.pages-back: Btn {
                icon: Icons.arrow-left;
                text: "Back";
                size: xs;
                variant: ghost-muted;
                tip: "Back (Esc)";
                clicked => {
                    root.back();
                }
            }
            if !root.pages-back: MeBtn {
                photo: root.me-photo;
                has-photo: root.me-has-photo;
                letter: root.me-letter;
                clicked => {
                    root.settings();
                }
            }
            // Apart from your photo, so a click meant for one never lands on the other.
            Rectangle {
                width: 4px;
            }
            // Centred on your photo, which is taller than the rest of the row.
            VerticalLayout {
                alignment: center;
                ThemeBtn {
                    toggled => {
                        root.toggle-theme();
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if root.mem != "": VerticalLayout {
                alignment: center;
                MemGauge {
                    text: root.mem;
                    frac: root.mem-frac;
                    low: root.mem-low;
                    open: root.pop-id == "mem-devices";
                    tip: root.mem-tip;
                    clicked => {
                        root.mem-pop(self.absolute-position.x, self.absolute-position.y);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    icon: Icons.gauge;
                    size: icon-xs;
                    variant: ghost-muted;
                    pressed: root.pop-id == "usage";
                    tip: "Claude usage";
                    clicked => {
                        root.usage(self.absolute-position.x, self.absolute-position.y);
                    }
                }
            }
        }
    }
}
