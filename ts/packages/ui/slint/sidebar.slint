import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Btn, Glyph, Spinner, StatusData, StatusView, SearchField, Empty, TipArea, ScrollThumb } from "widgets.slint";
// Hub's design system (DESIGN.md): the sidebar frame, its header, section heads, the lead square and the Settled fold are
// the shared ones Persons and Routine use too.
import { Ds } from "ds-tokens.slint";
import { SectionHead, FoldBar } from "ds-list.slint";
import { SideSurface, SideHead } from "ds-surface.slint";
import { MemGauge } from "memory.slint";

export struct SideRow {
    kind: string,
    id: int,
    title: string,
    active: bool,
    status: StatusData,
    letter: string,
    avatar: image,
    has-avatar: bool,
    settled: bool,
    snoozed: bool,
    worktree: string,
    worktree-tip: string,
    pr: string,
    pr-tip: string,
    tip: string,
    // A project row's hint after its name: the PC that holds its folder when it isn't here.
    place: string,
    // `place` names a PC (else it's this PC's folder, for two projects with one name).
    place-pc: bool,
    // Share with workspace…: "" not shared, "shared", "here" (shown only because it's shared with a picked workspace).
    shared: string,
    shared-tip: string,
    // A project row's fold: "" no chats under it, "open", "folded".
    fold: string,
    // A chat row's last activity ("13m ago"), on its right while nothing else is to say.
    ago: string,
    // The branch it works on (its worktree's, else its project's checkout's; no "harbor/"), on a line under the title.
    branch: string,
    // The last chat under its project: the guide line ends with it.
    last: bool,
    // Someone else's chat: their initials ("" yours), name and photo.
    owner: string,
    owner-tip: string,
    owner-photo: image,
    has-owner-photo: bool,
    // Open in a split pane, and that pane has the keyboard.
    pane: bool,
    pane-focus: bool,
    // The chat a drag of the row carries to the centre (split panes): a chat row's own, a project row's main
    // chat; -1 none, and the row doesn't start that drag.
    chat: int,
}

// A chat's status before its title: the spinner while it works (grey while it syncs), amber while it waits or is
// limited, blue while unread, red when its turn failed.
component LeadMark {
    in property <StatusData> status;
    width: 12px;
    if root.status.kind == "working": Spinner {
        radius: 5px;
        color: Theme.blue-900;
    }
    // Syncing (its newest version on its way, or handed on): a grey spinner; changes to it wait.
    if root.status.kind == "syncing": Spinner {
        radius: 5px;
        color: Theme.subtle;
    }
    if root.status.kind == "waiting" || root.status.kind == "limited": Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.amber-700;
    }
    if root.status.kind == "done": Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.blue-700;
    }
    if root.status.kind == "failed": Glyph {
        icon: Icons.circle-x;
        size: 12px;
        color: Theme.red-900;
    }
}

// What a chat row says on its right: Working, Syncing, Waiting, Limited or Failed in their colours; a snooze's clock or another
// mark as the status says it; else when it was last active ("13m ago").
component RowStatus {
    in property <StatusData> status;
    in property <string> ago;
    property <bool> word: status.kind == "working" || status.kind == "waiting" || status.kind == "limited" || status.kind == "failed" || status.kind == "syncing";
    property <bool> mark: status.kind == "text" && (status.icon != "" || status.text == "●");
    width: self.preferred-width;
    HorizontalLayout {
        alignment: end;
        if root.word: Text {
            text: root.status.kind == "working" ? "Working" : root.status.kind == "syncing" ? "Syncing" : root.status.kind == "waiting" ? (root.status.text == "" ? "Waiting" : root.status.text) : root.status.kind == "limited" ? "Limited" : "Failed";
            font-size: 12.5px;
            color: root.status.kind == "working" ? Theme.blue-900 : root.status.kind == "syncing" ? Theme.subtle : root.status.kind == "failed" ? Theme.red-900 : Theme.amber-900;
            vertical-alignment: center;
        }
        if root.mark: StatusView {
            status: root.status;
        }
        if !root.word && !root.mark: Text {
            text: root.ago;
            font-size: 12.5px;
            color: Theme.gray-800;
            vertical-alignment: center;
        }
    }
}

// The branch a chat works on: the branch glyph and its name, small and dim (red when its worktree is gone).
component BranchLabel inherits HorizontalLayout {
    in property <string> branch;
    in property <bool> gone;
    spacing: 3px;
    Glyph {
        width: 11px;
        icon: Icons.branch;
        size: 11px;
        color: root.gone ? Theme.red-900 : Theme.gray-800;
    }
    Text {
        text: root.branch;
        font-family: "Geist Mono";
        font-size: 11.5px;
        color: root.gone ? Theme.red-900 : Theme.gray-800;
        overflow: elide;
        vertical-alignment: center;
    }
}

// Someone else's chat: their round photo, else their initials.
component OwnerMark inherits TipArea {
    in property <string> letters;
    in property <image> photo;
    in property <bool> has-photo;
    width: 16px;
    height: 16px;
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.gray-400;
        clip: true;
        if root.has-photo: Image {
            width: 16px;
            height: 16px;
            source: root.photo;
            image-fit: cover;
        }
        if !root.has-photo: Text {
            text: root.letters;
            font-size: 7.5px;
            font-weight: 600;
            color: Theme.fg;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Share with workspace…'s mark: a link glyph, blue when the filter shows the row only because it's shared.
component SharedMark inherits TipArea {
    in property <string> kind;
    in property <bool> active;
    width: 16px;
    Glyph {
        icon: Icons.link;
        size: 12px;
        color: root.kind == "here" ? Theme.blue-900 : root.active ? Theme.fg : Theme.subtle;
    }
}

component ThreadRow {
    in property <SideRow> data;
    callback open();
    // Dragged past egui's click distance (window coordinates), and let go: a chat dropped on the centre splits it.
    callback drag(length, length);
    callback dropped(length, length);
    property <bool> far;
    // The left button is down on this row (only it drags).
    property <bool> left-held;
    callback settle(bool);
    // Under the clock button, in window coordinates.
    callback snooze(length, length);
    // At the pointer, in window coordinates.
    callback menu(length, length);
    // The marks after the title count too: they sit over `area`, and without them pointing at one
    // drops the hover, the title widens, the mark slides off the pointer, the hover comes back and
    // the title narrows under it again, over and over.
    property <bool> hovering: area.has-hover || worktree.has-hover || pr.has-hover || shared.has-hover || owner.has-hover || settle-btn.hovered || snooze-btn.hovered;
    // A chat keeps its chat glyph in the lead column (as a person's avatar in Persons) until it has a status to show there.
    property <bool> lead-status: data.status.kind == "working" || data.status.kind == "syncing" || data.status.kind == "waiting" || data.status.kind == "limited" || data.status.kind == "done" || data.status.kind == "failed";
    // The branch it works on, on a second line under the title.
    property <bool> two-lines: data.branch != "";
    // The hover buttons' width: the clock and Settle, icons only.
    property <length> act-w: root.data.settled ? 28px : 56px;
    // The worktree glyph stands in for a branch that isn't known.
    property <bool> wt-glyph: data.worktree != "" && data.branch == "";
    height: two-lines ? 46px : Theme.row-h;
    // Persons' row metrics (ds-list.slint ListRow): no indent under its project's head, the lead mark in the 16px
    // column at 8, the title at 32, the second line under it.
    Rectangle {
        x: 0px;
        width: parent.width - self.x;
        background: root.data.active || root.hovering ? Theme.accent : transparent;
        border-radius: Theme.radius-md;
        area := TouchArea {
            mouse-cursor: root.far ? MouseCursor.grabbing : MouseCursor.pointer;
            clicked => {
                if !root.far {
                    root.open();
                }
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                    root.far = false;
                    root.left-held = false;
                    root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    root.far = false;
                    root.left-held = true;
                }
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    root.left-held = false;
                    if root.far {
                        root.dropped(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
            moved => {
                // Only the left button drags: a right press that moves (into its menu) isn't a drag.
                root.far = root.left-held && (root.far || abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px);
                if root.far {
                    root.drag(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
        // The title's line: the whole row, or its top with the branch under it.
        property <length> line-y: root.two-lines ? 4px : 0px;
        property <length> line-h: root.two-lines ? 22px : Theme.row-h;
        if root.lead-status: LeadMark {
            x: 10px;
            y: parent.line-y;
            height: parent.line-h;
            status: root.data.status;
        }
        if !root.lead-status: Glyph {
            x: 8px;
            y: parent.line-y;
            width: 16px;
            height: parent.line-h;
            icon: root.data.kind == "settled-project" ? Icons.folder : Icons.message;
            size: 14px;
            color: root.data.active ? Theme.fg : Theme.subtle;
        }
        // The title, then its marks: the PR, the share mark. Hovered, the last mark keeps 30px (glyph to glyph) before
        // the clock, as the clock does before Settle.
        // Hovered, nothing moves: the clock and Settle sit over the title's end, which fades out under them.
        property <length> pane-w: root.data.pane ? 21px : 0px;
        property <length> right-w: status.width + 16px + (root.data.owner != "" ? 22px : 0px) + self.pane-w;
        property <length> marks-w: (root.wt-glyph ? 20px : 0px) + (root.data.pr != "" ? 20px : 0px) + (root.data.shared != "" ? 20px : 0px) + (root.data.place != "" ? place.width + 6px : 0px);
        property <length> room: self.width - title.x - self.right-w - self.marks-w;
        title := Text {
            x: 32px;
            y: parent.line-y;
            height: parent.line-h;
            width: min(self.preferred-width, max(parent.room, 10px));
            text: root.data.title;
            font-size: 14px;
            // As a person's row: unread (done) 600, open 500.
            font-weight: root.data.status.kind == "done" ? 600 : root.data.active ? 500 : 400;
            // Snoozed: it stays in its place, muted, its status saying when it wakes.
            color: root.data.snoozed ? Theme.gray-800 : Theme.fg;
            overflow: elide;
            vertical-alignment: center;
        }
        // Under the title, from where it starts, as far as the row goes.
        if root.two-lines: BranchLabel {
            x: title.x;
            y: parent.line-y + parent.line-h;
            height: 16px;
            width: parent.width - title.x - 10px;
            branch: root.data.branch;
            gone: root.data.worktree == "gone";
        }
        property <length> marks-x: title.x + title.width + 5px;
        // A settled project's PC, when its folder isn't here (the project row's hint).
        place := HorizontalLayout {
            visible: root.data.place != "";
            x: parent.marks-x + 1px;
            y: parent.line-y;
            height: parent.line-h;
            width: root.data.place != "" ? min(self.preferred-width, 106px) : 0px;
            spacing: 3px;
            Glyph {
                width: 12px;
                icon: root.data.place-pc ? Icons.monitor : Icons.folder;
                size: 12px;
                color: Theme.subtle;
            }
            Text {
                text: root.data.place;
                font-size: 12px;
                color: Theme.subtle;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        worktree := TipArea {
            visible: root.wt-glyph;
            x: parent.marks-x;
            y: parent.line-y;
            height: parent.line-h;
            width: 16px;
            tip: root.data.worktree-tip;
            Glyph {
                icon: Icons.folder-git;
                size: 13px;
                color: root.data.worktree == "gone" ? Theme.red-900 : root.data.active ? Theme.fg : Theme.subtle;
            }
        }
        pr := TipArea {
            visible: root.data.pr != "";
            x: parent.marks-x + (root.wt-glyph ? 20px : 0px);
            y: parent.line-y;
            height: parent.line-h;
            width: 16px;
            tip: root.data.pr-tip;
            Glyph {
                icon: root.data.pr == "merged" ? Icons.git-merge : root.data.pr == "draft" ? Icons.pr-draft : root.data.pr == "closed" ? Icons.pr-closed : Icons.pr-open;
                size: 13px;
                color: root.data.pr == "open" ? Theme.green-900 : root.data.pr == "draft" ? Theme.gray-800 : root.data.pr == "closed" ? Theme.red-900 : Theme.dark ? #c4b5fd : #7c3aed;
            }
        }
        shared := SharedMark {
            visible: root.data.shared != "";
            x: parent.marks-x + (root.wt-glyph ? 20px : 0px) + (root.data.pr != "" ? 20px : 0px);
            y: parent.line-y;
            height: parent.line-h;
            kind: root.data.shared;
            active: root.data.active;
            tip: root.data.shared-tip;
        }
        // Open in a split pane: a small two-column mark, quiet; a little brighter while that pane has the keyboard.
        if root.data.pane && !root.hovering: Rectangle {
            property <color> ink: root.data.pane-focus ? Theme.fg.mix(Theme.subtle, 0.6) : Theme.gray-700;
            x: parent.width - parent.right-w + 6px;
            y: parent.line-y + (parent.line-h - self.height) / 2;
            width: 13px;
            height: 11px;
            border-radius: 2px;
            border-width: 1.2px;
            border-color: self.ink;
            Rectangle {
                x: (parent.width - 1.2px) / 2;
                width: 1.2px;
                background: parent.ink;
            }
        }
        owner := OwnerMark {
            visible: root.data.owner != "" && !root.hovering;
            x: parent.width - parent.right-w + 6px + parent.pane-w;
            y: parent.line-y + (parent.line-h - self.height) / 2;
            letters: root.data.owner;
            photo: root.data.owner-photo;
            has-photo: root.data.has-owner-photo;
            tip: root.data.owner-tip;
        }
        status := RowStatus {
            visible: !root.hovering;
            x: parent.width - 8px - self.width;
            y: parent.line-y;
            height: parent.line-h;
            status: root.data.status;
            ago: root.data.ago;
        }
        // The title's end fades out under the buttons, on its line only.
        if root.hovering: Rectangle {
            x: actions.x - 30px;
            y: parent.line-y;
            width: parent.width - self.x;
            height: parent.line-h;
            background: @linear-gradient(90deg, Theme.accent.transparentize(1) 0%, Theme.accent 45%, Theme.accent 100%);
        }
        actions := HorizontalLayout {
            visible: root.hovering;
            // On the title's line, centred on it as the title is.
            x: parent.width - 4px - root.act-w;
            y: parent.line-y + (parent.line-h - 28px) / 2;
            height: 28px;
            width: root.act-w;
            spacing: 0px;
            snooze-btn := Btn {
                visible: !root.data.settled;
                width: root.data.settled ? 0px : 28px;
                icon: Icons.clock;
                size: icon-xs;
                variant: ghost-muted;
                pressed: root.data.snoozed;
                tip: "Snooze";
                clicked => {
                    root.snooze(self.absolute-position.x, self.absolute-position.y + self.height);
                }
            }
            settle-btn := Btn {
                width: 28px;
                icon: root.data.settled ? Icons.unarchive : Icons.check;
                tip: root.data.settled ? "Unsettle" : "Settle";
                size: icon-xs;
                variant: ghost-muted;
                clicked => {
                    root.settle(!root.data.settled);
                }
            }
        }
    }
}

// A project: a section head as Persons' (ds-list.slint SectionHead): its name in caps, the fold's chevron after it, the
// row's hover fill, its status on the right and, hovered, Snooze and + (a new chat in it). A click opens its main chat;
// a right click its menu. Dragged, it reorders the projects (while the order is yours); dragged out of the sidebar it
// is its main chat's drag (a chat dropped on the centre splits it). A real icon (favicon, emoji) stays, small, before
// the name, else a neutral folder glyph there; the letter square doesn't (Persons' heads have none).
component ProjectHead {
    in property <SideRow> data;
    in property <bool> first;
    callback open();
    callback fold();
    callback new-chat();
    callback snooze(length, length);
    callback menu(length, length);
    in property <bool> grip;
    // The project dragged across the sidebar (-1: none) and the pointer's window y.
    in property <int> drag-id: -1;
    in property <length> drag-y;
    callback drag(length);
    callback dropped();
    callback chat-drag(length, length);
    callback chat-drop(length, length);
    // This drag carries its main chat (it left the sidebar, or the order isn't yours).
    property <bool> chat-mode;
    property <bool> pointed: drag-y >= self.absolute-position.y && drag-y < self.absolute-position.y + self.height;
    out property <bool> under: drag-id >= 0 && drag-id != data.id && pointed;
    out property <bool> above: drag-y < self.absolute-position.y + self.height / 2;
    height: head.height;
    head := SectionHead {
        width: root.width;
        title: root.data.title.to-uppercase();
        first: root.first;
        fold: root.data.fold;
        opens: true;
        active: root.data.active || root.under;
        dim: root.data.snoozed;
        icon: root.data.avatar;
        has-icon: root.data.has-avatar;
        // no favicon or emoji: a neutral folder in the same slot, so every project's name starts at the same x
        glyph: Icons.folder;
        tip: root.data.tip != "" ? root.data.tip : root.data.title;
        draggable: root.grip || root.data.chat >= 0;
        plus-tip: "New chat in this project";
        plus-on-hover: true;
        keep-hover: snooze.hovered || shared.has-hover;
        clicked => {
            root.open();
        }
        toggled => {
            root.fold();
        }
        plus => {
            root.new-chat();
        }
        menu(x, y) => {
            root.chat-mode = false;
            root.menu(x, y);
        }
        drag(x, y) => {
            if root.data.chat >= 0 && (root.chat-mode || !root.grip || x > root.absolute-position.x + root.width + 12px) {
                root.chat-mode = true;
                root.chat-drag(x, y);
            } else {
                root.drag(y);
            }
        }
        dropped(x, y) => {
            if root.chat-mode {
                root.chat-mode = false;
                root.chat-drop(x, y);
            } else {
                root.dropped();
            }
        }
        // The project's PC when its folder isn't here, then the share mark and the status; hovered, Snooze (and the +).
        if root.data.place != "" && !head.hovered: HorizontalLayout {
            max-width: 96px;
            spacing: 3px;
            Glyph {
                width: 12px;
                icon: root.data.place-pc ? Icons.monitor : Icons.folder;
                size: 12px;
                color: Theme.subtle;
            }
            Text {
                text: root.data.place;
                font-size: 12px;
                color: Theme.subtle;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        shared := SharedMark {
            visible: root.data.shared != "";
            width: root.data.shared != "" ? 16px : 0px;
            kind: root.data.shared;
            active: root.data.active;
            tip: root.data.shared-tip;
        }
        status := StatusView {
            visible: !head.hovered;
            width: head.hovered ? 0px : self.preferred-width;
            status: root.data.status;
        }
        snooze := Btn {
            visible: head.hovered;
            width: head.hovered ? 22px : 0px;
            height: 22px;
            icon: Icons.clock;
            size: icon-xs;
            variant: ghost-muted;
            pressed: root.data.snoozed;
            tip: "Snooze";
            clicked => {
                root.snooze(self.absolute-position.x, self.absolute-position.y + self.height);
            }
        }
    }
    // A project dragged over it: the drop line above or under its head.
    if root.under: Rectangle {
        y: root.above ? head.y + (root.first ? 0px : 8px) - 2px : root.height;
        height: 2px;
        background: Theme.gray-1000;
    }
}

// The bottom bar's light/dark button, beside your photo: one round button, a sun in dark (to light) and a moon in light
// (to dark); a click flips the theme at once.
component ThemeBtn {
    callback toggled;
    width: 28px;
    height: 28px;
    Rectangle {
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: area.has-hover ? Theme.gray-300 : Theme.gray-200;
        border-width: 1px;
        border-color: Theme.border;
        Glyph {
            width: parent.width;
            height: parent.height;
            icon: Theme.dark ? Icons.sun : Icons.moon;
            size: 13px;
            color: Theme.fg;
        }
    }
    area := TipArea {
        tip: Theme.dark ? "Light theme" : "Dark theme";
        clicked => {
            root.toggled();
        }
    }
}

// The bottom bar's first button: your round photo (or initial; the gear when signed out), opening Settings.
component MeBtn {
    in property <image> photo;
    in property <bool> has-photo;
    in property <string> letter;
    callback clicked;
    width: 34px;
    height: 34px;
    // A ring around you, so your photo stands out in the bar.
    Rectangle {
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: area.has-hover ? Theme.accent : transparent;
        border-width: root.has-photo || root.letter != "" ? 2px : 0px;
        border-color: area.has-hover ? Theme.fg : Theme.border;
    }
    if root.has-photo: Image {
        width: 28px;
        height: 28px;
        source: root.photo;
    }
    if !root.has-photo && root.letter != "": Rectangle {
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: #7a6ad8;
        Text {
            text: root.letter;
            font-size: 14px;
            font-weight: 600;
            color: white;
        }
    }
    if !root.has-photo && root.letter == "": Glyph {
        icon: Icons.settings;
        size: 14px;
        color: area.has-hover ? Theme.fg : Theme.subtle;
    }
    area := TipArea {
        tip: "Settings (Ctrl+,)";
        clicked => {
            root.clicked();
        }
    }
}

export component Sidebar inherits SideSurface {
    in property <[SideRow]> rows;
    in property <[SideRow]> settled;
    in property <int> settled-count;
    in-out property <bool> settled-open;
    in-out property <string> search <=> search-field.text;
    in property <string> empty-kind;
    in property <string> empty-desc;
    in property <bool> workspaces;
    in property <bool> ws-on;
    in property <string> ws-tip;
    in property <string> pop-id;
    in property <bool> pages-back;
    // The row Alt+Up / Alt+Down opened ("kind:id"): scrolled into view.
    in property <string> reveal;
    in-out property <length> scroll-y <=> list.content-y;
    callback open-chat(int);
    callback open-project(int);
    callback fold-project(int);
    callback new-chat(int);
    callback new-thread();
    callback add-project();
    callback settle(int, bool);
    callback settle-project(int, bool);
    callback snooze(string, length, length);
    callback chat-menu(int, length, length);
    callback project-menu(int, length, length);
    callback searched(string);
    callback hide();
    callback palette();
    // The bottom bar's light/dark button, beside your photo: flips at once (kv `theme`; Settings has no Appearance).
    callback toggle-theme();
    // You, in the bottom bar's first place (opens Settings): your photo, else your initial; neither (signed out): the gear.
    in property <image> me-photo;
    in property <bool> me-has-photo;
    in property <string> me-letter;
    callback filter(length, length);
    // Over the gauge, in window coordinates.
    callback usage(length, length);
    // This PC's memory ("" hides the gauge): figure, share used, low on memory, tooltip.
    in property <string> mem;
    in property <float> mem-frac;
    in property <bool> mem-low;
    in property <string> mem-tip;
    // Over the memory gauge, in window coordinates.
    callback mem-pop(length, length);
    callback ws-filter(length, length);
    callback ws-all();
    in property <bool> can-drag;
    callback reorder(int, int, bool);
    // A chat row dragged (its row, the pointer in window coordinates) and let go: the centre's split panes. A project
    // row dragged by its name comes here too, for its main chat (`SideRow.chat`, which app.slint drags).
    callback chat-drag(SideRow, length, length);
    callback chat-drop(SideRow, length, length);
    in-out property <int> drag-id: -1;
    in-out property <length> drag-y;
    property <int> drop-id: -1;
    property <bool> drop-above;
    callback settings();
    callback back();
    callback refresh();
    VerticalLayout {
        padding: 11px;
        padding-top: 13px;
        spacing: 2px;
        SideHead {
            hide => {
                root.hide();
            }
            Btn {
                icon: Icons.refresh;
                size: icon-xs;
                variant: ghost-muted;
                tip: "Refresh providers, projects and git";
                clicked => {
                    root.refresh();
                }
            }
            Btn {
                icon: Icons.search;
                size: icon-xs;
                variant: ghost-muted;
                tip: "Search everything (Ctrl+K)";
                clicked => {
                    root.palette();
                }
            }
        }
        Rectangle {
            height: 3px;
        }
        HorizontalLayout {
            height: 32px;
            spacing: 2px;
            search-field := SearchField {
                horizontal-stretch: 1;
                hint: "Search";
                edited(t) => {
                    root.searched(t);
                }
            }
            if root.workspaces: Btn {
                y: (parent.height - self.height) / 2;
                icon: Icons.users;
                size: icon-xs;
                variant: ghost-muted;
                pressed: root.pop-id == "workspace" || root.ws-on;
                tip: root.ws-tip;
                clicked => {
                    root.ws-filter(self.absolute-position.x, self.absolute-position.y + self.height);
                }
            }
            filter-btn := Btn {
                y: (parent.height - self.height) / 2;
                icon: Icons.filter;
                size: icon-xs;
                variant: ghost-muted;
                pressed: root.pop-id == "filter";
                tip: "Order and view";
                clicked => {
                    root.filter(self.absolute-position.x, self.absolute-position.y + self.height);
                }
            }
            Btn {
                y: (parent.height - self.height) / 2;
                icon: Icons.folder-plus;
                size: icon-xs;
                variant: ghost-muted;
                tip: "Add project";
                clicked => {
                    root.add-project();
                }
            }
            Btn {
                y: (parent.height - self.height) / 2;
                icon: Icons.compose;
                size: icon-xs;
                variant: ghost-muted;
                tip: "New thread (Ctrl+N)";
                clicked => {
                    root.new-thread();
                }
            }
        }
        Rectangle {
            height: 7px;
        }
        // The wheel scrolls it; a drag doesn't, so a chat row can be dragged out to the centre (split panes).
        // Kept in range when its rows or its height change (a search, a fold, settled chats, a restored
        // scroll): Slint doesn't, and ignores the wheel once the rows fit, so a list scrolled a little and then
        // shortened stayed scrolled for good, "PROJECTS" half under the search row.
        Rectangle {
            vertical-stretch: 1;
            list := Flickable {
                width: parent.width;
                height: parent.height;
                interactive: false;
                function keep-in() {
                    self.content-y = max(min(self.content-y, 0), min(0, self.height - self.content-height));
                }
                changed content-height => {
                    self.keep-in();
                }
                changed height => {
                    self.keep-in();
                }
                changed content-y => {
                    self.keep-in();
                }
                VerticalLayout {
                    alignment: start;
                    spacing: 2px;
                    if root.empty-kind != "": VerticalLayout {
                        padding-top: 24px;
                        Empty {
                            icon: root.empty-kind == "search" ? Icons.search : root.empty-kind == "ws" ? Icons.users : Icons.folder-plus;
                            title: root.empty-kind == "search" ? "No match" : root.empty-kind == "ws" ? "Nothing here" : "No projects yet";
                            desc: root.empty-desc;
                            action: root.empty-kind == "search" ? "" : root.empty-kind == "ws" ? "Show all" : "Add project";
                            act => {
                                if root.empty-kind == "ws" {
                                    root.ws-all();
                                } else {
                                    root.add-project();
                                }
                            }
                        }
                    }
                    for r[i] in root.rows: VerticalLayout {
                        property <bool> revealed: root.reveal == r.kind + ":" + r.id;
                        changed revealed => {
                            if self.revealed {
                                list.content-y = max(min(list.content-y, list.height - self.y - self.height), -self.y);
                            }
                        }
                        if r.kind == "project": ProjectHead {
                            data: r;
                            first: i == 0;
                            grip: root.can-drag;
                            drag-id: root.drag-id;
                            drag-y: root.drag-y;
                            drag(y) => {
                                root.drag-id = r.id;
                                root.drag-y = y;
                            }
                            dropped => {
                                if root.drop-id >= 0 {
                                    root.reorder(r.id, root.drop-id, root.drop-above);
                                }
                                root.drag-id = -1;
                                root.drop-id = -1;
                            }
                            changed under => {
                                if self.under {
                                    root.drop-id = r.id;
                                    root.drop-above = self.above;
                                } else if root.drop-id == r.id {
                                    root.drop-id = -1;
                                }
                            }
                            changed above => {
                                if self.under {
                                    root.drop-above = self.above;
                                }
                            }
                            chat-drag(x, y) => {
                                // Out of the sidebar: no reorder is under way any more.
                                root.drag-id = -1;
                                root.drop-id = -1;
                                root.chat-drag(r, x, y);
                            }
                            chat-drop(x, y) => {
                                root.chat-drop(r, x, y);
                            }
                            open => {
                                root.open-project(r.id);
                            }
                            fold => {
                                root.fold-project(r.id);
                            }
                            new-chat => {
                                root.new-chat(r.id);
                            }
                            snooze(x, y) => {
                                root.snooze("r" + r.id, x, y);
                            }
                            menu(x, y) => {
                                root.project-menu(r.id, x, y);
                            }
                        }
                        if r.kind == "thread" || r.kind == "loose": ThreadRow {
                            data: r;
                            open => {
                                root.open-chat(r.id);
                            }
                            drag(x, y) => {
                                root.chat-drag(r, x, y);
                            }
                            dropped(x, y) => {
                                root.chat-drop(r, x, y);
                            }
                            settle(on) => {
                                root.settle(r.id, on);
                            }
                            snooze(x, y) => {
                                root.snooze("c" + r.id, x, y);
                            }
                            menu(x, y) => {
                                root.chat-menu(r.id, x, y);
                            }
                        }
                        // "THREADS": a section's small head (ds-list.slint SectionHead), as a project's.
                        if r.kind == "label": SectionHead {
                            title: r.title;
                            first: i == 0;
                        }
                    }
                }
            }
            ScrollThumb {
                x: parent.width - self.width + 8px;
                y: 0;
                height: parent.height;
                content-y: list.content-y;
                content-height: list.content-height;
                visible-height: list.height;
                scroll-to(v) => {
                    list.content-y = v;
                }
            }
        }
        // "Settled (N)", a hairline to the edge and the fold's chevron: up while open, down while folded.
        if root.settled-count > 0: FoldBar {
            label: "Settled (" + root.settled-count + ")";
            open: root.settled-open;
            toggled => {
                root.settled-open = !root.settled-open;
            }
        }
        if root.settled-count > 0 && root.settled-open: settled-list := Flickable {
            interactive: false;
            height: min(root.settled-count * 46px, 230px);
            // As the list above: in range when its rows change.
            function keep-in() {
                self.content-y = max(min(self.content-y, 0), min(0, self.height - self.content-height));
            }
            changed content-height => {
                self.keep-in();
            }
            changed height => {
                self.keep-in();
            }
            changed content-y => {
                self.keep-in();
            }
            VerticalLayout {
                alignment: start;
                spacing: 2px;
                for r in root.settled: ThreadRow {
                    data: r;
                    property <bool> revealed: root.reveal == r.kind + ":" + r.id;
                    changed revealed => {
                        if self.revealed {
                            settled-list.content-y = max(min(settled-list.content-y, settled-list.height - self.y - self.height), -self.y);
                        }
                    }
                    open => {
                        if r.kind == "settled-project" {
                            root.open-project(r.id);
                        } else {
                            root.open-chat(r.id);
                        }
                    }
                    drag(x, y) => {
                        if r.kind != "settled-project" {
                            root.chat-drag(r, x, y);
                        }
                    }
                    dropped(x, y) => {
                        if r.kind != "settled-project" {
                            root.chat-drop(r, x, y);
                        }
                    }
                    settle(on) => {
                        if r.kind == "settled-project" {
                            root.settle-project(r.id, on);
                        } else {
                            root.settle(r.id, on);
                        }
                    }
                    menu(x, y) => {
                        if r.kind == "settled-project" {
                            root.project-menu(r.id, x, y);
                        } else {
                            root.chat-menu(r.id, x, y);
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            height: 46px;
            padding-top: 9px;
            padding-bottom: 3px;
            spacing: 4px;
            if root.pages-back: Btn {
                icon: Icons.arrow-left;
                text: "Back";
                size: xs;
                variant: ghost-muted;
                tip: "Back (Esc)";
                clicked => {
                    root.back();
                }
            }
            if !root.pages-back: MeBtn {
                photo: root.me-photo;
                has-photo: root.me-has-photo;
                letter: root.me-letter;
                clicked => {
                    root.settings();
                }
            }
            // Apart from your photo, so a click meant for one never lands on the other.
            Rectangle {
                width: 4px;
            }
            // Centred on your photo, which is taller than the rest of the row.
            VerticalLayout {
                alignment: center;
                ThemeBtn {
                    toggled => {
                        root.toggle-theme();
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if root.mem != "": VerticalLayout {
                alignment: center;
                MemGauge {
                    text: root.mem;
                    frac: root.mem-frac;
                    low: root.mem-low;
                    open: root.pop-id == "mem-devices";
                    tip: root.mem-tip;
                    clicked => {
                        root.mem-pop(self.absolute-position.x, self.absolute-position.y);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    icon: Icons.gauge;
                    size: icon-xs;
                    variant: ghost-muted;
                    pressed: root.pop-id == "usage";
                    tip: "Claude usage";
                    clicked => {
                        root.usage(self.absolute-position.x, self.absolute-position.y);
                    }
                }
            }
        }
    }
}
