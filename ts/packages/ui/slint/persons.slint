// Persons tab (Person Hub, native): sidebar of sections (Stores, Creators, SpokPay) with their people, the list of
// everyone, a person's chat (Discord, Gmail, WhatsApp) with the Person AI's bubbles, and the person panel. Driven by
// packages/ui/src/tabs/persons/ui.ts through PersonsBus; data from the engine's v1/persons routes.
// Built on Hub's design system (ds.slint, DESIGN.md): rows, heads, panels, dialogs and menus are the shared ones.
import { Theme, Icons, Ds, Glyph, TipArea, Btn, Variant, BtnSize, Ui, Input, SearchField, Spinner, Empty, MenuItem, MenuLabel, MenuSeparator, ListRow, SectionHead, FoldBar, ListNote, Avatar, ChannelMark, StatusDot, SideSurface, SideHead, ShowSideBtn, PageBar, PanelSurface, PanelSection, DialogFrame, DialogActions, Field, FieldLabel, TextBox, MenuPanel, Toast, Chip, PillSwitch, Card, ComposeField, Scroll, ScrollThumb, PopoverFrame, CapsLabel } from "ds.slint";
import { MdBlock, MdBlockView } from "markdown.slint";
import { ListView } from "std-widgets.slint";
import { ImageTile } from "composer.slint";

export struct PRow {
    kind: string, // all | section | store | person | settled | empty | sr-head | sr-notice | sr-empty | sr | sr-gap
    id: string,
    section: string,
    store: string,
    name: string,
    initials: string,
    color: color,
    avatar: image,
    has-avatar: bool,
    presence: string, // online | idle | dnd | offline | ""
    status: string,
    tone: string, // green | yellow | red | muted
    channel: string, // discord | gmail | whatsapp | ""
    time: string,
    unread: int,
    typing: string, // typing | recording | ""
    owner: bool,
    active: bool,
    expanded: bool,
    count: int,
    depth: int,
    dim: bool,
    tip: string, // a site request: who spoke last
}

// One piece of the Person AI's answer: a markdown block (markdown.slint, as Projects' chat draws it) or a message it
// drafted for the person (a ```reply block: `draft`, its text in `text`).
export struct PPart {
    draft: bool,
    text: string,
    block: MdBlock,
    gap: length,
}

// A picture in a message's bubble at its place in the bubble's image box (img-w × img-h).
export struct PImg {
    image: image,
    x: length,
    y: length,
    w: length,
    h: length,
}

// An emoji drawn as a picture or a glyph: a Discord custom emoji inside a message's text (its gap's UTF-8 offsets
// `from`..`to` in the drawn text, emoji.ts inlineLayout), or one of a big emoji-only message's (`text`: a Unicode one).
export struct PEmoji {
    image: image,
    has-image: bool,
    custom: bool,
    text: string,
    name: string,
    from: int,
    to: int,
}

// The composer's emoji picker: a category tab, a grid row of emoji (with their names, the hover line).
export struct PEmojiCat { icon: string, label: string }
export struct PEmojiCell { e: string, name: string }
export struct PEmojiRow { cells: [PEmojiCell] }

export struct PMsg {
    kind: string, // msg | day | unread | subject | ai | out
    id: string,
    mine: bool,
    text: string,
    time: string,
    meta: string, // "edited", ticks
    reply: string,
    has-reply: bool,
    // Discord custom emoji inside `text` (drawn over their gaps) and, for a message of nothing but 1-3 emoji, those
    // emoji drawn big instead of the text.
    emojis: [PEmoji],
    jumbo: [PEmoji],
    images: [PImg],
    has-image: bool,
    img-w: length,
    img-h: length,
    files: string,
    first: bool,
    failed: bool,
    sending: bool,
    streaming: bool,
    // The Person AI's thread: its answers' parts (markdown blocks and ```reply drafts) and the user's questions.
    to-ai: bool,
    parts: [PPart],
    // A folded answer (its chevron; older answers start folded): the header, its first lines and its first draft.
    folded: bool,
    preview: string,
    draft: string,
    // A SpokPay site request card (kind "proposal": proposed from a message; "proposing": the agent drafting it).
    card-title: string,
    card-sub: string,
    card-state: string, // waiting | opening | opened | failed | drafting
    card-note: string,
    card-why: string,
    card-chat: bool,
    // The channel it came or went on (a mark by the time when the person has more than one chat).
    chan: string,
    chan-label: string,
    // A voice message or audio file, drawn as a player: its key, length (s), bars 0..1, played, transcript.
    has-audio: bool,
    a-key: string,
    a-dur: float,
    a-bars: [float],
    a-played: bool,
    a-voice: bool,
    a-transcript: string,
    a-transcribing: bool,
    a-hidden: bool, // its transcript folded away (show / hide)
}

// Someone to link with (the Link with… picker), or someone linked (the panel's LINKED).
export struct PPick { id: string, name: string, sub: string, initials: string, color: color, avatar: image, has-avatar: bool, on: bool }

export struct PMenu { id: string, label: string, icon: string, sub: string, hint: string, danger: bool, sep: bool, header: bool, disabled: bool, checked: bool, submenu: bool }

export struct PUpload { title: string, meta: string, url: string, thumb: image, has-thumb: bool }

export struct PSocial { platform: string, handle: string, url: string, uploads: [PUpload], note: string }

export struct PChip { id: string, label: string, on: bool, color: color }
/** Forward to Projects' picker: a group's heading ("head"), a project ("item") or "empty"; `hi` = the keyboard's row. */
export struct PFwdRow { kind: string, id: string, name: string, path: string, on: bool, dot: bool, hi: bool }

// A site request's pane (SpokPay's admin request page): a picture of the brief or a message at its drawn size, a fact
// row of the brief (two half ones side by side), and one line of the timeline (an event or a message).
// A picture going with the next message, shown over the composer as Projects' composer does (ImageTile).
export struct PAttach { name: string, thumb: image }
export struct PSrImg { image: image, w: length, h: length }
export struct PSrFact { a-label: string, a-text: string, b-label: string, b-text: string, two: bool }
export struct PSrItem {
    kind: string, // event | msg | ai (a turn with the Person AI: its note or answer, drawn as person chats draw it, in `ai`)
    id: string,
    mine: bool, // SpokPay's (right, dark bubble)
    head: string, // "Truth · 7 h ago" on a run's first message, else ""
    text: string,
    avatar: bool, // the run's last message carries the avatar
    joins-prev: bool,
    joins-next: bool,
    images: [PSrImg],
    files: [string],
    ai: PMsg,
}

export global PersonsBus {
    in-out property <bool> ready;
    // sidebar
    in property <[PRow]> side;
    in property <int> unread-total;
    in property <string> note; // a quiet line under the sidebar (offline, errors)
    // main: "list" (All people), "chat" (a person open), "loading"
    in property <string> view: "loading";
    in property <string> list-title: "All people";
    in property <string> list-sub;
    in property <[PRow]> list;
    in-out property <string> query;
    // The sidebar's search button asked for the list's search field (set in Slint; the list focuses it and clears it).
    in-out property <bool> want-search;
    // The sidebar hidden (its header's button, Ctrl+B through shell.ts): this tab's own, as Projects' sidebar-open.
    in-out property <bool> side-hidden;
    // chat
    in property <string> c-name;
    in property <string> c-initials;
    in property <color> c-color;
    in property <image> c-avatar;
    in property <bool> c-has-avatar;
    in property <string> c-presence;
    in property <string> c-status;
    in property <string> c-tone;
    in property <string> c-channel;
    in property <string> c-account;
    in property <bool> c-accounts; // more than one: the account chip opens a menu
    in property <bool> c-gmail;
    in property <bool> c-connected: true;
    in property <string> c-empty: "No messages yet.";
    in property <bool> c-more;
    in property <bool> c-loading;
    in property <[PMsg]> msgs;
    in property <int> msgs-rev; // bumps when the conversation changes: the view sticks to the bottom
    in-out property <string> draft;
    in-out property <string> subject;
    in property <string> reply-name; // the message being replied to: its author ("" none) and text
    in property <string> reply-text;
    in property <string> attached; // the files going with the next message (or note), one line
    in property <[PAttach]> attach-tiles; // its pictures, as tiles over the composer
    in property <string> attached-files; // its other files, one line (the chip)
    // The composer (Person Hub's): to the person or to their AI ("To: AI | Name"), each with its own draft.
    in property <bool> ai-mode;
    in property <bool> c-ai-on: true; // the person's AI is there: the switch shows
    in property <bool> c-can-send: true;
    in property <string> c-blocked; // why it can't write to the person (instead of the field)
    in property <bool> c-need-subject; // Gmail with no thread yet: the first email's subject
    in property <string> c-hint; // the field's placeholder
    in property <bool> has-ai-chat; // "Open in Projects" (the AI's chat exists)
    in property <string> fwd-name; // Forward to AI: the forwarded message's author and text ("" none)
    in property <string> fwd-text;
    in property <int> focus-rev; // bumps when the composer's field should take the focus (Reply, Forward, the switch)
    // the field's selection (UTF-8 byte offsets), kept here for the emoji picker; `cursor-rev` bumps to put the cursor
    // at `cursor-to` (after an emoji went in)
    in-out property <int> draft-cursor;
    in-out property <int> draft-anchor;
    in property <int> cursor-to;
    in property <int> cursor-rev;
    // the emoji picker over the composer's smiley button (its corner at emoji-x, emoji-y, window coordinates)
    in-out property <bool> emoji-open;
    in property <length> emoji-x;
    in property <length> emoji-y;
    in property <[PEmojiCat]> emoji-cats;
    in property <int> emoji-cat; // the tab shown (-1: search results)
    in property <[PEmojiRow]> emoji-rows;
    in property <string> emoji-empty;
    in-out property <string> emoji-query;
    in property <int> emoji-rev; // bumps when the grid's content changes: back to its top
    // panel
    in property <bool> panel;
    in property <string> p-name;
    in property <string> p-initials;
    in property <color> p-color;
    in property <image> p-avatar;
    in property <bool> p-has-avatar;
    in property <string> p-sub;
    in-out property <string> p-notes;
    in property <[PSocial]> p-socials;
    in property <bool> p-socials-loading;
    in property <string> p-pos; // "3 of 12"
    // popup menu
    in property <[PMenu]> menu;
    in property <bool> menu-open;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <length> menu-w: 264px;
    // a menu entry's cascading submenu (Move to › Stores): beside the menu, its top at `sub-y` (the entry's)
    in property <[PMenu]> sub-menu;
    in property <bool> sub-open;
    in property <string> sub-of;
    in property <length> sub-y;
    in property <length> sub-w: 232px;
    // dialogs: "" | person | store | qr | confirm | rename | contact | session
    in property <string> dialog;
    in property <string> d-title;
    in property <string> d-text;
    in property <string> d-ok: "Save";
    in property <bool> d-danger;
    in property <string> d-error;
    in property <bool> d-busy;
    in-out property <string> f-name;
    in-out property <string> f-discord;
    in-out property <string> f-email;
    in-out property <string> f-whatsapp;
    in-out property <string> f-socials;
    in-out property <string> f-store;
    in-out property <string> f-subject;
    in-out property <string> f-details;
    // Personal › Add contact: the one field's label and hint (the platform picked)
    in property <string> f-handle-label;
    in property <string> f-handle-hint;
    in property <[PChip]> f-chips;
    in property <[PChip]> f-lists;
    in property <[PChip]> f-colors;
    in property <image> qr;
    in property <bool> has-qr;
    // Forward to Projects (dialog "fwd-project"): the message's quote, the prompt, the project and its picker (opened from
    // the project field, whose place in the window it keeps in fp-x/-y/-w/-h)
    in property <string> fp-author;
    in property <string> fp-meta;
    in property <string> fp-text;
    in-out property <string> fp-prompt;
    in property <bool> fp-can-send;
    in property <string> fp-name;
    in property <string> fp-path;
    in-out property <bool> fp-open;
    in-out property <string> fp-query;
    in property <[PFwdRow]> fp-rows;
    in property <length> fp-list-h: 200px;
    in property <int> fp-focus-rev;
    in-out property <length> fp-x;
    in-out property <length> fp-y;
    in-out property <length> fp-w;
    in-out property <length> fp-h;
    // the toast line at the bottom
    in property <string> toast;
    in property <string> toast-action;

    // the audio player (one at a time): the attachment's key, playing, position (s, moves on its own while playing)
    in property <string> a-key;
    in property <bool> a-playing;
    in-out property <float> a-pos;
    in property <float> a-dur;
    in property <float> a-speed: 1;

    // Link with…: the people to pick from (the search filters them), and the panel's linked people
    in-out property <string> f-query;
    in property <[PPick]> f-picks;
    in property <string> f-picked; // "2 picked: Evellin, Eve"
    in property <[PPick]> p-linked;

    // a site request's pane (view "sr"): SpokPay's admin request page
    in property <string> sr-subject;
    in property <string> sr-status;
    in property <string> sr-tone; // neutral | info | warning | success
    in property <string> sr-store;
    in property <string> sr-ref;
    in property <string> sr-initials;
    in property <image> sr-icon;
    in property <bool> sr-has-icon;
    in property <string> sr-brief-title;
    in property <string> sr-brief-sub;
    in property <string> sr-summary;
    in property <[PSrFact]> sr-facts;
    in property <[PSrImg]> sr-brief-imgs;
    in property <[string]> sr-brief-files;
    in property <[PSrItem]> sr-items;
    in property <int> sr-rev; // another request opened: the view goes to its end
    in property <bool> sr-loading;
    in property <string> sr-error; // it couldn't be read (with Try again)
    in property <string> sr-note; // an earlier read is shown (SpokPay didn't answer now)
    in property <bool> sr-more; // SpokPay sent only its newest 100 messages
    in property <bool> sr-finished;
    in property <string> sr-finished-note;
    in property <bool> sr-can-move; // the status menu has somewhere to go
    in property <bool> sr-moving;

    callback all-people();
    callback open-person(string, string, string);
    callback toggle-store(string);
    callback open-sr(string); // a site request's row (its ref)
    callback sr-menu(string, length, length); // right-click on it: Copy link
    callback toggle-section(string);
    callback section-menu(string, length, length);
    // A section's head dragged in the sidebar: the section ("" none), the pointer's window y, the section under it.
    // Dropped, `section-drop(dragged, under)`: the dragged one takes that one's place (kept in folds.json).
    in-out property <string> drag-sec;
    in-out property <length> drag-y;
    in-out property <string> drag-over;
    callback section-drop(string, string);
    callback row-menu(string, string, string, length, length);
    callback store-menu(string, length, length);
    callback edited-query(string);
    callback close-chat();
    callback send();
    callback typing();
    callback older();
    callback toggle-panel();
    callback account-menu(length, length);
    callback msg-menu(string, length, length);
    callback open-file(string, int);
    // A picture of a message (its index): Hub's lightbox, browsing that message's pictures.
    callback open-image(string, int);
    callback cancel-reply();
    callback attach();
    callback emoji-toggle(length, length); // the smiley button: opens (at its corner) or closes the picker
    callback emoji-tab(int);
    callback emoji-search(string);
    callback emoji-pick(string); // an emoji into the draft at its cursor (draft-cursor / draft-anchor)
    callback emoji-first(); // Enter in the search: the first emoji found
    callback paste(); // Ctrl+V in the composer: a picture on the clipboard joins the message
    callback clear-attached(); // drops the files that aren't pictures (each picture has its own ×)
    callback remove-attached(int); // a picture's ×, by its place among the tiles
    callback open-attached(int); // a picture clicked: the lightbox
    callback toggle-ai();
    callback set-to(string); // "ai" | "person"
    callback cancel-forward();
    callback open-ai-chat();
    callback msg-unread(string); // Alt+Click on their message
    callback card-act(string, string); // a site request card's button: (row id, open | edit | discard | local | dismiss | agent)
    callback save-notes(string);
    callback open-url(string);
    // a link in the AI's answer (markdown.slint reports selections too: ui.ts keeps web links only)
    callback md-link(string);
    // a draft's "Use as reply": into the composer, to the person
    callback use-draft(string);
    callback ai-fold(string); // an AI answer's chevron (or a click on it folded): fold / unfold it
    callback menu-pick(string);
    // the pointer came onto a menu entry (its id, its top): opens its submenu, or closes another's
    callback menu-hover(string, length);
    callback menu-close();
    callback dialog-ok();
    callback dialog-cancel();
    callback fp-edited(string); // the prompt changed (Send needs one)
    callback fp-toggle(); // the project field: the picker opens or closes
    callback fp-search(string); // the picker's search
    callback fp-pick(string); // a project picked
    callback fp-key(string); // up | down | enter | escape in the picker's search
    callback chip(string);
    callback color(string);
    callback add-person();
    callback prev();
    callback next();
    callback toast-act();
    callback audio-toggle(string); // a message's play / pause
    callback audio-seek(string, float); // a message's audio to that fraction
    callback audio-speed(); // 1x → 1.5x → 2x
    callback audio-transcribe(string); // no transcript yet (or the background one failed): make it; else show / hide it
    callback pick-toggle(string); // Link with…: a person picked or not
    callback pick-query(string);
    callback unlink(string); // the panel's LINKED: back on their own
    callback panel-menu(length, length); // the panel's ⋯
    callback sr-close();
    callback sr-status-menu(length, length); // the status button: SpokPay's moves
    callback sr-copy(); // the ref's copy button: the request's link
    callback sr-retry();
    callback sr-open-image(string, int); // a picture of the brief ("brief") or of a message (its id)
    callback sr-open-file(string, int);
}

// ---------- rows (ds-list.slint's ListRow, SectionHead, FoldBar) ----------

// One person: avatar with presence, name (+ crown; no channel mark), the status line under it, time and unread on the right.
component PersonRow inherits ListRow {
    in property <PRow> r;
    active: r.active;
    depth: r.depth;
    lead: "avatar";
    letter: r.initials;
    tint: r.color;
    image: r.avatar;
    has-image: r.has-avatar;
    presence: r.presence;
    title: r.name;
    strong: r.unread > 0;
    dim: r.dim;
    sub: r.typing != "" ? (r.typing == "recording" ? "recording audio…" : "typing…") : r.status;
    sub-color: r.typing != "" ? Theme.blue-900 : Ds.tone(r.tone);
    meta: r.time;
    count: r.unread;
    clicked => {
        PersonsBus.open-person(root.r.id, root.r.section, root.r.store);
    }
    menu(x, y) => {
        PersonsBus.row-menu(root.r.id, root.r.section, root.r.store, x, y);
    }
    if root.r.owner: Text {
        text: "♛";
        font-size: 11px;
        color: Theme.amber-900;
        vertical-alignment: center;
    }
}

// ---------- SpokPay › Site requests (Headquarters' Home list, drawn as Headquarters draws it) ----------
// Headquarters' chat-list/Section.tsx (FoldingSection, NoticeRow) and chat-list/Row.tsx, class for class: rengaf's
// tokens are Theme's (gray-900 subtle, gray-1000 fg, amber, blue); the alpha greys are written out.

global SrTokens {
    // --gray-alpha-100 (hover) and --gray-alpha-200 (current)
    out property <color> hover: Theme.dark ? #ffffff0f : #0000000d;
    out property <color> current: Theme.dark ? #ffffff17 : #00000014;
}

// FoldingSection's heading: h-8, pl-3 pr-3, label-12; fg while one waits on SpokPay (its amber dot), else subtle.
component SrHead {
    in property <PRow> r;
    property <bool> waits: r.tone == "needs";
    height: 32px;
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            PersonsBus.toggle-section("sr");
        }
    }
    property <color> ink: area.has-hover || root.waits ? Theme.gray-1000 : Theme.gray-900;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: "Site requests";
                font-size: 12px;
                font-weight: 400;
                color: root.ink;
                vertical-alignment: center;
            }
            // chat-list/status.tsx's StatusDot "needs-you": size-2, --amber-700
            if root.waits: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.amber-700;
                }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            alignment: end;
            if root.r.count > 0: Text {
                text: root.r.count;
                font-size: 12px;
                color: root.ink;
                vertical-alignment: center;
            }
            Glyph {
                width: 14px;
                icon: root.r.expanded ? Icons.down : Icons.right;
                size: 14px;
                color: root.ink;
            }
        }
    }
}

// NoticeRow: mx-1 mb-1, rounded-md, --amber-400 border, --amber-100 fill, px-2.5 py-2, CircleAlert and words in --amber-900.
component SrNotice {
    in property <PRow> r;
    height: box.preferred-height + 4px;
    box := Rectangle {
        x: 4px;
        y: 0;
        width: root.width - 8px;
        height: root.height - 4px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.amber-400;
        background: Theme.amber-100;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 8px;
            VerticalLayout {
                padding-top: 2px;
                alignment: start;
                Glyph {
                    width: 14px;
                    height: 14px;
                    icon: Icons.alert;
                    size: 14px;
                    color: Theme.amber-900;
                }
            }
            VerticalLayout {
                spacing: 2px;
                Text {
                    min-height: 16px;
                    text: root.r.name;
                    font-size: 13px;
                    color: Theme.amber-900;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                Text {
                    min-height: 18px;
                    text: root.r.status;
                    font-size: 13px;
                    color: Theme.amber-900;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// ChatListRow for a site request: px-3 py-1.5 gap-2.5, rounded-md, hover --gray-alpha-100, current --gray-alpha-200; the
// store's square bordered icon (size-8, initials until read), the subject (label-14), then the store's side
// ("Store replied" --blue-900 / "Store waiting" --amber-900 / "Nothing new") with the ref on the right (label-12-mono).
component SrRow {
    in property <PRow> r;
    height: 48px;
    Rectangle {
        border-radius: 6px;
        background: root.r.active ? SrTokens.current : area.has-hover ? SrTokens.hover : transparent;
    }
    area := TipArea {
        tip: root.r.tip;
        clicked => {
            PersonsBus.open-sr(root.r.id);
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                PersonsBus.sr-menu(root.r.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.gray-400;
                background: Theme.gray-100;
                clip: true;
                if !root.r.has-avatar: Text {
                    text: root.r.initials;
                    font-size: 13px;
                    color: Theme.gray-900;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.r.has-avatar: Image {
                    x: 1px;
                    y: 1px;
                    width: 30px;
                    height: 30px;
                    source: root.r.avatar;
                    image-fit: cover;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                height: 20px;
                text: root.r.name;
                font-size: 14px;
                font-weight: 400;
                color: Theme.gray-1000;
                overflow: elide;
                vertical-alignment: center;
            }
            HorizontalLayout {
                height: 16px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.r.status;
                    font-size: 12px;
                    color: root.r.tone == "info" ? Theme.blue-900 : root.r.tone == "warning" ? Theme.amber-900 : Theme.gray-900;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 0;
                    text: root.r.time;
                    font-size: 12px;
                    font-family: "Geist Mono";
                    color: Theme.gray-900;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// ---------- sidebar ----------

component SideRow {
    in property <PRow> r;
    // A person's row has a second line while there's a status or someone types.
    property <length> person-h: r.status != "" || r.typing != "" ? Ds.row2-h : Ds.row-h;
    height: r.kind == "section" ? 34px : r.kind == "settled" ? Theme.row-h : r.kind == "empty" ? 24px : r.kind == "person" ? person-h : r.kind == "store" ? Ds.head-row-h
        : r.kind == "sr-head" ? 32px : r.kind == "sr" ? 48px : r.kind == "sr-empty" ? 26px : r.kind == "sr-gap" ? 10px : r.kind == "sr-notice" ? notice.height : Ds.row-h;
    if root.r.kind == "all" || root.r.kind == "store": ListRow {
        width: root.width;
        active: root.r.active;
        head: root.r.kind == "store";
        fold: root.r.kind == "store" ? (root.r.expanded ? "open" : "folded") : "";
        lead: root.r.kind == "store" ? "letter" : "glyph";
        glyph: Icons.users;
        letter: root.r.initials;
        tint: root.r.has-avatar ? transparent : root.r.color;
        image: root.r.avatar;
        has-image: root.r.has-avatar;
        title: root.r.kind == "all" ? "All people" : root.r.name;
        count: root.r.unread;
        meta: root.r.count;
        clicked => {
            if root.r.kind == "all" {
                PersonsBus.all-people();
            } else {
                PersonsBus.toggle-store(root.r.id);
            }
        }
        fold-clicked => {
            PersonsBus.toggle-store(root.r.id);
        }
        menu(x, y) => {
            if root.r.kind == "store" {
                PersonsBus.store-menu(root.r.id, x, y);
            }
        }
    }
    // A section dragged over this row: it's the section the drop puts the dragged one in place of.
    property <bool> pointed: PersonsBus.drag-sec != "" && root.r.section != "" && PersonsBus.drag-y >= root.absolute-position.y && PersonsBus.drag-y < root.absolute-position.y + root.height;
    changed pointed => {
        if root.pointed {
            PersonsBus.drag-over = root.r.section;
        }
    }
    // the drop's place: the head of the section the dragged one would take the place of
    if root.r.kind == "section" && PersonsBus.drag-sec != "" && PersonsBus.drag-sec != root.r.section && PersonsBus.drag-over == root.r.section: Rectangle {
        y: 9px;
        height: 24px;
        border-radius: Ds.radius-md;
        border-width: 1.5px;
        border-color: Theme.blue-700;
        background: Theme.blue-700.with-alpha(0.10);
    }
    if root.r.kind == "section": SectionHead {
        width: root.width;
        title: root.r.name;
        fold: root.r.expanded ? "open" : "folded";
        dot: root.r.status != "" ? Ds.tone-dot(root.r.tone) : transparent;
        dot-tip: root.r.status;
        count: root.r.unread;
        plus-tip: "Add or connections";
        // dragged onto another section's rows, it takes that section's place
        draggable: true;
        opacity: PersonsBus.drag-sec == root.r.section ? 0.5 : 1;
        drag(x, y) => {
            PersonsBus.drag-sec = root.r.section;
            PersonsBus.drag-y = y;
        }
        dropped(x, y) => {
            PersonsBus.section-drop(root.r.section, PersonsBus.drag-over);
            PersonsBus.drag-sec = "";
            PersonsBus.drag-over = "";
        }
        toggled => {
            PersonsBus.toggle-section(root.r.section);
        }
        plus(x, y) => {
            PersonsBus.section-menu(root.r.section, x, y);
        }
    }
    if root.r.kind == "settled": FoldBar {
        width: root.width;
        label: "Settled (" + root.r.count + ")";
        open: root.r.expanded;
        toggled => {
            PersonsBus.toggle-section("settled:" + root.r.section);
        }
    }
    if root.r.kind == "empty": ListNote {
        depth: root.r.depth;
        text: root.r.name;
    }
    if root.r.kind == "sr-head": SrHead {
        width: root.width;
        r: root.r;
    }
    // px-3 py-1, copy-13, subtle
    if root.r.kind == "sr-empty": Text {
        x: 12px;
        width: root.width - 24px;
        text: root.r.name;
        font-size: 13px;
        color: Theme.gray-900;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.r.kind == "sr": SrRow {
        width: root.width;
        r: root.r;
    }
    notice := SrNotice {
        width: root.width;
        visible: root.r.kind == "sr-notice";
        r: root.r;
    }
    person := PersonRow {
        width: root.width;
        visible: root.r.kind == "person";
        height: root.r.kind == "person" ? root.person-h : 0px;
        r: root.r;
    }
}

component Sidebar inherits SideSurface {
    VerticalLayout {
        padding-top: Ds.side-pad-top;
        spacing: 2px;
        // The sidebar's first row, as Projects': this tab's buttons on the right.
        SideHead {
            padding-left: Ds.side-pad;
            padding-right: Ds.side-pad;
            hide => {
                PersonsBus.side-hidden = true;
            }
            // Search in the rightmost slot, as Projects' (refresh, search).
            Btn {
                icon: Icons.plus;
                size: icon-xs;
                variant: ghost-muted;
                tip: "Add person";
                clicked => {
                    PersonsBus.add-person();
                }
            }
            Btn {
                icon: Icons.search;
                size: icon-xs;
                variant: ghost-muted;
                tip: "Search people";
                clicked => {
                    PersonsBus.want-search = true;
                    PersonsBus.all-people();
                }
            }
        }
        Scroll {
            vertical-stretch: 1;
            VerticalLayout {
                padding: Ds.side-pad;
                padding-top: Ds.side-list-top;
                spacing: 2px;
                alignment: start;
                for r in PersonsBus.side: SideRow {
                    r: r;
                }
            }
        }
        if PersonsBus.note != "": Rectangle {
            height: 30px;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }
            Text {
                x: 12px;
                width: parent.width - 24px;
                text: PersonsBus.note;
                font-size: Ds.t-xs;
                color: Theme.subtle;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// ---------- the list (All people) ----------

component ListPane inherits Rectangle {
    // The sidebar's search button: focus the search field, now (the list was showing) or as the list appears.
    property <bool> want: PersonsBus.want-search;
    function take-search() {
        if PersonsBus.want-search {
            PersonsBus.want-search = false;
            search.focus-field();
        }
    }
    changed want => {
        self.take-search();
    }
    init => {
        self.take-search();
    }
    VerticalLayout {
        // The page's header: the shared PageBar (as Projects' breadcrumbs), "Persons / All people  68 people".
        PageBar {
            side-hidden: PersonsBus.side-hidden;
            icon: Icons.users;
            section: "Persons";
            title: PersonsBus.list-title;
            sub: PersonsBus.list-sub;
            show-side => {
                PersonsBus.side-hidden = false;
            }
            Btn {
                y: 1px;
                text: "Add person";
                icon: Icons.plus;
                variant: Variant.primary;
                size: BtnSize.xs;
                clicked => {
                    PersonsBus.add-person();
                }
            }
        }
        VerticalLayout {
            padding-left: Ds.page-pad;
            padding-right: Ds.page-pad;
            padding-top: Ds.sp7;
            spacing: Ds.sp6;
            Rectangle {
                height: 34px;
                border-radius: Ds.radius-md;
                border-width: 1px;
                border-color: search.focused ? Theme.gray-1000 : Theme.border;
                search := SearchField {
                    x: 8px;
                    width: parent.width - 16px;
                    y: 1px;
                    hint: "Search name, username, id, email, notes…";
                    text <=> PersonsBus.query;
                    edited(t) => {
                        PersonsBus.edited-query(t);
                    }
                }
            }
            Scroll {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 2px;
                    for r in PersonsBus.list: PersonRow {
                        r: r;
                    }
                    if PersonsBus.list.length == 0: VerticalLayout {
                        padding-top: 40px;
                        Empty {
                            icon: PersonsBus.query != "" ? Icons.search : Icons.users;
                            title: PersonsBus.query != "" ? "No match" : "No people yet";
                            desc: PersonsBus.query != "" ? "No one matches “" + PersonsBus.query + "”." : "";
                            action: PersonsBus.query != "" ? "" : "Add person";
                            act => {
                                PersonsBus.add-person();
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------- chat ----------

// A message the Person AI drafted for the person (a ```reply block in its answer): in the user's own bubble colour,
// as it would go out, with copy and "Use as reply" (into the composer) once the answer is done.
component DraftCard inherits Rectangle {
    in property <string> text;
    in property <bool> done;
    property <bool> copied;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    border-radius: Ds.radius-lg;
    background: Theme.dark ? #1f2a44 : #e6f0ff;
    border-width: 1px;
    border-color: Theme.dark ? #2d3d63 : #c9dcfa;
    lay := VerticalLayout {
        padding-left: Ds.sp6;
        padding-right: Ds.sp4;
        padding-top: Ds.sp3;
        padding-bottom: Ds.sp5;
        spacing: Ds.sp2;
        HorizontalLayout {
            height: 28px;
            spacing: Ds.sp3;
            Glyph {
                icon: Icons.corner-up-right;
                size: Ds.icon-xs;
                color: Ds.caps-fg;
            }
            Text {
                text: root.done ? "REPLY DRAFT" : "REPLY DRAFT · WRITING…";
                font-size: Ds.t-caps;
                font-weight: 500;
                letter-spacing: Ds.caps-spacing * 1px;
                color: Ds.caps-fg;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.done: Btn {
                icon: root.copied ? Icons.check : Icons.copy;
                size: BtnSize.icon-xs;
                variant: Variant.ghost-muted;
                tip: root.copied ? "Copied" : "Copy";
                clicked => {
                    clip.text = root.text;
                    clip.select-all();
                    clip.copy();
                    clip.text = "";
                    root.copied = true;
                }
            }
            if root.done: Btn {
                text: "Use as reply";
                icon: Icons.corner-up-right;
                size: BtnSize.xs;
                variant: Variant.outline;
                tip: "Put it in the message box, to send to them";
                clicked => {
                    PersonsBus.use-draft(root.text);
                }
            }
        }
        HorizontalLayout {
            padding-right: Ds.sp2;
            Text {
                text: root.text;
                font-size: Ds.t-body;
                color: Theme.fg;
                wrap: word-wrap;
            }
        }
    }
    clip := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
    }
    Timer {
        interval: 1500ms;
        running: root.copied;
        triggered => {
            root.copied = false;
        }
    }
}

// A folded answer's draft on one line: the same colours as DraftCard, its first words and "Use as reply".
component DraftLine inherits Rectangle {
    in property <string> text;
    callback open();
    height: 34px;
    border-radius: Ds.radius-md;
    background: Theme.dark ? #1f2a44 : #e6f0ff;
    border-width: 1px;
    border-color: Theme.dark ? #2d3d63 : #c9dcfa;
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.open();
        }
    }
    HorizontalLayout {
        padding-left: Ds.sp5;
        padding-right: Ds.sp2;
        padding-top: Ds.sp2;
        padding-bottom: Ds.sp2;
        spacing: Ds.sp4;
        Glyph {
            icon: Icons.corner-up-right;
            size: Ds.icon-xs;
            color: Ds.caps-fg;
        }
        Text {
            text: root.text;
            font-size: Ds.t-sm;
            color: Theme.fg;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Btn {
            text: "Use as reply";
            icon: Icons.corner-up-right;
            size: BtnSize.xs;
            variant: Variant.outline;
            tip: "Put it in the message box, to send to them";
            clicked => {
                PersonsBus.use-draft(root.text);
            }
        }
    }
}

// A voice message or an audio file in a bubble (WhatsApp's): play / pause, the bars (played part in ink; a click
// seeks there), the position or the length, the speed (1x, 1.5x, 2x, for every audio), a dot until it is played;
// Transcribe under it, then its text (Hub's own speech to text, kept).
component AudioPlayer {
    in property <PMsg> m;
    property <bool> current: PersonsBus.a-key == m.a-key;
    property <bool> playing: current && PersonsBus.a-playing;
    property <float> pos: current ? PersonsBus.a-pos : 0;
    property <float> dur: current && PersonsBus.a-dur > 0 ? PersonsBus.a-dur : m.a-dur;
    property <float> frac: dur > 0 ? clamp(pos / dur, 0, 1) : 0;
    property <int> n: max(1, m.a-bars.length);
    property <color> ink: m.mine ? Theme.blue-900 : Theme.fg;
    property <float> shown: current && (playing || pos > 0) ? pos : dur;
    height: col.preferred-height;
    col := VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 10px;
            height: 38px;
            Rectangle {
                width: 32px;
                height: 32px;
                y: 3px;
                border-radius: 16px;
                background: play-area.has-hover ? root.ink.with-alpha(0.82) : root.ink;
                Glyph {
                    // the play triangle sits a little right of the middle, as players draw it
                    x: (parent.width - self.width) / 2 + (root.playing ? 0px : 1px);
                    icon: root.playing ? Icons.pause : Icons.play;
                    size: 14px;
                    color: Theme.bg100;
                }
                play-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        PersonsBus.audio-toggle(root.m.id);
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                bars := Rectangle {
                    height: 22px;
                    property <length> bw: max(1px, (self.width - (root.n - 1) * 2px) / root.n);
                    for b[i] in root.m.a-bars: Rectangle {
                        x: i * (bars.bw + 2px);
                        width: bars.bw;
                        height: max(3px, b * 22px);
                        y: (parent.height - self.height) / 2;
                        border-radius: min(bars.bw, 3px) / 2;
                        background: (i + 0.5) / root.n <= root.frac && (root.current) ? root.ink : root.ink.with-alpha(0.28);
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            PersonsBus.audio-seek(root.m.id, clamp(self.mouse-x / self.width, 0, 1));
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: floor(root.shown / 60) + ":" + (mod(floor(root.shown), 60) < 10 ? "0" : "") + mod(floor(root.shown), 60);
                        font-size: 11px;
                        font-family: "Geist Mono";
                        color: Theme.gray-800;
                        vertical-alignment: center;
                    }
                    if !root.m.a-played && !root.m.mine: Rectangle {
                        width: 6px;
                        height: 6px;
                        y: (parent.height - 6px) / 2;
                        border-radius: 3px;
                        background: Theme.blue-700;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
            }
            sp := Rectangle {
                width: 38px;
                height: 22px;
                y: 8px;
                border-radius: 11px;
                background: sp-area.has-hover ? Theme.fg.with-alpha(0.14) : Theme.fg.with-alpha(0.08);
                Text {
                    text: PersonsBus.a-speed >= 1.75 ? "2x" : PersonsBus.a-speed >= 1.25 ? "1.5x" : "1x";
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                sp-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        PersonsBus.audio-speed();
                    }
                }
            }
        }
        // its transcript (made in the background, or on a click), shown under it; the button hides or shows it
        if root.m.a-transcript != "" && !root.m.a-hidden: Text {
            text: root.m.a-transcript;
            font-size: 12.5px;
            color: Theme.subtle;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            Btn {
                text: root.m.a-transcript != "" ? (root.m.a-hidden ? "Show transcript" : "Hide transcript") : root.m.a-transcribing ? "Transcribing…" : "Transcribe";
                icon: Icons.file-text;
                size: BtnSize.xs;
                variant: Variant.ghost-muted;
                enabled: root.m.a-transcript != "" || !root.m.a-transcribing;
                tip: root.m.a-transcript != "" ? "What it says (transcribed on this PC)" : "Write down what it says (on this PC)";
                clicked => {
                    PersonsBus.audio-transcribe(root.m.id);
                }
            }
        }
    }
}

// A message, the user's note to the Person AI, or the AI's answer. The AI's thread has its own tint and a small
// caps label with the time ("AI · 10:35", "TO THE AI · 10:33"); an answer is as wide as the column and draws its
// markdown as Projects' chat does (markdown.slint), its ```reply drafts as DraftCards.
// Discord's custom emoji inside a message's text: the text is drawn with a gap of no-break spaces in each one's place
// (emoji.ts inlineLayout) and the picture goes over the gap, found where it's drawn as markdown.slint's LinkLayer finds
// a link's words: from a hidden TextInput laid out as the text, where its cursor goes at the gap's ends.
component EmojiLayer {
    in property <string> plain;
    in property <[PEmoji]> emojis;
    in property <length> size;
    property <length> line: one.preferred-height;
    property <Point> at;
    function where(offset: int) -> Point {
        probe.set-selection-offsets(offset, offset);
        return root.at;
    }
    one := Text {
        visible: false;
        text: "X";
        font-size: root.size;
        font-family: "Geist";
    }
    probe := TextInput {
        visible: false;
        enabled: false;
        read-only: true;
        width: root.width;
        height: root.height;
        text: root.plain;
        font-size: root.size;
        font-family: "Geist";
        wrap: word-wrap;
        cursor-position-changed(p) => {
            root.at = p;
        }
    }
    for e in root.emojis: spot := Rectangle {
        property <Point> a;
        property <Point> b;
        property <bool> placed;
        // Laid out again when any of these change.
        property <length> w-now: root.width;
        property <length> size-now: root.size;
        property <string> text-now: root.plain;
        property <int> from-now: e.from;
        // its picture: a line high, centred on its gap (on the gap's last line when it starts at a line's end)
        property <length> s: min(root.line * 1.1, root.size * 1.375);
        property <bool> same: self.b.y == self.a.y;
        function place() {
            self.a = root.where(e.from);
            self.b = root.where(e.to);
            // Before the window can lay text out, every offset is at 0,0: try again shortly.
            self.placed = root.width > 0 && (self.b.x != self.a.x || self.b.y != self.a.y);
        }
        init => {
            self.place();
        }
        changed w-now => {
            self.place();
        }
        changed size-now => {
            self.place();
        }
        changed text-now => {
            self.place();
        }
        changed from-now => {
            self.place();
        }
        Timer {
            interval: 100ms;
            running: !spot.placed && root.width > 0;
            triggered => {
                spot.place();
            }
        }
        if spot.placed && e.has-image: Image {
            x: spot.same ? (spot.a.x + spot.b.x - spot.s) / 2 : max(0px, spot.b.x - spot.s);
            y: (spot.same ? spot.a.y : spot.b.y) + (root.line - spot.s) / 2;
            width: spot.s;
            height: spot.s;
            source: e.image;
            image-fit: contain;
        }
    }
}

component Bubble {
    in property <PMsg> m;
    in property <length> max-w;
    callback menu(length, length);
    property <bool> ai: m.kind == "ai";
    property <bool> thread: ai || m.to-ai;
    property <bool> copied;
    property <color> ai-ink: Theme.dark ? #b9a6ff : #6d4ad6;
    property <color> bg: ai ? (Theme.dark ? #1d1830 : #f3effe) : m.to-ai ? (Theme.dark ? #241d3b : #ebe4fd) : m.mine ? (Theme.dark ? #1f2a44 : #e6f0ff) : Theme.gray-100;
    property <length> pad-x: thread ? Ds.sp6 : 12px;
    // A message of nothing but 1-3 emoji: drawn big (48px each, Discord's jumbo), not as text.
    property <bool> jumbo: !ai && m.jumbo.length > 0;
    property <length> text-w: min(root.max-w - 2 * pad-x, root.jumbo ? m.jumbo.length * 52px - 4px : body.preferred-width);
    // "TO THE AI · 00:00" fits.
    property <length> label-w: thread ? 124px : 0px;
    property <length> w: ai ? root.max-w : max(max(root.m.has-image ? root.m.img-w : 0px, label-w), max(text-w, root.m.has-audio ? 280px : root.m.has-reply || root.m.files != "" ? 220px : 60px)) + 2 * pad-x;
    height: lay.preferred-height;
    lay := HorizontalLayout {
        width: root.width;
        alignment: root.m.mine && !root.ai ? end : start;
        padding-top: root.m.first ? (root.thread ? 8px : 6px) : 1px;
        Rectangle {
            width: min(root.max-w, root.w);
            border-radius: Ds.radius-xl;
            background: root.bg;
            border-width: root.m.failed ? 1px : root.thread ? 1px : 0px;
            border-color: root.m.failed ? Theme.red-800 : root.ai-ink.with-alpha(Theme.dark ? 0.22 : 0.18);
            col := VerticalLayout {
                padding-top: root.thread ? Ds.sp5 : 8px;
                padding-bottom: root.thread ? Ds.sp6 : 8px;
                padding-left: root.pad-x;
                padding-right: root.pad-x;
                spacing: root.thread ? Ds.sp3 : 4px;
                if root.thread: HorizontalLayout {
                    spacing: Ds.sp2;
                    HorizontalLayout {
                        spacing: Ds.sp3;
                        Glyph {
                            icon: Icons.sparkles;
                            size: Ds.icon-xs;
                            color: root.ai-ink;
                        }
                        Text {
                            text: root.ai ? (root.m.streaming ? "AI · WRITING…" : "AI") : "TO THE AI";
                            font-size: Ds.t-caps;
                            font-weight: 600;
                            letter-spacing: Ds.caps-spacing * 1px;
                            color: root.ai-ink;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "· " + root.m.time;
                            font-size: Ds.t-caps;
                            color: Ds.muted-fg;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    if root.ai && !root.m.streaming: Btn {
                        height: 16px;
                        icon: root.m.folded ? Icons.down : Icons.up;
                        size: BtnSize.icon-xs;
                        variant: Variant.ghost-muted;
                        tip: root.m.folded ? "Show the whole answer" : "Fold the answer";
                        clicked => {
                            PersonsBus.ai-fold(root.m.id);
                        }
                    }
                    if root.ai && !root.m.streaming: Btn {
                        height: 16px;
                        icon: root.copied ? Icons.check : Icons.copy;
                        size: BtnSize.icon-xs;
                        variant: Variant.ghost-muted;
                        tip: root.copied ? "Copied" : "Copy the answer";
                        clicked => {
                            clip.text = root.m.text;
                            clip.select-all();
                            clip.copy();
                            clip.text = "";
                            root.copied = true;
                        }
                    }
                }
                if root.m.has-reply: Rectangle {
                    height: rt.preferred-height + 6px;
                    border-radius: 4px;
                    background: Theme.fg.with-alpha(0.06);
                    Rectangle {
                        x: 0;
                        width: 2px;
                        background: Theme.blue-700;
                    }
                    rt := Text {
                        x: 8px;
                        width: parent.width - 12px;
                        text: root.m.reply;
                        font-size: 11.5px;
                        color: Theme.subtle;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                if root.m.has-image: Rectangle {
                    width: root.m.img-w;
                    height: root.m.img-h;
                    for p[i] in root.m.images: Rectangle {
                        x: p.x;
                        y: p.y;
                        width: p.w;
                        height: p.h;
                        border-radius: 8px;
                        clip: true;
                        background: Theme.fg.with-alpha(0.06);
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: p.image;
                            image-fit: cover;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                PersonsBus.open-image(root.m.id, i);
                            }
                        }
                    }
                }
                if root.m.files != "": Rectangle {
                    height: ft.preferred-height + 8px;
                    border-radius: 6px;
                    background: Theme.fg.with-alpha(0.05);
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 6px;
                        Glyph {
                            icon: Icons.file;
                            size: 14px;
                            color: Theme.subtle;
                        }
                        ft := Text {
                            text: root.m.files;
                            font-size: 12px;
                            color: Theme.fg;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            PersonsBus.open-file(root.m.id, 0);
                        }
                    }
                }
                if root.m.has-audio: AudioPlayer {
                    m: root.m;
                }
                if root.jumbo: HorizontalLayout {
                    height: 48px;
                    spacing: 4px;
                    alignment: start;
                    for j in root.m.jumbo: Rectangle {
                        width: 48px;
                        height: 48px;
                        if j.has-image: Image {
                            width: 48px;
                            height: 48px;
                            source: j.image;
                            image-fit: contain;
                        }
                        if !j.custom: Text {
                            text: j.text;
                            font-size: 40px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        if j.custom: TipArea {
                            tip: ":" + j.name + ":";
                        }
                    }
                }
                Rectangle {
                    visible: !root.ai && root.m.text != "" && !root.jumbo;
                    height: self.visible ? body.preferred-height : 0px;
                    body := Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.ai ? "" : root.m.text;
                        font-size: Ds.t-body;
                        color: Theme.fg;
                        wrap: word-wrap;
                    }
                    if root.m.emojis.length > 0 && !root.ai: EmojiLayer {
                        width: parent.width;
                        height: parent.height;
                        plain: root.m.text;
                        emojis: root.m.emojis;
                        size: Ds.t-body;
                    }
                }
                // Folded: its first two lines (a click opens it) and its first draft on one line.
                if root.ai && root.m.folded && root.m.preview != "": Rectangle {
                    height: min(pv.preferred-height, 2 * Ds.t-body * 1.45);
                    pv := Text {
                        width: parent.width;
                        height: parent.height;
                        vertical-alignment: top;
                        text: root.m.preview;
                        font-size: Ds.t-body;
                        color: Theme.fg.with-alpha(0.72);
                        wrap: word-wrap;
                        overflow: elide;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            PersonsBus.ai-fold(root.m.id);
                        }
                    }
                }
                if root.ai && root.m.folded && root.m.draft != "": DraftLine {
                    text: root.m.draft;
                    open => {
                        PersonsBus.ai-fold(root.m.id);
                    }
                }
                if root.ai && !root.m.folded: VerticalLayout {
                    for p in root.m.parts: VerticalLayout {
                        padding-top: p.gap;
                        if !p.draft: MdBlockView {
                            block: p.block;
                            size: Ds.t-body;
                            select: false;
                            link(u) => {
                                PersonsBus.md-link(u);
                            }
                            copy(t) => {
                                clip.text = t;
                                clip.select-all();
                                clip.copy();
                                clip.text = "";
                            }
                        }
                        if p.draft: DraftCard {
                            text: p.text;
                            done: !root.m.streaming;
                        }
                    }
                }
                if !root.thread: HorizontalLayout {
                    alignment: end;
                    spacing: 4px;
                    // the channel it came or went on (the person has more than one chat)
                    if root.m.chan != "": VerticalLayout {
                        alignment: center;
                        opacity: 0.7;
                        ChannelMark {
                            kind: root.m.chan;
                            size: 10px;
                        }
                    }
                    Text {
                        text: root.m.failed ? "Not sent · click to retry" : root.m.sending ? "Sending…" : root.m.meta != "" ? root.m.meta + " · " + root.m.time : root.m.time;
                        font-size: 10px;
                        color: root.m.failed ? Theme.red-900 : Theme.gray-800;
                    }
                }
            }
            clip := TextInput {
                visible: false;
                width: 0px;
                height: 0px;
            }
            Timer {
                interval: 1500ms;
                running: root.copied;
                triggered => {
                    root.copied = false;
                }
            }
            // Under the answer's text and buttons (they come later): a right-click anywhere else opens the menu.
            TouchArea {
                z: -1;
                // a right-click opens the menu; Alt+Click on their message marks it unread (Person Hub's)
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                        root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    } else if e.kind == PointerEventKind.down && e.button == PointerEventButton.left && e.modifiers.alt && root.m.kind == "msg" && !root.m.mine {
                        PersonsBus.msg-unread(root.m.id);
                    }
                }
                clicked => {
                    if root.m.failed {
                        PersonsBus.msg-menu(root.m.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
        }
    }
}

// A SpokPay site request proposed from a message (Headquarters' ProposalCard): what the store will read, the store and
// category, who proposed it and why, then Open site request / Edit / Discard; or the agent still drafting it.
component SiteCard {
    in property <PMsg> m;
    in property <length> max-w;
    property <bool> drafting: m.kind == "proposing";
    property <string> st: m.card-state;
    property <color> ink: Theme.dark ? #b9a6ff : #6d4ad6;
    height: row.preferred-height;
    row := HorizontalLayout {
        alignment: start;
        padding-top: 8px;
        padding-bottom: 2px;
        Card {
            width: min(root.max-w, 480px);
            col := VerticalLayout {
                padding-left: Ds.sp6;
                padding-right: Ds.sp6;
                padding-top: Ds.sp5;
                padding-bottom: Ds.sp6;
                spacing: Ds.sp3;
                HorizontalLayout {
                    spacing: Ds.sp3;
                    Glyph {
                        icon: Icons.file-plus;
                        size: Ds.icon-xs;
                        color: Ds.caps-fg;
                    }
                    Text {
                        text: root.drafting ? (root.st == "failed" ? "SITE REQUEST · NOT DRAFTED" : "SITE REQUEST · DRAFTING…") : root.st == "opened" ? "SITE REQUEST · OPENED" : root.st == "opening" ? "SITE REQUEST · OPENING…" : root.st == "failed" ? "SITE REQUEST · NOT OPENED" : "SITE REQUEST · PROPOSED";
                        font-size: Ds.t-caps;
                        font-weight: 500;
                        letter-spacing: Ds.caps-spacing * 1px;
                        color: Ds.caps-fg;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "· " + root.m.time;
                        font-size: Ds.t-caps;
                        color: Ds.muted-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.m.card-chat: Btn {
                        height: 16px;
                        icon: Icons.external;
                        size: BtnSize.icon-xs;
                        variant: Variant.ghost-muted;
                        tip: "The SpokPay agent's chat (Projects)";
                        clicked => {
                            PersonsBus.card-act(root.m.id, "agent");
                        }
                    }
                }
                Text {
                    text: root.m.card-title;
                    font-size: root.drafting ? Ds.t-sm : 15px;
                    font-weight: root.drafting ? 400 : 600;
                    color: root.drafting ? Theme.subtle : Theme.fg;
                    wrap: word-wrap;
                }
                if !root.drafting && root.m.card-sub != "": Text {
                    text: root.m.card-sub;
                    font-size: 12.5px;
                    color: Theme.subtle;
                    overflow: elide;
                }
                if !root.drafting && root.m.text != "": Text {
                    text: root.m.text;
                    font-size: Ds.t-sm;
                    color: Theme.fg;
                    wrap: word-wrap;
                }
                if !root.drafting && root.m.card-why != "": Text {
                    text: root.m.card-why;
                    font-size: 12px;
                    font-italic: true;
                    color: Theme.subtle;
                    wrap: word-wrap;
                }
                if root.m.card-note != "": Text {
                    text: root.m.card-note;
                    font-size: 12.5px;
                    color: root.st == "opened" ? Ds.tone("green") : root.st == "failed" ? Theme.red-900 : Theme.subtle;
                    wrap: word-wrap;
                }
                if root.st != "opened" && root.st != "opening": HorizontalLayout {
                    padding-top: Ds.sp2;
                    spacing: Ds.sp3;
                    alignment: start;
                    if root.drafting && root.st != "failed": Spinner { }
                    if !root.drafting: Btn {
                        text: root.st == "failed" ? "Try again" : "Open site request";
                        size: BtnSize.xs;
                        variant: Variant.primary;
                        tip: "Sends it to SpokPay and the store";
                        clicked => {
                            PersonsBus.card-act(root.m.id, "open");
                        }
                    }
                    if !root.drafting: Btn {
                        text: "Edit";
                        icon: Icons.pen-line;
                        size: BtnSize.xs;
                        variant: Variant.outline;
                        clicked => {
                            PersonsBus.card-act(root.m.id, "edit");
                        }
                    }
                    if !root.drafting: Btn {
                        text: "Discard";
                        size: BtnSize.xs;
                        variant: Variant.ghost-muted;
                        clicked => {
                            PersonsBus.card-act(root.m.id, "discard");
                        }
                    }
                    if root.drafting: Btn {
                        text: "Use the message";
                        size: BtnSize.xs;
                        variant: root.st == "failed" ? Variant.primary : Variant.outline;
                        tip: "Skip the agent: the message itself becomes the proposal";
                        clicked => {
                            PersonsBus.card-act(root.m.id, "local");
                        }
                    }
                    if root.drafting: Btn {
                        text: root.st == "failed" ? "Dismiss" : "Cancel";
                        size: BtnSize.xs;
                        variant: Variant.ghost-muted;
                        clicked => {
                            PersonsBus.card-act(root.m.id, "dismiss");
                        }
                    }
                }
            }
        }
    }
}

component MsgRow {
    in property <PMsg> m;
    in property <length> max-w;
    height: m.kind == "day" || m.kind == "unread" ? 30px : m.kind == "subject" ? 30px : m.kind == "proposal" || m.kind == "proposing" ? card.preferred-height : bubble.preferred-height;
    if root.m.kind == "day": Text {
        width: root.width;
        height: root.height;
        text: root.m.text;
        font-size: 11px;
        font-weight: 600;
        color: Theme.gray-800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.m.kind == "unread": Rectangle {
        width: root.width;
        height: root.height;
        Rectangle {
            height: 1px;
            background: Theme.red-800;
        }
        Rectangle {
            width: ut.preferred-width + 12px;
            height: 18px;
            background: Theme.bg100;
            ut := Text {
                text: root.m.text;
                font-size: 10.5px;
                font-weight: 600;
                color: Theme.red-900;
            }
        }
    }
    if root.m.kind == "subject": HorizontalLayout {
        width: root.width;
        height: root.height;
        alignment: start;
        spacing: 6px;
        Glyph {
            icon: Icons.message;
            size: 12px;
            color: Theme.subtle;
        }
        Text {
            text: root.m.text;
            font-size: 12px;
            font-weight: 600;
            color: Theme.subtle;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    card := SiteCard {
        width: root.width;
        visible: root.m.kind == "proposal" || root.m.kind == "proposing";
        m: root.m;
        max-w: root.max-w;
    }
    bubble := Bubble {
        width: root.width;
        visible: root.m.kind == "msg" || root.m.kind == "ai" || root.m.kind == "out";
        m: root.m;
        max-w: root.max-w;
        menu(x, y) => {
            PersonsBus.msg-menu(root.m.id, x, y);
        }
    }
}

// A line over the field: the message being replied to, or the one forwarded to the AI (Person Hub's chips).
component QuoteChip inherits Rectangle {
    in property <string> glyph;
    in property <string> lead;
    in property <string> name;
    in property <string> text;
    in property <string> close-tip;
    in property <bool> dashed;
    callback close();
    height: 32px;
    border-radius: Ds.radius-md;
    border-width: 1px;
    border-color: root.dashed ? Theme.gray-600 : Theme.border;
    background: Theme.bg200;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 2px;
        spacing: 6px;
        Glyph {
            icon: root.glyph;
            size: 13px;
            color: Theme.subtle;
        }
        Text {
            text: root.lead;
            font-size: 12.5px;
            color: Theme.subtle;
            vertical-alignment: center;
        }
        Text {
            text: root.name;
            font-size: 12.5px;
            font-weight: 600;
            color: Theme.fg;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-size: 12.5px;
            color: Theme.subtle;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Btn {
                icon: Icons.x;
                size: BtnSize.icon-xs;
                variant: Variant.ghost-muted;
                tip: root.close-tip;
                clicked => {
                    root.close();
                }
            }
        }
    }
}

// The composer (Person Hub's Chat.tsx): a card with who it goes to on top ("To <person>", or "Note to the AI · never
// sent to them" in the AI's tint), then the first email's subject, the reply or the forwarded message, the files, the
// field (or why it can't write to them), and the actions: attach (Open in Projects for the AI), the "To: AI | <person>"
// switch, Send. Enter sends, Shift+Enter is a new line, Esc drops the reply or the forward.
component Composer inherits Rectangle {
    property <bool> ai: PersonsBus.ai-mode;
    property <color> ai-ink: Theme.dark ? #b9a6ff : #6d4ad6;
    property <bool> writes: root.ai || PersonsBus.c-can-send;
    property <bool> has-text: PersonsBus.draft != "";
    property <bool> focused;
    height: wrap.preferred-height;
    wrap := VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 6px;
        padding-bottom: 14px;
        Rectangle {
            border-radius: Ds.radius-xl;
            border-width: 1px;
            border-color: root.ai ? root.ai-ink.with-alpha(Theme.dark ? 0.55 : 0.45) : root.focused ? Theme.gray-600 : Theme.border;
            background: root.ai ? (Theme.dark ? #1a1726 : #fbfaff) : Theme.bg100;
            VerticalLayout {
                // who it goes to
                HorizontalLayout {
                    height: 40px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    if root.ai: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: Theme.fg;
                            Glyph {
                                icon: Icons.sparkles;
                                size: 11px;
                                color: Theme.bg100;
                            }
                        }
                    }
                    if !root.ai: VerticalLayout {
                        alignment: center;
                        Avatar {
                            size: 20px;
                            initials: PersonsBus.c-initials;
                            color: PersonsBus.c-color;
                            photo: PersonsBus.c-avatar;
                            has-photo: PersonsBus.c-has-avatar;
                        }
                    }
                    if root.ai: Text {
                        text: "Note to the AI";
                        font-size: 13px;
                        color: Theme.subtle;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.ai: Text {
                        text: "Never sent to " + PersonsBus.c-name;
                        font-size: 11.5px;
                        color: Theme.gray-800;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if !root.ai: Text {
                        text: "To";
                        font-size: 13px;
                        color: Theme.subtle;
                        vertical-alignment: center;
                    }
                    if !root.ai: Text {
                        text: PersonsBus.c-name;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
                Rectangle {
                    height: 1px;
                    background: root.ai ? root.ai-ink.with-alpha(0.25) : Theme.border;
                }
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 10px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    if !root.ai && PersonsBus.c-need-subject: Input {
                        hint: "Subject (first email)";
                        text <=> PersonsBus.subject;
                    }
                    if !root.ai && PersonsBus.reply-name != "": QuoteChip {
                        glyph: Icons.reply;
                        lead: "Replying to";
                        name: PersonsBus.reply-name;
                        text: PersonsBus.reply-text;
                        close-tip: "Cancel reply (Esc)";
                        close => {
                            PersonsBus.cancel-reply();
                        }
                    }
                    if root.ai && PersonsBus.fwd-name != "": QuoteChip {
                        glyph: Icons.forward;
                        lead: "Forwarding";
                        name: PersonsBus.fwd-name;
                        text: PersonsBus.fwd-text;
                        dashed: true;
                        close-tip: "Cancel forward (Esc)";
                        close => {
                            PersonsBus.cancel-forward();
                        }
                    }
                    if PersonsBus.attach-tiles.length > 0: Rectangle {
                        height: 70px;
                        clip: true;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            for t[i] in PersonsBus.attach-tiles: ImageTile {
                                thumb: t.thumb;
                                name: t.name;
                                number: 0;
                                remove => {
                                    PersonsBus.remove-attached(i);
                                }
                                open => {
                                    PersonsBus.open-attached(i);
                                }
                            }
                        }
                    }
                    if PersonsBus.attached-files != "": QuoteChip {
                        glyph: Icons.file;
                        lead: "";
                        name: PersonsBus.attached-files;
                        close-tip: "Remove the files";
                        close => {
                            PersonsBus.clear-attached();
                        }
                    }
                    if !root.writes: Text {
                        text: PersonsBus.c-blocked;
                        font-size: 13px;
                        color: Theme.subtle;
                        wrap: word-wrap;
                    }
                    // the shared composer field (ds ComposeField): Enter sends, Shift+Enter a new line, Esc drops the reply / forward
                    if root.writes: ComposeField {
                        text <=> PersonsBus.draft;
                        hint: PersonsBus.c-hint;
                        focus-rev: PersonsBus.focus-rev;
                        cursor-to: PersonsBus.cursor-to;
                        cursor-rev: PersonsBus.cursor-rev;
                        changed cursor => {
                            PersonsBus.draft-cursor = self.cursor;
                        }
                        changed anchor => {
                            PersonsBus.draft-anchor = self.anchor;
                        }
                        submit => {
                            PersonsBus.send();
                        }
                        edited => {
                            PersonsBus.typing();
                        }
                        paste => {
                            PersonsBus.paste();
                        }
                        escape => {
                            if !root.ai && PersonsBus.reply-name != "" {
                                PersonsBus.cancel-reply();
                                return true;
                            }
                            if root.ai && PersonsBus.fwd-name != "" {
                                PersonsBus.cancel-forward();
                                return true;
                            }
                            return false;
                        }
                        changed focused => {
                            root.focused = self.focused;
                        }
                    }
                    // attach (+ Open in Projects for the AI), the recipient switch, send
                    HorizontalLayout {
                        height: 32px;
                        spacing: 6px;
                        Btn {
                            icon: Icons.clip;
                            size: BtnSize.icon-sm;
                            variant: Variant.ghost-muted;
                            enabled: root.writes;
                            tip: root.ai ? "Attach files for the AI" : "Attach files";
                            clicked => {
                                PersonsBus.attach();
                            }
                        }
                        emoji-btn := Btn {
                            icon: Icons.smile;
                            size: BtnSize.icon-sm;
                            variant: PersonsBus.emoji-open ? Variant.ghost : Variant.ghost-muted;
                            enabled: root.writes;
                            tip: PersonsBus.emoji-open ? "" : "Emoji";
                            clicked => {
                                PersonsBus.emoji-toggle(self.absolute-position.x, self.absolute-position.y);
                            }
                        }
                        if root.ai: Btn {
                            icon: Icons.maximize;
                            size: BtnSize.icon-sm;
                            variant: Variant.ghost-muted;
                            enabled: PersonsBus.has-ai-chat;
                            tip: PersonsBus.has-ai-chat ? "Open the AI's chat in Projects" : "Open in Projects (after the first note)";
                            clicked => {
                                PersonsBus.open-ai-chat();
                            }
                        }
                        if PersonsBus.c-ai-on: HorizontalLayout {
                            horizontal-stretch: 0;
                            padding-left: 4px;
                            spacing: 6px;
                            Text {
                                text: "To";
                                font-size: 12.5px;
                                color: Theme.subtle;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                PillSwitch {
                                    a-glyph: Icons.sparkles;
                                    a-text: "AI";
                                    a-tip: "Write to their AI (never sent to them)";
                                    b-glyph: Icons.message;
                                    b-text: PersonsBus.c-name;
                                    b-tip: "Write to " + PersonsBus.c-name;
                                    b-on: !root.ai;
                                    pick(b) => {
                                        PersonsBus.set-to(b ? "person" : "ai");
                                    }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        if root.ai: Btn {
                            icon: Icons.arrow-up;
                            size: BtnSize.icon-sm;
                            variant: Variant.outline;
                            enabled: root.has-text || PersonsBus.fwd-name != "" || PersonsBus.attached != "";
                            tip: "Send to the AI (Enter)";
                            clicked => {
                                PersonsBus.send();
                            }
                        }
                        if !root.ai: Btn {
                            text: "Send";
                            trailing: Icons.arrow-up;
                            size: BtnSize.sm;
                            variant: root.writes && (root.has-text || PersonsBus.attached != "") ? Variant.primary : Variant.secondary;
                            enabled: root.writes && (root.has-text || PersonsBus.attached != "");
                            tip: "Send (Enter)";
                            clicked => {
                                PersonsBus.send();
                            }
                        }
                    }
                }
            }
        }
    }
}

component ChatPane inherits Rectangle {
    property <bool> at-bottom: true;
    // the audio playing moves on by itself (the engine says when it ends or stops)
    Timer {
        interval: 100ms;
        running: PersonsBus.a-playing;
        triggered => {
            PersonsBus.a-pos = PersonsBus.a-dur > 0 ? min(PersonsBus.a-dur, PersonsBus.a-pos + 0.1 * PersonsBus.a-speed) : PersonsBus.a-pos + 0.1 * PersonsBus.a-speed;
        }
    }
    VerticalLayout {
        // header: the shared page bar (46px, as Projects' chat header)
        PageBar {
            side-hidden: PersonsBus.side-hidden;
            show-side => {
                PersonsBus.side-hidden = false;
            }
            Btn {
                y: (parent.height - self.height) / 2;
                icon: Icons.arrow-left;
                size: BtnSize.icon-xs;
                variant: Variant.ghost-muted;
                tip: "Close (Esc)";
                clicked => {
                    PersonsBus.close-chat();
                }
            }
            Avatar {
                y: (parent.height - self.height) / 2;
                size: 28px;
                initials: PersonsBus.c-initials;
                color: PersonsBus.c-color;
                photo: PersonsBus.c-avatar;
                has-photo: PersonsBus.c-has-avatar;
                presence: PersonsBus.c-presence;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: PersonsBus.c-name;
                    font-size: Ds.t-body;
                    font-weight: 600;
                    color: Theme.fg;
                    overflow: elide;
                }
                if PersonsBus.c-status != "": Text {
                    text: PersonsBus.c-status;
                    font-size: Ds.t-xs;
                    color: Ds.tone(PersonsBus.c-tone);
                    overflow: elide;
                }
            }
            // the account this chat goes through (several: a menu), a small pill as Chip's
            acct := Rectangle {
                y: (parent.height - 26px) / 2;
                height: 26px;
                width: al.preferred-width + 20px;
                border-radius: 13px;
                background: acct-area.has-hover && PersonsBus.c-accounts ? Theme.gray-300 : Theme.gray-200;
                al := HorizontalLayout {
                    x: 10px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        ChannelMark {
                            kind: PersonsBus.c-channel;
                        }
                    }
                    Text {
                        text: PersonsBus.c-account;
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.fg;
                        vertical-alignment: center;
                    }
                    if PersonsBus.c-accounts: Glyph {
                        icon: Icons.down;
                        size: Ds.icon-xs;
                        color: Theme.subtle;
                    }
                }
                acct-area := TouchArea {
                    enabled: PersonsBus.c-accounts;
                    mouse-cursor: PersonsBus.c-accounts ? pointer : default;
                    clicked => {
                        PersonsBus.account-menu(self.absolute-position.x, self.absolute-position.y + self.height + 4px);
                    }
                }
            }
            Btn {
                y: (parent.height - self.height) / 2;
                icon: Icons.panel-right;
                size: BtnSize.icon-xs;
                variant: Variant.ghost-muted;
                pressed: PersonsBus.panel;
                tip: "Details";
                clicked => {
                    PersonsBus.toggle-panel();
                }
            }
        }
        // messages
        Rectangle {
            vertical-stretch: 1;
            sv := Scroll {
                property <length> max-w: min(640px, self.visible-width * 0.78);
                changed content-height => {
                    if root.at-bottom {
                        self.content-y = min(0px, self.visible-height - self.content-height);
                    }
                }
                // the composer grew (a reply, a forward, a longer text): the newest message stays in sight
                changed visible-height => {
                    if root.at-bottom {
                        self.content-y = min(0px, self.visible-height - self.content-height);
                    }
                }
                scrolled => {
                    root.at-bottom = self.content-y <= self.visible-height - self.content-height + 40px;
                    if self.content-y >= -2px && PersonsBus.c-more && !PersonsBus.c-loading {
                        PersonsBus.older();
                    }
                }
                VerticalLayout {
                    padding: 16px;
                    padding-bottom: 8px;
                    spacing: 2px;
                    alignment: end;
                    if PersonsBus.c-loading: HorizontalLayout {
                        alignment: center;
                        Spinner { }
                    }
                    if PersonsBus.msgs.length == 0 && !PersonsBus.c-loading: Text {
                        text: PersonsBus.c-empty;
                        font-size: 13px;
                        color: Theme.subtle;
                        horizontal-alignment: center;
                    }
                    for m in PersonsBus.msgs: MsgRow {
                        m: m;
                        max-w: sv.max-w;
                    }
                }
            }
        }
        Composer { }
    }
    changed width => {
        root.at-bottom = true;
    }
}

// ---------- a site request's pane (SpokPay's admin request page, request-thread.tsx, drawn in Hub) ----------
// ThreadHeader (the store's square logo, the subject, the status badge, "Store · SR-215 ⧉", the status select), the
// RequestBrief card, the timeline (events as centered dividers, messages as RequestLine: the author and time over the
// bubble, the store's on the left in the secondary bubble, SpokPay's on the right in the dark one, one author's run
// joined) and the person chats' Composer (To <owner>, pictures, To: AI | <owner>, Send). Edit is left out: SpokPay's admin API has no
// route for it.

global SrLook {
    // rengaf's Badge tones (bg 200, border 400, text 900; neutral's text 1000)
    public pure function pill-bg(tone: string) -> color {
        return tone == "info" ? Theme.blue-200 : tone == "warning" ? Theme.amber-200 : tone == "success" ? Theme.green-200 : Theme.gray-200;
    }
    public pure function pill-line(tone: string) -> color {
        return tone == "info" ? Theme.blue-400 : tone == "warning" ? Theme.amber-400 : tone == "success" ? Theme.green-400 : Theme.gray-400;
    }
    public pure function pill-fg(tone: string) -> color {
        return tone == "info" ? Theme.blue-900 : tone == "warning" ? Theme.amber-900 : tone == "success" ? Theme.green-900 : Theme.gray-1000;
    }
}

// StoreLogo: the store's picture, else its initials, in a rounded square.
component SrLogo inherits Rectangle {
    in property <length> size: 32px;
    width: root.size;
    height: root.size;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.gray-400;
    background: Theme.gray-100;
    clip: true;
    if !PersonsBus.sr-has-icon: Text {
        text: PersonsBus.sr-initials;
        font-size: root.size >= 40px ? 15px : 12px;
        font-weight: 500;
        color: Theme.gray-900;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if PersonsBus.sr-has-icon: Image {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        source: PersonsBus.sr-icon;
        image-fit: cover;
    }
}

