// Pictures in a row (BubbleGallery, simply): each at its drawn size, a click opens the lightbox.
component SrGallery inherits HorizontalLayout {
    in property <[PSrImg]> imgs;
    in property <string> owner;
    spacing: 4px;
    alignment: start;
    for p[i] in root.imgs: Rectangle {
        width: p.w;
        height: p.h;
        border-radius: 6px;
        clip: true;
        background: Theme.gray-200;
        Image {
            width: parent.width;
            height: parent.height;
            source: p.image;
            image-fit: cover;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                PersonsBus.sr-open-image(root.owner, i);
            }
            // a message's picture: its message's menu (the brief's have none)
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.right && root.owner != "brief" {
                    PersonsBus.msg-menu(root.owner, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
}

// Files that aren't pictures: a chip each, opened by the system.
component SrFiles inherits HorizontalLayout {
    in property <[string]> names;
    in property <string> owner;
    in property <color> ink: Theme.fg;
    spacing: 6px;
    alignment: start;
    for n[i] in root.names: Rectangle {
        height: 24px;
        width: fl.preferred-width + 16px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        background: fa.has-hover ? Theme.gray-200 : transparent;
        fl := HorizontalLayout {
            x: 8px;
            spacing: 4px;
            Glyph {
                icon: Icons.file;
                size: 12px;
                color: root.ink;
            }
            Text {
                text: n;
                font-size: 12px;
                color: root.ink;
                vertical-alignment: center;
            }
        }
        fa := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                PersonsBus.sr-open-file(root.owner, i);
            }
        }
    }
}

// RequestBrief: a compact card: "Request brief", "Website · Opened by SpokPay · 19 Nov 2026", the summary, a divider,
// the brief's parts (small muted label, the text under it), the pictures.
component SrBrief inherits Rectangle {
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg100;
    // Every wrapped text gets its width here: inside the repeated fact rows (two half ones side by side) a layout's
    // height was worked out before its texts knew their width, one line short per wrapped one, and the card ended
    // above its last fact, which then drew over the timeline below it.
    property <length> inner-w: max(0px, root.width - 32px);
    property <length> half-w: max(0px, (root.inner-w - 16px) / 2);
    height: col.preferred-height;
    col := VerticalLayout {
        padding: 16px;
        spacing: 12px;
        VerticalLayout {
            spacing: 2px;
            Text {
                text: PersonsBus.sr-brief-title;
                font-size: 14px;
                font-weight: 600;
                color: Theme.fg;
            }
            Text {
                width: root.inner-w;
                text: PersonsBus.sr-brief-sub;
                font-size: 13px;
                color: Theme.subtle;
                wrap: word-wrap;
            }
        }
        if PersonsBus.sr-summary != "": Text {
            width: root.inner-w;
            text: PersonsBus.sr-summary;
            font-size: 14px;
            color: Theme.fg;
            wrap: word-wrap;
        }
        if PersonsBus.sr-facts.length > 0 && PersonsBus.sr-summary != "": Rectangle {
            height: 1px;
            background: Theme.border;
        }
        for f in PersonsBus.sr-facts: HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                width: f.two ? root.half-w : root.inner-w;
                alignment: start;
                spacing: 4px;
                Text {
                    text: f.a-label;
                    font-size: 12px;
                    color: Theme.subtle;
                }
                Text {
                    width: f.two ? root.half-w : root.inner-w;
                    text: f.a-text;
                    font-size: 14px;
                    color: Theme.fg;
                    wrap: word-wrap;
                }
            }
            if f.two: VerticalLayout {
                width: root.half-w;
                alignment: start;
                spacing: 4px;
                Text {
                    text: f.b-label;
                    font-size: 12px;
                    color: Theme.subtle;
                }
                Text {
                    width: root.half-w;
                    text: f.b-text;
                    font-size: 14px;
                    color: Theme.fg;
                    wrap: word-wrap;
                }
            }
        }
        if PersonsBus.sr-brief-imgs.length > 0: SrGallery {
            imgs: PersonsBus.sr-brief-imgs;
            owner: "brief";
        }
        if PersonsBus.sr-brief-files.length > 0: SrFiles {
            names: PersonsBus.sr-brief-files;
            owner: "brief";
        }
    }
}

// RequestLine: an event as a centered muted line; a message as the author and time over its bubble, with the avatar
// beside the run's last one (the store's on the left, SpokPay's on the right). A right-click on a bubble opens the
// person chats' message menu (ui.ts srMsgMenu). A turn with the Person AI (kind "ai": the note sent from this pane, or
// the AI's answer) is the person chats' own AI card (Bubble: fold, copy, reply drafts with "Use as reply", its menu).
component SrLine {
    in property <PSrItem> it;
    in property <length> max-w;
    property <bool> is-ai: root.it.kind == "ai";
    property <length> pad-x: 12px;
    property <length> text-w: min(root.max-w * 0.85 - 2 * pad-x, body.preferred-width);
    property <length> img-w: root.it.images.length == 0 ? 0px : gal.preferred-width;
    property <length> bubble-w: min(root.max-w * 0.85, max(root.it.text == "" ? 0px : text-w + 2 * pad-x, img-w + 8px));
    property <length> r-in: 4px; // a joined corner (rounded-sm)
    property <length> r-out: 8px;
    height: root.it.kind == "event" ? 28px : root.is-ai ? card.preferred-height + 6px : lay.preferred-height;
    card := Bubble {
        y: 6px;
        width: root.width;
        visible: root.is-ai;
        m: root.it.ai;
        max-w: root.max-w;
        menu(x, y) => {
            PersonsBus.msg-menu(root.it.ai.id, x, y);
        }
    }
    if root.it.kind == "event": Text {
        width: root.width;
        height: root.height;
        text: root.it.text;
        font-size: 12px;
        color: Theme.subtle;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    lay := HorizontalLayout {
        visible: root.it.kind == "msg";
        width: root.width;
        padding-top: root.it.joins-prev ? 2px : 10px;
        spacing: 12px;
        alignment: root.it.mine ? end : start;
        // the avatar column (left for the store)
        if !root.it.mine: VerticalLayout {
            width: 32px;
            alignment: end;
            if root.it.avatar: SrLogo { }
        }
        VerticalLayout {
            spacing: 4px;
            if root.it.head != "": Text {
                text: root.it.head;
                font-size: 12px;
                color: Theme.subtle;
                horizontal-alignment: root.it.mine ? right : left;
            }
            HorizontalLayout {
                alignment: root.it.mine ? end : start;
                Rectangle {
                    width: root.bubble-w;
                    border-top-left-radius: !root.it.mine && root.it.joins-prev ? root.r-in : root.r-out;
                    border-bottom-left-radius: !root.it.mine && root.it.joins-next ? root.r-in : root.r-out;
                    border-top-right-radius: root.it.mine && root.it.joins-prev ? root.r-in : root.r-out;
                    border-bottom-right-radius: root.it.mine && root.it.joins-next ? root.r-in : root.r-out;
                    border-width: root.it.mine ? 0px : 1px;
                    border-color: Theme.border;
                    background: root.it.mine ? Theme.fg : Theme.bg200;
                    // under the text and pictures: a right-click opens the person chats' message menu (msg-menu)
                    TouchArea {
                        z: -1;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                                PersonsBus.msg-menu(root.it.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    VerticalLayout {
                        padding-left: root.it.text == "" ? 4px : root.pad-x;
                        padding-right: root.it.text == "" ? 4px : root.pad-x;
                        padding-top: root.it.text == "" ? 4px : 8px;
                        padding-bottom: root.it.text == "" ? 4px : 8px;
                        spacing: 6px;
                        body := Text {
                            visible: root.it.text != "";
                            height: root.it.text == "" ? 0px : self.preferred-height;
                            width: root.text-w;
                            text: root.it.text;
                            font-size: 13px;
                            color: root.it.mine ? Theme.bg100 : Theme.fg;
                            wrap: word-wrap;
                        }
                        gal := SrGallery {
                            visible: root.it.images.length > 0;
                            imgs: root.it.images;
                            owner: root.it.id;
                        }
                        if root.it.files.length > 0: SrFiles {
                            names: root.it.files;
                            owner: root.it.id;
                            ink: root.it.mine ? Theme.bg100 : Theme.fg;
                        }
                    }
                }
            }
        }
        if root.it.mine: VerticalLayout {
            width: 32px;
            alignment: end;
            if root.it.avatar: SrSpokPayAvatar { }
        }
    }
}

component SrPane inherits Rectangle {
    property <bool> at-bottom: true;
    changed width => {
        root.at-bottom = true;
    }
    VerticalLayout {
        // ThreadHeader
        Rectangle {
            height: head.preferred-height;
            head := HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 12px;
                if PersonsBus.side-hidden: VerticalLayout {
                    alignment: center;
                    ShowSideBtn {
                        clicked => {
                            PersonsBus.side-hidden = false;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Btn {
                        icon: Icons.arrow-left;
                        size: BtnSize.icon-xs;
                        variant: Variant.ghost-muted;
                        tip: "Back to requests (Esc)";
                        clicked => {
                            PersonsBus.sr-close();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    SrLogo {
                        size: 48px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 0;
                            max-width: self.preferred-width;
                            text: PersonsBus.sr-subject;
                            font-size: 18px;
                            font-weight: 600;
                            color: Theme.fg;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if PersonsBus.sr-status != "": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 22px;
                                width: pill.preferred-width + 18px;
                                border-radius: 11px;
                                border-width: 1px;
                                border-color: SrLook.pill-line(PersonsBus.sr-tone);
                                background: SrLook.pill-bg(PersonsBus.sr-tone);
                                pill := Text {
                                    text: PersonsBus.sr-status;
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: SrLook.pill-fg(PersonsBus.sr-tone);
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 0px;
                        Text {
                            horizontal-stretch: 0;
                            text: PersonsBus.sr-store + " · ";
                            font-size: 13px;
                            color: Theme.subtle;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        ref := Rectangle {
                            horizontal-stretch: 0;
                            width: rl.preferred-width;
                            rl := HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: PersonsBus.sr-ref;
                                    font-size: 13px;
                                    color: ra.has-hover ? Theme.fg : Theme.subtle;
                                    vertical-alignment: center;
                                }
                                Glyph {
                                    icon: Icons.copy;
                                    size: 12px;
                                    color: ra.has-hover ? Theme.fg : Theme.subtle;
                                }
                            }
                            ra := TipArea {
                                tip: "Copy the request's link";
                                clicked => {
                                    PersonsBus.sr-copy();
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
                // the status select (SpokPay's own moves; a final one asks first)
                if PersonsBus.sr-status != "": VerticalLayout {
                    alignment: center;
                    st := Btn {
                        text: PersonsBus.sr-moving ? "Moving…" : PersonsBus.sr-status;
                        trailing: Icons.down;
                        size: BtnSize.sm;
                        variant: Variant.outline;
                        enabled: PersonsBus.sr-can-move && !PersonsBus.sr-moving;
                        tip: PersonsBus.sr-finished ? "Final: SpokPay doesn't move it again" : "Status";
                        clicked => {
                            PersonsBus.sr-status-menu(self.absolute-position.x, self.absolute-position.y + self.height + 4px);
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }
        // the conversation: the brief, then events and messages in order
        Rectangle {
            vertical-stretch: 1;
            if PersonsBus.sr-loading && PersonsBus.sr-items.length == 0 && PersonsBus.sr-brief-sub == "": Spinner { }
            if PersonsBus.sr-error != "" && PersonsBus.sr-brief-sub == "": VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: "Could not load " + PersonsBus.sr-ref;
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.fg;
                    horizontal-alignment: center;
                }
                Text {
                    text: PersonsBus.sr-error;
                    font-size: 13px;
                    color: Theme.subtle;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    Btn {
                        text: "Try again";
                        icon: Icons.rotate-cw;
                        size: BtnSize.sm;
                        variant: Variant.outline;
                        clicked => {
                            PersonsBus.sr-retry();
                        }
                    }
                }
            }
            if PersonsBus.sr-brief-sub != "": sv := Scroll {
                property <length> col-w: min(self.visible-width - 48px, 768px);
                changed content-height => {
                    if root.at-bottom {
                        self.content-y = min(0px, self.visible-height - self.content-height);
                    }
                }
                changed visible-height => {
                    if root.at-bottom {
                        self.content-y = min(0px, self.visible-height - self.content-height);
                    }
                }
                scrolled => {
                    root.at-bottom = self.content-y <= self.visible-height - self.content-height + 40px;
                }
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: sv.col-w;
                        alignment: start;
                        padding-top: 20px;
                        padding-bottom: 12px;
                        spacing: 4px;
                        if PersonsBus.sr-note != "": Text {
                            text: PersonsBus.sr-note;
                            font-size: 12px;
                            color: Theme.amber-900;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        SrBrief { }
                        if PersonsBus.sr-more: Text {
                            text: "Older messages are on spokpay.com.";
                            font-size: 12px;
                            color: Theme.subtle;
                            horizontal-alignment: center;
                        }
                        for it in PersonsBus.sr-items: SrLine {
                            it: it;
                            max-w: sv.col-w - 44px;
                        }
                    }
                }
            }
        }
        if PersonsBus.sr-finished && PersonsBus.sr-brief-sub != "": Rectangle {
            height: fin.preferred-height;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }
            fin := Text {
                x: 16px;
                width: parent.width - 32px;
                text: PersonsBus.sr-finished-note;
                font-size: 14px;
                color: Theme.subtle;
                wrap: word-wrap;
                vertical-alignment: center;
                min-height: 46px;
            }
        }
        // the person chats' composer: To <owner>, "Message <owner> on SpokPay", attach, To: AI | <owner>, Send
        if !PersonsBus.sr-finished && PersonsBus.sr-brief-sub != "": Composer { }
    }
    // another request opened: its end shows
    property <int> rev: PersonsBus.sr-rev;
    changed rev => {
        root.at-bottom = true;
    }
}


// ---------- the person panel ----------

component Panel inherits PanelSurface {
    property <length> inner-w: self.width - 36px;
    VerticalLayout {
        // top bar: position, prev / next, close (as tall as the chat's header beside it)
        Rectangle {
            height: Ds.bar-h;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 8px;
                spacing: 2px;
                Text {
                    text: PersonsBus.p-pos;
                    font-size: Ds.t-meta;
                    color: Theme.subtle;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Btn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.up;
                    size: BtnSize.icon-xs;
                    variant: Variant.ghost-muted;
                    tip: "Previous";
                    clicked => {
                        PersonsBus.prev();
                    }
                }
                Btn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.down;
                    size: BtnSize.icon-xs;
                    variant: Variant.ghost-muted;
                    tip: "Next";
                    clicked => {
                        PersonsBus.next();
                    }
                }
                Btn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.x;
                    size: BtnSize.icon-xs;
                    variant: Variant.ghost-muted;
                    tip: "Close details";
                    clicked => {
                        PersonsBus.toggle-panel();
                    }
                }
            }
        }
        Scroll {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 18px;
                padding-top: 4px;
                spacing: 20px;
                alignment: start;
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: center;
                        Avatar {
                            size: 84px;
                            initials: PersonsBus.p-initials;
                            color: PersonsBus.p-color;
                            photo: PersonsBus.p-avatar;
                            has-photo: PersonsBus.p-has-avatar;
                        }
                    }
                    Text {
                        text: PersonsBus.p-name;
                        font-size: 18px;
                        font-weight: 600;
                        letter-spacing: -0.3px;
                        color: Theme.fg;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if PersonsBus.p-sub != "": Text {
                        text: PersonsBus.p-sub;
                        font-size: Ds.t-meta;
                        color: Theme.subtle;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Btn {
                            text: "Edit";
                            icon: Icons.pen-line;
                            size: BtnSize.xs;
                            clicked => {
                                PersonsBus.menu-pick("panel:edit");
                            }
                        }
                        Btn {
                            text: "Rename";
                            size: BtnSize.xs;
                            clicked => {
                                PersonsBus.menu-pick("panel:rename");
                            }
                        }
                        Btn {
                            icon: Icons.trash;
                            size: BtnSize.icon-xs;
                            variant: Variant.ghost-destructive;
                            tip: "Delete";
                            clicked => {
                                PersonsBus.menu-pick("panel:delete");
                            }
                        }
                        Btn {
                            text: "⋯";
                            size: BtnSize.xs;
                            variant: Variant.ghost-muted;
                            tip: "More: Link with…, Unlink";
                            clicked => {
                                PersonsBus.panel-menu(self.absolute-position.x, self.absolute-position.y + self.height + 4px);
                            }
                        }
                    }
                }
                // People linked into this one (Link with…): one chat over all their channels; Unlink splits one back out
                if PersonsBus.p-linked.length > 0: PanelSection {
                    title: "LINKED (" + PersonsBus.p-linked.length + ")";
                    action: "Link…";
                    action-icon: Icons.link;
                    act => {
                        PersonsBus.menu-pick("panel:link");
                    }
                    for l in PersonsBus.p-linked: HorizontalLayout {
                        spacing: 8px;
                        height: 36px;
                        VerticalLayout {
                            alignment: center;
                            Avatar {
                                size: 22px;
                                initials: l.initials;
                                color: l.color;
                                photo: l.avatar;
                                has-photo: l.has-avatar;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: l.name;
                                font-size: Ds.t-sm;
                                color: Theme.fg;
                                overflow: elide;
                            }
                            if l.sub != "": Text {
                                text: l.sub;
                                font-size: Ds.t-xs;
                                color: Theme.gray-800;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                text: "Unlink";
                                size: BtnSize.xs;
                                variant: Variant.ghost-muted;
                                tip: "Split " + l.name + " back out as their own person";
                                clicked => {
                                    PersonsBus.unlink(l.id);
                                }
                            }
                        }
                    }
                }
                PanelSection {
                    title: "NOTES";
                    TextBox {
                        hint: "Notes about them…";
                        text <=> PersonsBus.p-notes;
                        left(t) => {
                            PersonsBus.save-notes(t);
                        }
                    }
                }
                // Socials (Person Hub's PersonSocials): each profile (platform, @handle link, remove) over its 3 latest
                // uploads as 16:9 cards; Add takes a TikTok / Instagram / YouTube profile link
                PanelSection {
                    title: PersonsBus.p-socials.length > 0 ? "SOCIALS (" + PersonsBus.p-socials.length + ")" : "SOCIALS";
                    action: "Add";
                    action-icon: Icons.plus;
                    act => {
                        PersonsBus.menu-pick("panel:add-social");
                    }
                    if PersonsBus.p-socials.length == 0: Text {
                        text: PersonsBus.p-socials-loading ? "Reading their profiles…" : "No profiles yet: Add a TikTok, Instagram or YouTube link.";
                        font-size: Ds.t-sm;
                        color: Theme.subtle;
                        wrap: word-wrap;
                    }
                    for s in PersonsBus.p-socials: VerticalLayout {
                        spacing: 6px;
                        padding-bottom: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            height: 24px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    border-radius: Ds.radius-sm;
                                    background: s.platform == "YouTube" ? #ff0033 : s.platform == "TikTok" ? #111111 : s.platform == "Instagram" ? #d62976 : Theme.gray-500;
                                    Text {
                                        text: s.platform == "YouTube" ? "▶" : s.platform == "TikTok" ? "♪" : s.platform == "Instagram" ? "◎" : "↗";
                                        font-size: 10px;
                                        color: white;
                                    }
                                }
                            }
                            Text {
                                text: s.handle;
                                font-size: Ds.t-sm;
                                color: handle-area.has-hover ? Theme.fg : Theme.subtle;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                                handle-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        PersonsBus.open-url(s.url);
                                    }
                                }
                            }
                            Btn {
                                icon: Icons.x;
                                size: BtnSize.icon-xs;
                                variant: Variant.ghost-muted;
                                tip: "Remove this profile";
                                clicked => {
                                    PersonsBus.menu-pick("panel:remove-social:" + s.url);
                                }
                            }
                        }
                        if s.note != "": Text {
                            text: s.note;
                            font-size: Ds.t-xs;
                            color: Theme.subtle;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            for u in s.uploads: VerticalLayout {
                                width: (root.inner-w - 12px) / 3;
                                spacing: 3px;
                                Rectangle {
                                    height: self.width * 9 / 16;
                                    border-radius: Ds.radius-md;
                                    background: Theme.gray-200;
                                    clip: true;
                                    if u.has-thumb: Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: u.thumb;
                                        image-fit: cover;
                                    }
                                }
                                Rectangle {
                                    // two lines at most
                                    height: min(31px, ut.preferred-height);
                                    clip: true;
                                    ut := Text {
                                        y: 0;
                                        width: parent.width;
                                        text: u.title;
                                        font-size: 12px;
                                        color: Theme.fg;
                                        wrap: word-wrap;
                                        vertical-alignment: top;
                                    }
                                }
                                Text {
                                    text: u.meta;
                                    font-size: 11px;
                                    color: Theme.subtle;
                                    overflow: elide;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        PersonsBus.open-url(u.url);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------- popups (ds-surface.slint's MenuPanel and DialogFrame) ----------

component Menu inherits MenuPanel {
    in property <[PMenu]> items: PersonsBus.menu;
    // the submenu itself: its entries open nothing further
    in property <bool> nested;
    menu-w: PersonsBus.menu-w;
    for it in root.items: Rectangle {
        height: it.sep ? 9px : it.header ? 28px : it.sub != "" ? 44px : 32px;
        // Each entry fills its slot (without a size a child of a Rectangle gets its preferred width, 0, and is
        // centred: an empty menu with a dash in it).
        if it.sep: MenuSeparator {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
        }
        if it.header: MenuLabel {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: it.label;
        }
        // A channel (Discord, Gmail, WhatsApp) is its mark in the icon's place.
        property <bool> brand: it.icon == "discord" || it.icon == "gmail" || it.icon == "whatsapp" || it.icon == "instagram";
        if !it.sep && !it.header: MenuItem {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            icon: parent.brand ? " " : it.icon;
            label: it.label;
            desc: it.sub;
            hint: it.hint;
            danger: it.danger;
            enabled: !it.disabled;
            checked: it.checked;
            submenu: it.submenu;
            open: it.submenu && PersonsBus.sub-open && PersonsBus.sub-of == it.id;
            hovered => {
                if !root.nested {
                    PersonsBus.menu-hover(it.id, self.absolute-position.y);
                }
            }
            clicked => {
                if it.submenu {
                    PersonsBus.menu-hover(it.id, self.absolute-position.y);
                } else {
                    PersonsBus.menu-pick(it.id);
                }
            }
        }
        if !it.sep && !it.header && (it.icon == "discord" || it.icon == "gmail" || it.icon == "whatsapp" || it.icon == "instagram"): ChannelMark {
            x: 9px;
            y: 9px;
            kind: it.icon;
            size: 14px;
        }
    }
}

/** A row of choices (stores, lists, colours) in the dialogs: chips that wrap at the box's width. */
component Choices inherits HorizontalLayout {
    in property <[PChip]> chips;
    spacing: 6px;
    alignment: start;
    for c in root.chips: Chip {
        text: c.label;
        on: c.on;
        sm: true;
        clicked => {
            PersonsBus.chip(c.id);
        }
    }
}

/** Forward to Projects: the forwarded message as a quote (author · time · section, its words), a blue bar on its left. */
component FwdQuote inherits Rectangle {
    border-radius: Ds.radius-md;
    background: Theme.fg.with-alpha(0.06);
    clip: true;
    height: min(140px, fq-col.preferred-height);
    Rectangle {
        x: 0;
        width: 2px;
        background: Theme.blue-700;
    }
    fq-col := VerticalLayout {
        padding: 8px;
        padding-left: 12px;
        spacing: 3px;
        HorizontalLayout {
            Text {
                text: PersonsBus.fp-author;
                font-size: Ds.t-xs;
                font-weight: 500;
                color: Theme.fg;
            }
            Text {
                text: PersonsBus.fp-meta;
                font-size: Ds.t-xs;
                color: Theme.subtle;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        Text {
            text: PersonsBus.fp-text;
            font-size: Ds.t-sm;
            color: Theme.fg;
            wrap: word-wrap;
        }
    }
}

/** Forward to Projects' prompt: a few lines, focused when the dialog opens; Ctrl+Enter sends, Esc closes the dialog. */
component FwdPrompt {
    in property <string> hint;
    height: max(84px, fp-field.preferred-height + 18px);
    init => {
        fp-field.focus();
    }
    // the picker closed: the prompt has the keys again
    property <int> fp-rev: PersonsBus.fp-focus-rev;
    changed fp-rev => {
        fp-field.focus();
    }
    FocusScope {
        capture-key-pressed(e) => {
            if e.text == Key.Return && (e.modifiers.control || e.modifiers.meta) {
                PersonsBus.dialog-ok();
                return accept;
            }
            if e.text == Key.Escape {
                PersonsBus.dialog-cancel();
                return accept;
            }
            return reject;
        }
        Rectangle {
            border-radius: Ds.radius-md;
            border-width: 1px;
            border-color: fp-field.has-focus ? Theme.gray-1000 : Theme.border;
            background: Theme.bg100;
        }
        if fp-field.text == "": Text {
            x: 10px;
            y: 9px;
            width: parent.width - 20px;
            text: root.hint;
            font-size: Ds.t-sm;
            color: Theme.gray-800;
            wrap: word-wrap;
        }
        fp-field := TextInput {
            x: 10px;
            y: 9px;
            width: parent.width - 20px;
            text <=> PersonsBus.fp-prompt;
            font-size: Ds.t-sm;
            color: Theme.fg;
            wrap: word-wrap;
            single-line: false;
            selection-background-color: Theme.dark ? Theme.blue-500 : Theme.blue-400;
            selection-foreground-color: Theme.fg;
            edited => {
                PersonsBus.fp-edited(self.text);
            }
        }
    }
}

/** Forward to Projects' project: its name, its path (right, muted) and the up/down chevrons; a click opens the picker. */
component FwdTarget inherits Rectangle {
    height: 32px;
    border-radius: Ds.radius-md;
    border-width: 1px;
    border-color: PersonsBus.fp-open ? Theme.fg : Theme.border;
    background: ft-touch.has-hover && !PersonsBus.fp-open ? Theme.gray-100 : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Glyph {
            width: 14px;
            icon: Icons.folder;
            size: 14px;
            color: Theme.subtle;
        }
        Text {
            text: PersonsBus.fp-name;
            font-size: Ds.t-sm;
            color: Theme.fg;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: PersonsBus.fp-path;
            font-family: "Geist Mono";
            font-size: Ds.t-xs;
            color: Theme.gray-800;
            horizontal-stretch: 1;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        Glyph {
            width: 14px;
            icon: Icons.chevrons-up-down;
            size: 14px;
            color: Theme.subtle;
        }
    }
    ft-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            PersonsBus.fp-x = root.absolute-position.x;
            PersonsBus.fp-y = root.absolute-position.y;
            PersonsBus.fp-w = root.width;
            PersonsBus.fp-h = root.height;
            PersonsBus.fp-toggle();
        }
    }
}

/** Forward to Projects' picker: a search over names and paths, then Recent and All projects (path right, muted; a green
 *  dot while a chat of it works; the picked one ticked). Up / Down / Enter pick from the keyboard, Esc closes it. */
component FwdPicker inherits PopoverFrame {
    height: 35px + PersonsBus.fp-list-h;
    drop-shadow-offset-y: 12px;
    drop-shadow-blur: 28px;
    drop-shadow-color: black.with-alpha(Theme.dark ? 90 / 255 : 24 / 255);
    TouchArea { }
    Rectangle {
        y: 0;
        height: 34px;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 8px;
            Glyph {
                width: 14px;
                icon: Icons.search;
                size: 14px;
                color: Theme.gray-800;
            }
            FocusScope {
                horizontal-stretch: 1;
                capture-key-pressed(e) => {
                    if e.text == Key.UpArrow {
                        PersonsBus.fp-key("up");
                        return accept;
                    }
                    if e.text == Key.DownArrow {
                        PersonsBus.fp-key("down");
                        return accept;
                    }
                    if e.text == Key.Return {
                        PersonsBus.fp-key("enter");
                        return accept;
                    }
                    if e.text == Key.Escape {
                        PersonsBus.fp-key("escape");
                        return accept;
                    }
                    return reject;
                }
                if fps-field.text == "": Text {
                    x: 0;
                    width: parent.width;
                    horizontal-alignment: left;
                    text: "Search projects…";
                    font-size: Ds.t-sm;
                    color: Theme.gray-800;
                    vertical-alignment: center;
                }
                fps-field := TextInput {
                    x: 0;
                    width: parent.width;
                    text <=> PersonsBus.fp-query;
                    font-size: Ds.t-sm;
                    color: Theme.fg;
                    vertical-alignment: center;
                    single-line: true;
                    init => {
                        self.focus();
                    }
                    edited => {
                        PersonsBus.fp-search(self.text);
                    }
                }
            }
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.border;
        }
    }
    Rectangle {
        y: 35px;
        height: PersonsBus.fp-list-h;
        clip: true;
        Scroll {
            VerticalLayout {
                padding: 4px;
                for r in PersonsBus.fp-rows: Rectangle {
                    height: r.kind == "head" ? 26px : 32px;
                    border-radius: 4px;
                    background: r.kind == "item" && (r.hi || fpr-touch.has-hover) ? Theme.gray-200 : transparent;
                    if r.kind == "head": CapsLabel {
                        x: 8px;
                        y: 6px;
                        height: 20px;
                        text: r.name;
                    }
                    if r.kind == "empty": Text {
                        x: 8px;
                        text: r.name;
                        font-size: Ds.t-sm;
                        color: Theme.subtle;
                        vertical-alignment: center;
                    }
                    if r.kind == "item": HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Glyph {
                            width: 14px;
                            icon: Icons.folder;
                            size: 14px;
                            color: Theme.subtle;
                        }
                        Text {
                            text: r.name;
                            font-size: Ds.t-sm;
                            color: Theme.fg;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if r.dot: Rectangle {
                            width: 6px;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.green-700;
                            }
                        }
                        if r.on: Glyph {
                            width: 14px;
                            icon: Icons.check;
                            size: 14px;
                            color: Theme.fg;
                        }
                        Text {
                            text: r.path;
                            font-size: Ds.t-xs;
                            color: Theme.gray-800;
                            horizontal-stretch: 1;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    fpr-touch := TouchArea {
                        enabled: r.kind == "item";
                        mouse-cursor: r.kind == "item" ? pointer : default;
                        clicked => {
                            PersonsBus.fp-pick(r.id);
                        }
                    }
                }
            }
        }
    }
}

component Dialog inherits DialogFrame {
    title: PersonsBus.d-title;
    text: PersonsBus.d-text;
    box-w: PersonsBus.dialog == "qr" ? 300px : PersonsBus.dialog == "person" || PersonsBus.dialog == "link" ? 512px : 448px;
    scrim-dismisses: PersonsBus.dialog != "fwd-project";
    dismiss => {
        PersonsBus.dialog-cancel();
    }
    if PersonsBus.dialog == "qr": HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 260px;
            height: 260px;
            background: white;
            border-radius: Ds.radius-lg;
            if PersonsBus.has-qr: Image {
                width: 240px;
                height: 240px;
                source: PersonsBus.qr;
                image-rendering: pixelated;
            }
            if !PersonsBus.has-qr: Text {
                text: "Getting a code…";
                color: #444;
                font-size: Ds.t-sm;
            }
        }
    }
    if PersonsBus.dialog == "social": Input {
        hint: "tiktok.com/@…, instagram.com/…, youtube.com/@…";
        text <=> PersonsBus.f-socials;
        accepted => {
            PersonsBus.dialog-ok();
        }
    }
    // Link with…: everyone else, searchable; a click picks or unpicks
    if PersonsBus.dialog == "link": VerticalLayout {
        spacing: 8px;
        link-search := SearchField {
            hint: "Search people";
            text <=> PersonsBus.f-query;
            init => {
                self.focus-field();
            }
            edited(t) => {
                PersonsBus.pick-query(t);
            }
        }
        Rectangle {
            height: 300px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Ds.radius-lg;
            clip: true;
            Scroll {
                VerticalLayout {
                    padding: 4px;
                    for p in PersonsBus.f-picks: Rectangle {
                        height: Ds.row2-h;
                        ListRow {
                            width: parent.width;
                            height: parent.height;
                            lead: "avatar";
                            letter: p.initials;
                            tint: p.color;
                            image: p.avatar;
                            has-image: p.has-avatar;
                            title: p.name;
                            sub: p.sub;
                            active: p.on;
                            clicked => {
                                PersonsBus.pick-toggle(p.id);
                            }
                        }
                        Rectangle {
                            x: parent.width - 30px;
                            y: (parent.height - 18px) / 2;
                            width: 18px;
                            height: 18px;
                            border-radius: 5px;
                            border-width: p.on ? 0px : 1px;
                            border-color: Theme.gray-600;
                            background: p.on ? Theme.fg : transparent;
                            if p.on: Glyph {
                                icon: Icons.check;
                                size: 12px;
                                color: Theme.bg100;
                            }
                        }
                    }
                    if PersonsBus.f-picks.length == 0: Text {
                        height: 40px;
                        text: "Nobody matches.";
                        font-size: Ds.t-sm;
                        color: Theme.subtle;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Text {
            text: PersonsBus.f-picked;
            font-size: Ds.t-sm;
            color: Theme.subtle;
            wrap: word-wrap;
        }
    }
    // Personal's Instagram: the session pasted from a browser's cookies
    if PersonsBus.dialog == "session": Input {
        hint: "sessionid=…; ds_user_id=…";
        text <=> PersonsBus.f-socials;
        accepted => {
            PersonsBus.dialog-ok();
        }
    }
    // Personal › Add contact: the platform, then their number or username (resolved there before it's saved)
    if PersonsBus.dialog == "contact": VerticalLayout {
        spacing: 12px;
        VerticalLayout {
            spacing: 6px;
            FieldLabel {
                text: "Platform";
            }
            Choices {
                chips: PersonsBus.f-chips;
            }
        }
        Field {
            label: PersonsBus.f-handle-label;
            hint: PersonsBus.f-handle-hint;
            text <=> PersonsBus.f-discord;
            accepted => {
                PersonsBus.dialog-ok();
            }
        }
        Field {
            label: "Name";
            hint: "Optional: your name for them (empty: theirs there)";
            text <=> PersonsBus.f-name;
            accepted => {
                PersonsBus.dialog-ok();
            }
        }
    }
    if PersonsBus.dialog == "rename": Input {
        hint: "Name";
        text <=> PersonsBus.f-name;
        accepted => {
            PersonsBus.dialog-ok();
        }
    }
    if PersonsBus.dialog == "person": VerticalLayout {
        spacing: 12px;
        Field {
            label: "Name";
            hint: "Shown everywhere (empty: their Discord name)";
            text <=> PersonsBus.f-name;
        }
        Field {
            label: "Discord";
            hint: "User id or @username";
            text <=> PersonsBus.f-discord;
        }
        Field {
            label: "Email (Gmail)";
            hint: "name@example.com";
            text <=> PersonsBus.f-email;
        }
        Field {
            label: "WhatsApp";
            hint: "+55 11 91234-5678";
            text <=> PersonsBus.f-whatsapp;
        }
        Field {
            label: "Socials";
            hint: "TikTok, Instagram, YouTube links (space separated)";
            text <=> PersonsBus.f-socials;
        }
    }
    if PersonsBus.dialog == "proposal": VerticalLayout {
        spacing: 12px;
        Field {
            label: "Store";
            hint: "Its SpokPay slug (loja-exemplo)";
            text <=> PersonsBus.f-store;
        }
        Field {
            label: "Subject";
            hint: "What the store reads first";
            text <=> PersonsBus.f-subject;
        }
        VerticalLayout {
            spacing: 6px;
            FieldLabel {
                text: "Details";
            }
            TextBox {
                hint: "What to change, where, by when";
                min-h: 96px;
                text <=> PersonsBus.f-details;
            }
        }
    }
    if PersonsBus.dialog == "store": Field {
        label: "Name";
        hint: "Store name";
        text <=> PersonsBus.f-name;
    }
    if PersonsBus.dialog == "store": HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for c in PersonsBus.f-colors: Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            border-width: c.on ? 2px : 0px;
            border-color: Theme.fg;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: c.color;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    PersonsBus.color(c.id);
                }
            }
        }
    }
    if PersonsBus.f-chips.length > 0 && (PersonsBus.dialog == "person"): VerticalLayout {
        spacing: 6px;
        FieldLabel {
            text: "Stores and lists";
        }
        Choices {
            chips: PersonsBus.f-chips;
        }
        Choices {
            chips: PersonsBus.f-lists;
        }
    }
    // Forward to Projects: the message, the prompt, the project (the picker opens over the page: PersonsPage)
    if PersonsBus.dialog == "fwd-project": VerticalLayout {
        spacing: 16px;
        VerticalLayout {
            spacing: 6px;
            FieldLabel {
                text: "Message";
            }
            FwdQuote { }
        }
        VerticalLayout {
            spacing: 6px;
            FieldLabel {
                text: "Prompt";
            }
            FwdPrompt {
                hint: "What should change?";
            }
        }
        VerticalLayout {
            spacing: 6px;
            FieldLabel {
                text: "Project";
            }
            FwdTarget { }
        }
    }
    if PersonsBus.d-error != "": Text {
        text: PersonsBus.d-error;
        font-size: 12px;
        color: Theme.red-900;
        wrap: word-wrap;
    }
    if PersonsBus.dialog == "fwd-project": HorizontalLayout {
        spacing: 8px;
        padding-top: 8px;
        Text {
            text: "Ctrl+Enter to send";
            font-size: Ds.t-xs;
            color: Theme.gray-800;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Btn {
            text: "Cancel";
            size: BtnSize.sm;
            clicked => {
                PersonsBus.dialog-cancel();
            }
        }
        Btn {
            text: PersonsBus.d-busy ? "Sending…" : "Send";
            icon: Icons.send;
            size: BtnSize.sm;
            variant: Variant.primary;
            enabled: !PersonsBus.d-busy && PersonsBus.fp-can-send;
            clicked => {
                PersonsBus.dialog-ok();
            }
        }
    }
    if PersonsBus.dialog != "fwd-project": DialogActions {
        Btn {
            text: PersonsBus.dialog == "qr" ? "Close" : "Cancel";
            clicked => {
                PersonsBus.dialog-cancel();
            }
        }
        if PersonsBus.dialog != "qr": Btn {
            text: PersonsBus.d-busy ? "…" : PersonsBus.d-ok;
            enabled: !PersonsBus.d-busy;
            variant: PersonsBus.d-danger ? Variant.destructive : Variant.primary;
            clicked => {
                PersonsBus.dialog-ok();
            }
        }
    }
}

// The composer's emoji picker (over its smiley button): search on top (Enter takes the first, Esc closes), a tab per
// category, the grid (only the rows on screen exist), and the hovered emoji's name under it. A click puts the emoji into
// the draft at the cursor (over a selection) and closes it.
component EmojiPicker inherits PopoverFrame {
    property <length> cell: 36px;
    property <PEmojiCell> hover;
    property <int> rev: PersonsBus.emoji-rev;
    changed rev => {
        grid.content-y = 0;
    }
    width: 9 * root.cell + 2 * 8px + 6px;
    height: 360px;
    init => {
        search.focus-field();
    }
    TouchArea { }
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Rectangle {
            height: 32px;
            border-radius: Ds.radius-md;
            background: Theme.gray-100;
            search := SearchField {
                x: 6px;
                width: parent.width - 12px;
                hint: "Search emoji";
                text <=> PersonsBus.emoji-query;
                edited(t) => {
                    PersonsBus.emoji-search(t);
                }
                key(e) => {
                    if e.text == Key.Escape {
                        PersonsBus.emoji-toggle(0, 0);
                        return accept;
                    }
                    if e.text == Key.Return {
                        PersonsBus.emoji-first();
                        return accept;
                    }
                    return reject;
                }
            }
        }
        HorizontalLayout {
            height: 32px;
            spacing: 2px;
            for c[i] in PersonsBus.emoji-cats: Rectangle {
                horizontal-stretch: 1;
                border-radius: Ds.radius-md;
                background: PersonsBus.emoji-cat == i ? Theme.gray-200 : tab.has-hover ? Theme.gray-100 : transparent;
                Text {
                    text: c.icon;
                    font-size: 17px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    opacity: PersonsBus.emoji-cat == i || tab.has-hover ? 1 : 0.6;
                }
                tab := TipArea {
                    tip: c.label;
                    clicked => {
                        PersonsBus.emoji-tab(i);
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        Rectangle {
            vertical-stretch: 1;
            if PersonsBus.emoji-rows.length == 0: Text {
                text: PersonsBus.emoji-empty;
                font-size: Ds.t-sm;
                color: Theme.subtle;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            grid := ListView {
                width: parent.width;
                height: parent.height;
                vertical-scrollbar-policy: always-off;
                horizontal-scrollbar-policy: always-off;
                for r in PersonsBus.emoji-rows: HorizontalLayout {
                    height: root.cell;
                    alignment: start;
                    for c in r.cells: Rectangle {
                        width: root.cell;
                        height: root.cell;
                        border-radius: Ds.radius-md;
                        background: area.has-hover ? Theme.gray-200 : transparent;
                        Text {
                            text: c.e;
                            font-size: 24px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        area := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if self.has-hover {
                                    root.hover = c;
                                }
                            }
                            clicked => {
                                PersonsBus.emoji-pick(c.e);
                            }
                        }
                    }
                }
            }
            ScrollThumb {
                x: parent.width - self.width;
                height: parent.height;
                content-y: grid.content-y;
                content-height: grid.content-height;
                visible-height: grid.visible-height;
                scroll-to(y) => {
                    grid.content-y = y;
                }
            }
        }
        HorizontalLayout {
            height: 24px;
            spacing: 8px;
            Text {
                text: root.hover.e;
                font-size: 18px;
                vertical-alignment: center;
            }
            Text {
                text: root.hover.e == "" ? "" : root.hover.name;
                font-size: Ds.t-sm;
                color: Theme.subtle;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
}

// ---------- the page ----------

export component PersonsPage {
    /** The sidebar's width: Projects' (app.slint side-shown), so the header's buttons sit where they do there. */
    in property <length> side-w: Ds.side-w;
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                if PersonsBus.emoji-open {
                    PersonsBus.emoji-toggle(0, 0);
                } else if PersonsBus.menu-open {
                    PersonsBus.menu-close();
                } else if PersonsBus.dialog != "" {
                    PersonsBus.dialog-cancel();
                } else if PersonsBus.view == "chat" {
                    PersonsBus.close-chat();
                } else if PersonsBus.view == "sr" {
                    PersonsBus.sr-close();
                }
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            if !PersonsBus.side-hidden: Sidebar {
                width: root.side-w;
            }
            Rectangle {
                horizontal-stretch: 1;
                if PersonsBus.view == "loading": Spinner { }
                if PersonsBus.view == "list": ListPane { }
                if PersonsBus.view == "chat": ChatPane { }
                if PersonsBus.view == "sr": SrPane { }
            }
            if PersonsBus.view == "chat" && PersonsBus.panel: Panel {
                // Whole physical pixels: its hairline (PanelSurface) lands on one.
                width: round(Ds.panel-w / 1phx) * 1phx;
            }
        }
    }
    if PersonsBus.menu-open: TouchArea {
        clicked => {
            PersonsBus.menu-close();
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                PersonsBus.menu-close();
            }
        }
    }
    // where the menu lands (kept inside the window), so its submenu can open beside it
    property <length> menu-left: min(PersonsBus.menu-x - root.absolute-position.x, root.width - PersonsBus.menu-w - 8px);
    if PersonsBus.menu-open: Menu {
        x: root.menu-left;
        y: min(PersonsBus.menu-y - root.absolute-position.y, root.height - self.height - 8px);
    }
    // Projects' cascading submenu: right of the menu with its top on the entry's, flipped left at the window's edge,
    // shifted up at its bottom
    if PersonsBus.menu-open && PersonsBus.sub-open: Menu {
        items: PersonsBus.sub-menu;
        nested: true;
        menu-w: PersonsBus.sub-w;
        x: root.menu-left + PersonsBus.menu-w + 2px + self.width <= root.width - 4px ? root.menu-left + PersonsBus.menu-w + 2px : max(4px, root.menu-left - self.width - 2px);
        y: max(0px, min(PersonsBus.sub-y - root.absolute-position.y - 4px, root.height - self.height - 8px));
    }
    if PersonsBus.emoji-open: TouchArea {
        clicked => {
            PersonsBus.emoji-toggle(0, 0);
        }
    }
    if PersonsBus.emoji-open: EmojiPicker {
        x: max(8px, min(PersonsBus.emoji-x - root.absolute-position.x, root.width - self.width - 8px));
        y: max(8px, PersonsBus.emoji-y - root.absolute-position.y - self.height - 6px);
    }
    if PersonsBus.dialog != "": Dialog { }
    // Forward to Projects' picker, over the dialog: under the project field, or above it when there's no room below
    if PersonsBus.dialog == "fwd-project" && PersonsBus.fp-open: TouchArea {
        clicked => {
            PersonsBus.fp-open = false;
        }
    }
    if PersonsBus.dialog == "fwd-project" && PersonsBus.fp-open: FwdPicker {
        property <length> top: PersonsBus.fp-y - root.absolute-position.y;
        // which side is decided as it opens (at its tallest), so it doesn't jump while the search shortens it
        property <bool> up;
        init => {
            self.up = self.top + PersonsBus.fp-h + 4px + 35px + 304px > root.height - 8px;
        }
        x: PersonsBus.fp-x - root.absolute-position.x;
        width: PersonsBus.fp-w;
        y: self.up ? max(8px, self.top - 4px - self.height) : self.top + PersonsBus.fp-h + 4px;
    }
    if PersonsBus.toast != "": Toast {
        x: (root.width - self.width) / 2;
        y: root.height - 24px - self.height;
        text: PersonsBus.toast;
        action: PersonsBus.toast-action;
        act => {
            PersonsBus.toast-act();
        }
    }
}
