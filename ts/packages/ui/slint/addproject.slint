import "fonts/Geist-Regular.ttf";
import "fonts/Geist-Medium.ttf";
import "fonts/Geist-SemiBold.ttf";
import "fonts/GeistMono-Regular.ttf";
import "fonts/lucide.ttf";
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Btn, BtnSize, Glyph, Separator, Variant } from "widgets.slint";

export enum StatusTone { subtle, error, warn }

export enum AddKey { up, down, enter, add, back, esc }

export struct AddRow {
    glyph: string,
    logo: bool,
    title: string,
    detail: string,
}

export struct AddStatus {
    text: string,
    tone: StatusTone,
}

component Chip {
    in property <string> text;
    height: 20px;
    width: label.preferred-width + 10px;
    Rectangle {
        background: Theme.gray-100;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 4px;
    }
    label := Text {
        text: root.text;
        font-family: "Geist Mono";
        font-size: 12px;
        color: Theme.subtle;
        vertical-alignment: center;
    }
}

// addproject.rs `add_project_ui`: a 560 px box centred over a dimmed window; pointing only moves the highlight, the keys act.
export global AddProjectBus {
    in property <[AddRow]> rows;
    in property <[AddStatus]> statuses;
    in property <int> selected;
    in property <string> label;
    in property <string> hint;
    in property <bool> local;
    in property <bool> can-back;
    in property <image> github;
    in-out property <string> query;
    callback edited(string);
    callback key(AddKey);
    callback hover(int);
    callback back();
    callback add();
    callback open-files();
}

export component AddProjectOverlay inherits Rectangle {
    in property <[AddRow]> rows <=> AddProjectBus.rows;
    in property <[AddStatus]> statuses <=> AddProjectBus.statuses;
    in property <int> selected <=> AddProjectBus.selected;
    in property <string> label <=> AddProjectBus.label;
    in property <string> hint <=> AddProjectBus.hint;
    in property <bool> local <=> AddProjectBus.local;
    in property <bool> can-back <=> AddProjectBus.can-back;
    in property <image> github <=> AddProjectBus.github;
    in-out property <string> query <=> AddProjectBus.query;
    callback edited <=> AddProjectBus.edited;
    callback key <=> AddProjectBus.key;
    callback hover <=> AddProjectBus.hover;
    callback back <=> AddProjectBus.back;
    callback add <=> AddProjectBus.add;
    callback open-files <=> AddProjectBus.open-files;
    public function focus-field() {
        field.focus();
    }
    background: Theme.scrim;
    TouchArea {
        clicked => {
            root.key(AddKey.esc);
        }
    }
    box := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 560px;
        height: col.preferred-height;
        background: Theme.bg100;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius-xl;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;
        clip: true;
        TouchArea { }
        col := VerticalLayout {
            HorizontalLayout {
                height: 52px;
                padding-left: 12px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 6px;
                Btn {
                    icon: Icons.arrow-left;
                    variant: Variant.ghost-muted;
                    size: BtnSize.icon-xs;
                    enabled: root.can-back;
                    clicked => {
                        root.back();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    if field.text == "": Text {
                        x: 4px;
                        text: root.hint;
                        font-size: 14px;
                        color: Theme.subtle;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    field := TextInput {
                        text <=> AddProjectBus.query;
                        x: 4px;
                        width: parent.width - 8px;
                        font-size: 14px;
                        color: Theme.fg;
                        vertical-alignment: center;
                        single-line: true;
                        selection-background-color: Theme.dark ? Theme.blue-500 : Theme.blue-400;
                        selection-foreground-color: Theme.fg;
                        edited => {
                            root.edited(self.text);
                        }
                        key-pressed(e) => {
                            if e.text == Key.UpArrow {
                                root.key(AddKey.up);
                                return accept;
                            }
                            if e.text == Key.DownArrow {
                                root.key(AddKey.down);
                                return accept;
                            }
                            if e.text == Key.Return {
                                root.key(e.modifiers.control ? AddKey.add : AddKey.enter);
                                return accept;
                            }
                            if e.text == Key.Escape {
                                root.key(AddKey.esc);
                                return accept;
                            }
                            if e.text == Key.Backspace && self.text == "" {
                                root.key(AddKey.back);
                                return accept;
                            }
                            reject
                        }
                    }
                }
                if root.local: Rectangle {
                    width: add-row.preferred-width;
                    height: 28px;
                    y: (parent.height - 28px) / 2;
                    background: add-area.has-hover ? Theme.accent : Theme.bg100;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    add-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.add();
                        }
                    }
                    add-row := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 5px;
                        spacing: 8px;
                        alignment: center;
                        Text {
                            text: "Add";
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                        Chip {
                            text: "Ctrl Enter";
                            height: 18px;
                            y: 4px;
                        }
                    }
                }
            }
            Separator { }
            VerticalLayout {
                padding: 8px;
                min-height: 316px;
                alignment: start;
                Rectangle {
                    height: 4px;
                }
                HorizontalLayout {
                    height: 32px;
                    padding-left: 10px;
                    Text {
                        text: root.label;
                        font-size: 12px;
                        color: Theme.subtle;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 6px;
                }
                for s in root.statuses: HorizontalLayout {
                    padding-left: 10px;
                    padding-bottom: 6px;
                    Text {
                        text: s.text;
                        font-size: 13px;
                        wrap: word-wrap;
                        color: s.tone == StatusTone.error ? Theme.red-900 : s.tone == StatusTone.warn ? Theme.amber-900 : Theme.subtle;
                    }
                }
                ScrollView {
                    height: min(list.preferred-height, 340px);
                    list := VerticalLayout {
                        for r[i] in root.rows: row := Rectangle {
                            height: root.local ? 40px : 52px;
                            property <bool> on: i == root.selected;
                            if row.on: Rectangle {
                                background: Theme.accent;
                                border-radius: Theme.radius-md;
                            }
                            TouchArea {
                                moved => {
                                    if !row.on {
                                        root.hover(i);
                                    }
                                }
                                clicked => {
                                    root.hover(i);
                                }
                            }
                            if !r.logo: Glyph {
                                x: 20px - 10px;
                                width: 20px;
                                text: r.glyph;
                                font-size: 17px;
                                color: Theme.subtle;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if r.logo: Image {
                                x: 20px - 8.5px;
                                y: (parent.height - 17px) / 2;
                                width: 17px;
                                height: 17px;
                                source: root.github;
                            }
                            if root.local: Text {
                                x: 42px;
                                width: parent.width - 52px;
                                text: r.title;
                                font-size: 14px;
                                font-weight: 500;
                                color: Theme.fg;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if !root.local: Text {
                                x: 42px;
                                y: 8px;
                                width: parent.width - 52px;
                                text: r.title;
                                font-size: 14px;
                                font-weight: 500;
                                color: Theme.fg;
                                overflow: elide;
                            }
                            if !root.local: Text {
                                x: 42px;
                                y: 28px;
                                width: parent.width - 52px;
                                text: r.detail;
                                font-size: 12.5px;
                                color: Theme.subtle;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 40px;
                background: Theme.bg200;
                Separator {
                    y: 0;
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    for k in [{ cap: "↑ ↓", text: "Navigate" }, { cap: "Enter", text: "Select" }, { cap: "Backspace", text: "Back" }, { cap: "Esc", text: "Close" }]: HorizontalLayout {
                        padding-right: 18px;
                        spacing: 6px;
                        alignment: start;
                        Chip {
                            y: 10px;
                            text: k.cap;
                        }
                        Text {
                            text: k.text;
                            font-size: 13px;
                            color: Theme.subtle;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    if root.local: Text {
                        text: "Open in Files";
                        font-size: 13px;
                        color: files.has-hover ? Theme.fg : Theme.subtle;
                        vertical-alignment: center;
                        files := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-files();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AddProjectWindow inherits Window {
    in-out property <bool> dark <=> Theme.dark;
    width: 1400px;
    height: 900px;
    background: Theme.bg100;
    default-font-family: "Geist";
    overlay := AddProjectOverlay {
        width: root.width;
        height: root.height;
    }
    init => {
        overlay.focus-field();
    }
}
