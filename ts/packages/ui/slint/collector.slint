// Collector tab: leads (content creators) from YouTube, TikTok and Instagram. Five views, picked in the sidebar:
// Collector (the search form, one line while a run goes, and the leads it found), Available (every lead not
// Approved or Restricted), Approved (approved in a lead's review bar), Restricted (leads the user keeps out of
// Available) and History (every search run by day, as Headquarters' Timeline; a click shows the leads it found). A lead is a card: picture, name and handle, platform, profile link, their way of contact (email, WhatsApp, Discord or Instagram: found, or typed by hand)
// and followers; a click opens its detail, with the 3 newest videos, the review bar (Reject / Skip / Approve / Neobux, or Move to
// Available) and Send message (which adds them to Persons › Creators). The runs happen in the engine (ts/tabs/collector); CollectorBus is
// driven by src/tabs/collector/ui.ts, the same data Hub for Android shows. Built on Hub's design system (ds.slint,
// DESIGN.md): sidebar, page bar, cards, chips, inputs, a dialog.
import { Scroll, PageBar, Theme, Icons, Ds, Btn, Variant, BtnSize, Input, TipArea, Card, Well, Glyph, Empty, ListRow, SideSurface, SideHead, FieldLabel, Chip, Muted, Hint, Avatar, Spinner, ScrollThumb, CapsLabel, DialogFrame, DialogActions, TextBox, SearchField, PopoverFrame, MenuItem, MenuLabel, MenuSeparator } from "ds.slint";

export struct ClChip { value: string, label: string, on: bool, available: bool, tip: string }
/** A way to contact a lead (its card's contact line): the channel ("email", "whatsapp", "discord", "instagram"), its
 *  brand colour, as shown, "WhatsApp +55 … · from YouTube About", and its place in the lead's list. */
export struct ClContact { kind: string, color: color, text: string, tip: string, i: int }
export struct ClRow {
    id: string, name: string, handle: string, platform: string, url: string, short: string,
    avatar: image, has-avatar: bool, initials: string, color: color,
    email: string, restricted: bool, approved: bool,
    /** The best way to contact them ("" kind: none known: Add contact), the others' marks (3 at most) and how many more. */
    contact: ClContact, has-contact: bool, more: [ClContact], more-n: int,
    /** "9.2M followers" (YouTube subscribers count as followers); "" unknown. */
    followers: string,
}
export struct ClStat { icon: string, value: string, label: string }
/** One of the podium's videos (render order 2-1-3: the newest, featured, in the middle). */
export struct ClDVid { url: string, title: string, meta: string, thumb: image, has-thumb: bool, short: bool, featured: bool, empty: bool }
export struct ClReach { kind: string, label: string, color: color, on: bool }
export struct ClNav { id: string, label: string, count: int, on: bool }
export struct ClTpl { id: string, name: string, description: string, on: bool }
/** Where Send message can go: a Persons › Creators connection ("value": its id), the brand ("kind": email, whatsapp,
 *  discord, instagram) and its colour, "Email", who they are there, the account it goes from or why it can't. */
/** A place in Persons Send can put them in (a store, Creators, SpokPay, Personal; "store": a store's). */
export struct ClPlace { value: string, label: string, store: bool, on: bool }
export struct ClDest { value: string, kind: string, color: color, label: string, to: string, via: string, on: bool, available: bool }
/** The lists' Sort menu ("sep": a separator above it) and platform menu (brand colour, count on the list). */
export struct ClSort { value: string, label: string, on: bool, sep: bool }
export struct ClPlat { value: string, label: string, color: color, count: int, on: bool }
/** One line of History: a day's head ("day": label, first) or a run ("run": time, term, platform, how it went, its
 *  tone: "running", "done", "empty", "stopped", "failed"; last: the day's last, no line under its dot). */
export struct ClHist {
    kind: string, label: string, first: bool,
    id: string, time: string, query: string, platform: string, platform-key: string,
    line: string, note: string, tone: string, running: bool, last: bool,
}

export global CollectorBus {
    in property <bool> loading: true;
    in property <string> error;
    /** "collector", "available", "approved", "sent", "restricted" or "history". */
    in property <string> page: "collector";
    in property <[ClNav]> nav;
    // The form
    in property <[ClChip]> sources;
    in property <[ClChip]> gaps;
    /** The picked source can't run (its reason), or "". */
    in property <string> unavailable;
    in property <string> source-note;
    in-out property <string> query;
    in-out property <string> target;
    // Instagram's session (shown when Instagram is picked)
    in property <bool> show-session;
    in property <bool> session-on;
    in property <string> session-account;
    in property <string> session-help;
    in-out property <string> session-cookie;
    in property <bool> session-busy;
    // The run: one line while it goes, its outcome after
    in property <bool> running;
    in property <string> run-line;
    // The leads on the page (the run's on Collector; Available's or Restricted's, filtered)
    in property <[ClRow]> rows;
    in property <string> rows-head;
    in property <string> empty-title;
    in property <string> empty-desc;
    in-out property <string> filter;
    /** Each view's scroll, kept while Hub runs (the detail, a review, a refresh or another tab never moves it). A new
     *  filter, sort or platform choice starts its list at the top. */
    in-out property <length> y-collector;
    in-out property <length> y-available;
    in-out property <length> y-approved;
    in-out property <length> y-sent;
    in-out property <length> y-restricted;
    in property <int> n-available;
    in property <int> n-restricted;
    in property <int> n-approved;
    in property <int> n-sent;
    // History: every search run by day, newest first; a run opened shows its leads (rows)
    in property <[ClHist]> history;
    in property <int> n-runs;
    /** The run open ("" the timeline). */
    in property <string> history-run;
    in property <string> hr-query;
    in property <string> hr-platform-key;
    /** "YouTube · Today 08:26 · 20 new leads · 7 already collected". */
    in property <string> hr-sub;
    in property <string> hr-note;
    in property <string> hr-tone;
    in-out property <length> y-history;
    in property <string> copy-label;
    in-out property <bool> side-hidden;
    // Add contact: the card being edited, the channel picked, the text and its hint
    in property <string> contact-for;
    in property <[ClReach]> contact-kinds;
    in-out property <string> contact-text;
    in property <string> contact-hint;
    // Send message
    in property <bool> send-open;
    in property <string> s-title;
    in property <[ClTpl]> s-templates;
    in property <[ClDest]> s-dests;
    /** The picked destination: its brand, colour and name (the To button). */
    in property <string> s-dest-kind;
    in property <color> s-dest-color;
    in property <string> s-dest-label;
    in property <string> s-to-hint;
    /** Where in Persons they go (Persons' places) and the one picked. */
    in property <[ClPlace]> s-places;
    in property <string> s-place-label;
    /** "From igor@spokpay.com · Creators Gmail", or why it can't send. */
    in property <string> s-from;
    in property <string> s-channel-why;
    in property <bool> s-is-email;
    in-out property <string> s-to;
    in-out property <string> s-subject;
    in-out property <string> s-text;
    in property <string> s-guard;
    in property <string> s-already;
    in property <string> s-error;
    in property <bool> s-busy;
    in property <bool> s-confirm;
    in property <string> s-confirm-text;
    in property <bool> s-can-send;
    in property <string> s-saved;
    // A lead's detail (the CRM's creator profile dialog), opened by a click on its card
    in property <bool> detail-open;
    in property <string> d-name;
    in property <string> d-platform;
    in property <string> d-handle;
    in property <image> d-avatar;
    in property <bool> d-has-avatar;
    in property <string> d-initials;
    in property <color> d-color;
    in property <bool> d-has-contact;
    in property <[ClStat]> d-stats;
    in property <[ClDVid]> d-videos;
    in property <string> d-bio;
    /** The bio on one paragraph (its line breaks and blank lines as " · "), for the dialog's three clamped lines. */
    in property <string> d-bio-line;
    in property <[ClReach]> d-reaches;
    in property <string> d-reach-hint;
    in-out property <string> d-reach-text;
    in property <string> d-reach-error;
    in property <bool> d-reach-saved;
    in property <bool> d-reach-can-save;
    in property <bool> d-reach-busy;
    in property <string> d-url;
    in property <string> d-open-label;
    in property <bool> d-filling;
    // The review bar (Reject / Skip / Approve)
    in property <string> d-approved-note;
    in property <bool> d-restricted;
    in property <bool> d-approved;
    /** The lead is still under review (a run's leads, Available, Restricted): the review bar shows. Not for Approved
     *  (nor Sent) leads. */
    in property <bool> d-review: true;
    /** "3 of 12": where this lead is in the list the detail was opened from ("" alone). */
    in property <string> d-position;
    /** The detail has a lead before / after it in the list it was opened from (← and → go there). */
    in property <bool> d-has-prev;
    in property <bool> d-has-next;
    in property <bool> review-busy;
    // The lists' Sort and "Show only — platforms" (beside the filter box)
    in property <string> sort-label;
    in property <string> sort-tip;
    in property <[ClSort]> sort-items;
    in property <string> plat-label;
    in property <bool> plat-on;
    in property <[ClPlat]> plat-items;
    /** "sort", "plat" or "": the menu open. */
    in property <string> list-menu;
    // Edit (name, handle, bio, links typed by hand)
    in property <bool> edit-open;
    in-out property <string> e-name;
    in-out property <string> e-handle;
    in-out property <string> e-bio;
    in-out property <string> e-links;
    in property <string> e-error;

    callback go(string);
    callback pick-source(string);
    callback pick-gap(string);
    callback query-edited(string);
    callback target-edited(string);
    callback target-step(int);
    callback start();
    callback stop();
    callback copy();
    callback open(string);
    callback restrict(string, bool);
    callback filter-edited(string);
    callback contact-edit(string);
    callback contact-pick(string);
    callback contact-save();
    callback contact-cancel();
    /** A contact on a card clicked (the lead, its place in the list): opens it (WhatsApp, Discord, Instagram) or copies
     *  it (an email, a Discord username). */
    callback contact-open(string, int);
    callback session-save();
    callback session-remove();
    callback send-show(string);
    callback send-close();
    callback pick-template(string);
    callback pick-channel(string);
    callback pick-place(string);
    /** To, Subject or the message typed in: Send… follows. */
    callback to-edited(string);
    callback send-ask();
    callback send-confirm();
    callback send-back();
    callback save-template();
    callback detail-show(string);
    callback detail-close();
    callback reach-pick(string);
    callback reach-edited(string);
    callback reach-save();
    callback reach-clear();
    /** The detail's Send message: the composer for this lead. */
    callback detail-send();
    callback edit-show();
    callback edit-save();
    callback edit-close();
    /** "reject", "skip", "approve" (Approved and Persons › Creators) or "neobux" (Approved and Persons › Neobux): then
     *  the next lead of the list. */
    callback review(string);
    /** The previous (-1) or next (+1) lead of the list the detail was opened from (← and →, in every list). */
    callback detail-step(int);
    /** A card's Unapprove (false). */
    callback approve-set(string, bool);
    callback list-menu-show(string);
    callback sort-pick(string);
    /** A platform ticked or unticked; "" is All platforms. */
    callback plat-pick(string);
    /** History: a run's leads, and back to the timeline. */
    callback history-open(string);
    callback history-back();
}

/** Collector, Available, Approved, Restricted, History: the five views. A click shows that view. */
component Sidebar inherits SideSurface {
    VerticalLayout {
        padding-top: Ds.side-pad-top;
        spacing: 2px;
        SideHead {
            padding-left: Ds.side-pad;
            padding-right: Ds.side-pad;
            hide => {
                CollectorBus.side-hidden = true;
            }
        }
        VerticalLayout {
            padding: Ds.side-pad;
            padding-top: Ds.side-list-top;
            spacing: 2px;
            alignment: start;
            vertical-stretch: 1;
            for n in CollectorBus.nav: ListRow {
                lead: "glyph";
                glyph: n.id == "collector" ? Icons.search : n.id == "available" ? Icons.users : n.id == "approved" ? Icons.circle-check : n.id == "sent" ? Icons.send : n.id == "history" ? "\u{e063}" : Icons.circle-slash;
                title: n.label;
                active: n.on;
                meta: n.id == "collector" ? (CollectorBus.running ? "running" : "") : n.count > 0 ? n.count : "";
                clicked => {
                    CollectorBus.go(n.id);
                }
            }
        }
    }
}

/** The form: platform, search term, how many leads, Collect/Stop, the last-upload window, Instagram's session. */
component Controls inherits Card {
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        VerticalLayout {
            spacing: 6px;
            FieldLabel {
                text: "Platform";
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for s in CollectorBus.sources: Chip {
                    sm: true;
                    text: s.available ? s.label : s.label + " · needs sign-in";
                    on: s.on;
                    enabled: !CollectorBus.running || s.on;
                    tip: s.tip;
                    clicked => {
                        CollectorBus.pick-source(s.value);
                    }
                }
            }
            if CollectorBus.unavailable != "": Hint {
                text: CollectorBus.unavailable;
                wrap: word-wrap;
            }
            if CollectorBus.unavailable == "" && CollectorBus.source-note != "": Muted {
                text: CollectorBus.source-note;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                FieldLabel {
                    text: "Search term";
                    horizontal-stretch: 1;
                }
                FieldLabel {
                    width: 132px;
                    text: "Leads";
                }
                Rectangle {
                    width: 104px;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Input {
                    horizontal-stretch: 1;
                    text <=> CollectorBus.query;
                    hint: "e.g. dress to impress";
                    edited(t) => {
                        CollectorBus.query-edited(t);
                    }
                    accepted => {
                        if !CollectorBus.running {
                            CollectorBus.start();
                        }
                    }
                }
                HorizontalLayout {
                    width: 132px;
                    spacing: 4px;
                    Btn {
                        text: "−";
                        size: icon;
                        variant: ghost-muted;
                        tip: "5 fewer";
                        enabled: !CollectorBus.running;
                        clicked => {
                            CollectorBus.target-step(-5);
                        }
                    }
                    Input {
                        text <=> CollectorBus.target;
                        hint: "All";
                        mono: true;
                        edited(t) => {
                            CollectorBus.target-edited(t);
                        }
                    }
                    Btn {
                        icon: Icons.plus;
                        size: icon;
                        variant: ghost-muted;
                        tip: "5 more";
                        enabled: !CollectorBus.running;
                        clicked => {
                            CollectorBus.target-step(5);
                        }
                    }
                }
                if !CollectorBus.running: Btn {
                    width: 104px;
                    text: "Collect";
                    icon: Icons.search;
                    variant: primary;
                    enabled: CollectorBus.unavailable == "" && CollectorBus.query != "";
                    clicked => {
                        CollectorBus.start();
                    }
                }
                if CollectorBus.running: Btn {
                    width: 104px;
                    text: "Stop";
                    icon: Icons.stop;
                    variant: outline;
                    clicked => {
                        CollectorBus.stop();
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 6px;
            FieldLabel {
                text: "Last upload";
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for g in CollectorBus.gaps: Chip {
                    sm: true;
                    text: g.label;
                    on: g.on;
                    enabled: !CollectorBus.running || g.on;
                    tip: g.tip;
                    clicked => {
                        CollectorBus.pick-gap(g.value);
                    }
                }
            }
        }
        if CollectorBus.show-session: Well {
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Glyph {
                        icon: CollectorBus.session-on ? Icons.circle-check : Icons.lock;
                        size: 14px;
                        color: CollectorBus.session-on ? Theme.green-800 : Theme.gray-800;
                    }
                    Text {
                        text: CollectorBus.session-on ? "Instagram session: " + (CollectorBus.session-account != "" ? "@" + CollectorBus.session-account : "saved") : "Instagram session";
                        font-size: Ds.t-sm;
                        font-weight: 600;
                        color: Theme.fg;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    if CollectorBus.session-on: Btn {
                        text: "Remove";
                        size: xs;
                        variant: ghost-muted;
                        clicked => {
                            CollectorBus.session-remove();
                        }
                    }
                }
                if !CollectorBus.session-on: Muted {
                    text: CollectorBus.session-help;
                    wrap: word-wrap;
                }
                if !CollectorBus.session-on: HorizontalLayout {
                    spacing: 8px;
                    Input {
                        horizontal-stretch: 1;
                        password: true;
                        mono: true;
                        text <=> CollectorBus.session-cookie;
                        hint: "sessionid=…; csrftoken=…";
                        accepted => {
                            CollectorBus.session-save();
                        }
                    }
                    Btn {
                        text: CollectorBus.session-busy ? "Checking…" : "Save";
                        size: sm;
                        variant: outline;
                        enabled: CollectorBus.session-cookie != "" && !CollectorBus.session-busy;
                        clicked => {
                            CollectorBus.session-save();
                        }
                    }
                }
            }
        }
    }
}

/** A tag (the platform). */
component Tag inherits Rectangle {
    in property <string> text;
    width: t.preferred-width + 10px;
    height: 16px;
    border-radius: 4px;
    background: Theme.gray-200;
    t := Text {
        text: root.text;
        font-size: 10.5px;
        font-weight: 600;
        color: Theme.gray-1000;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/** A brand's mark (the CRM's social-brands / creator-reach glyphs): Discord, WhatsApp and TikTok as their simple-icons
 *  paths, the rest as Lucide glyphs (Instagram, YouTube, Twitch, X, Email, else a globe). */
component BrandGlyph inherits Rectangle {
    in property <string> kind;
    in property <length> size: 12px;
    in property <color> ink: Theme.fg;
    width: root.size;
    height: root.size;
    if root.kind == "discord": Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: "M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z";
    }
    if root.kind == "whatsapp": Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z";
    }
    if root.kind == "tiktok": Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: "M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z";
    }
    // Lucide's own brand icons (their font dropped them): stroked like the rest.
    if root.kind == "instagram" || root.kind == "youtube" || root.kind == "twitch" || root.kind == "x": Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.ink;
        stroke-width: root.size / 12;
        commands: root.kind == "instagram" ? "M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5z M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z M17.5 6.5h.01" : root.kind == "youtube" ? "M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17 M10 15l5-3-5-3z" : root.kind == "twitch" ? "M21 2H3v16h5v4l4-4h5l4-4V2z M11 11V7 M16 11V7" : "M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.18 0 3-1.2 3-1.2z";
    }
    if root.kind != "discord" && root.kind != "whatsapp" && root.kind != "tiktok" && root.kind != "instagram" && root.kind != "youtube" && root.kind != "twitch" && root.kind != "x": Glyph {
        width: root.size;
        height: root.size;
        size: root.size;
        color: root.ink;
        icon: root.kind == "email" ? Icons.mail : Icons.globe;
    }
}

/** A lead: picture, name, platform, handle, profile link, their way of contact (or Add contact). A click opens its detail, where the
 *  review (Reject / Skip / Approve, or Move to Available), Send and the videos are. */
component LeadCard inherits Rectangle {
    in property <ClRow> r;
    property <bool> editing: CollectorBus.contact-for == root.r.id;
    height: max(76px, body.preferred-height + 24px);
    border-radius: Ds.radius-lg;
    border-width: 1px;
    border-color: card-ta.has-hover ? Theme.gray-600 : Theme.border;
    background: Theme.bg100;
    // A click anywhere the card has no control of its own opens the lead's detail.
    card-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            CollectorBus.detail-show(root.r.id);
        }
    }
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 44px;
                initials: root.r.initials;
                color: root.r.color;
                photo: root.r.avatar;
                has-photo: root.r.has-avatar;
            }
        }
        body := VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.r.name;
                    font-size: Ds.t-body;
                    font-weight: 500;
                    color: Theme.fg;
                    overflow: elide;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                }
                VerticalLayout {
                    alignment: center;
                    Tag {
                        text: root.r.platform;
                    }
                }
                if root.r.handle != "" && root.r.handle != "@" + root.r.name: Text {
                    text: root.r.handle;
                    font-size: 12.5px;
                    color: Theme.gray-800;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                spacing: 5px;
                Glyph {
                    icon: Icons.link;
                    size: 12px;
                    color: Theme.gray-800;
                }
                link := Text {
                    text: root.r.short;
                    font-size: 12.5px;
                    color: la.has-hover ? Theme.fg : Theme.gray-900;
                    overflow: elide;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                    la := TipArea {
                        mouse-cursor: pointer;
                        tip: "Open " + root.r.url;
                        clicked => {
                            CollectorBus.open(root.r.url);
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            // Their way of contact, whichever channel: the best one, the others' marks, + to type another.
            if !root.editing && root.r.has-contact: HorizontalLayout {
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    BrandGlyph {
                        kind: root.r.contact.kind;
                        size: 12px;
                        ink: root.r.contact.color;
                    }
                }
                Text {
                    text: root.r.contact.text;
                    font-size: 12.5px;
                    color: ca.has-hover ? Theme.fg : Theme.gray-1000;
                    overflow: elide;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                    ca := TipArea {
                        mouse-cursor: pointer;
                        tip: root.r.contact.tip;
                        clicked => {
                            CollectorBus.contact-open(root.r.id, root.r.contact.i);
                        }
                    }
                }
                for k in root.r.more: Rectangle {
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Ds.radius-sm;
                    background: mta.has-hover ? Theme.fg.with-alpha(0.08) : transparent;
                    BrandGlyph {
                        kind: k.kind;
                        size: 11px;
                        ink: mta.has-hover ? k.color : k.color.with-alpha(0.75);
                    }
                    mta := TipArea {
                        mouse-cursor: pointer;
                        tip: k.tip;
                        clicked => {
                            CollectorBus.contact-open(root.r.id, k.i);
                        }
                    }
                }
                if root.r.more-n > 0: Text {
                    text: "+" + root.r.more-n;
                    font-size: 11.5px;
                    color: Theme.gray-800;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Ds.radius-sm;
                    background: pa.has-hover ? Theme.fg.with-alpha(0.08) : transparent;
                    Glyph {
                        icon: Icons.plus;
                        size: 11px;
                        color: pa.has-hover ? Theme.fg : Theme.gray-700;
                    }
                    pa := TipArea {
                        mouse-cursor: pointer;
                        tip: "Add another way to contact them";
                        clicked => {
                            CollectorBus.contact-edit(root.r.id);
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            if !root.editing && !root.r.has-contact: HorizontalLayout {
                spacing: 5px;
                Glyph {
                    icon: Icons.at-sign;
                    size: 12px;
                    color: ea.has-hover ? Theme.fg : Theme.gray-700;
                }
                Text {
                    text: "Add contact";
                    font-size: 12.5px;
                    color: ea.has-hover ? Theme.fg : Theme.gray-700;
                    overflow: elide;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                    ea := TipArea {
                        mouse-cursor: pointer;
                        tip: "Type how to reach them: Email, WhatsApp, Discord or Instagram";
                        clicked => {
                            CollectorBus.contact-edit(root.r.id);
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            // Add contact: the channel, then its value (a typed one is never replaced by one found later).
            if root.editing: HorizontalLayout {
                spacing: 4px;
                for k in CollectorBus.contact-kinds: Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Ds.radius-md;
                    background: k.on ? k.color.with-alpha(0.13) : kpa.has-hover ? Theme.fg.with-alpha(0.08) : Theme.fg.with-alpha(0.04);
                    border-width: k.on ? 1px : 0px;
                    border-color: Theme.fg.with-alpha(0.4);
                    BrandGlyph {
                        kind: k.kind;
                        size: 14px;
                        ink: k.on ? k.color : kpa.has-hover ? Theme.fg.with-alpha(0.7) : Theme.fg.with-alpha(0.4);
                    }
                    kpa := TipArea {
                        tip: k.label;
                        clicked => {
                            CollectorBus.contact-pick(k.kind);
                        }
                    }
                }
                Rectangle {
                    width: 2px;
                }
                Input {
                    horizontal-stretch: 1;
                    text <=> CollectorBus.contact-text;
                    hint: CollectorBus.contact-hint;
                    init => {
                        self.focus-end();
                    }
                    accepted => {
                        CollectorBus.contact-save();
                    }
                }
                Btn {
                    text: "Save";
                    size: sm;
                    variant: outline;
                    clicked => {
                        CollectorBus.contact-save();
                    }
                }
                Btn {
                    text: "Cancel";
                    size: sm;
                    variant: ghost-muted;
                    clicked => {
                        CollectorBus.contact-cancel();
                    }
                }
            }
        }
        // Followers, on the right (hidden when unknown).
        if root.r.followers != "": VerticalLayout {
            alignment: center;
            Text {
                text: root.r.followers;
                font-size: 12.5px;
                color: Theme.gray-900;
                horizontal-alignment: right;
            }
        }
    }
}

/** The leads of a view, or its empty state. */
component Leads inherits VerticalLayout {
    spacing: 8px;
    if CollectorBus.rows-head != "": HorizontalLayout {
        padding-top: 2px;
        CapsLabel {
            text: CollectorBus.rows-head;
        }
    }
    for r in CollectorBus.rows: LeadCard {
        r: r;
    }
    if CollectorBus.rows.length == 0 && CollectorBus.empty-title != "": Empty {
        icon: CollectorBus.page == "restricted" ? Icons.circle-slash : CollectorBus.page == "approved" ? Icons.circle-check : CollectorBus.page == "sent" ? Icons.send : CollectorBus.page == "history" ? "\u{e063}" : Icons.users;
        title: CollectorBus.empty-title;
        desc: CollectorBus.empty-desc;
    }
}

/** Available, Approved and Restricted: the leads (the filter box and menus stay above, ListBar). */
component ListScreen inherits VerticalLayout {
    Leads { }
}

/** A compact menu button beside the filter box: icon, label, chevron; framed like the box. */
component ListMenuBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> tip;
    in property <bool> open;
    in property <bool> active;
    callback clicked;
    height: 34px;
    width: lbl.preferred-width + 54px;
    border-radius: Ds.radius-md;
    border-width: 1px;
    border-color: root.open ? Theme.gray-1000 : Theme.border;
    background: area.has-hover || root.open ? Theme.accent : transparent;
    Glyph {
        x: 11px;
        width: 15px;
        icon: root.icon;
        size: 15px;
        color: root.active ? Theme.blue-900 : Theme.subtle;
    }
    lbl := Text {
        x: 33px;
        text: root.label;
        font-size: 13px;
        color: root.active || area.has-hover || root.open ? Theme.fg : Theme.gray-1000;
        vertical-alignment: center;
    }
    Glyph {
        x: parent.width - 20px;
        width: 13px;
        icon: Icons.down;
        size: 13px;
        color: Theme.subtle;
    }
    area := TipArea {
        mouse-cursor: pointer;
        tip: root.tip;
        clicked => {
            root.clicked();
        }
    }
}

/** One "Show only — platforms" row (the CRM's checkbox item): the tick on the left, the brand's mark in its colour,
 *  the name, the list's count on the right. The menu stays open. */
component PlatRow inherits Rectangle {
    in property <string> kind;
    in property <string> label;
    in property <color> ink;
    in property <string> count;
    in property <bool> on;
    callback clicked;
    height: 32px;
    border-radius: 4px;
    background: area.has-hover ? Theme.accent : transparent;
    if root.on: Glyph {
        x: 8px;
        width: 16px;
        icon: Icons.check;
        size: 15px;
        color: Theme.fg;
    }
    if root.kind != "": BrandGlyph {
        x: 32px;
        y: (parent.height - self.height) / 2;
        kind: root.kind;
        size: 15px;
        ink: root.ink;
    }
    Text {
        x: root.kind != "" ? 56px : 32px;
        text: root.label;
        font-size: 14px;
        color: Theme.fg;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - self.width - 10px;
        text: root.count;
        font-size: 12px;
        color: Theme.subtle;
        vertical-alignment: center;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/** The lists' bar: the filter box (full width), then Sort and "Show only — platforms" (the SpokPay CRM's creator
 *  column menus), their menus dropping under them over the leads. */
component ListBar inherits Rectangle {
    height: 34px;
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1;
            border-radius: Ds.radius-md;
            border-width: 1px;
            border-color: search.focused ? Theme.gray-1000 : Theme.border;
            search := SearchField {
                x: 8px;
                width: parent.width - 16px;
                y: 1px;
                hint: "Filter by name, handle, email or platform";
                text <=> CollectorBus.filter;
                edited(t) => {
                    CollectorBus.filter-edited(t);
                }
            }
        }
        sort-btn := ListMenuBtn {
            icon: Icons.arrow-down-up;
            label: CollectorBus.sort-label;
            tip: CollectorBus.sort-tip;
            open: CollectorBus.list-menu == "sort";
            clicked => {
                CollectorBus.list-menu-show("sort");
            }
        }
        plat-btn := ListMenuBtn {
            icon: Icons.filter;
            label: CollectorBus.plat-label;
            tip: "Show only — platforms";
            open: CollectorBus.list-menu == "plat";
            active: CollectorBus.plat-on;
            clicked => {
                CollectorBus.list-menu-show("plat");
            }
        }
    }
    if CollectorBus.list-menu == "sort": PopoverFrame {
        x: sort-btn.x + sort-btn.width - self.width;
        y: root.height + 6px;
        width: 248px;
        height: sm.preferred-height;
        sm := VerticalLayout {
            padding: 4px;
            MenuLabel {
                text: "Sort by";
            }
            for o in CollectorBus.sort-items: VerticalLayout {
                if o.sep: MenuSeparator { }
                MenuItem {
                    label: o.label;
                    checked: o.on;
                    clicked => {
                        CollectorBus.sort-pick(o.value);
                    }
                }
            }
        }
    }
    if CollectorBus.list-menu == "plat": PopoverFrame {
        x: plat-btn.x + plat-btn.width - self.width;
        y: root.height + 6px;
        width: 232px;
        height: pm.preferred-height;
        pm := VerticalLayout {
            padding: 4px;
            MenuLabel {
                text: "Show only — platforms";
            }
            PlatRow {
                label: "All platforms";
                on: !CollectorBus.plat-on;
                clicked => {
                    CollectorBus.plat-pick("");
                }
            }
            for p in CollectorBus.plat-items: PlatRow {
                kind: p.value;
                label: p.label;
                ink: p.color;
                count: p.count;
                on: p.on;
                clicked => {
                    CollectorBus.plat-pick(p.value);
                }
            }
        }
    }
}

/** Collector: the form, the run's one line, the leads it found. */
component CollectScreen inherits VerticalLayout {
    spacing: 14px;
    Controls { }
    if CollectorBus.run-line != "": HorizontalLayout {
        spacing: 8px;
        padding-left: 4px;
        if CollectorBus.running: VerticalLayout {
            alignment: center;
            Spinner { }
        }
        Text {
            text: CollectorBus.run-line;
            font-size: 13px;
            color: CollectorBus.running ? Theme.fg : Theme.subtle;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    Leads { }
}

/** A run's tone as its dot (Headquarters' Timeline: blue going, green done, amber stopped, red failed, grey nobody new). */
component HistDot inherits Rectangle {
    in property <string> tone;
    property <length> d: root.tone == "empty" ? 8px : 10px;
    width: 10px;
    height: 10px;
    Rectangle {
        width: root.d;
        height: root.d;
        border-radius: root.d / 2;
        background: root.tone == "running" ? Theme.blue-700 : root.tone == "done" ? Theme.green-700 : root.tone == "stopped" ? Theme.amber-700 : root.tone == "failed" ? Theme.red-800 : Theme.gray-600;
    }
}

/** A platform's mark in its brand colour. */
component PlatMark inherits BrandGlyph {
    size: 14px;
    ink: root.kind == "youtube" ? #ff0000 : root.kind == "tiktok" ? #fe2c55 : root.kind == "instagram" ? #e1306c : Theme.subtle;
}

/** One run on the timeline: the time (mono, right-aligned), its dot on the day's line, the term with the platform's
 *  mark, how it went, and why it stopped early. A click shows the leads it found. */
component HistRow inherits Rectangle {
    in property <ClHist> h;
    property <length> time-w: 52px;
    property <length> dot-x: 8px + root.time-w + 12px;
    property <length> body-x: root.dot-x + 10px + 12px;
    property <float> dim: root.h.tone == "empty" ? 0.6 : 1;
    height: body.preferred-height + 20px;
    border-radius: Ds.radius-md;
    background: ta.has-hover ? Theme.accent : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            CollectorBus.history-open(root.h.id);
        }
    }
    Text {
        x: 8px;
        y: 2px;
        width: root.time-w;
        text: root.h.time;
        font-family: "Geist Mono";
        font-size: 13px;
        horizontal-alignment: right;
        color: root.h.running ? Theme.blue-900 : Theme.subtle;
        opacity: root.dim;
    }
    HistDot {
        x: root.dot-x;
        y: 6px;
        tone: root.h.tone;
    }
    if !root.h.last: Rectangle {
        x: root.dot-x + 4.5px;
        y: 22px;
        width: 1px;
        height: root.height - 22px;
        background: Theme.gray-400;
    }
    body := VerticalLayout {
        x: root.body-x;
        y: 0;
        width: root.width - root.body-x - 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 7px;
            height: 20px;
            VerticalLayout {
                alignment: center;
                PlatMark {
                    kind: root.h.platform-key;
                }
            }
            Text {
                text: root.h.query;
                font-size: 14px;
                color: Theme.fg;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
                opacity: root.dim;
            }
        }
        // One line each (elided; the run's page has it all), so the row's height is exact.
        Text {
            height: 18px;
            text: root.h.platform + " · " + root.h.line;
            font-size: 13px;
            color: Theme.subtle;
            overflow: elide;
            vertical-alignment: center;
            opacity: root.dim;
        }
        if root.h.note != "": Text {
            height: 18px;
            text: root.h.note;
            font-size: 13px;
            color: root.h.tone == "failed" ? Theme.red-900 : root.h.tone == "stopped" ? Theme.amber-900 : Theme.subtle;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

/** A day's head ("Today", "Yesterday", "Wed, Nov 25") or one run. */
component HistItem inherits VerticalLayout {
    in property <ClHist> h;
    spacing: 0;
    if root.h.kind == "day": VerticalLayout {
        spacing: 0;
        padding-top: root.h.first ? 0 : 24px;
        padding-bottom: 12px;
        Text {
            height: 18px;
            vertical-alignment: center;
            text: root.h.label;
            font-size: 13px;
            color: Theme.subtle;
        }
    }
    if root.h.kind == "run": HistRow {
        h: root.h;
    }
}

/** History: every search run, by day, newest first (Headquarters' Timeline); a run opened: its term, how it went, and
 *  the leads it found (the usual cards and detail). */
component HistoryScreen inherits VerticalLayout {
    spacing: 0;
    if CollectorBus.history-run == "": VerticalLayout {
        spacing: 0;
        for h in CollectorBus.history: HistItem {
            h: h;
        }
        if CollectorBus.history.length == 0: Empty {
            icon: "\u{e063}";
            title: "No searches yet";
            desc: "Every search you run shows here, by day: the term, the platform, how many new leads it found. Click one to see its leads.";
        }
    }
    if CollectorBus.history-run != "": VerticalLayout {
        spacing: 14px;
        HorizontalLayout {
            alignment: start;
            Btn {
                text: "History";
                icon: Icons.left;
                variant: ghost;
                size: sm;
                clicked => {
                    CollectorBus.history-back();
                }
            }
        }
        VerticalLayout {
            spacing: 6px;
            padding-left: 4px;
            HorizontalLayout {
                spacing: 10px;
                height: 28px;
                VerticalLayout {
                    alignment: center;
                    PlatMark {
                        kind: CollectorBus.hr-platform-key;
                        size: 18px;
                    }
                }
                Text {
                    text: CollectorBus.hr-query;
                    vertical-alignment: center;
                    font-size: 20px;
                    font-weight: 600;
                    letter-spacing: -0.4px;
                    color: Theme.fg;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            Text {
                height: 18px;
                text: CollectorBus.hr-sub;
                font-size: 13px;
                color: Theme.subtle;
                overflow: elide;
                vertical-alignment: center;
            }
            if CollectorBus.hr-note != "": Text {
                height: 18px;
                text: CollectorBus.hr-note;
                font-size: 13px;
                color: CollectorBus.hr-tone == "failed" ? Theme.red-900 : CollectorBus.hr-tone == "stopped" ? Theme.amber-900 : Theme.subtle;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        Leads { }
    }
}

/** One place Send message can go (the composer's To menu): the brand's mark on its tint, "Email · a@b.com", and on a
 *  second line the Persons › Creators account it goes from, or why it can't. */
component DestRow inherits Rectangle {
    in property <ClDest> d;
    callback pick();
    height: 46px;
    border-radius: Ds.radius-md;
    background: root.d.on ? Theme.gray-200 : ta.has-hover ? Theme.accent : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.pick();
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Ds.radius-md;
                background: root.d.color.with-alpha(root.d.available ? 0.14 : 0.06);
                BrandGlyph {
                    kind: root.d.kind;
                    size: 14px;
                    ink: root.d.available ? root.d.color : Theme.fg.with-alpha(0.4);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.d.label;
                    font-size: Ds.t-sm;
                    font-weight: 500;
                    color: root.d.available ? Theme.fg : Theme.fg.with-alpha(0.55);
                    horizontal-stretch: 0;
                }
                Text {
                    text: root.d.to;
                    font-size: Ds.t-sm;
                    color: root.d.available ? Theme.fg.with-alpha(0.7) : Theme.fg.with-alpha(0.4);
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: root.d.via;
                font-size: Ds.t-meta;
                color: root.d.available ? Theme.gray-800 : Theme.amber-900;
                overflow: elide;
            }
        }
        if root.d.on: VerticalLayout {
            alignment: center;
            Glyph {
                icon: Icons.check;
                size: 14px;
                color: Theme.fg;
            }
        }
    }
}

/** Send message (Persons' composer, as a dialog): the templates on the left; on the right a composer card with To on
 *  top (the destination picker: every way Persons › Creators can write to them, Email, WhatsApp, Discord, Instagram,
 *  each with who they are there; the address beside it, editable), the subject when it's an email, the message, and
 *  the account it goes from with Send… at the bottom. Send… asks first ("Send it?"), then Send now: the real send. */
component SendDialog inherits DialogFrame {
    title: CollectorBus.s-confirm ? "Send it?" : CollectorBus.s-title;
    text: CollectorBus.s-confirm ? CollectorBus.s-confirm-text : "";
    box-w: CollectorBus.s-confirm ? 448px : 760px;
    scrim-dismisses: false;
    property <bool> menu-open;
    property <bool> place-open;
    dismiss => {
        if root.menu-open || root.place-open {
            root.menu-open = false;
            root.place-open = false;
            return;
        }
        CollectorBus.send-close();
    }
    if !CollectorBus.s-confirm: HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            width: 200px;
            spacing: 2px;
            alignment: start;
            FieldLabel {
                text: "Template";
            }
            for t in CollectorBus.s-templates: Rectangle {
                height: tv.preferred-height + 12px;
                border-radius: Ds.radius-md;
                background: t.on ? Theme.gray-200 : ta.has-hover ? Theme.accent : transparent;
                ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        CollectorBus.pick-template(t.id);
                    }
                }
                tv := VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    y: 6px;
                    spacing: 1px;
                    Text {
                        text: t.name;
                        font-size: Ds.t-sm;
                        font-weight: t.on ? 600 : 500;
                        color: Theme.fg;
                        overflow: elide;
                    }
                    if t.description != "": Text {
                        text: t.description;
                        font-size: Ds.t-meta;
                        color: Theme.gray-800;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                padding-top: 6px;
                alignment: start;
                Btn {
                    text: CollectorBus.s-saved != "" ? CollectorBus.s-saved : "Save as template";
                    icon: Icons.copy;
                    size: xs;
                    variant: ghost-muted;
                    tip: "Keep this subject and message in the picked template (or as a new one, from Blank)";
                    clicked => {
                        CollectorBus.save-template();
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 10px;
            // The composer card (Persons' frame: radius 12, hairline, To on top).
            Rectangle {
                border-radius: Ds.radius-xl;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.fg.with-alpha(0.02);
                VerticalLayout {
                    // To: where it goes (the picker) and to whom (the address, editable)
                    HorizontalLayout {
                        height: 48px;
                        padding-left: 14px;
                        padding-right: 8px;
                        spacing: 10px;
                        Text {
                            text: "To";
                            font-size: 13px;
                            color: Theme.subtle;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            dest-btn := Rectangle {
                                height: 30px;
                                width: dl.preferred-width;
                                border-radius: 15px;
                                background: root.menu-open ? Theme.gray-300 : dta.has-hover ? Theme.gray-300 : Theme.gray-200;
                                dl := HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 9px;
                                    spacing: 7px;
                                    VerticalLayout {
                                        alignment: center;
                                        BrandGlyph {
                                            kind: CollectorBus.s-dest-kind;
                                            size: 13px;
                                            ink: CollectorBus.s-dest-color;
                                        }
                                    }
                                    Text {
                                        text: CollectorBus.s-dest-label;
                                        font-size: 13px;
                                        font-weight: 500;
                                        color: Theme.fg;
                                        vertical-alignment: center;
                                    }
                                    Glyph {
                                        icon: Icons.down;
                                        size: 12px;
                                        color: Theme.fg.with-alpha(0.6);
                                    }
                                }
                                dta := TipArea {
                                    tip: root.menu-open ? "" : "Where it goes: their email, WhatsApp, Discord or Instagram, through Persons › Creators";
                                    clicked => {
                                        root.place-open = false;
                                        root.menu-open = !root.menu-open;
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Input {
                                text <=> CollectorBus.s-to;
                                hint: CollectorBus.s-to-hint;
                                edited(t) => {
                                    CollectorBus.to-edited(t);
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        if CollectorBus.s-is-email: Input {
                            text <=> CollectorBus.s-subject;
                            hint: "Subject";
                            edited(t) => {
                                CollectorBus.to-edited(t);
                            }
                        }
                        TextBox {
                            min-h: 232px;
                            text <=> CollectorBus.s-text;
                            hint: "Write the message";
                            edited(t) => {
                                CollectorBus.to-edited(t);
                            }
                        }
                        // the account it goes from, Send…
                        HorizontalLayout {
                            height: 32px;
                            spacing: 8px;
                            Text {
                                text: CollectorBus.s-from;
                                font-size: 12.5px;
                                color: CollectorBus.s-channel-why != "" ? Theme.amber-900 : Theme.gray-800;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Btn {
                                text: "Send…";
                                icon: Icons.send;
                                size: sm;
                                variant: primary;
                                enabled: CollectorBus.s-can-send;
                                clicked => {
                                    CollectorBus.send-ask();
                                }
                            }
                        }
                    }
                }
                // The To menu, over the card under its button (a click elsewhere on the card closes it; so do Esc and ×).
                if root.menu-open || root.place-open: TouchArea {
                    clicked => {
                        root.menu-open = false;
                        root.place-open = false;
                    }
                }
                if root.menu-open: PopoverFrame {
                    x: 40px;
                    y: 44px;
                    width: min(parent.width - 48px, 400px);
                    height: menu.preferred-height;
                    menu := VerticalLayout {
                        padding: 4px;
                        spacing: 1px;
                        MenuLabel {
                            text: "Send through Persons › Creators";
                        }
                        for d in CollectorBus.s-dests: DestRow {
                            d: d;
                            pick => {
                                root.menu-open = false;
                                CollectorBus.pick-channel(d.value);
                            }
                        }
                    }
                }
            }
            // Where in Persons they go (a store, Creators, SpokPay, Personal): its connections are the ones in To.
            Rectangle {
                height: 30px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Add to Persons ›";
                        font-size: 13px;
                        color: Theme.subtle;
                        vertical-alignment: center;
                    }
                    place-btn := Rectangle {
                        height: 30px;
                        width: pl.preferred-width;
                        border-radius: 15px;
                        background: root.place-open || pta.has-hover ? Theme.gray-300 : Theme.gray-200;
                        pl := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 9px;
                            spacing: 7px;
                            Glyph {
                                icon: Icons.users;
                                size: 13px;
                                color: Theme.fg.with-alpha(0.75);
                            }
                            Text {
                                text: CollectorBus.s-place-label;
                                font-size: 13px;
                                font-weight: 500;
                                color: Theme.fg;
                                vertical-alignment: center;
                            }
                            Glyph {
                                icon: Icons.down;
                                size: 12px;
                                color: Theme.fg.with-alpha(0.6);
                            }
                        }
                        pta := TipArea {
                            tip: root.place-open ? "" : "Where they go in Persons when it's sent (the To channels are that place's)";
                            clicked => {
                                root.menu-open = false;
                                root.place-open = !root.place-open;
                            }
                        }
                    }
                }
                // its menu opens upward, over the card
                if root.place-open: PopoverFrame {
                    x: 120px;
                    y: -self.height - 4px;
                    width: 260px;
                    height: pmenu.preferred-height;
                    pmenu := VerticalLayout {
                        padding: 4px;
                        spacing: 1px;
                        MenuLabel {
                            text: "Add them to";
                        }
                        for p in CollectorBus.s-places: MenuItem {
                            label: p.label;
                            checked: p.on;
                            icon: p.store ? Icons.tag : Icons.users;
                            clicked => {
                                root.place-open = false;
                                CollectorBus.pick-place(p.value);
                            }
                        }
                    }
                }
            }
            if CollectorBus.s-already != "": Hint {
                text: CollectorBus.s-already;
                wrap: word-wrap;
            }
            if CollectorBus.s-guard != "": Muted {
                text: CollectorBus.s-guard;
                wrap: word-wrap;
            }
        }
    }
    if CollectorBus.s-error != "": Text {
        text: CollectorBus.s-error;
        font-size: Ds.t-sm;
        color: Theme.red-900;
        wrap: word-wrap;
    }
    if CollectorBus.s-confirm: DialogActions {
        Btn {
            text: "Back";
            variant: outline;
            enabled: !CollectorBus.s-busy;
            clicked => {
                CollectorBus.send-back();
            }
        }
        Btn {
            text: CollectorBus.s-busy ? "Sending…" : "Send now";
            icon: Icons.send;
            variant: primary;
            enabled: !CollectorBus.s-busy;
            clicked => {
                CollectorBus.send-confirm();
            }
        }
    }
}


/** A section of the detail (the CRM's profile Section): a small caps head with its icon, then its content. */
component DSection inherits VerticalLayout {
    in property <string> icon;
    in property <string> title;
    spacing: 6px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Glyph {
            icon: root.icon;
            size: 12px;
            color: Theme.fg.with-alpha(0.35);
        }
        Text {
            text: root.title;
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: Theme.fg.with-alpha(0.35);
            vertical-alignment: center;
        }
    }
    @children
}

/** A stat tile: icon and value, the label in caps under it. Hidden tiles never get here (no data, no tile). */
component StatTile inherits Rectangle {
    in property <ClStat> s;
    border-radius: Ds.radius-lg;
    background: Theme.fg.with-alpha(0.035);
    height: 56px;
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Glyph {
                icon: root.s.icon == "users" ? Icons.users : root.s.icon == "video" ? Icons.video : root.s.icon == "heart" ? Icons.heart : Icons.eye;
                size: 14px;
                color: Theme.fg.with-alpha(0.4);
            }
            Text {
                text: root.s.value;
                font-size: 15px;
                font-weight: 600;
                color: Theme.fg.with-alpha(0.85);
                vertical-alignment: center;
            }
        }
        Text {
            text: root.s.label;
            font-size: 10.5px;
            letter-spacing: 0.5px;
            color: Theme.fg.with-alpha(0.3);
        }
    }
}

/** One of the podium's videos (the CRM's VideoTile): 16:9 thumbnail, two lines of title, "yesterday · 22K views". */
component VidTile inherits Rectangle {
    in property <ClDVid> v;
    property <length> thumb-h: (root.width - 12px) * 9 / 16;
    height: 6px + root.thumb-h + 8px + 32px + 16px + 8px;
    border-radius: Ds.radius-lg;
    background: ta.has-hover ? Theme.fg.with-alpha(0.08) : root.v.featured ? Theme.fg.with-alpha(0.06) : Theme.fg.with-alpha(0.035);
    border-width: root.v.featured ? 1px : 0px;
    border-color: Theme.fg.with-alpha(0.1);
    Rectangle {
        x: 6px;
        y: 6px;
        width: root.width - 12px;
        height: root.thumb-h;
        border-radius: Ds.radius-md;
        background: #00000066;
        clip: true;
        if root.v.has-thumb: Image {
            width: parent.width;
            height: parent.height;
            source: root.v.thumb;
            image-fit: cover;
        }
        if !root.v.has-thumb: Glyph {
            icon: Icons.video;
            size: 20px;
            color: Theme.fg.with-alpha(0.2);
        }
        if root.v.short: Rectangle {
            x: parent.width - self.width - 4px;
            y: 4px;
            width: st.preferred-width + 8px;
            height: 15px;
            border-radius: 4px;
            background: #000000b3;
            st := Text {
                text: "SHORT";
                font-size: 9px;
                font-weight: 500;
                color: #ffffffbf;
            }
        }
        if ta.has-hover: Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: #000000b3;
            Glyph {
                icon: Icons.play;
                size: 14px;
                color: white;
            }
        }
    }
    Text {
        x: 8px;
        y: 6px + root.thumb-h + 8px;
        width: root.width - 16px;
        height: 32px;
        text: root.v.title != "" ? root.v.title : "Untitled";
        font-size: root.v.featured ? 12px : 11px;
        font-weight: 500;
        color: ta.has-hover ? Theme.fg : Theme.fg.with-alpha(0.8);
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
    }
    Text {
        x: 8px;
        y: 6px + root.thumb-h + 8px + 32px + 2px;
        width: root.width - 16px;
        text: root.v.meta;
        font-size: 10.5px;
        color: Theme.fg.with-alpha(0.35);
        overflow: elide;
    }
    ta := TipArea {
        tip: root.v.title;
        clicked => {
            CollectorBus.open(root.v.url);
        }
    }
}

/** MOST RECENT: the 3 newest as a podium (the CRM's CreatorRecentVideosPodium): #2, #1 (wider, raised), #3. */
component Podium inherits Rectangle {
    /** At most this tall (the detail fits the window without scrolling): narrower tiles, centred. */
    property <length> gap: 8px;
    /** The tiles' unit for the width alone, and as the height the layout gave allows: the detail's layout shrinks the
     *  podium (its only give) so everything else fits the window above the review bar. */
    property <length> wide-unit: (root.width - 2 * root.gap) / 3.25;
    property <length> unit: max(60px, min(root.wide-unit, ((root.height - 70px) * 16 / 9 + 12px) / 1.25));
    property <length> mid-h: (1.25 * root.unit - 12px) * 9 / 16 + 70px;
    preferred-height: (1.25 * root.wide-unit - 12px) * 9 / 16 + 70px;
    max-height: self.preferred-height;
    min-height: 90px;
    vertical-stretch: 1;
    property <length> left: (root.width - 3.25 * root.unit - 2 * root.gap) / 2;
    for v[i] in CollectorBus.d-videos: Rectangle {
        y: parent.height - self.height;
        x: root.left + (i == 0 ? 0px : i == 1 ? root.unit + root.gap : 2.25 * root.unit + 2 * root.gap);
        width: v.featured ? 1.25 * root.unit : root.unit;
        height: root.mid-h;
        if !v.empty: VidTile {
            v: v;
            width: parent.width;
            y: parent.height - self.height;
        }
    }
}

/** Lucide's arrow-down (the font subset has no glyph for it), stroked like the font's icons. */
component ArrowDown inherits Path {
    in property <color> ink;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "M12 5v14M19 12l-7 7-7-7";
    stroke: root.ink;
    stroke-width: root.width / 12;
    fill: transparent;
}

/** A review key's cap: a small outlined square with the letter or the arrow. */
component ReviewCap inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> down;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.fg.with-alpha(0.16);
    background: Theme.fg.with-alpha(0.04);
    if root.text != "": Text {
        text: root.text;
        font-family: "Geist Mono";
        font-size: 10px;
        color: Theme.fg.with-alpha(0.55);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon != "": Glyph {
        icon: root.icon;
        size: 10px;
        color: Theme.fg.with-alpha(0.55);
    }
    if root.down: ArrowDown {
        width: 10px;
        height: 10px;
        ink: Theme.fg.with-alpha(0.55);
    }
}

/** One cell of the review bar: its icon, label and key caps, centred; the cell tints on hover. */
component ReviewCell inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> down;
    in property <color> ink;
    in property <string> cap;
    in property <string> cap-icon;
    in property <bool> cap-down;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    horizontal-stretch: 1;
    background: area.has-hover && root.enabled ? root.ink.with-alpha(0.08) : transparent;
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Glyph {
                icon: root.icon;
                size: 16px;
                color: root.ink;
            }
        }
        if root.down: VerticalLayout {
            alignment: center;
            ArrowDown {
                width: 16px;
                height: 16px;
                ink: root.ink;
            }
        }
        Text {
            text: root.label;
            font-size: 15px;
            font-weight: 500;
            color: root.ink;
            vertical-alignment: center;
        }
        HorizontalLayout {
            padding-left: 2px;
            spacing: 3px;
            alignment: center;
            VerticalLayout {
                alignment: center;
                ReviewCap {
                    text: root.cap;
                }
            }
            if root.cap-icon != "" || root.cap-down: VerticalLayout {
                alignment: center;
                ReviewCap {
                    icon: root.cap-icon;
                    down: root.cap-down;
                }
            }
        }
    }
    area := TipArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        tip: root.tip;
        clicked => {
            root.clicked();
        }
    }
}

/** A lead's detail: the SpokPay CRM's creator profile dialog (creator-profile-dialog.tsx), trimmed to one screen that
 *  never scrolls. Header (picture, name, PLATFORM @handle, Has Contact; Open channel, Edit, "3 of 12" and × on the
 *  right), the stat tiles, MOST RECENT, Bio (3 lines at most), Reach; then the review queue's bar (Reject / Skip /
 *  Approve, R S A or ← ↓ →). The keys act only while no text field has the focus. */
component DetailDialog inherits Rectangle {
    background: Theme.scrim;
    TouchArea {
        clicked => {
            CollectorBus.detail-close();
        }
    }
    property <length> box-w: min(720px, root.width - 32px);
    property <length> bar-h: CollectorBus.d-review ? 52px : 0px;
    /** The bio's line and its three lines (one line of the same font, measured). */
    property <length> bio-line: bio-fm.preferred-height;
    property <length> bio-h: 3 * root.bio-line;
    /** The whole bio in a popover over the dialog (nothing under it moves); closed by Esc, a click outside, or the next lead. */
    property <bool> bio-open;
    property <string> bio-of: CollectorBus.d-bio;
    changed bio-of => {
        self.bio-open = false;
    }
    bio-fm := Text {
        visible: false;
        width: 0;
        height: 0;
        text: "Ag";
        font-size: 12.5px;
    }
    // Edit or Send message closed over the detail: the keys come back to the review bar.
    property <bool> covered: CollectorBus.edit-open || CollectorBus.send-open;
    changed covered => {
        if !self.covered {
            keys.focus();
        }
    }
    keys := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        init => {
            self.focus();
        }
        key-pressed(e) => {
            if e.text == Key.Escape {
                if root.bio-open {
                    root.bio-open = false;
                } else if !self.has-focus {
                    self.focus();
                } else {
                    CollectorBus.detail-close();
                }
                return accept;
            }
            // Only while no text field has the focus (the scope itself has it), and never with a modifier.
            if !self.has-focus || e.modifiers.control || e.modifiers.alt || e.modifiers.meta {
                return reject;
            }
            // ← and →: the previous and next lead, in every list (under review or not).
            if e.text == Key.LeftArrow {
                CollectorBus.detail-step(-1);
                return accept;
            }
            if e.text == Key.RightArrow {
                CollectorBus.detail-step(1);
                return accept;
            }
            if !CollectorBus.d-review {
                return reject;
            }
            if e.text == "r" || e.text == "R" {
                CollectorBus.review("reject");
                return accept;
            }
            if e.text == "s" || e.text == "S" || e.text == Key.DownArrow {
                CollectorBus.review("skip");
                return accept;
            }
            if e.text == "a" || e.text == "A" {
                CollectorBus.review("approve");
                return accept;
            }
            if (e.text == "n" || e.text == "N") && !CollectorBus.d-approved {
                CollectorBus.review("neobux");
                return accept;
            }
            reject
        }
    }
    box := Rectangle {
        width: root.box-w;
        height: min(root.height - 32px, inner.preferred-height + 1px + root.bar-h);
        background: Theme.bg100;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Ds.radius-xl;
        clip: true;
        drop-shadow-offset-y: 12px;
        drop-shadow-blur: 28px;
        drop-shadow-color: black.with-alpha(Theme.dark ? 56 / 255 : 20 / 255);
        TouchArea {
            clicked => {
                keys.focus();
            }
        }
        // The content above the review bar, clipped to it: whatever the window, nothing reaches the bar.
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height - 1px - root.bar-h;
            clip: true;
            inner := VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                padding: 20px;
                padding-bottom: 16px;
                spacing: 12px;
                alignment: start;
                // Header: picture, name, PLATFORM @handle, Has Contact; Open channel, Edit, "3 of 12", × on the right.
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: 10px;
                        clip: true;
                        background: CollectorBus.d-has-avatar ? Theme.fg.with-alpha(0.06) : CollectorBus.d-color;
                        if CollectorBus.d-has-avatar: Image {
                            width: parent.width;
                            height: parent.height;
                            source: CollectorBus.d-avatar;
                            image-fit: cover;
                        }
                        if !CollectorBus.d-has-avatar: Text {
                            text: CollectorBus.d-initials;
                            font-size: 16px;
                            font-weight: 600;
                            color: white;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text {
                            text: CollectorBus.d-name;
                            font-size: 16px;
                            font-weight: 600;
                            color: Theme.fg;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: CollectorBus.d-platform;
                                font-size: 12px;
                                letter-spacing: 0.5px;
                                color: Theme.fg.with-alpha(0.3);
                                vertical-alignment: center;
                            }
                            if CollectorBus.d-handle != "": Text {
                                text: CollectorBus.d-handle;
                                font-size: 12.5px;
                                color: Theme.fg.with-alpha(0.45);
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            if CollectorBus.d-has-contact: Rectangle {
                                width: hc.preferred-width + 14px;
                                height: 19px;
                                border-radius: 9.5px;
                                background: Theme.fg.with-alpha(0.07);
                                hc := Text {
                                    text: "Has Contact";
                                    font-size: 10.5px;
                                    color: Theme.fg.with-alpha(0.55);
                                }
                            }
                            if CollectorBus.d-approved || CollectorBus.d-restricted: Rectangle {
                                width: st.preferred-width + 14px;
                                height: 19px;
                                border-radius: 9.5px;
                                background: (CollectorBus.d-approved ? Theme.green-900 : Theme.red-900).with-alpha(0.12);
                                st := Text {
                                    text: CollectorBus.d-approved ? "Approved" : "Restricted";
                                    font-size: 10.5px;
                                    color: CollectorBus.d-approved ? Theme.green-900 : Theme.red-900;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        VerticalLayout {
                            alignment: center;
                            if CollectorBus.d-url != "": Btn {
                                text: CollectorBus.d-open-label;
                                icon: Icons.external;
                                size: sm;
                                variant: outline;
                                clicked => {
                                    CollectorBus.open(CollectorBus.d-url);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                text: "Edit";
                                icon: Icons.pencil;
                                size: sm;
                                variant: primary;
                                clicked => {
                                    CollectorBus.edit-show();
                                }
                            }
                        }
                        // "49 of 190" between the ← and → caps: a click (or the key) goes to the previous / next lead.
                        if CollectorBus.d-position != "": HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                ReviewCap {
                                    icon: Icons.arrow-left;
                                    opacity: CollectorBus.d-has-prev ? (prev-area.has-hover ? 1 : 0.85) : 0.35;
                                    prev-area := TipArea {
                                        enabled: CollectorBus.d-has-prev;
                                        tip: "Previous lead (←)";
                                        clicked => {
                                            CollectorBus.detail-step(-1);
                                        }
                                    }
                                }
                            }
                            Text {
                                text: CollectorBus.d-position;
                                font-size: 12.5px;
                                color: Theme.gray-800;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                ReviewCap {
                                    icon: Icons.arrow-right;
                                    opacity: CollectorBus.d-has-next ? (next-area.has-hover ? 1 : 0.85) : 0.35;
                                    next-area := TipArea {
                                        enabled: CollectorBus.d-has-next;
                                        tip: "Next lead (→)";
                                        clicked => {
                                            CollectorBus.detail-step(1);
                                        }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            TouchArea {
                                width: 28px;
                                height: 28px;
                                mouse-cursor: pointer;
                                clicked => {
                                    CollectorBus.detail-close();
                                }
                                Glyph {
                                    icon: Icons.x;
                                    size: 16px;
                                    color: parent.has-hover ? Theme.fg : Theme.subtle;
                                }
                            }
                        }
                    }
                }
                // The stat tiles (only those with data).
                if CollectorBus.d-stats.length > 0: HorizontalLayout {
                    spacing: 8px;
                    for s in CollectorBus.d-stats: StatTile {
                        s: s;
                        horizontal-stretch: 1;
                        height: 48px;
                    }
                }
                if CollectorBus.d-filling && CollectorBus.d-stats.length == 0: Text {
                    text: "Reading their profile…";
                    font-size: 12px;
                    color: Theme.fg.with-alpha(0.3);
                }
                // MOST RECENT
                if CollectorBus.d-videos.length > 0: VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Glyph {
                            icon: Icons.flame;
                            size: 14px;
                            color: Theme.fg.with-alpha(0.4);
                        }
                        Text {
                            text: "MOST RECENT";
                            font-size: 12px;
                            font-weight: 600;
                            letter-spacing: 2.4px;
                            color: Theme.fg.with-alpha(0.7);
                            vertical-alignment: center;
                        }
                    }
                    Podium { }
                }
                DSection {
                    icon: Icons.sticky-note;
                    title: "BIO";
                    // Three lines at most, clipped (its line breaks folded into " · "): the dialog never scrolls and the
                    // bio never runs over the review bar. Not `overflow: elide`: on wrapped text Slint 1.18 elides every
                    // font run of the last line ("2022▸…100"), so a cut bio ends in a fade and "… more" instead. A click
                    // shows it all in a popover over the dialog.
                    // 2px short of three lines: the accents of a fourth line (Ã, Õ) reach up into the third's box.
                    Rectangle {
                        height: min(bio-t.preferred-height, root.bio-h - 2px);
                        clip: true;
                        bio-t := Text {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: root.bio-h;
                            vertical-alignment: top;
                            text: CollectorBus.d-bio != "" ? CollectorBus.d-bio-line : CollectorBus.d-filling ? "Reading their profile…" : "No bio on the profile.";
                            font-size: 12.5px;
                            color: CollectorBus.d-bio != "" ? (bio-ta.has-hover ? Theme.fg.with-alpha(0.8) : Theme.fg.with-alpha(0.65)) : Theme.fg.with-alpha(0.3);
                            wrap: word-wrap;
                        }
                        if CollectorBus.d-bio != "" && bio-t.preferred-height > root.bio-h + 1px: HorizontalLayout {
                            x: parent.width - self.width;
                            y: root.bio-h - 2px - root.bio-line;
                            width: 36px + more.preferred-width;
                            height: root.bio-line;
                            Rectangle {
                                width: 28px;
                                background: @linear-gradient(90deg, Theme.bg100.with-alpha(0) 0%, Theme.bg100 100%);
                            }
                            Rectangle {
                                background: Theme.bg100;
                                more := Text {
                                    x: parent.width - self.width;
                                    text: "… more";
                                    font-size: 12.5px;
                                    color: bio-ta.has-hover ? Theme.fg.with-alpha(0.8) : Theme.fg.with-alpha(0.45);
                                }
                            }
                        }
                        bio-ta := TipArea {
                            enabled: CollectorBus.d-bio != "";
                            mouse-cursor: CollectorBus.d-bio != "" ? pointer : default;
                            tip: "Click to read the whole bio";
                            clicked => {
                                root.bio-open = true;
                            }
                        }
                    }
                }
                DSection {
                    icon: Icons.mail;
                    title: "REACH";
                    HorizontalLayout {
                        spacing: 6px;
                        for k in CollectorBus.d-reaches: Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: Ds.radius-md;
                            background: k.on ? k.color.with-alpha(0.13) : kta.has-hover ? Theme.fg.with-alpha(0.08) : Theme.fg.with-alpha(0.04);
                            border-width: k.on ? 1px : 0px;
                            border-color: Theme.fg.with-alpha(0.4);
                            BrandGlyph {
                                kind: k.kind;
                                size: 16px;
                                ink: k.on ? k.color : kta.has-hover ? Theme.fg.with-alpha(0.7) : Theme.fg.with-alpha(0.4);
                            }
                            kta := TipArea {
                                tip: k.label + ": one way to contact them (its icon shows on their card)";
                                clicked => {
                                    CollectorBus.reach-pick(k.kind);
                                }
                            }
                        }
                        Rectangle {
                            width: 2px;
                        }
                        Input {
                            horizontal-stretch: 1;
                            text <=> CollectorBus.d-reach-text;
                            hint: CollectorBus.d-reach-hint;
                            edited(t) => {
                                CollectorBus.reach-edited(t);
                            }
                            accepted => {
                                CollectorBus.reach-save();
                            }
                        }
                        Btn {
                            text: CollectorBus.d-reach-busy ? "Saving…" : "Save";
                            size: sm;
                            variant: primary;
                            enabled: CollectorBus.d-reach-can-save && !CollectorBus.d-reach-busy;
                            clicked => {
                                CollectorBus.reach-save();
                            }
                        }
                        if CollectorBus.d-reach-saved: Btn {
                            text: "Clear";
                            size: sm;
                            variant: ghost-muted;
                            enabled: !CollectorBus.d-reach-busy;
                            clicked => {
                                CollectorBus.reach-clear();
                            }
                        }
                    }
                    if CollectorBus.d-reach-error != "": Text {
                        text: CollectorBus.d-reach-error;
                        font-size: 11.5px;
                        color: Theme.red-900;
                        overflow: elide;
                    }
                    // Send message, the same whichever icon is picked: the composer with that channel picked in To
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Btn {
                            text: "Send message";
                            icon: Icons.send;
                            size: sm;
                            variant: primary;
                            tip: "Write to them by email, WhatsApp, Discord or Instagram (they join Persons › Creators)";
                            clicked => {
                                CollectorBus.detail-send();
                            }
                        }
                    }
                }
            }
        }
        // The review bar at the bottom (leads under review only).
        if CollectorBus.d-review: Rectangle {
            y: parent.height - 1px - root.bar-h;
            height: 1px + root.bar-h;
            background: Theme.dark ? #00000040 : Theme.fg.with-alpha(0.03);
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                y: 1px;
                height: root.bar-h;
                ReviewCell {
                    width: (root.box-w - 3px) / 4;
                    // A Restricted lead's Reject is Move to Available (an Approved one's is Approve's cell).
                    label: CollectorBus.d-restricted ? "Move to Available" : "Reject";
                    icon: CollectorBus.d-restricted ? Icons.rotate-cw : Icons.x;
                    ink: CollectorBus.d-restricted ? Theme.fg.with-alpha(0.8) : Theme.red-900;
                    cap: "R";
                    tip: CollectorBus.d-restricted ? "Back to Available, then the next lead" : "To Restricted (never collected again), then the next lead";
                    enabled: !CollectorBus.review-busy;
                    clicked => {
                        CollectorBus.review("reject");
                    }
                }
                Rectangle {
                    width: 1px;
                    background: Theme.border;
                }
                ReviewCell {
                    width: (root.box-w - 3px) / 4;
                    label: "Skip";
                    down: true;
                    ink: Theme.fg.with-alpha(0.6);
                    cap: "S";
                    cap-down: true;
                    tip: "Leave it as it is: the next lead";
                    enabled: !CollectorBus.review-busy;
                    clicked => {
                        CollectorBus.review("skip");
                    }
                }
                Rectangle {
                    width: 1px;
                    background: Theme.border;
                }
                ReviewCell {
                    width: (root.box-w - 3px) / 4;
                    label: CollectorBus.d-approved ? "Move to Available" : "Approve";
                    icon: CollectorBus.d-approved ? Icons.rotate-cw : Icons.check;
                    ink: CollectorBus.d-approved ? Theme.fg.with-alpha(0.8) : Theme.green-900;
                    cap: "A";
                    tip: CollectorBus.d-approved ? "Back to Available, then the next lead" : "To Approved and Persons › Creators (nothing sent), then the next lead";
                    enabled: !CollectorBus.review-busy;
                    clicked => {
                        CollectorBus.review("approve");
                    }
                }
                Rectangle {
                    width: 1px;
                    background: Theme.border;
                }
                // Approve into Persons › Neobux instead of Creators.
                ReviewCell {
                    width: (root.box-w - 3px) / 4;
                    label: "Neobux";
                    icon: Icons.check;
                    ink: Theme.blue-900;
                    cap: "N";
                    tip: "To Approved and Persons › Neobux (nothing sent), then the next lead";
                    enabled: !CollectorBus.review-busy && !CollectorBus.d-approved;
                    clicked => {
                        CollectorBus.review("neobux");
                    }
                }
            }
        }
    }
    // The whole bio, over the dialog (it doesn't push anything): scrolls inside when it's long.
    if root.bio-open: Rectangle {
        TouchArea {
            clicked => {
                root.bio-open = false;
                keys.focus();
            }
        }
        PopoverFrame {
            width: root.box-w - 48px;
            height: min(full.preferred-height + 2px, root.height * 0.6);
            TouchArea { }
            Scroll {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                content-height: full.preferred-height;
                full := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: root.box-w - 50px;
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Glyph {
                            icon: Icons.sticky-note;
                            size: 12px;
                            color: Theme.fg.with-alpha(0.35);
                        }
                        Text {
                            text: "BIO";
                            font-size: 10.5px;
                            font-weight: 600;
                            letter-spacing: 0.5px;
                            color: Theme.fg.with-alpha(0.35);
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: CollectorBus.d-bio;
                        font-size: 12.5px;
                        color: Theme.fg.with-alpha(0.8);
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

/** Edit: name, handle, bio and links typed by hand (kept over anything read later). */
component EditDialog inherits DialogFrame {
    title: "Edit " + CollectorBus.d-name;
    box-w: 512px;
    scrim-dismisses: false;
    dismiss => {
        CollectorBus.edit-close();
    }
    VerticalLayout {
        spacing: 6px;
        FieldLabel {
            text: "Name";
        }
        Input {
            text <=> CollectorBus.e-name;
            hint: "Their name";
        }
    }
    VerticalLayout {
        spacing: 6px;
        FieldLabel {
            text: "Handle";
        }
        Input {
            text <=> CollectorBus.e-handle;
            hint: "@handle";
        }
    }
    VerticalLayout {
        spacing: 6px;
        FieldLabel {
            text: "Bio";
        }
        TextBox {
            min-h: 96px;
            text <=> CollectorBus.e-bio;
            hint: "Their bio";
        }
    }
    VerticalLayout {
        spacing: 6px;
        FieldLabel {
            text: "Links (one a line: Title https://…)";
        }
        TextBox {
            min-h: 96px;
            text <=> CollectorBus.e-links;
            hint: "Loja https://loja.com.br";
        }
    }
    if CollectorBus.e-error != "": Text {
        text: CollectorBus.e-error;
        font-size: Ds.t-sm;
        color: Theme.red-900;
        wrap: word-wrap;
    }
    DialogActions {
        Btn {
            text: "Cancel";
            variant: outline;
            clicked => {
                CollectorBus.edit-close();
            }
        }
        Btn {
            text: "Save";
            variant: primary;
            enabled: CollectorBus.e-name != "";
            clicked => {
                CollectorBus.edit-save();
            }
        }
    }
}

/** One scrolling column (a fresh one per view), at the view's kept scroll (CollectorBus.y-…). */
component Column inherits Rectangle {
    in property <length> col-w;
    in property <length> col-x;
    /** "collector", "available", "approved", "sent", "restricted", "history" (the timeline) or "history-run" (a run's leads). */
    in property <string> key;
    property <length> kept: root.key == "available" ? CollectorBus.y-available : root.key == "approved" ? CollectorBus.y-approved : root.key == "sent" ? CollectorBus.y-sent : root.key == "restricted" ? CollectorBus.y-restricted : root.key == "history" ? CollectorBus.y-history : root.key == "history-run" ? 0 : CollectorBus.y-collector;
    // Not `content-y <=> a global` (Slint 1.18 kept such a viewport at 0, settings.slint): set once, followed after.
    init => {
        f.content-y = root.kept;
    }
    // A new filter, sort or platform choice: back to the top.
    property <string> asked: CollectorBus.filter + "|" + CollectorBus.sort-label + "|" + CollectorBus.plat-label;
    changed asked => {
        f.content-y = 0;
    }
    f := Flickable {
        width: parent.width;
        height: parent.height;
        changed content-y => {
            if root.key == "available" {
                CollectorBus.y-available = self.content-y;
            } else if root.key == "approved" {
                CollectorBus.y-approved = self.content-y;
            } else if root.key == "sent" {
                CollectorBus.y-sent = self.content-y;
            } else if root.key == "restricted" {
                CollectorBus.y-restricted = self.content-y;
            } else if root.key == "history" {
                CollectorBus.y-history = self.content-y;
            } else if root.key == "history-run" {
                // a run's leads open at the top each time
            } else {
                CollectorBus.y-collector = self.content-y;
            }
        }
        content-height: inner.preferred-height + 40px;
        inner := VerticalLayout {
            x: root.col-x;
            y: Ds.sp8;
            width: root.col-w;
            @children
        }
    }
    ScrollThumb {
        x: parent.width - self.width;
        y: 0;
        height: parent.height;
        content-y: f.content-y;
        content-height: f.content-height;
        visible-height: f.height;
        scroll-to(v) => {
            f.content-y = v;
        }
    }
}

export component CollectorPage {
    /** The sidebar's width: Projects' (app.slint side-shown), so the header's buttons sit where they do there. */
    in property <length> side-w: Ds.side-w;
    Rectangle {
        background: Theme.bg100;
    }
    if !CollectorBus.side-hidden: Sidebar {
        x: 0;
        y: 0;
        width: root.side-w;
        height: root.height;
    }
    property <length> main-x: CollectorBus.side-hidden ? 0px : root.side-w;
    property <length> main-w: root.width - main-x;
    property <length> col-w: min(Ds.page-max-w + 160px, main-w - 2 * Ds.page-pad);
    property <length> col-x: (main-w - col-w) / 2;
    bar := PageBar {
        x: root.main-x;
        y: 0;
        width: root.main-w;
        side-hidden: CollectorBus.side-hidden;
        icon: CollectorBus.page == "collector" ? Icons.search : CollectorBus.page == "available" ? Icons.users : CollectorBus.page == "approved" ? Icons.circle-check : CollectorBus.page == "sent" ? Icons.send : CollectorBus.page == "history" ? "\u{e063}" : Icons.circle-slash;
        section: "Collector";
        title: CollectorBus.page == "collector" ? "Collect leads" : CollectorBus.page == "available" ? "Available" : CollectorBus.page == "approved" ? "Approved" : CollectorBus.page == "sent" ? "Sent" : CollectorBus.page == "history" ? "History" : "Restricted";
        sub: CollectorBus.page == "history" ? (CollectorBus.history-run != "" ? CollectorBus.rows.length + (CollectorBus.rows.length == 1 ? " lead" : " leads") : CollectorBus.n-runs + (CollectorBus.n-runs == 1 ? " search" : " searches")) : CollectorBus.page == "available" ? CollectorBus.n-available + (CollectorBus.n-available == 1 ? " lead" : " leads") : CollectorBus.page == "approved" ? CollectorBus.n-approved + (CollectorBus.n-approved == 1 ? " lead" : " leads") : CollectorBus.page == "sent" ? CollectorBus.n-sent + (CollectorBus.n-sent == 1 ? " lead" : " leads") : CollectorBus.page == "restricted" ? CollectorBus.n-restricted + (CollectorBus.n-restricted == 1 ? " lead" : " leads") : "";
        show-side => {
            CollectorBus.side-hidden = false;
        }
        if CollectorBus.page == "available" || CollectorBus.page == "approved": Btn {
            text: CollectorBus.copy-label;
            icon: Icons.copy;
            size: sm;
            variant: outline;
            enabled: CollectorBus.page == "approved" ? CollectorBus.n-approved > 0 : CollectorBus.n-available > 0;
            tip: "The " + (CollectorBus.page == "approved" ? "Approved" : "Available") + " leads as JSONL, one per line (with the email): paste it in SpokPayCRM → Creators → Import";
            clicked => {
                CollectorBus.copy();
            }
        }
    }
    property <length> top: bar.height;
    /** The lists scroll under their bar (filter box, Sort, platforms), which stays put. */
    property <length> list-top: root.top + Ds.sp8 + 34px - 6px;
    if CollectorBus.loading: Text {
        x: root.main-x;
        width: root.main-w;
        text: CollectorBus.error != "" ? CollectorBus.error : "Loading…";
        color: Theme.subtle;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !CollectorBus.loading && CollectorBus.page == "collector": Column {
        key: "collector";
        x: root.main-x;
        y: root.top;
        width: root.main-w;
        height: root.height - root.top;
        col-w: root.col-w;
        col-x: root.col-x;
        CollectScreen { }
    }
    if !CollectorBus.loading && CollectorBus.page == "available": Column {
        key: "available";
        x: root.main-x;
        y: root.list-top;
        width: root.main-w;
        height: root.height - root.list-top;
        col-w: root.col-w;
        col-x: root.col-x;
        ListScreen { }
    }
    if !CollectorBus.loading && CollectorBus.page == "approved": Column {
        key: "approved";
        x: root.main-x;
        y: root.list-top;
        width: root.main-w;
        height: root.height - root.list-top;
        col-w: root.col-w;
        col-x: root.col-x;
        ListScreen { }
    }
    if !CollectorBus.loading && CollectorBus.page == "sent": Column {
        key: "sent";
        x: root.main-x;
        y: root.list-top;
        width: root.main-w;
        height: root.height - root.list-top;
        col-w: root.col-w;
        col-x: root.col-x;
        ListScreen { }
    }
    if !CollectorBus.loading && CollectorBus.page == "restricted": Column {
        key: "restricted";
        x: root.main-x;
        y: root.list-top;
        width: root.main-w;
        height: root.height - root.list-top;
        col-w: root.col-w;
        col-x: root.col-x;
        ListScreen { }
    }
    if !CollectorBus.loading && CollectorBus.page == "history" && CollectorBus.history-run == "": Column {
        key: "history";
        x: root.main-x;
        y: root.top;
        width: root.main-w;
        height: root.height - root.top;
        col-w: min(Ds.page-max-w, root.col-w);
        col-x: (root.main-w - self.col-w) / 2;
        HistoryScreen { }
    }
    if !CollectorBus.loading && CollectorBus.page == "history" && CollectorBus.history-run != "": Column {
        key: "history-run";
        x: root.main-x;
        y: root.top;
        width: root.main-w;
        height: root.height - root.top;
        col-w: root.col-w;
        col-x: root.col-x;
        HistoryScreen { }
    }
    if !CollectorBus.loading && CollectorBus.page != "collector" && CollectorBus.page != "history" && CollectorBus.list-menu != "": TouchArea {
        clicked => {
            CollectorBus.list-menu-show("");
        }
    }
    if !CollectorBus.loading && CollectorBus.page != "collector" && CollectorBus.page != "history": ListBar {
        x: root.main-x + root.col-x;
        y: root.top + Ds.sp8;
        width: root.col-w;
    }
    if CollectorBus.detail-open: DetailDialog {
        width: root.width;
        height: root.height;
    }
    if CollectorBus.edit-open: EditDialog {
        width: root.width;
        height: root.height;
    }
    if CollectorBus.send-open: SendDialog {
        width: root.width;
        height: root.height;
    }
}
