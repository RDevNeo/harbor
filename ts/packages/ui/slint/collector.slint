// Collector tab: leads (content creators) from YouTube, TikTok and Instagram. Three views, picked in the sidebar:
// Collector (the search form, one line while a run goes, and the leads it found), Available (every lead not
// Restricted) and Restricted (leads the user keeps out of Available). A lead is a card: picture, name and handle,
// platform, profile link, email (found, or typed by hand), the 3 newest videos, and Restrict / Unrestrict and Send
// message (which adds them to Persons › Creators). The runs happen in the engine (ts/tabs/collector); CollectorBus is
// driven by src/tabs/collector/ui.ts, the same data Hub for Android shows. Built on Hub's design system (ds.slint,
// DESIGN.md): sidebar, page bar, cards, chips, inputs, a dialog.
import { PageBar, Theme, Icons, Ds, Btn, Variant, BtnSize, Input, TipArea, Card, Well, Glyph, Empty, ListRow, SideSurface, SideHead, FieldLabel, Chip, Muted, Hint, Avatar, Spinner, ScrollThumb, CapsLabel, DialogFrame, DialogActions, TextBox, SearchField } from "ds.slint";

export struct ClChip { value: string, label: string, on: bool, available: bool, tip: string }
export struct ClVid { url: string, title: string, thumb: image, has-thumb: bool }
export struct ClRow {
    id: string, name: string, handle: string, platform: string, url: string, short: string,
    avatar: image, has-avatar: bool, initials: string, color: color,
    email: string, email-source: string, restricted: bool, videos: [ClVid],
}
export struct ClNav { id: string, label: string, count: int, on: bool }
export struct ClTpl { id: string, name: string, description: string, on: bool }

export global CollectorBus {
    in property <bool> loading: true;
    in property <string> error;
    /** "collector", "available" or "restricted". */
    in property <string> page: "collector";
    in property <[ClNav]> nav;
    // The form
    in property <[ClChip]> sources;
    in property <[ClChip]> gaps;
    /** The picked source can't run (its reason), or "". */
    in property <string> unavailable;
    in property <string> source-note;
    in-out property <string> query;
    in-out property <string> target;
    // Instagram's session (shown when Instagram is picked)
    in property <bool> show-session;
    in property <bool> session-on;
    in property <string> session-account;
    in property <string> session-help;
    in-out property <string> session-cookie;
    in property <bool> session-busy;
    // The run: one line while it goes, its outcome after
    in property <bool> running;
    in property <string> run-line;
    // The leads on the page (the run's on Collector; Available's or Restricted's, filtered)
    in property <[ClRow]> rows;
    in property <string> rows-head;
    in property <string> empty-title;
    in property <string> empty-desc;
    in-out property <string> filter;
    in property <int> n-available;
    in property <int> n-restricted;
    in property <string> copy-label;
    in-out property <bool> side-hidden;
    // A typed email: the card being edited and the text
    in property <string> email-for;
    in-out property <string> email-text;
    // Send message
    in property <bool> send-open;
    in property <string> s-title;
    in property <[ClTpl]> s-templates;
    in property <[ClChip]> s-channels;
    in property <string> s-channel-why;
    in property <bool> s-is-email;
    in-out property <string> s-to;
    in-out property <string> s-subject;
    in-out property <string> s-text;
    in property <string> s-guard;
    in property <string> s-already;
    in property <string> s-error;
    in property <bool> s-busy;
    in property <bool> s-confirm;
    in property <string> s-confirm-text;
    in property <bool> s-can-send;
    in property <string> s-saved;

    callback go(string);
    callback pick-source(string);
    callback pick-gap(string);
    callback query-edited(string);
    callback target-edited(string);
    callback target-step(int);
    callback start();
    callback stop();
    callback copy();
    callback open(string);
    callback restrict(string, bool);
    callback filter-edited(string);
    callback email-edit(string);
    callback email-save();
    callback email-cancel();
    callback session-save();
    callback session-remove();
    callback send-show(string);
    callback send-close();
    callback pick-template(string);
    callback pick-channel(string);
    callback send-ask();
    callback send-confirm();
    callback send-back();
    callback save-template();
}

/** Collector, Available, Restricted: the three views. A click shows that view. */
component Sidebar inherits SideSurface {
    VerticalLayout {
        padding-top: Ds.side-pad-top;
        spacing: 2px;
        SideHead {
            padding-left: Ds.side-pad;
            padding-right: Ds.side-pad;
            hide => {
                CollectorBus.side-hidden = true;
            }
        }
        VerticalLayout {
            padding: Ds.side-pad;
            padding-top: Ds.side-list-top;
            spacing: 2px;
            alignment: start;
            vertical-stretch: 1;
            for n in CollectorBus.nav: ListRow {
                lead: "glyph";
                glyph: n.id == "collector" ? Icons.search : n.id == "available" ? Icons.users : Icons.circle-slash;
                title: n.label;
                active: n.on;
                meta: n.id == "collector" ? (CollectorBus.running ? "running" : "") : n.count > 0 ? n.count : "";
                clicked => {
                    CollectorBus.go(n.id);
                }
            }
        }
    }
}

/** The form: platform, search term, how many leads, Collect/Stop, the last-upload window, Instagram's session. */
component Controls inherits Card {
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        VerticalLayout {
            spacing: 6px;
            FieldLabel {
                text: "Platform";
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for s in CollectorBus.sources: Chip {
                    sm: true;
                    text: s.available ? s.label : s.label + " · needs sign-in";
                    on: s.on;
                    enabled: !CollectorBus.running || s.on;
                    tip: s.tip;
                    clicked => {
                        CollectorBus.pick-source(s.value);
                    }
                }
            }
            if CollectorBus.unavailable != "": Hint {
                text: CollectorBus.unavailable;
                wrap: word-wrap;
            }
            if CollectorBus.unavailable == "" && CollectorBus.source-note != "": Muted {
                text: CollectorBus.source-note;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                FieldLabel {
                    text: "Search term";
                    horizontal-stretch: 1;
                }
                FieldLabel {
                    width: 132px;
                    text: "Leads";
                }
                Rectangle {
                    width: 104px;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Input {
                    horizontal-stretch: 1;
                    text <=> CollectorBus.query;
                    hint: "e.g. dress to impress";
                    edited(t) => {
                        CollectorBus.query-edited(t);
                    }
                    accepted => {
                        if !CollectorBus.running {
                            CollectorBus.start();
                        }
                    }
                }
                HorizontalLayout {
                    width: 132px;
                    spacing: 4px;
                    Btn {
                        text: "−";
                        size: icon;
                        variant: ghost-muted;
                        tip: "5 fewer";
                        enabled: !CollectorBus.running;
                        clicked => {
                            CollectorBus.target-step(-5);
                        }
                    }
                    Input {
                        text <=> CollectorBus.target;
                        hint: "All";
                        mono: true;
                        edited(t) => {
                            CollectorBus.target-edited(t);
                        }
                    }
                    Btn {
                        icon: Icons.plus;
                        size: icon;
                        variant: ghost-muted;
                        tip: "5 more";
                        enabled: !CollectorBus.running;
                        clicked => {
                            CollectorBus.target-step(5);
                        }
                    }
                }
                if !CollectorBus.running: Btn {
                    width: 104px;
                    text: "Collect";
                    icon: Icons.search;
                    variant: primary;
                    enabled: CollectorBus.unavailable == "" && CollectorBus.query != "";
                    clicked => {
                        CollectorBus.start();
                    }
                }
                if CollectorBus.running: Btn {
                    width: 104px;
                    text: "Stop";
                    icon: Icons.stop;
                    variant: outline;
                    clicked => {
                        CollectorBus.stop();
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 6px;
            FieldLabel {
                text: "Last upload";
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for g in CollectorBus.gaps: Chip {
                    sm: true;
                    text: g.label;
                    on: g.on;
                    enabled: !CollectorBus.running || g.on;
                    tip: g.tip;
                    clicked => {
                        CollectorBus.pick-gap(g.value);
                    }
                }
            }
        }
        if CollectorBus.show-session: Well {
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Glyph {
                        icon: CollectorBus.session-on ? Icons.circle-check : Icons.lock;
                        size: 14px;
                        color: CollectorBus.session-on ? Theme.green-800 : Theme.gray-800;
                    }
                    Text {
                        text: CollectorBus.session-on ? "Instagram session: " + (CollectorBus.session-account != "" ? "@" + CollectorBus.session-account : "saved") : "Instagram session";
                        font-size: Ds.t-sm;
                        font-weight: 600;
                        color: Theme.fg;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    if CollectorBus.session-on: Btn {
                        text: "Remove";
                        size: xs;
                        variant: ghost-muted;
                        clicked => {
                            CollectorBus.session-remove();
                        }
                    }
                }
                if !CollectorBus.session-on: Muted {
                    text: CollectorBus.session-help;
                    wrap: word-wrap;
                }
                if !CollectorBus.session-on: HorizontalLayout {
                    spacing: 8px;
                    Input {
                        horizontal-stretch: 1;
                        password: true;
                        mono: true;
                        text <=> CollectorBus.session-cookie;
                        hint: "sessionid=…; csrftoken=…";
                        accepted => {
                            CollectorBus.session-save();
                        }
                    }
                    Btn {
                        text: CollectorBus.session-busy ? "Checking…" : "Save";
                        size: sm;
                        variant: outline;
                        enabled: CollectorBus.session-cookie != "" && !CollectorBus.session-busy;
                        clicked => {
                            CollectorBus.session-save();
                        }
                    }
                }
            }
        }
    }
}

/** A tag (the platform). */
component Tag inherits Rectangle {
    in property <string> text;
    width: t.preferred-width + 10px;
    height: 16px;
    border-radius: 4px;
    background: Theme.gray-200;
    t := Text {
        text: root.text;
        font-size: 10.5px;
        font-weight: 600;
        color: Theme.gray-1000;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/** One of the 3 newest videos: its thumbnail; a click opens it, the title is its tip. */
component Thumb inherits Rectangle {
    in property <ClVid> v;
    width: 64px;
    height: 48px;
    border-radius: Ds.radius-md;
    background: Theme.gray-200;
    clip: true;
    if root.v.has-thumb: Image {
        width: parent.width;
        height: parent.height;
        source: root.v.thumb;
        image-fit: cover;
    }
    if !root.v.has-thumb: Glyph {
        icon: Icons.play;
        size: 14px;
        color: Theme.gray-700;
    }
    Rectangle {
        border-radius: Ds.radius-md;
        border-width: 1px;
        border-color: ta.has-hover ? Theme.gray-1000 : Theme.border;
    }
    ta := TipArea {
        mouse-cursor: pointer;
        tip: root.v.title != "" ? root.v.title : root.v.url;
        clicked => {
            CollectorBus.open(root.v.url);
        }
    }
}

/** A lead: picture, name, platform, handle, profile link, email (or Add email), the 3 newest videos, Send and Restrict. */
component LeadCard inherits Rectangle {
    in property <ClRow> r;
    property <bool> editing: CollectorBus.email-for == root.r.id;
    height: max(76px, body.preferred-height + 24px);
    border-radius: Ds.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg100;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 44px;
                initials: root.r.initials;
                color: root.r.color;
                photo: root.r.avatar;
                has-photo: root.r.has-avatar;
            }
        }
        body := VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.r.name;
                    font-size: Ds.t-body;
                    font-weight: 500;
                    color: Theme.fg;
                    overflow: elide;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                }
                VerticalLayout {
                    alignment: center;
                    Tag {
                        text: root.r.platform;
                    }
                }
                if root.r.handle != "" && root.r.handle != "@" + root.r.name: Text {
                    text: root.r.handle;
                    font-size: 12.5px;
                    color: Theme.gray-800;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                spacing: 5px;
                Glyph {
                    icon: Icons.link;
                    size: 12px;
                    color: Theme.gray-800;
                }
                link := Text {
                    text: root.r.short;
                    font-size: 12.5px;
                    color: la.has-hover ? Theme.fg : Theme.gray-900;
                    overflow: elide;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                    la := TipArea {
                        mouse-cursor: pointer;
                        tip: "Open " + root.r.url;
                        clicked => {
                            CollectorBus.open(root.r.url);
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            if !root.editing: HorizontalLayout {
                spacing: 5px;
                Glyph {
                    icon: Icons.at-sign;
                    size: 12px;
                    color: root.r.email != "" ? Theme.fg : Theme.gray-700;
                }
                Text {
                    text: root.r.email != "" ? root.r.email : "Add email";
                    font-size: 12.5px;
                    color: root.r.email != "" ? Theme.fg : ea.has-hover ? Theme.fg : Theme.gray-700;
                    overflow: elide;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                    ea := TipArea {
                        mouse-cursor: pointer;
                        tip: root.r.email != "" ? "Type another email (a typed one is never replaced)" : "Type their email";
                        clicked => {
                            CollectorBus.email-edit(root.r.id);
                        }
                    }
                }
                if root.r.email-source != "": Text {
                    text: "· " + root.r.email-source;
                    font-size: 12px;
                    color: Theme.gray-800;
                    overflow: elide;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            if root.editing: HorizontalLayout {
                spacing: 6px;
                Input {
                    horizontal-stretch: 1;
                    text <=> CollectorBus.email-text;
                    hint: "name@example.com";
                    init => {
                        self.focus-end();
                    }
                    accepted => {
                        CollectorBus.email-save();
                    }
                }
                Btn {
                    text: "Save";
                    size: sm;
                    variant: outline;
                    clicked => {
                        CollectorBus.email-save();
                    }
                }
                Btn {
                    text: "Cancel";
                    size: sm;
                    variant: ghost-muted;
                    clicked => {
                        CollectorBus.email-cancel();
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            for v in root.r.videos: VerticalLayout {
                alignment: center;
                Thumb {
                    v: v;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Btn {
                text: root.r.restricted ? "Unrestrict" : "Restrict";
                icon: root.r.restricted ? Icons.rotate-cw : Icons.circle-slash;
                size: sm;
                variant: ghost-muted;
                tip: root.r.restricted ? "Back to Available" : "Keep out of Available (still never collected again)";
                clicked => {
                    CollectorBus.restrict(root.r.id, !root.r.restricted);
                }
            }
            Btn {
                text: "Send";
                icon: Icons.send;
                size: sm;
                variant: ghost-muted;
                tip: "Send message… (Gmail or WhatsApp; adds them to Persons › Creators)";
                clicked => {
                    CollectorBus.send-show(root.r.id);
                }
            }
        }
    }
}

/** The leads of a view, or its empty state. */
component Leads inherits VerticalLayout {
    spacing: 8px;
    if CollectorBus.rows-head != "": HorizontalLayout {
        padding-top: 2px;
        CapsLabel {
            text: CollectorBus.rows-head;
        }
    }
    for r in CollectorBus.rows: LeadCard {
        r: r;
    }
    if CollectorBus.rows.length == 0 && CollectorBus.empty-title != "": Empty {
        icon: CollectorBus.page == "restricted" ? Icons.circle-slash : Icons.users;
        title: CollectorBus.empty-title;
        desc: CollectorBus.empty-desc;
    }
}

/** Available and Restricted: the one filter box, then the leads. */
component ListScreen inherits VerticalLayout {
    spacing: 14px;
    Rectangle {
        height: 34px;
        border-radius: Ds.radius-md;
        border-width: 1px;
        border-color: search.focused ? Theme.gray-1000 : Theme.border;
        search := SearchField {
            x: 8px;
            width: parent.width - 16px;
            y: 1px;
            hint: "Filter by name, handle, email or platform";
            text <=> CollectorBus.filter;
            edited(t) => {
                CollectorBus.filter-edited(t);
            }
        }
    }
    Leads { }
}

/** Collector: the form, the run's one line, the leads it found. */
component CollectScreen inherits VerticalLayout {
    spacing: 14px;
    Controls { }
    if CollectorBus.run-line != "": HorizontalLayout {
        spacing: 8px;
        padding-left: 4px;
        if CollectorBus.running: VerticalLayout {
            alignment: center;
            Spinner { }
        }
        Text {
            text: CollectorBus.run-line;
            font-size: 13px;
            color: CollectorBus.running ? Theme.fg : Theme.subtle;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    Leads { }
}

component SendDialog inherits DialogFrame {
    title: CollectorBus.s-confirm ? "Send it?" : CollectorBus.s-title;
    text: CollectorBus.s-confirm ? CollectorBus.s-confirm-text : "";
    box-w: CollectorBus.s-confirm ? 448px : 760px;
    scrim-dismisses: false;
    dismiss => {
        CollectorBus.send-close();
    }
    if !CollectorBus.s-confirm: HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            width: 200px;
            spacing: 2px;
            alignment: start;
            FieldLabel {
                text: "Template";
            }
            for t in CollectorBus.s-templates: Rectangle {
                height: tv.preferred-height + 12px;
                border-radius: Ds.radius-md;
                background: t.on ? Theme.gray-200 : ta.has-hover ? Theme.accent : transparent;
                ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        CollectorBus.pick-template(t.id);
                    }
                }
                tv := VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    y: 6px;
                    spacing: 1px;
                    Text {
                        text: t.name;
                        font-size: Ds.t-sm;
                        font-weight: t.on ? 600 : 500;
                        color: Theme.fg;
                        overflow: elide;
                    }
                    if t.description != "": Text {
                        text: t.description;
                        font-size: Ds.t-meta;
                        color: Theme.gray-800;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                padding-top: 6px;
                alignment: start;
                Btn {
                    text: CollectorBus.s-saved != "" ? CollectorBus.s-saved : "Save as template";
                    icon: Icons.copy;
                    size: xs;
                    variant: ghost-muted;
                    tip: "Keep this subject and message in the picked template (or as a new one, from Blank)";
                    clicked => {
                        CollectorBus.save-template();
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 10px;
            VerticalLayout {
                spacing: 6px;
                FieldLabel {
                    text: "Send through";
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for c in CollectorBus.s-channels: Chip {
                        sm: true;
                        text: c.label;
                        on: c.on;
                        enabled: c.available;
                        tip: c.tip;
                        clicked => {
                            CollectorBus.pick-channel(c.value);
                        }
                    }
                }
                if CollectorBus.s-channel-why != "": Hint {
                    text: CollectorBus.s-channel-why;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                spacing: 6px;
                FieldLabel {
                    text: CollectorBus.s-is-email ? "To (email)" : "To (WhatsApp number)";
                }
                Input {
                    text <=> CollectorBus.s-to;
                    hint: CollectorBus.s-is-email ? "their@email.com" : "55 11 99999-9999";
                }
            }
            if CollectorBus.s-is-email: VerticalLayout {
                spacing: 6px;
                FieldLabel {
                    text: "Subject";
                }
                Input {
                    text <=> CollectorBus.s-subject;
                    hint: "Subject";
                }
            }
            VerticalLayout {
                spacing: 6px;
                FieldLabel {
                    text: "Message";
                }
                TextBox {
                    min-h: 220px;
                    text <=> CollectorBus.s-text;
                    hint: "Write the message";
                }
            }
            if CollectorBus.s-already != "": Hint {
                text: CollectorBus.s-already;
                wrap: word-wrap;
            }
            if CollectorBus.s-guard != "": Muted {
                text: CollectorBus.s-guard;
                wrap: word-wrap;
            }
        }
    }
    if CollectorBus.s-error != "": Text {
        text: CollectorBus.s-error;
        font-size: Ds.t-sm;
        color: Theme.red-900;
        wrap: word-wrap;
    }
    DialogActions {
        if !CollectorBus.s-confirm: Btn {
            text: "Cancel";
            variant: outline;
            clicked => {
                CollectorBus.send-close();
            }
        }
        if !CollectorBus.s-confirm: Btn {
            text: "Send…";
            icon: Icons.send;
            variant: primary;
            enabled: CollectorBus.s-can-send;
            clicked => {
                CollectorBus.send-ask();
            }
        }
        if CollectorBus.s-confirm: Btn {
            text: "Back";
            variant: outline;
            enabled: !CollectorBus.s-busy;
            clicked => {
                CollectorBus.send-back();
            }
        }
        if CollectorBus.s-confirm: Btn {
            text: CollectorBus.s-busy ? "Sending…" : "Send now";
            icon: Icons.send;
            variant: primary;
            enabled: !CollectorBus.s-busy;
            clicked => {
                CollectorBus.send-confirm();
            }
        }
    }
}


/** One scrolling column (a fresh one per view: switching views starts at the top). */
component Column inherits Rectangle {
    in property <length> col-w;
    in property <length> col-x;
    f := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: inner.preferred-height + 40px;
        inner := VerticalLayout {
            x: root.col-x;
            y: Ds.sp8;
            width: root.col-w;
            @children
        }
    }
    ScrollThumb {
        x: parent.width - self.width;
        y: 0;
        height: parent.height;
        content-y: f.content-y;
        content-height: f.content-height;
        visible-height: f.height;
        scroll-to(v) => {
            f.content-y = v;
        }
    }
}

export component CollectorPage {
    /** The sidebar's width: Projects' (app.slint side-shown), so the header's buttons sit where they do there. */
    in property <length> side-w: Ds.side-w;
    Rectangle {
        background: Theme.bg100;
    }
    if !CollectorBus.side-hidden: Sidebar {
        x: 0;
        y: 0;
        width: root.side-w;
        height: root.height;
    }
    property <length> main-x: CollectorBus.side-hidden ? 0px : root.side-w;
    property <length> main-w: root.width - main-x;
    property <length> col-w: min(Ds.page-max-w + 160px, main-w - 2 * Ds.page-pad);
    property <length> col-x: (main-w - col-w) / 2;
    bar := PageBar {
        x: root.main-x;
        y: 0;
        width: root.main-w;
        side-hidden: CollectorBus.side-hidden;
        icon: CollectorBus.page == "collector" ? Icons.search : CollectorBus.page == "available" ? Icons.users : Icons.circle-slash;
        section: "Collector";
        title: CollectorBus.page == "collector" ? "Collect leads" : CollectorBus.page == "available" ? "Available" : "Restricted";
        sub: CollectorBus.page == "available" ? CollectorBus.n-available + (CollectorBus.n-available == 1 ? " lead" : " leads") : CollectorBus.page == "restricted" ? CollectorBus.n-restricted + (CollectorBus.n-restricted == 1 ? " lead" : " leads") : "";
        show-side => {
            CollectorBus.side-hidden = false;
        }
        if CollectorBus.page == "available": Btn {
            text: CollectorBus.copy-label;
            icon: Icons.copy;
            size: sm;
            variant: outline;
            enabled: CollectorBus.n-available > 0;
            tip: "The Available leads as JSONL, one per line (with the email): paste it in SpokPayCRM → Creators → Import";
            clicked => {
                CollectorBus.copy();
            }
        }
    }
    property <length> top: bar.height;
    if CollectorBus.loading: Text {
        x: root.main-x;
        width: root.main-w;
        text: CollectorBus.error != "" ? CollectorBus.error : "Loading…";
        color: Theme.subtle;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !CollectorBus.loading && CollectorBus.page == "collector": Column {
        x: root.main-x;
        y: root.top;
        width: root.main-w;
        height: root.height - root.top;
        col-w: root.col-w;
        col-x: root.col-x;
        CollectScreen { }
    }
    if !CollectorBus.loading && CollectorBus.page == "available": Column {
        x: root.main-x;
        y: root.top;
        width: root.main-w;
        height: root.height - root.top;
        col-w: root.col-w;
        col-x: root.col-x;
        ListScreen { }
    }
    if !CollectorBus.loading && CollectorBus.page == "restricted": Column {
        x: root.main-x;
        y: root.top;
        width: root.main-w;
        height: root.height - root.top;
        col-w: root.col-w;
        col-x: root.col-x;
        ListScreen { }
    }
    if CollectorBus.send-open: SendDialog {
        width: root.width;
        height: root.height;
    }
}
