// Collector tab (the Lead Collector userscript, moved into Hub): creators from YouTube, TikTok and Instagram, each kept
// once (never collected twice, on any platform, nor anyone already in Persons › Creators), with every link of their
// bio and link-in-bio pages, an email and where it was found, updated once a day; Send message writes to one through
// Persons › Creators (templates, Gmail or WhatsApp). The sweeps run in the engine (ts/tabs/collector); CollectorBus is
// driven by src/tabs/collector/ui.ts, the same data Hub for Android shows. Built on Hub's design system (ds.slint,
// DESIGN.md): sidebar, page bar, cards, chips, inputs, rows, a dialog.
import { PageBar, Theme, Icons, Ds, Btn, Variant, BtnSize, Input, TipArea, Card, Well, Glyph, Empty, ListRow, SideSurface, SideHead, FieldLabel, Chip, Muted, Hint, Avatar, Spinner, ScrollThumb, CapsLabel, Toggle, DialogFrame, DialogActions, TextBox, Badge, Tone } from "ds.slint";

export struct ClChip { value: string, label: string, on: bool, available: bool, tip: string }
export struct ClLog { text: string, tone: string }
export struct ClRow {
    id: string, name: string, sub: string, stats: string, meta: string, url: string,
    avatar: image, has-avatar: bool, initials: string, color: color, discord: bool, platform: string,
    email: string, email-source: string, updated: string, changed: string, contacted: string,
}
export struct ClFilter { id: string, label: string, count: int, on: bool, glyph: string }
export struct ClStat { label: string, value: string }
export struct ClLink { label: string, url: string, kind: string, source: string, short: string }
export struct ClHist { when: string, changes: string }
export struct ClVid { title: string, url: string, when: string, views: string }
export struct ClTpl { id: string, name: string, description: string, on: bool }

export global CollectorBus {
    in property <bool> loading: true;
    in property <string> error;
    in property <int> n-creators;
    in property <[ClFilter]> filters;
    /** "list" or "creator". */
    in property <string> view: "list";
    // The form
    in property <[ClChip]> sources;
    in property <[ClChip]> gaps;
    /** The picked source can't run (its reason), or "". */
    in property <string> unavailable;
    in property <string> source-note;
    in-out property <string> query;
    in-out property <string> target;
    // Instagram's session (shown when Instagram is picked)
    in property <bool> show-session;
    in property <bool> session-on;
    in property <string> session-account;
    in property <string> session-help;
    in-out property <string> session-cookie;
    in property <bool> session-busy;
    // The run (the last one, or the one going)
    in property <bool> running;
    in property <bool> has-run;
    in property <string> run-title;
    in property <string> run-status;
    in property <string> run-clock;
    in property <float> run-frac;
    in property <string> run-meta;
    in property <[ClLog]> logs;
    in property <bool> log-open;
    // The daily update
    in property <bool> daily-on;
    in property <bool> daily-running;
    in property <string> daily-status;
    in property <string> daily-meta;
    in property <float> daily-frac;
    // The list
    in property <[ClRow]> rows;
    in property <string> list-empty;
    in property <bool> confirm-clear;
    in property <string> copy-label;
    in-out property <bool> side-hidden;
    // One creator
    in property <string> d-id;
    in property <string> d-name;
    in property <string> d-sub;
    in property <string> d-platform;
    in property <image> d-avatar;
    in property <bool> d-has-avatar;
    in property <string> d-initials;
    in property <color> d-color;
    in property <string> d-url;
    in property <[ClStat]> d-stats;
    in property <string> d-desc;
    in property <string> d-email;
    in property <string> d-email-source;
    in property <bool> d-email-manual;
    in-out property <string> d-email-edit;
    in property <string> d-whatsapp;
    in property <[ClLink]> d-links;
    in property <string> d-updated;
    in property <string> d-update-error;
    in property <[ClHist]> d-history;
    in property <[ClVid]> d-recent;
    in property <string> d-contacted;
    in property <string> d-found;
    in property <bool> d-refreshing;
    in property <bool> d-discord;
    // Send message
    in property <bool> send-open;
    in property <string> s-title;
    in property <[ClTpl]> s-templates;
    in property <[ClChip]> s-channels;
    in property <string> s-channel-why;
    in property <bool> s-is-email;
    in-out property <string> s-to;
    in-out property <string> s-subject;
    in-out property <string> s-text;
    in property <string> s-guard;
    in property <string> s-already;
    in property <string> s-error;
    in property <bool> s-busy;
    in property <bool> s-confirm;
    in property <string> s-confirm-text;
    in property <bool> s-can-send;
    in property <string> s-saved;

    callback pick-filter(string);
    callback pick-source(string);
    callback pick-gap(string);
    callback query-edited(string);
    callback target-edited(string);
    callback target-step(int);
    callback start();
    callback stop();
    callback copy();
    callback clear();
    callback clear-ask(bool);
    callback toggle-log();
    callback clear-log();
    callback open(string);
    callback remove(string);
    callback session-save();
    callback session-remove();
    callback daily-toggle(bool);
    callback daily-now();
    callback daily-stop();
    callback open-creator(string);
    callback back();
    callback email-save();
    callback refresh-one();
    callback send-show();
    callback send-close();
    callback pick-template(string);
    callback pick-channel(string);
    callback send-ask();
    callback send-confirm();
    callback send-back();
    callback save-template();
}

component Sidebar inherits SideSurface {
    VerticalLayout {
        padding-top: Ds.side-pad-top;
        spacing: 2px;
        SideHead {
            padding-left: Ds.side-pad;
            padding-right: Ds.side-pad;
            hide => {
                CollectorBus.side-hidden = true;
            }
        }
        VerticalLayout {
            padding: Ds.side-pad;
            padding-top: Ds.side-list-top;
            spacing: 2px;
            alignment: start;
            vertical-stretch: 1;
            for f in CollectorBus.filters: ListRow {
                lead: "glyph";
                glyph: f.glyph;
                title: f.label;
                active: f.on && CollectorBus.view == "list";
                meta: f.id == "all" && CollectorBus.running ? "running" : f.count > 0 ? f.count : "";
                clicked => {
                    CollectorBus.pick-filter(f.id);
                }
            }
        }
    }
}

/** The form: source, search term, target, Start/Stop, the freshness window, Instagram's session. */
component Controls inherits Card {
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        VerticalLayout {
            spacing: 6px;
            FieldLabel {
                text: "Source";
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for s in CollectorBus.sources: Chip {
                    sm: true;
                    text: s.available ? s.label : s.label + " · needs sign-in";
                    on: s.on;
                    enabled: !CollectorBus.running || s.on;
                    tip: s.tip;
                    clicked => {
                        CollectorBus.pick-source(s.value);
                    }
                }
            }
            if CollectorBus.unavailable != "": Hint {
                text: CollectorBus.unavailable;
                wrap: word-wrap;
            }
            if CollectorBus.unavailable == "" && CollectorBus.source-note != "": Muted {
                text: CollectorBus.source-note;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                FieldLabel {
                    text: "Search term";
                    horizontal-stretch: 1;
                }
                FieldLabel {
                    width: 132px;
                    text: "New creators";
                }
                Rectangle {
                    width: 92px;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Input {
                    horizontal-stretch: 1;
                    text <=> CollectorBus.query;
                    hint: "e.g. blox fruits brasil";
                    edited(t) => {
                        CollectorBus.query-edited(t);
                    }
                    accepted => {
                        if !CollectorBus.running {
                            CollectorBus.start();
                        }
                    }
                }
                HorizontalLayout {
                    width: 132px;
                    spacing: 4px;
                    Btn {
                        text: "−";
                        size: icon;
                        variant: ghost-muted;
                        tip: "10 fewer";
                        enabled: !CollectorBus.running;
                        clicked => {
                            CollectorBus.target-step(-10);
                        }
                    }
                    Input {
                        text <=> CollectorBus.target;
                        hint: "All";
                        mono: true;
                        edited(t) => {
                            CollectorBus.target-edited(t);
                        }
                    }
                    Btn {
                        icon: Icons.plus;
                        size: icon;
                        variant: ghost-muted;
                        tip: "10 more";
                        enabled: !CollectorBus.running;
                        clicked => {
                            CollectorBus.target-step(10);
                        }
                    }
                }
                if !CollectorBus.running: Btn {
                    width: 92px;
                    text: "Start";
                    icon: Icons.play;
                    variant: primary;
                    enabled: CollectorBus.unavailable == "" && CollectorBus.query != "";
                    clicked => {
                        CollectorBus.start();
                    }
                }
                if CollectorBus.running: Btn {
                    width: 92px;
                    text: "Stop";
                    icon: Icons.stop;
                    variant: outline;
                    clicked => {
                        CollectorBus.stop();
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 6px;
            FieldLabel {
                text: "Last upload";
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for g in CollectorBus.gaps: Chip {
                    sm: true;
                    text: g.label;
                    on: g.on;
                    enabled: !CollectorBus.running || g.on;
                    tip: g.tip;
                    clicked => {
                        CollectorBus.pick-gap(g.value);
                    }
                }
            }
        }
        if CollectorBus.show-session: Well {
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Glyph {
                        icon: CollectorBus.session-on ? Icons.circle-check : Icons.lock;
                        size: 14px;
                        color: CollectorBus.session-on ? Theme.green-800 : Theme.gray-800;
                    }
                    Text {
                        text: CollectorBus.session-on ? "Instagram session: " + (CollectorBus.session-account != "" ? "@" + CollectorBus.session-account : "saved") : "Instagram session";
                        font-size: Ds.t-sm;
                        font-weight: 600;
                        color: Theme.fg;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    if CollectorBus.session-on: Btn {
                        text: "Remove";
                        size: xs;
                        variant: ghost-muted;
                        clicked => {
                            CollectorBus.session-remove();
                        }
                    }
                }
                if !CollectorBus.session-on: Muted {
                    text: CollectorBus.session-help;
                    wrap: word-wrap;
                }
                if !CollectorBus.session-on: HorizontalLayout {
                    spacing: 8px;
                    Input {
                        horizontal-stretch: 1;
                        password: true;
                        mono: true;
                        text <=> CollectorBus.session-cookie;
                        hint: "sessionid=…; csrftoken=…";
                        accepted => {
                            CollectorBus.session-save();
                        }
                    }
                    Btn {
                        text: CollectorBus.session-busy ? "Checking…" : "Save";
                        size: sm;
                        variant: outline;
                        enabled: CollectorBus.session-cookie != "" && !CollectorBus.session-busy;
                        clicked => {
                            CollectorBus.session-save();
                        }
                    }
                }
            }
        }
    }
}

/** The run: what's going (or went), the clock, found / target, and the log's tail. */
component Progress inherits Card {
    VerticalLayout {
        padding: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            if CollectorBus.running: VerticalLayout {
                alignment: center;
                Spinner { }
            }
            if !CollectorBus.running: Glyph {
                icon: Icons.circle-check;
                size: 16px;
                color: Theme.subtle;
            }
            Text {
                text: CollectorBus.run-title;
                font-size: 14px;
                font-weight: 600;
                color: Theme.fg;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Text {
                text: CollectorBus.run-clock;
                font-family: "Geist Mono";
                font-size: Ds.t-meta;
                color: Theme.gray-800;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.gray-200;
            Rectangle {
                x: 0;
                width: parent.width * clamp(CollectorBus.run-frac, 0, 1);
                border-radius: 3px;
                background: CollectorBus.running ? Theme.blue-800 : Theme.green-800;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Muted {
                text: CollectorBus.run-status;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Muted {
                text: CollectorBus.run-meta;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Btn {
                text: CollectorBus.log-open ? "Hide log" : "Show log";
                icon: CollectorBus.log-open ? Icons.up : Icons.down;
                size: xs;
                variant: ghost-muted;
                clicked => {
                    CollectorBus.toggle-log();
                }
            }
            if CollectorBus.log-open: Btn {
                text: "Clear log";
                size: xs;
                variant: ghost-muted;
                clicked => {
                    CollectorBus.clear-log();
                }
            }
        }
        if CollectorBus.log-open: Well {
            VerticalLayout {
                padding: 10px;
                spacing: 3px;
                for l in CollectorBus.logs: Text {
                    text: l.text;
                    font-family: "Geist Mono";
                    font-size: 11.5px;
                    wrap: word-wrap;
                    color: l.tone == "ok" ? Theme.green-900 : l.tone == "drop" || l.tone == "skip" ? Theme.gray-800 : l.tone == "error" ? Theme.red-900 : Theme.fg;
                }
            }
        }
    }
}

/** The daily update: every creator read again once a day (stats, last upload, bio, links, email), what changed kept. */
component Daily inherits Card {
    VerticalLayout {
        padding: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            if CollectorBus.daily-running: VerticalLayout {
                alignment: center;
                Spinner { }
            }
            if !CollectorBus.daily-running: Glyph {
                icon: Icons.rotate-cw;
                size: 15px;
                color: Theme.subtle;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text {
                    text: "Daily update";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.fg;
                }
                Muted {
                    text: CollectorBus.daily-status;
                    overflow: elide;
                }
            }
            if !CollectorBus.daily-running: Btn {
                text: "Update all now";
                icon: Icons.refresh;
                size: sm;
                variant: outline;
                enabled: CollectorBus.n-creators > 0;
                tip: "Read every creator again now (gently, one at a time)";
                clicked => {
                    CollectorBus.daily-now();
                }
            }
            if CollectorBus.daily-running: Btn {
                text: "Stop";
                icon: Icons.stop;
                size: sm;
                variant: outline;
                clicked => {
                    CollectorBus.daily-stop();
                }
            }
            VerticalLayout {
                alignment: center;
                Toggle {
                    on: CollectorBus.daily-on;
                    toggled(v) => {
                        CollectorBus.daily-toggle(v);
                    }
                }
            }
        }
        if CollectorBus.daily-running: Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.gray-200;
            Rectangle {
                x: 0;
                width: parent.width * clamp(CollectorBus.daily-frac, 0, 1);
                border-radius: 3px;
                background: Theme.blue-800;
            }
        }
        if CollectorBus.daily-meta != "": Muted {
            text: CollectorBus.daily-meta;
            wrap: word-wrap;
        }
    }
}

component Tag inherits Rectangle {
    in property <string> text;
    in property <color> bg: Theme.gray-200;
    in property <color> fg: Theme.gray-1000;
    width: t.preferred-width + 10px;
    height: 16px;
    border-radius: 4px;
    background: root.bg;
    t := Text {
        text: root.text;
        font-size: 10.5px;
        font-weight: 600;
        color: root.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/** One collected creator: picture, name and handle, stats, email and where it came from, the last update; click opens it. */
component ResultRow inherits Rectangle {
    in property <ClRow> r;
    height: root.r.changed != "" ? 84px : 68px;
    border-radius: Ds.radius-md;
    background: area.has-hover ? Theme.accent : transparent;
    area := TipArea {
        mouse-cursor: pointer;
        tip: root.r.url;
        clicked => {
            CollectorBus.open-creator(root.r.id);
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 40px;
                initials: root.r.initials;
                color: root.r.color;
                photo: root.r.avatar;
                has-photo: root.r.has-avatar;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.r.name;
                    font-size: Ds.t-body;
                    font-weight: 500;
                    color: Theme.fg;
                    overflow: elide;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                }
                VerticalLayout {
                    alignment: center;
                    Tag {
                        text: root.r.platform;
                    }
                }
                if root.r.contacted != "": VerticalLayout {
                    alignment: center;
                    Tag {
                        text: root.r.contacted;
                        bg: Theme.green-200;
                        fg: Theme.green-900;
                    }
                }
                if root.r.discord: VerticalLayout {
                    alignment: center;
                    Tag {
                        text: "Discord";
                        bg: Theme.blue-200;
                        fg: Theme.blue-900;
                    }
                }
                if root.r.sub != "": Text {
                    text: root.r.sub;
                    font-size: 12px;
                    color: Theme.gray-800;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: root.r.stats;
                font-size: 12px;
                color: Theme.subtle;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 5px;
                Glyph {
                    icon: Icons.at-sign;
                    size: 12px;
                    color: root.r.email != "" ? Theme.fg : Theme.gray-700;
                }
                Text {
                    text: root.r.email != "" ? root.r.email : "No email yet";
                    font-size: 12px;
                    color: root.r.email != "" ? Theme.fg : Theme.gray-700;
                    overflow: elide;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                }
                if root.r.email-source != "": Text {
                    text: "· " + root.r.email-source;
                    font-size: 12px;
                    color: Theme.gray-800;
                    overflow: elide;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            if root.r.changed != "": Text {
                text: "↻ " + root.r.changed;
                font-size: 12px;
                color: Theme.amber-900;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: root.r.meta;
                font-size: Ds.t-meta;
                color: Theme.gray-800;
                horizontal-alignment: right;
                overflow: elide;
                max-width: 220px;
            }
            Text {
                text: root.r.updated;
                font-size: Ds.t-meta;
                color: Theme.gray-700;
                horizontal-alignment: right;
                overflow: elide;
                max-width: 220px;
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                opacity: area.has-hover || self.hovered ? 1 : 0;
                icon: Icons.x;
                size: icon-xs;
                variant: ghost-muted;
                tip: "Remove from the list (they stay remembered: no run collects them again)";
                clicked => {
                    CollectorBus.remove(root.r.id);
                }
            }
        }
    }
}

component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    padding-top: 2px;
    CapsLabel {
        text: root.text;
    }
}

/** One creator: who, stats, email (found where, or typed), every link, the daily updates, Send message. */
component Detail inherits VerticalLayout {
    spacing: 14px;
    HorizontalLayout {
        alignment: start;
        Btn {
            text: "All creators";
            icon: Icons.arrow-left;
            size: sm;
            variant: ghost-muted;
            clicked => {
                CollectorBus.back();
            }
        }
    }
    Card {
        VerticalLayout {
            padding: 16px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    Avatar {
                        size: 56px;
                        initials: CollectorBus.d-initials;
                        color: CollectorBus.d-color;
                        photo: CollectorBus.d-avatar;
                        has-photo: CollectorBus.d-has-avatar;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: CollectorBus.d-name;
                            font-size: 18px;
                            font-weight: 600;
                            color: Theme.fg;
                            overflow: elide;
                            horizontal-stretch: 0;
                            max-width: self.preferred-width;
                        }
                        VerticalLayout {
                            alignment: center;
                            Tag {
                                text: CollectorBus.d-platform;
                            }
                        }
                        if CollectorBus.d-contacted != "": VerticalLayout {
                            alignment: center;
                            Tag {
                                text: CollectorBus.d-contacted;
                                bg: Theme.green-200;
                                fg: Theme.green-900;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    Muted {
                        text: CollectorBus.d-sub;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        Btn {
                            icon: Icons.external;
                            size: icon;
                            variant: ghost-muted;
                            tip: "Open their profile";
                            clicked => {
                                CollectorBus.open(CollectorBus.d-url);
                            }
                        }
                        Btn {
                            text: CollectorBus.d-refreshing ? "Updating…" : "Update now";
                            icon: Icons.refresh;
                            size: sm;
                            variant: outline;
                            enabled: !CollectorBus.d-refreshing;
                            clicked => {
                                CollectorBus.refresh-one();
                            }
                        }
                        Btn {
                            text: "Send message";
                            icon: Icons.send;
                            size: sm;
                            variant: primary;
                            clicked => {
                                CollectorBus.send-show();
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                for s in CollectorBus.d-stats: Well {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 2px;
                        Text {
                            text: s.value;
                            font-size: 16px;
                            font-weight: 600;
                            color: Theme.fg;
                        }
                        Muted {
                            text: s.label;
                        }
                    }
                }
            }
            if CollectorBus.d-desc != "": Text {
                text: CollectorBus.d-desc;
                font-size: Ds.t-sm;
                color: Theme.gray-1000;
                wrap: word-wrap;
            }
        }
    }
    SectionTitle {
        text: "EMAIL";
    }
    Card {
        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Glyph {
                    icon: Icons.at-sign;
                    size: 14px;
                    color: CollectorBus.d-email != "" ? Theme.fg : Theme.gray-700;
                }
                Text {
                    text: CollectorBus.d-email != "" ? CollectorBus.d-email : "No email found yet";
                    font-size: Ds.t-body;
                    font-weight: CollectorBus.d-email != "" ? 500 : 400;
                    color: CollectorBus.d-email != "" ? Theme.fg : Theme.gray-800;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                }
                if CollectorBus.d-email-source != "": VerticalLayout {
                    alignment: center;
                    Tag {
                        text: CollectorBus.d-email-manual ? "typed" : "found in " + CollectorBus.d-email-source;
                        bg: CollectorBus.d-email-manual ? Theme.gray-200 : Theme.blue-200;
                        fg: CollectorBus.d-email-manual ? Theme.gray-1000 : Theme.blue-900;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Input {
                    horizontal-stretch: 1;
                    text <=> CollectorBus.d-email-edit;
                    hint: "Type or correct their email";
                    accepted => {
                        CollectorBus.email-save();
                    }
                }
                Btn {
                    text: "Save";
                    size: sm;
                    variant: outline;
                    enabled: CollectorBus.d-email-edit != CollectorBus.d-email;
                    clicked => {
                        CollectorBus.email-save();
                    }
                }
            }
            Muted {
                text: CollectorBus.d-email-manual ? "Typed by hand: the daily update won't replace it. Clear it to let Collector look again." : "Found in their bio, link-in-bio pages or website. YouTube's own business email sits behind a sign-in and a captcha, so it isn't read.";
                wrap: word-wrap;
            }
            if CollectorBus.d-whatsapp != "": HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Glyph {
                    icon: Icons.message;
                    size: 14px;
                    color: Theme.fg;
                }
                Text {
                    text: "WhatsApp +" + CollectorBus.d-whatsapp;
                    font-size: Ds.t-sm;
                    color: Theme.fg;
                }
            }
        }
    }
    SectionTitle {
        text: "LINKS · " + CollectorBus.d-links.length;
    }
    Card {
        VerticalLayout {
            padding: 6px;
            spacing: 0px;
            if CollectorBus.d-links.length == 0: Muted {
                text: "No links in their bio.";
            }
            for l in CollectorBus.d-links: Rectangle {
                height: 36px;
                border-radius: Ds.radius-md;
                background: la.has-hover ? Theme.accent : transparent;
                la := TipArea {
                    mouse-cursor: pointer;
                    tip: l.url;
                    clicked => {
                        CollectorBus.open(l.url);
                    }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    Glyph {
                        icon: l.kind == "website" ? Icons.globe : Icons.link;
                        size: 13px;
                        color: Theme.subtle;
                    }
                    Text {
                        width: 110px;
                        text: l.label;
                        font-size: Ds.t-sm;
                        font-weight: 500;
                        color: Theme.fg;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        text: l.short;
                        font-size: Ds.t-sm;
                        color: Theme.gray-900;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if l.source != "": Text {
                        text: "from " + l.source;
                        font-size: Ds.t-meta;
                        color: Theme.gray-800;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 200px;
                    }
                }
            }
        }
    }
    SectionTitle {
        text: "UPDATES";
    }
    Card {
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                Glyph {
                    icon: CollectorBus.d-update-error != "" ? Icons.alert : Icons.clock;
                    size: 14px;
                    color: CollectorBus.d-update-error != "" ? Theme.amber-800 : Theme.subtle;
                }
                Text {
                    text: CollectorBus.d-update-error != "" ? CollectorBus.d-update-error : CollectorBus.d-updated;
                    font-size: Ds.t-sm;
                    color: Theme.fg;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
            if CollectorBus.d-history.length == 0: Muted {
                text: "No changes since they were collected. Each daily update writes down what changed (subscribers, videos, last upload, bio, links, email).";
                wrap: word-wrap;
            }
            for h in CollectorBus.d-history: HorizontalLayout {
                spacing: 12px;
                Text {
                    width: 150px;
                    text: h.when;
                    font-size: Ds.t-meta;
                    color: Theme.gray-800;
                }
                Text {
                    text: h.changes;
                    font-size: Ds.t-sm;
                    color: Theme.fg;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
    }
    if CollectorBus.d-recent.length > 0: SectionTitle {
        text: "LATEST UPLOADS";
    }
    if CollectorBus.d-recent.length > 0: Card {
        VerticalLayout {
            padding: 6px;
            for v in CollectorBus.d-recent: Rectangle {
                height: 34px;
                border-radius: Ds.radius-md;
                background: va.has-hover ? Theme.accent : transparent;
                va := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        CollectorBus.open(v.url);
                    }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    Text {
                        text: v.title != "" ? v.title : v.url;
                        font-size: Ds.t-sm;
                        color: Theme.fg;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: v.views != "" ? v.when + " · " + v.views : v.when;
                        font-size: Ds.t-meta;
                        color: Theme.gray-800;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    Muted {
        text: CollectorBus.d-found;
    }
}

/** Send message: a template (the CRM's outreach emails), the channel (Persons › Creators' Gmail or WhatsApp), the
 * message to edit, and Send, which asks once more: it's a real message. */
component SendDialog inherits DialogFrame {
    title: CollectorBus.s-confirm ? "Send it?" : CollectorBus.s-title;
    text: CollectorBus.s-confirm ? CollectorBus.s-confirm-text : "";
    box-w: CollectorBus.s-confirm ? 448px : 760px;
    scrim-dismisses: false;
    dismiss => {
        CollectorBus.send-close();
    }
    if !CollectorBus.s-confirm: HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            width: 200px;
            spacing: 2px;
            alignment: start;
            FieldLabel {
                text: "Template";
            }
            for t in CollectorBus.s-templates: Rectangle {
                height: tv.preferred-height + 12px;
                border-radius: Ds.radius-md;
                background: t.on ? Theme.gray-200 : ta.has-hover ? Theme.accent : transparent;
                ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        CollectorBus.pick-template(t.id);
                    }
                }
                tv := VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    y: 6px;
                    spacing: 1px;
                    Text {
                        text: t.name;
                        font-size: Ds.t-sm;
                        font-weight: t.on ? 600 : 500;
                        color: Theme.fg;
                        overflow: elide;
                    }
                    if t.description != "": Text {
                        text: t.description;
                        font-size: Ds.t-meta;
                        color: Theme.gray-800;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                padding-top: 6px;
                alignment: start;
                Btn {
                    text: CollectorBus.s-saved != "" ? CollectorBus.s-saved : "Save as template";
                    icon: Icons.copy;
                    size: xs;
                    variant: ghost-muted;
                    tip: "Keep this subject and message in the picked template (or as a new one, from Blank)";
                    clicked => {
                        CollectorBus.save-template();
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 10px;
            VerticalLayout {
                spacing: 6px;
                FieldLabel {
                    text: "Send through";
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for c in CollectorBus.s-channels: Chip {
                        sm: true;
                        text: c.label;
                        on: c.on;
                        enabled: c.available;
                        tip: c.tip;
                        clicked => {
                            CollectorBus.pick-channel(c.value);
                        }
                    }
                }
                if CollectorBus.s-channel-why != "": Hint {
                    text: CollectorBus.s-channel-why;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                spacing: 6px;
                FieldLabel {
                    text: CollectorBus.s-is-email ? "To (email)" : "To (WhatsApp number)";
                }
                Input {
                    text <=> CollectorBus.s-to;
                    hint: CollectorBus.s-is-email ? "their@email.com" : "55 11 99999-9999";
                }
            }
            if CollectorBus.s-is-email: VerticalLayout {
                spacing: 6px;
                FieldLabel {
                    text: "Subject";
                }
                Input {
                    text <=> CollectorBus.s-subject;
                    hint: "Subject";
                }
            }
            VerticalLayout {
                spacing: 6px;
                FieldLabel {
                    text: "Message";
                }
                TextBox {
                    min-h: 220px;
                    text <=> CollectorBus.s-text;
                    hint: "Write the message";
                }
            }
            if CollectorBus.s-already != "": Hint {
                text: CollectorBus.s-already;
                wrap: word-wrap;
            }
            if CollectorBus.s-guard != "": Muted {
                text: CollectorBus.s-guard;
                wrap: word-wrap;
            }
        }
    }
    if CollectorBus.s-error != "": Text {
        text: CollectorBus.s-error;
        font-size: Ds.t-sm;
        color: Theme.red-900;
        wrap: word-wrap;
    }
    DialogActions {
        if !CollectorBus.s-confirm: Btn {
            text: "Cancel";
            variant: outline;
            clicked => {
                CollectorBus.send-close();
            }
        }
        if !CollectorBus.s-confirm: Btn {
            text: "Send…";
            icon: Icons.send;
            variant: primary;
            enabled: CollectorBus.s-can-send;
            clicked => {
                CollectorBus.send-ask();
            }
        }
        if CollectorBus.s-confirm: Btn {
            text: "Back";
            variant: outline;
            enabled: !CollectorBus.s-busy;
            clicked => {
                CollectorBus.send-back();
            }
        }
        if CollectorBus.s-confirm: Btn {
            text: CollectorBus.s-busy ? "Sending…" : "Send now";
            icon: Icons.send;
            variant: primary;
            enabled: !CollectorBus.s-busy;
            clicked => {
                CollectorBus.send-confirm();
            }
        }
    }
}

export component CollectorPage {
    /** The sidebar's width: Projects' (app.slint side-shown), so the header's buttons sit where they do there. */
    in property <length> side-w: Ds.side-w;
    Rectangle {
        background: Theme.bg100;
    }
    if !CollectorBus.side-hidden: Sidebar {
        x: 0;
        y: 0;
        width: root.side-w;
        height: root.height;
    }
    property <length> main-x: CollectorBus.side-hidden ? 0px : root.side-w;
    property <length> main-w: root.width - main-x;
    property <length> col-w: min(Ds.page-max-w + 120px, main-w - 2 * Ds.page-pad);
    property <length> col-x: (main-w - col-w) / 2;
    property <int> count: CollectorBus.n-creators;
    bar := PageBar {
        x: root.main-x;
        y: 0;
        width: root.main-w;
        side-hidden: CollectorBus.side-hidden;
        icon: Icons.users;
        section: "Collector";
        title: CollectorBus.view == "creator" ? CollectorBus.d-name : "Creators";
        sub: CollectorBus.view == "creator" ? CollectorBus.d-platform : root.count == 0 ? "" : root.count + (root.count == 1 ? " creator" : " creators");
        show-side => {
            CollectorBus.side-hidden = false;
        }
        HorizontalLayout {
            spacing: 6px;
            Btn {
                text: CollectorBus.copy-label;
                icon: Icons.copy;
                size: sm;
                variant: outline;
                enabled: root.count > 0;
                tip: "JSONL, one creator per line (with the email): paste it in SpokPayCRM → Creators → Import";
                clicked => {
                    CollectorBus.copy();
                }
            }
            if !CollectorBus.confirm-clear: Btn {
                text: "Clear";
                icon: Icons.trash;
                size: sm;
                variant: ghost-muted;
                enabled: root.count > 0 && !CollectorBus.running;
                tip: "Empty the list. They stay remembered, so later runs won't collect them again.";
                clicked => {
                    CollectorBus.clear-ask(true);
                }
            }
            if CollectorBus.confirm-clear: Btn {
                text: "Clear " + root.count + "?";
                size: sm;
                variant: destructive;
                clicked => {
                    CollectorBus.clear();
                }
            }
            if CollectorBus.confirm-clear: Btn {
                text: "Keep";
                size: sm;
                variant: ghost-muted;
                clicked => {
                    CollectorBus.clear-ask(false);
                }
            }
        }
    }
    property <length> top: bar.height;
    if CollectorBus.loading: Text {
        x: root.main-x;
        width: root.main-w;
        text: CollectorBus.error != "" ? CollectorBus.error : "Loading…";
        color: Theme.subtle;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !CollectorBus.loading && CollectorBus.view == "list": Rectangle {
        x: main-x;
        y: top;
        width: main-w;
        height: root.height - top;
        page := Flickable {
            width: parent.width;
            height: parent.height;
            content-height: screen.preferred-height + 40px;
            screen := VerticalLayout {
                x: col-x;
                y: Ds.sp8;
                width: col-w;
                spacing: 14px;
                Controls { }
                if CollectorBus.has-run: Progress { }
                if root.count > 0: Daily { }
                if CollectorBus.rows.length > 0: SectionTitle {
                    text: "COLLECTED CREATORS";
                }
                if CollectorBus.rows.length > 0: VerticalLayout {
                    spacing: 0px;
                    for r in CollectorBus.rows: ResultRow {
                        r: r;
                    }
                }
                if CollectorBus.rows.length == 0 && !CollectorBus.running: Empty {
                    icon: Icons.users;
                    title: root.count == 0 ? "No creators yet" : "Nobody here";
                    desc: CollectorBus.list-empty;
                }
            }
        }
        ScrollThumb {
            x: parent.width - self.width;
            y: 0;
            height: parent.height;
            content-y: page.content-y;
            content-height: page.content-height;
            visible-height: page.height;
            scroll-to(v) => {
                page.content-y = v;
            }
        }
    }
    if !CollectorBus.loading && CollectorBus.view == "creator": Rectangle {
        x: main-x;
        y: top;
        width: main-w;
        height: root.height - top;
        dpage := Flickable {
            width: parent.width;
            height: parent.height;
            content-height: dscreen.preferred-height + 40px;
            dscreen := Detail {
                x: col-x;
                y: Ds.sp8;
                width: col-w;
            }
        }
        ScrollThumb {
            x: parent.width - self.width;
            y: 0;
            height: parent.height;
            content-y: dpage.content-y;
            content-height: dpage.content-height;
            visible-height: dpage.height;
            scroll-to(v) => {
                dpage.content-y = v;
            }
        }
    }
    if CollectorBus.send-open: SendDialog {
        width: root.width;
        height: root.height;
    }
}
