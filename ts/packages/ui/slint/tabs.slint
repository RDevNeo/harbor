// Hub's top-level tabs: Projects (the hub's own window: sidebar, chats) | Persons | Routine | Collector.
// The switcher (AppTabs) sits at the window's top-left in every tab: in Projects' sidebar header (or its top bar while
// the sidebar is hidden), and in the header of TabFrame, the full-window page every other tab is drawn in.
// A tab: its own .slint file exporting `<Name>Bus` (a global the TS side drives, src/tabs/<id>/ui.ts) and
// `<Name>Page`; app.slint draws `if TabsBus.current == "<id>": TabFrame { <Name>Page { … } }`.
import { Theme } from "theme.slint";
import { HLine, TipArea } from "widgets.slint";
import { CountPill } from "ds-list.slint";

export global TabsBus {
    /** "projects", "persons", "routine", "collector". */
    in-out property <string> current: "projects";
    /** A switch asked for (a click, Ctrl+1/2/3): the TS side sets `current`, mounting the tab on its first time. */
    callback select(string);
    /** Everyone's unread messages in Persons (manually unread chats too): the Persons tab's count, 0 for none. */
    in-out property <int> persons-unread;
    /** Collector runs that finished since the Collector tab was last looked at (PC or phone): its count, 0 for none. */
    in-out property <int> collector-unread;
    /** Chats whose turn ended (done, failed, or stopped on a question or a key asked) while nobody had them open, not
     *  opened since (their sidebar dots): the Projects tab's count, 0 for none. */
    in-out property <int> projects-unread;
}

struct TabDef {
    id: string,
    label: string,
    icon: string,
}

/** The switcher: the current tab with its name, the others as icons (their names on hover). */
export component AppTabs {
    /** Icons only (the sidebar's header): names on hover, the current one highlighted. */
    in property <bool> compact;
    // Lucide: folder-kanban, users, dumbbell, funnel
    property <[TabDef]> tabs: [
        { id: "projects", label: "Projects", icon: "\u{e4c6}" },
        { id: "persons", label: "Persons", icon: "\u{e1a4}" },
        { id: "routine", label: "Routine", icon: "\u{e3a1}" },
        { id: "collector", label: "Collector", icon: "\u{e460}" },
    ];
    height: 28px;
    HorizontalLayout {
        spacing: 2px;
        for t in root.tabs: Rectangle {
            property <bool> on: TabsBus.current == t.id;
            property <bool> named: root.compact ? false : true;
            property <int> badge: t.id == "persons" ? TabsBus.persons-unread : t.id == "collector" ? TabsBus.collector-unread : t.id == "projects" ? TabsBus.projects-unread : 0;
            width: named ? label.preferred-width + 34px + (badge > 0 ? pill.width + 6px : 0) : 28px;
            border-radius: 6px;
            background: on ? Theme.gray-200 : area.has-hover ? Theme.accent : transparent;
            Text {
                x: 6px;
                width: 16px;
                text: t.icon;
                font-family: "lucide";
                font-size: 15px;
                color: on ? Theme.fg : Theme.subtle;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            label := Text {
                x: 27px;
                visible: named;
                text: t.label;
                font-size: 13px;
                font-weight: on ? 600 : 400;
                color: on ? Theme.fg : Theme.subtle;
                vertical-alignment: center;
            }
            // the unread count: after the name, or on the icon's corner when only icons show
            pill := CountPill {
                visible: badge > 0;
                n: badge;
                x: named ? 27px + label.preferred-width + 6px : parent.width - self.width / 2 - 4px;
                y: named ? (parent.height - self.height) / 2 : -4px;
            }
            area := TipArea {
                tip: named ? "" : badge <= 0 ? t.label : t.id == "collector" ? (badge == 1 ? "\{t.label} · a run is done" : "\{t.label} · \{badge} runs done") : t.id == "projects" ? (badge == 1 ? "\{t.label} · a chat needs you" : "\{t.label} · \{badge} chats need you") : "\{t.label} · \{badge} unread";
                clicked => {
                    TabsBus.select(t.id);
                }
            }
        }
    }
}

/** A full-window tab page: a header with the switcher (and `title`), the tab's own content under it. */
export component TabFrame inherits Rectangle {
    in property <string> title;
    /** The height under the header: a page sets `y: 0; height: frame.body-h` (children without y are centered). */
    out property <length> body-h: self.height - round(46px / 1phx) * 1phx;
    background: Theme.bg100;
    // Clicks don't fall through to the Projects window under it.
    TouchArea { }
    Rectangle {
        y: 0;
        height: round(46px / 1phx) * 1phx;
        AppTabs {
            x: 12px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            x: 330px;
            width: parent.width - self.x - 12px;
            text: root.title;
            font-size: 14px;
            color: Theme.subtle;
            vertical-alignment: center;
            overflow: elide;
        }
        // The one divider under the tab row (as app.slint's; widgets.slint HLine: no flicker at fractional scales).
        HLine {
            at: parent.height - 1phx;
        }
    }
    Rectangle {
        y: round(46px / 1phx) * 1phx;
        height: parent.height - self.y;
        @children
    }
}
