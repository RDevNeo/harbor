import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Glyph, TipArea, AccountMark, PopoverFrame, SearchField, KeyCap } from "widgets.slint";

export struct RailItem {
    id: string,
    logo: image,
    badge: string,
    photo: image,
    has-photo: bool,
    active: bool,
    dim: bool,
    tip: string,
}

export struct ModelRow {
    label: string,
    sub: string,
    logo: image,
    enabled: bool,
    current: bool,
    favorite: bool,
}

component StarFilled inherits Path {
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "M 12 2 L 15.09 8.26 L 22 9.27 L 17 14.14 L 18.18 21.02 L 12 17.77 L 5.82 21.02 L 7 14.14 L 2 9.27 L 8.91 8.26 Z";
}

export component ModelPicker inherits PopoverFrame {
    in property <[RailItem]> rail;
    // The rail's item to scroll into view (-1: the favourites): at open, and whenever it changes (keys move it).
    in property <int> rail-reveal: -1;
    in property <bool> favorites-active;
    in property <[ModelRow]> rows;
    in-out property <int> hover;
    in property <string> more-label;
    in property <int> more-count;
    in property <bool> in-more;
    in property <string> empty;
    in-out property <string> search <=> field.text;
    callback rail-pick(string);
    callback pick(int);
    callback star(int);
    callback more();
    callback back();
    callback searched(string);
    callback key(KeyEvent) -> bool;
    public function focus-search() {
        field.focus-field();
    }
    // Scrolls the rail so item `i` shows whole (the favourites stay above it, outside the scrolling part).
    function reveal(i: int) {
        if i < 0 {
            rail-flick.viewport-y = 0;
        } else if i * 44px < -rail-flick.viewport-y {
            rail-flick.viewport-y = -i * 44px;
        } else if i * 44px + 48px > -rail-flick.viewport-y + rail-flick.height {
            rail-flick.viewport-y = min(0px, rail-flick.height - i * 44px - 48px);
        }
    }
    init => {
        self.reveal(self.rail-reveal);
    }
    changed rail-reveal => {
        self.reveal(self.rail-reveal);
    }
    width: 448px;
    height: 310px;
    TouchArea { }
    Rectangle {
        x: 4px;
        y: 4px;
        width: 52px;
        height: 302px;
        fav := Rectangle {
            x: 4px;
            y: 4px;
            width: 40px;
            height: 40px;
            border-radius: Theme.radius-md;
            background: root.favorites-active ? Theme.gray-200 : fav-area.has-hover ? Theme.gray-100 : transparent;
            Glyph {
                icon: Icons.star;
                size: 18px;
                color: Theme.amber-900;
            }
            fav-area := TipArea {
                tip: "Favourites";
                clicked => {
                    root.rail-pick("");
                }
            }
        }
        Rectangle {
            x: 10px;
            y: 46px;
            width: 32px;
            height: 1px;
            background: Theme.border;
        }
        // Every account under the favourites, scrolled by the wheel or touchpad when they don't fit; the selected one is
        // scrolled into view (`rail-reveal`). Wider than the column so the active mark beside a tile isn't cut.
        rail-flick := Flickable {
            x: 0px;
            y: 49px;
            width: 57px;
            height: parent.height - 49px;
            viewport-width: self.width;
            viewport-height: root.rail.length * 44px + 4px;
            for r[i] in root.rail: Rectangle {
                x: 4px;
                y: 4px + i * 44px;
                width: 40px;
                height: 40px;
                border-radius: Theme.radius-md;
                background: r.active ? Theme.gray-200 : tile-area.has-hover ? Theme.gray-100 : transparent;
                opacity: r.dim ? 0.5 : 1;
                AccountMark {
                    x: 8px;
                    y: 8px;
                    width: 24px;
                    height: 24px;
                    logo: r.logo;
                    badge: r.badge;
                    photo: r.photo;
                    has-photo: r.has-photo;
                    ring: r.active ? Theme.gray-200 : tile-area.has-hover ? Theme.gray-100 : Theme.bg100;
                }
                if r.active: Rectangle {
                    x: 49px;
                    y: 8px;
                    width: 3px;
                    height: 24px;
                    border-radius: 2px;
                    background: Theme.gray-1000;
                }
                tile-area := TipArea {
                    tip: r.tip;
                    clicked => {
                        root.rail-pick(r.id);
                    }
                }
            }
        }
        // More above or below: the edge fades into the popover.
        if rail-flick.viewport-y < 0: Rectangle {
            x: 0px;
            y: 49px;
            width: 52px;
            height: 14px;
            background: @linear-gradient(180deg, Theme.bg100 0%, Theme.bg100.with-alpha(0) 100%);
        }
        if rail-flick.viewport-y > rail-flick.height - rail-flick.viewport-height: Rectangle {
            x: 0px;
            y: parent.height - self.height;
            width: 52px;
            height: 18px;
            background: @linear-gradient(180deg, Theme.bg100.with-alpha(0) 0%, Theme.bg100 100%);
        }
        Rectangle {
            x: parent.width + 4px;
            width: 1px;
            background: Theme.border;
        }
    }
    Rectangle {
        x: 72px;
        y: 4px;
        width: parent.width - 76px;
        height: 302px;
        FocusScope {
            x: 0;
            y: 0;
            width: parent.width;
            height: 32px;
            capture-key-pressed(e) => {
                if root.key(e) {
                    return accept;
                }
                reject
            }
            field := SearchField {
                width: parent.width;
                height: 32px;
                hint: "Search models...";
                edited(t) => {
                    root.searched(t);
                }
            }
        }
        Rectangle {
            y: 35px;
            height: 1px;
            background: field.focused ? Theme.gray-700 : Theme.border;
        }
        Flickable {
            y: 41px;
            height: parent.height - 41px;
            content-height: list.preferred-height;
            list := VerticalLayout {
                alignment: start;
                spacing: 2px;
                if root.in-more: Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: back-area.has-hover ? Theme.accent : transparent;
                    Glyph {
                        x: 8px;
                        width: 16px;
                        icon: Icons.left;
                        size: 16px;
                        color: Theme.subtle;
                    }
                    Text {
                        x: 32px;
                        text: "Back";
                        font-size: 14px;
                        color: Theme.fg;
                        vertical-alignment: center;
                    }
                    back-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.back();
                        }
                    }
                }
                if root.rows.length == 0: Text {
                    height: 48px;
                    text: root.empty;
                    font-size: 13px;
                    color: Theme.subtle;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                for m[i] in root.rows: Rectangle {
                    property <bool> lit: i == root.hover || m.current;
                    height: 50px;
                    border-radius: Theme.radius-lg;
                    background: lit ? (m.current ? Theme.gray-200 : Theme.gray-100) : transparent;
                    row-area := TouchArea {
                        mouse-cursor: m.enabled ? pointer : default;
                        changed has-hover => {
                            if self.has-hover {
                                root.hover = i;
                            }
                        }
                        clicked => {
                            if m.enabled {
                                root.pick(i);
                            }
                        }
                    }
                    Text {
                        x: 12px;
                        y: 8px;
                        text: m.label;
                        font-size: 15px;
                        color: Theme.fg.with-alpha(m.enabled ? 1 : 0.45);
                    }
                    AccountMark {
                        x: 11px;
                        y: 28px;
                        width: 14px;
                        height: 14px;
                        logo: m.logo;
                    }
                    Text {
                        x: 31px;
                        y: 28px;
                        height: 14px;
                        text: m.sub;
                        font-size: 13px;
                        color: Theme.subtle.with-alpha(m.enabled ? 1 : 0.45);
                        vertical-alignment: center;
                    }
                    if i < 9 && lit: KeyCap {
                        x: parent.width - 33px - 10px - self.width;
                        y: (parent.height - self.height) / 2;
                        text: "Ctrl+" + (i + 1);
                    }
                    if i < 9 && !lit: Text {
                        x: parent.width - 33px - 4px - self.preferred-width;
                        text: "Ctrl+" + (i + 1);
                        font-family: "Geist Mono";
                        font-size: 12px;
                        color: Theme.subtle;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        x: parent.width - 33px;
                        y: 12px;
                        width: 26px;
                        height: 26px;
                        if m.favorite: StarFilled {
                            width: 14px;
                            height: 14px;
                            fill: Theme.amber-900;
                        }
                        if !m.favorite: Glyph {
                            icon: Icons.star;
                            size: 15px;
                            color: star-area.has-hover ? Theme.fg : Theme.subtle;
                        }
                        star-area := TipArea {
                            tip: m.favorite ? "Unfavourite" : "Favourite";
                            clicked => {
                                root.star(i);
                            }
                        }
                    }
                }
                if root.more-count > 0 && !root.in-more: Rectangle {
                    height: 50px;
                    border-radius: Theme.radius-lg;
                    background: more-area.has-hover ? Theme.gray-100 : transparent;
                    Text {
                        x: 12px;
                        y: 8px;
                        text: root.more-label;
                        font-size: 15px;
                        color: Theme.fg;
                    }
                    Text {
                        x: 12px;
                        y: 28px;
                        text: root.more-count + (root.more-count == 1 ? " model" : " models");
                        font-size: 13px;
                        color: Theme.subtle;
                    }
                    Glyph {
                        x: parent.width - 28px;
                        width: 16px;
                        icon: Icons.right;
                        size: 15px;
                        color: Theme.subtle;
                    }
                    more-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.more();
                        }
                    }
                }
            }
        }
    }
}

// The new chat's project popover (logic/projectpop.ts): a search field over an accent rule, then one row per project
// (its icon, else its initials on its tint), "No project" first and "Add project" pinned last.
export struct ProjectPopRow {
    kind: string,
    label: string,
    // After the name, muted: the PC that holds its folder, or for two of one name its folder (projectplace.ts `placeHint`).
    hint: string,
    initials: string,
    tint: color,
    logo: image,
    has-logo: bool,
    current: bool,
}

component ProjectPopItem inherits Rectangle {
    in property <ProjectPopRow> it;
    in property <bool> lit;
    callback hovered();
    callback clicked();
    border-radius: Theme.radius-md;
    background: root.lit ? Theme.accent : transparent;
    Rectangle {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        border-radius: 5px;
        clip: true;
        background: root.it.kind == "project" && !root.it.has-logo ? root.it.tint.with-alpha(0.14) : transparent;
        border-width: root.it.kind == "project" && !root.it.has-logo ? 1px : 0px;
        border-color: root.it.tint.with-alpha(0.22);
        if root.it.kind == "project" && root.it.has-logo: Image {
            width: 20px;
            height: 20px;
            source: root.it.logo;
            image-fit: contain;
        }
        if root.it.kind == "project" && !root.it.has-logo: Text {
            text: root.it.initials;
            font-size: 9.5px;
            font-weight: 700;
            color: root.it.tint;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.it.kind == "none": Glyph {
            icon: Icons.folder;
            size: 16px;
            color: Theme.subtle;
        }
        if root.it.kind == "add": Glyph {
            icon: Icons.folder-plus;
            size: 17px;
            color: Theme.subtle;
        }
    }
    property <length> room: self.width - 38px - (root.it.current ? 30px : 8px);
    label := Text {
        x: 38px;
        width: min(self.preferred-width, root.room - (root.it.hint != "" ? min(hint.preferred-width, 110px) + 8px : 0px));
        text: root.it.label;
        font-size: 14px;
        color: Theme.fg;
        overflow: elide;
        vertical-alignment: center;
    }
    hint := Text {
        x: label.x + label.width + 8px;
        width: max(0px, min(self.preferred-width, 38px + root.room - self.x));
        visible: root.it.hint != "";
        text: root.it.hint;
        font-size: 12px;
        color: Theme.subtle;
        overflow: elide;
        vertical-alignment: center;
    }
    if root.it.current: Glyph {
        x: parent.width - 26px;
        width: 16px;
        icon: Icons.check;
        size: 14px;
        color: Theme.subtle;
    }
    TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if self.has-hover {
                root.hovered();
            }
        }
        clicked => {
            root.clicked();
        }
    }
}

export component ProjectPop inherits PopoverFrame {
    in property <[ProjectPopRow]> rows;
    in-out property <int> hover;
    in-out property <string> search <=> field.text;
    callback pick(int);
    callback searched(string);
    callback key(KeyEvent) -> bool;
    public function focus-search() {
        field.focus-field();
    }
    property <length> step: Theme.row-h + 2px;
    // Every row but the last ("Add project") scrolls, nine at most in view; the last stays pinned under them.
    property <int> listed: max(root.rows.length - 1, 0);
    property <length> list-h: min(root.listed, 9) * root.step;
    function reveal() {
        if root.hover >= root.listed {
            return;
        }
        if root.hover * root.step < -flick.viewport-y {
            flick.viewport-y = -root.hover * root.step;
        } else if (root.hover + 1) * root.step > -flick.viewport-y + flick.height {
            flick.viewport-y = min(0px, flick.height - (root.hover + 1) * root.step);
        }
    }
    changed hover => {
        self.reveal();
    }
    width: 264px;
    height: 48px + root.list-h + root.step + 5px;
    TouchArea { }
    FocusScope {
        x: 12px;
        y: 6px;
        width: parent.width - 24px;
        height: 34px;
        capture-key-pressed(e) => {
            if root.key(e) {
                return accept;
            }
            reject
        }
        field := SearchField {
            width: parent.width;
            height: 34px;
            hint: "Search projects...";
            edited(t) => {
                root.searched(t);
            }
        }
    }
    Rectangle {
        x: 10px;
        y: 41px;
        width: parent.width - 20px;
        height: 1px;
        background: Theme.blue-900;
    }
    flick := Flickable {
        x: 6px;
        y: 48px;
        width: parent.width - 12px;
        height: root.list-h;
        viewport-width: self.width;
        viewport-height: root.listed * root.step;
        for r[i] in root.rows: Rectangle {
            x: 0;
            y: i * root.step;
            width: parent.width;
            height: root.step - 2px;
            if i < root.listed: ProjectPopItem {
                it: r;
                lit: i == root.hover;
                hovered => {
                    root.hover = i;
                }
                clicked => {
                    root.pick(i);
                }
            }
        }
    }
    if root.rows.length > 0: ProjectPopItem {
        x: 6px;
        y: flick.y + flick.height;
        width: parent.width - 12px;
        height: root.step - 2px;
        it: root.rows[root.listed];
        lit: root.hover == root.listed;
        hovered => {
            root.hover = root.listed;
        }
        clicked => {
            root.pick(root.listed);
        }
    }
}
