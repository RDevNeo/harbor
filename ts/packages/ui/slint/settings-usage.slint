import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AccountMark, Badge, Btn, Card, Glyph, MenuItem, PopoverFrame, Separator, SettingRow, TipArea, Toggle, Tone } from "widgets.slint";

export struct UsageWin {
    key: string,
    label: string,
    numbers: string,
    has-used: bool,
    used: float,
    cap: int,
    warn: int,
    capped-note: string,
}

export struct UsageCard {
    id: string,
    logo: image,
    badge: string,
    name: string,
    plan: string,
    sub: string,
    block: string,
    block-red: bool,
    switchable: bool,
    switch-on: bool,
    use-it: bool,
    summary: string,
    empty: string,
    windows: [UsageWin],
    warn: int,
    warn-options: [string],
}

export struct UsageGroup {
    logo: image,
    name: string,
    cards: [UsageCard],
}

export struct UsageBar {
    frac: float,
    label: string,
    today: bool,
}

export struct UsageRow {
    name: string,
    logo: image,
    badge: string,
    has-logo: bool,
    value: string,
    tip: string,
}

export struct UsageData {
    accounts-note: string,
    groups: [UsageGroup],
    auto: bool,
    weekly: bool,
    hours: int,
    hours-options: [string],
    notify: bool,
    switch-on: bool,
    switch-note: string,
    bars: [UsageBar],
    projects: [UsageRow],
    days: [UsageRow],
    by-account: [UsageRow],
    presets: [int],
}

component Combo {
    in property <[string]> options;
    in property <int> selected;
    in property <bool> enabled: true;
    callback picked(int);
    width: 140px;
    height: 32px;
    opacity: enabled ? 1 : 0.5;
    Rectangle {
        background: Theme.dark ? Theme.bg100 : Theme.bg100;
        border-width: 1px;
        border-color: area.has-hover ? Theme.gray-500 : Theme.border;
        border-radius: Theme.radius-md;
    }
    Text {
        x: 12px;
        text: root.options[root.selected];
        font-size: 14px;
        color: Theme.fg;
        vertical-alignment: center;
    }
    Path {
        x: parent.width - 24px;
        y: 13px;
        width: 10px;
        height: 6px;
        commands: "M 0 0 L 10 0 L 5 6 Z";
        fill: Theme.fg;
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            menu.show();
        }
    }
    menu := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        height: root.options.length * 32px + 8px;
        PopoverFrame {
            VerticalLayout {
                padding: 4px;
                for o[i] in root.options: MenuItem {
                    label: o;
                    checked: i == root.selected;
                    clicked => {
                        root.picked(i);
                    }
                }
            }
        }
    }
}

component CapBar {
    in property <bool> has-used;
    in property <float> used;
    in property <int> cap;
    in property <int> warn;
    callback capped(int);
    callback settled();
    property <int> live: -1;
    property <int> shown: live >= 0 ? live : cap;
    property <bool> over: shown < 100 && used * 100 >= shown;
    property <length> mx: root.width * shown / 100;
    height: 30px;
    Rectangle {
        y: 11px;
        height: 8px;
        border-radius: 4px;
        background: Theme.gray-200;
    }
    if root.has-used: Rectangle {
        y: 11px;
        x: 0;
        width: root.width * max(0, min(1, root.used));
        height: 8px;
        border-radius: 4px;
        background: root.over ? Theme.red-800 : root.warn > 0 && root.used * 100 >= root.warn ? Theme.amber-800 : Theme.blue-800;
    }
    if root.shown < 100: Rectangle {
        x: root.mx - 1px;
        y: 4px;
        width: 2px;
        height: 22px;
        background: Theme.fg;
    }
    if root.shown < 100: Rectangle {
        x: max(0px, min(root.width - self.width, root.mx - self.width / 2));
        y: -5px;
        width: pill.preferred-width + 8px;
        height: 15px;
        border-radius: 5px;
        background: Theme.fg;
        pill := Text {
            text: root.shown + "%";
            font-size: 11px;
            font-weight: 500;
            color: Theme.on-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.shown >= 100 && area.has-hover: Text {
        x: root.width - self.preferred-width;
        y: -5px;
        height: 15px;
        text: "Unlimited · drag to set a cap";
        font-size: 11px;
        color: Theme.subtle;
        vertical-alignment: center;
    }
    function move(px: length) {
        if root.width > 0 {
            let pct = max(5, min(100, round(px / root.width * 20) * 5));
            if pct != root.shown {
                root.live = pct;
                root.capped(pct);
            }
        }
    }
    area := TouchArea {
        mouse-cursor: col-resize;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.move(self.mouse-x);
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                root.live = -1;
                root.settled();
            }
        }
        moved => {
            if self.pressed {
                root.move(self.mouse-x);
            }
        }
    }
}

component Section {
    in property <string> title;
    in property <length> top: 16px;
    VerticalLayout {
        padding-top: root.top;
        padding-bottom: 14px;
        Text {
            height: 24px;
            text: root.title;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: -0.32px;
            color: Theme.fg;
            vertical-alignment: center;
        }
    }
}

component Line {
    in property <string> name;
    in property <string> value;
    in property <string> tip;
    in property <bool> first;
    in property <bool> last;
    in property <image> logo;
    in property <string> badge;
    in property <bool> has-logo;
    height: first ? 61px : last ? 61px : 69px;
    VerticalLayout {
        alignment: start;
        if !root.first: Separator { }
        Rectangle {
            height: 10px;
        }
        HorizontalLayout {
            height: root.first ? 34px : 48px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 6px;
            if root.has-logo: VerticalLayout {
                width: 22px;
                alignment: center;
                AccountMark {
                    height: 22px;
                    logo: root.logo;
                    badge: root.badge;
                }
            }
            Text {
                text: root.name;
                font-size: 14px;
                font-weight: 500;
                color: Theme.fg;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: root.value;
                font-size: 13px;
                font-family: "Geist Mono";
                color: Theme.subtle;
                vertical-alignment: center;
            }
        }
    }
    TipArea {
        tip: root.tip;
        mouse-cursor: default;
    }
}

component Lines {
    in property <[UsageRow]> rows;
    Card {
        VerticalLayout {
            if root.rows.length == 0: Text {
                height: 49px;
                x: 16px;
                text: "No turns yet.";
                font-size: 13px;
                color: Theme.subtle;
                vertical-alignment: center;
            }
            for r[i] in root.rows: Line {
                first: i == 0;
                last: i == root.rows.length - 1;
                name: r.name;
                value: r.value;
                tip: r.tip;
                logo: r.logo;
                badge: r.badge;
                has-logo: r.has-logo;
            }
        }
    }
}

component Box {
    // One account's card: header, the plain-language summary, each window's bar and presets, the warning.
    in property <UsageCard> card;
    in property <[int]> presets;
    callback act(string, string, int);
    callback settled();
    Card {
        VerticalLayout {
            padding: 16px;
            padding-top: 17px;
            HorizontalLayout {
                height: 48px;
                spacing: 9px;
                VerticalLayout {
                    width: 30px;
                    alignment: start;
                    AccountMark {
                        height: 30px;
                        logo: root.card.logo;
                        badge: root.card.badge;
                    }
                }
                VerticalLayout {
                    alignment: start;
                    HorizontalLayout {
                        height: 32px;
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: root.card.name;
                            font-size: 14px;
                            font-weight: 500;
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                        if root.card.plan != "": VerticalLayout {
                            alignment: center;
                            Badge {
                                text: root.card.plan;
                            }
                        }
                    }
                    Text {
                        height: 16px;
                        text: root.card.sub;
                        font-size: 12px;
                        color: Theme.subtle;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: end;
                    spacing: 8px;
                    if root.card.block != "": VerticalLayout {
                        alignment: center;
                        Badge {
                            text: root.card.block;
                            tone: root.card.block-red ? red : amber;
                        }
                    }
                    if root.card.switchable: VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Use for auto-switch";
                            font-size: 12px;
                            color: Theme.subtle;
                        }
                    }
                    if root.card.switchable: VerticalLayout {
                        alignment: center;
                        Toggle {
                            on: root.card.use-it;
                            enabled: root.card.switch-on;
                            toggled(v) => {
                                root.act("use", root.card.id, v ? 1 : 0);
                                root.settled();
                            }
                        }
                    }
                }
            }
            if root.card.empty != "": VerticalLayout {
                padding-top: 8px;
                Text {
                    text: root.card.empty;
                    font-size: 13px;
                    color: Theme.subtle;
                    wrap: word-wrap;
                }
            }
            if root.card.empty == "": VerticalLayout {
                Rectangle {
                    height: 15px;
                }
                Text {
                    height: 20px;
                    text: root.card.summary;
                    font-size: 14px;
                    color: Theme.fg;
                    vertical-alignment: center;
                }
                Rectangle {
                    height: 4px;
                }
                for w in root.card.windows: VerticalLayout {
                    Rectangle {
                        height: 14px;
                    }
                    HorizontalLayout {
                        height: 32px;
                        Text {
                            horizontal-stretch: 1;
                            text: w.label;
                            font-size: 14px;
                            font-weight: 500;
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                        Text {
                            text: w.numbers;
                            font-size: 12px;
                            color: Theme.subtle;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 9px;
                    }
                    CapBar {
                        has-used: w.has-used;
                        used: w.used;
                        cap: w.cap;
                        warn: w.warn;
                        capped(p) => {
                            root.act("cap", root.card.id + "\n" + w.key, p);
                        }
                        settled => {
                            root.settled();
                        }
                    }
                    Rectangle {
                        height: 7px;
                    }
                    HorizontalLayout {
                        height: 32px;
                        spacing: 4px;
                        alignment: start;
                        for p in root.presets: VerticalLayout {
                            alignment: center;
                            Btn {
                                text: p == 100 ? "Unlimited" : p + "%";
                                size: xs;
                                variant: ghost-muted;
                                pressed: w.cap == p || (p == 100 && w.cap >= 100);
                                clicked => {
                                    root.act("cap", root.card.id + "\n" + w.key, p);
                                    root.settled();
                                }
                            }
                        }
                        if w.capped-note != "": Text {
                            text: w.capped-note;
                            font-size: 12px;
                            color: Theme.subtle;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    height: 16px;
                }
                Separator { }
                HorizontalLayout {
                    height: 46px;
                    padding-top: 14px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Warn me at";
                        font-size: 13px;
                        color: Theme.subtle;
                        vertical-alignment: center;
                    }
                    Combo {
                        options: root.card.warn-options;
                        selected: root.card.warn;
                        picked(n) => {
                            root.act("warn", root.card.id, n);
                            root.settled();
                        }
                    }
                    Text {
                        text: "of any window: a notification, once per window.";
                        font-size: 12px;
                        color: Theme.subtle;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component UsageTab {
    in property <UsageData> data;
    callback act(string, string, int);
    callback settled();
    VerticalLayout {
        alignment: start;
        Section {
            title: "Accounts";
            top: 9px;
        }
        Text {
            text: "Drag the marker on a bar to cap how much of that limit Harbor uses. At the cap, Harbor treats the account as limited: threads wait for the reset or move to another account.";
            font-size: 13px;
            color: Theme.subtle;
            wrap: word-wrap;
        }
        Rectangle {
            height: 10px;
        }
        if root.data.accounts-note != "": VerticalLayout {
            Text {
                text: root.data.accounts-note;
                font-size: 13px;
                color: Theme.subtle;
            }
            Rectangle {
                height: 6px;
            }
        }
        for g in root.data.groups: VerticalLayout {
            Rectangle {
                height: 6px;
            }
            HorizontalLayout {
                height: 32px;
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    width: 18px;
                    alignment: center;
                    AccountMark {
                        height: 18px;
                        logo: g.logo;
                    }
                }
                Text {
                    text: g.name;
                    font-size: 14px;
                    font-weight: 500;
                    color: Theme.fg;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: 14px;
            }
            for c in g.cards: VerticalLayout {
                Box {
                    card: c;
                    presets: root.data.presets;
                    act(w, a, n) => {
                        root.act(w, a, n);
                    }
                    settled => {
                        root.settled();
                    }
                }
                Rectangle {
                    height: 15px;
                }
            }
        }
        Rectangle {
            height: 9px;
        }
        Section {
            title: "After a limit";
        }
        Card {
            VerticalLayout {
                SettingRow {
                    title: "Continue automatically";
                    desc: "The thread waits for the limit to reset, then continues where it stopped, with whatever you queued meanwhile.";
                    Toggle {
                        on: root.data.auto;
                        toggled(v) => {
                            root.act("auto", "", v ? 1 : 0);
                            root.settled();
                        }
                    }
                }
                Separator { }
                SettingRow {
                    opacity: root.data.auto ? 1 : 0.5;
                    title: "Also after the weekly limit";
                    desc: "Weekly limits can take days to reset.";
                    Toggle {
                        on: root.data.weekly;
                        enabled: root.data.auto;
                        toggled(v) => {
                            root.act("weekly", "", v ? 1 : 0);
                            root.settled();
                        }
                    }
                }
                Separator { }
                SettingRow {
                    title: "Wait at most";
                    desc: "Longer waits ask you instead.";
                    Combo {
                        enabled: root.data.auto;
                        options: root.data.hours-options;
                        selected: root.data.hours;
                        picked(n) => {
                            root.act("hours", "", n);
                            root.settled();
                        }
                    }
                }
                Separator { }
                SettingRow {
                    title: "Notify me when work resumes";
                    desc: "A desktop notification when a thread continues after its limit.";
                    Toggle {
                        on: root.data.notify;
                        toggled(v) => {
                            root.act("notify", "", v ? 1 : 0);
                            root.settled();
                        }
                    }
                }
            }
        }
        Section {
            top: 32px;
            title: "Switching accounts";
        }
        Card {
            VerticalLayout {
                SettingRow {
                    title: "Switch to another account at a limit";
                    desc: "The thread moves to another of your accounts that has quota left (and is under its caps), and continues there.";
                    Toggle {
                        on: root.data.switch-on;
                        toggled(v) => {
                            root.act("switch", "", v ? 1 : 0);
                            root.settled();
                        }
                    }
                }
                Separator { }
                SettingRow {
                    title: "Accounts to switch to";
                    desc: root.data.switch-note;
                }
            }
        }
        Section {
            top: 32px;
            title: "Last 14 days";
        }
        Card {
            VerticalLayout {
                padding: 16px;
                padding-bottom: 17px;
                Rectangle {
                    height: 138px;
                    for b[i] in root.data.bars: Rectangle {
                        x: parent.width / 14 * i + parent.width / 14 * 0.2;
                        width: parent.width / 14 * 0.6;
                        y: 120px - 120px * b.frac;
                        height: 120px * b.frac;
                        border-radius: 3px;
                        background: b.today ? Theme.gray-1000 : Theme.gray-700;
                    }
                    for b[i] in root.data.bars: Text {
                        x: parent.width / 14 * i;
                        width: parent.width / 14;
                        y: parent.height - 14px;
                        height: 14px;
                        text: b.label;
                        font-size: 11px;
                        color: Theme.subtle;
                        horizontal-alignment: center;
                        vertical-alignment: bottom;
                    }
                }
                Rectangle {
                    height: 9px;
                }
                Text {
                    text: "Tokens (in + out) per day across all providers.";
                    font-size: 12px;
                    color: Theme.subtle;
                }
            }
        }
        Section {
            title: "By project";
        }
        Lines {
            rows: root.data.projects;
        }
        Section {
            title: "By day";
        }
        Lines {
            rows: root.data.days;
        }
        Section {
            title: "By account";
        }
        Lines {
            rows: root.data.by-account;
        }
    }
}
