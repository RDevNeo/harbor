import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Glyph, Spinner, Btn, TipArea } from "widgets.slint";
import { MdBlock, MdBlockView } from "markdown.slint";

export struct MediaRow {
    image: image,
    caption: string,
    large: bool,
    w: length,
    h: length,
    path: string,
}

export struct CardData {
    kind: string,
    seq: int,
    blocks: [MdBlock],
    text: string,
    label: string,
    icon: string,
    tone: string,
    detail: string,
    result: string,
    open: bool,
    pending: bool,
    expandable: bool,
    sender: string,
    files: [string],
    steer: bool,
    url: string,
    actions: [string],
    time: string,
    media: [MediaRow],
}

component ToolCard {
    in property <CardData> card;
    callback toggle();
    property <color> icon-color: card.tone == "red" ? Theme.red-900 : card.tone == "green" ? Theme.green-900 : Theme.gray-900;
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    Rectangle {
        background: root.card.open ? Theme.bg200 : transparent;
        border-radius: Theme.radius-md;
    }
    inner := VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            height: 20px;
            Glyph {
                width: 14px;
                icon: root.card.icon;
                size: 14px;
                color: root.icon-color;
            }
            Text {
                text: root.card.label;
                font-size: 14px;
                font-weight: 500;
                color: Theme.fg;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: root.card.text;
                font-family: "Geist Mono";
                font-size: 12.5px;
                color: Theme.subtle;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        if root.card.open: Rectangle {
            min-height: box0.min-height;
            preferred-height: box0.preferred-height;
            background: Theme.bg200;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-lg;
            box0 := VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                Text {
                    text: root.card.detail;
                    font-family: "Geist Mono";
                    font-size: 12px;
                    color: Theme.fg;
                    wrap: word-wrap;
                }
            }
        }
        if root.card.open && root.card.result != "": Rectangle {
            min-height: box1.min-height;
            preferred-height: box1.preferred-height;
            background: Theme.bg200;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-lg;
            box1 := VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                Text {
                    text: root.card.result;
                    font-family: "Geist Mono";
                    font-size: 12px;
                    color: root.card.tone == "red" ? Theme.red-900 : Theme.fg;
                    wrap: word-wrap;
                }
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggle();
        }
    }
}

component UserBubble {
    in property <CardData> card;
    in property <length> avail;
    callback link(string);
    property <length> hug: max(measure.preferred-width, from-measure.preferred-width);
    measure := StyledText {
        visible: false;
        text: root.card.blocks[0].text;
        default-font-size: 14px;
        default-font-family: "Geist";
    }
    from-measure := Text {
        visible: false;
        text: root.card.sender != "" ? "from " + root.card.sender : "";
        font-size: 12px;
    }
    property <length> w: min(hug + 2px, avail * 0.8 - 28px) + 28px;
    VerticalLayout {
        spacing: 2px;
        if root.card.steer: HorizontalLayout {
            alignment: end;
            height: 16px;
            spacing: 4px;
            Glyph {
                width: 12px;
                icon: Icons.redo-2;
                size: 12px;
                color: Theme.subtle;
            }
            Text {
                text: "Steer";
                font-size: 11.5px;
                color: Theme.subtle;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            alignment: end;
            Rectangle {
                min-height: box2.min-height;
                preferred-height: box2.preferred-height;
                width: root.w;
                background: Theme.gray-100;
                border-radius: Theme.radius-lg;
                box2 := VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 4px;
                    body := StyledText {
                        text: root.card.blocks[0].text;
                        default-font-size: 14px;
                        default-font-family: "Geist";
                        default-color: Theme.fg;
                        link-color: Theme.blue-900;
                        link-clicked(u) => {
                            root.link(u);
                        }
                    }
                    for f in root.card.files: HorizontalLayout {
                        spacing: 6px;
                        Glyph {
                            width: 12px;
                            icon: Icons.clip;
                            size: 12px;
                            color: Theme.subtle;
                        }
                        Text {
                            text: f;
                            font-size: 12px;
                            color: Theme.subtle;
                            overflow: elide;
                        }
                    }
                    from := Text {
                        visible: root.card.sender != "";
                        height: root.card.sender != "" ? self.preferred-height : 0px;
                        text: root.card.sender != "" ? "from " + root.card.sender : "";
                        font-size: 12px;
                        color: Theme.subtle;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

component NoticePill {
    in property <CardData> card;
    callback act();
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    inner := HorizontalLayout {
        alignment: center;
        Rectangle {
            min-height: box3.min-height;
            preferred-height: box3.preferred-height;
            background: Theme.gray-100;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 14px;
            box3 := HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 6px;
                Glyph {
                    width: 13px;
                    icon: root.card.icon;
                    size: 13px;
                    color: Theme.subtle;
                }
                Text {
                    text: root.card.text;
                    font-size: 13px;
                    color: Theme.fg;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.card.expandable: Glyph {
                    width: 12px;
                    icon: root.card.open ? Icons.up : Icons.down;
                    size: 12px;
                    color: Theme.subtle;
                }
            }
            TipArea {
                tip: root.card.url != "" ? "Open in Harbor's browser" : "";
                mouse-cursor: root.card.expandable || root.card.url != "" ? pointer : default;
                clicked => {
                    root.act();
                }
            }
        }
    }
}

export component CardView inherits TouchArea {
    in property <CardData> card;
    in property <length> avail;
    in property <bool> running;
    callback toggle(int);
    callback link(string);
    callback open-url(string);
    callback act(int, string);
    callback open-media(string);
    property <bool> right: card.kind == "user";
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    inner := VerticalLayout {
        padding-bottom: Theme.compact ? 8px : 12px;
        if root.card.kind == "user": UserBubble {
            card: root.card;
            avail: root.avail;
            link(u) => {
                root.link(u);
            }
        }
        if root.card.kind == "text": VerticalLayout {
            spacing: 0px;
            for b in root.card.blocks: MdBlockView {
                block: b;
                size: 16px;
                link(u) => {
                    root.link(u);
                }
            }
        }
        if root.card.kind == "group": HorizontalLayout {
            height: 18px;
            spacing: 6px;
            alignment: start;
            Glyph {
                width: 12px;
                icon: root.card.open ? Icons.down : Icons.right;
                size: 12px;
                color: Theme.subtle;
            }
            Text {
                text: root.card.label;
                font-size: 12px;
                color: Theme.subtle;
                vertical-alignment: center;
            }
            if root.card.pending && root.running: Spinner {
                y: 3px;
                size: 12px;
            }
            TouchArea {
                width: 0px;
            }
        }
        if root.card.kind == "tool": ToolCard {
            card: root.card;
            toggle => {
                root.toggle(root.card.seq);
            }
        }
        if root.card.kind == "thinking": VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Glyph {
                    width: 13px;
                    icon: root.card.open ? Icons.down : Icons.right;
                    size: 12px;
                    color: Theme.subtle;
                }
                Glyph {
                    width: 13px;
                    icon: Icons.brain;
                    size: 13px;
                    color: Theme.subtle;
                }
                Text {
                    text: "Thinking";
                    font-size: 13px;
                    color: Theme.subtle;
                }
            }
            if root.card.open: Text {
                text: root.card.text;
                font-size: 14px;
                font-italic: true;
                color: Theme.subtle;
                wrap: word-wrap;
            }
        }
        if root.card.kind == "notice": VerticalLayout {
            spacing: 4px;
            NoticePill {
                card: root.card;
                act => {
                    if root.card.url != "" {
                        root.open-url(root.card.url);
                    } else if root.card.expandable {
                        root.toggle(root.card.seq);
                    }
                }
            }
            if root.card.open: Rectangle {
                min-height: box4.min-height;
                preferred-height: box4.preferred-height;
                background: Theme.bg200;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: Theme.radius-lg;
                box4 := VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 5px;
                    if root.card.blocks.length == 0: Text {
                        text: root.card.detail;
                        font-family: "Geist Mono";
                        font-size: 12px;
                        color: Theme.fg;
                        wrap: word-wrap;
                    }
                    for b in root.card.blocks: MdBlockView {
                        block: b;
                        size: 14px;
                        link(u) => {
                            root.link(u);
                        }
                    }
                }
            }
        }
        if root.card.kind == "message": Rectangle {
            min-height: box5.min-height;
            preferred-height: box5.preferred-height;
            background: Theme.blue-100;
            border-width: 1px;
            border-color: Theme.blue-400;
            border-radius: Theme.radius-lg;
            box5 := VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Glyph {
                        width: 13px;
                        icon: Icons.message;
                        size: 13px;
                        color: Theme.blue-900;
                    }
                    Text {
                        text: root.card.label;
                        font-size: 14px;
                        font-weight: 500;
                        color: Theme.blue-900;
                    }
                }
                Text {
                    text: root.card.text;
                    font-size: 14px;
                    color: Theme.fg;
                    wrap: word-wrap;
                }
            }
        }
        if root.card.kind == "error": Rectangle {
            min-height: box6.min-height;
            preferred-height: box6.preferred-height;
            background: Theme.red-100;
            border-width: 1px;
            border-color: Theme.red-400;
            border-radius: Theme.radius-lg;
            box6 := VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                Text {
                    text: root.card.text;
                    font-family: "Geist Mono";
                    font-size: 13px;
                    color: Theme.red-900;
                    wrap: word-wrap;
                }
            }
        }
        if root.card.kind == "divider": HorizontalLayout {
            height: 24px;
            spacing: 10px;
            Rectangle {
                horizontal-stretch: 1;
                height: 1px;
                y: 12px;
                background: Theme.border;
            }
            Glyph {
                width: 13px;
                icon: root.card.icon;
                size: 13px;
                color: Theme.subtle;
            }
            Text {
                text: root.card.text;
                font-size: 12px;
                color: Theme.subtle;
                vertical-alignment: center;
            }
            if root.card.label != "": Text {
                text: root.card.label;
                font-size: 12px;
                color: Theme.blue-900;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.link(root.card.url);
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 1px;
                y: 12px;
                background: Theme.border;
            }
        }
        for m in root.card.media: VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            padding-left: root.card.kind == "tool" ? 30px : 0px;
            alignment: start;
            if m.large: VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    alignment: root.card.kind == "user" ? LayoutAlignment.end : LayoutAlignment.start;
                    Rectangle {
                        width: m.w;
                        height: m.h;
                        border-radius: Theme.radius-lg;
                        clip: true;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: m.image;
                            image-fit: contain;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-media(m.path);
                            }
                        }
                    }
                }
                if m.caption != "": Text {
                    text: m.caption;
                    font-size: 12px;
                    color: Theme.subtle;
                    horizontal-alignment: root.card.kind == "user" ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                }
            }
        }
        if root.card.media.length > 0: HorizontalLayout {
            alignment: root.card.kind == "user" ? LayoutAlignment.end : LayoutAlignment.start;
            padding-left: root.card.kind == "tool" ? 30px : 0px;
            spacing: 8px;
            for m in root.card.media: Rectangle {
                visible: !m.large;
                width: m.large ? 0px : 132px;
                height: m.large ? 0px : 96px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: m.image;
                    image-fit: cover;
                }
                TipArea {
                    tip: m.path;
                    clicked => {
                        root.open-media(m.path);
                    }
                }
            }
        }
        if root.card.actions.length > 0: Rectangle {
            height: 16px;
            HorizontalLayout {
                y: -8px;
                height: 24px;
                alignment: root.right ? end : start;
                spacing: 2px;
                visible: root.has-hover;
                if root.right && root.card.time != "": Text {
                    text: root.card.time;
                    font-size: 12px;
                    color: Theme.subtle;
                    vertical-alignment: center;
                }
                if root.right && root.card.time != "": Rectangle {
                    width: 6px;
                }
                for a in root.card.actions: Btn {
                    icon: a == "copy" ? Icons.copy : a == "quote" ? Icons.link : a == "fork" ? Icons.fork : Icons.at-sign;
                    size: icon-xs;
                    variant: ghost-muted;
                    tip: a == "copy" ? "Copy" : a == "quote" ? "Quote in reply" : a == "fork" ? "Fork from this response" : "Mention in your next message";
                    clicked => {
                        root.act(root.card.seq, a);
                    }
                }
                if !root.right && root.card.time != "": Rectangle {
                    width: 6px;
                }
                if !root.right && root.card.time != "": Text {
                    text: root.card.time;
                    font-size: 12px;
                    color: Theme.subtle;
                    vertical-alignment: center;
                }
            }
        }
    }
    if root.card.kind == "group" || root.card.kind == "thinking": TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggle(root.card.seq);
        }
    }
}

export component Transcript {
    in property <[CardData]> cards;
    in property <length> content-w: 760px;
    in property <bool> running;
    callback toggle(int);
    callback link(string);
    callback open-url(string);
    callback act(int, string);
    callback open-media(string);
    out property <bool> at-end: -list.content-y + list.height >= list.content-height - 48px;
    // Stuck to the end while it grows (egui's stick_to_bottom) until scrolled up.
    in-out property <bool> follow: true;
    public function scroll-to-end() {
        root.follow = true;
        list.content-y = min(0px, list.height - col.preferred-height);
    }
    property <length> gutter: root.width < 520px ? 12px : 24px;
    property <length> side: max((root.width - root.content-w) / 2, gutter);
    property <length> column: max(0px, root.width - 2 * side);
    list := Flickable {
        width: root.width;
        height: root.height;
        content-height: col.preferred-height;
        changed content-height => {
            if root.follow {
                self.content-y = min(0px, self.height - self.content-height);
            }
        }
        changed height => {
            if root.follow {
                self.content-y = min(0px, self.height - self.content-height);
            }
        }
        flicked => {
            root.follow = root.at-end;
        }
        col := VerticalLayout {
            x: root.side;
            width: root.column;
            alignment: start;
            for c in root.cards: VerticalLayout {
                if c.kind == "space": Rectangle {
                    height: 24px;
                }
                if c.kind == "status": HorizontalLayout {
                    height: 24px;
                    spacing: 6px;
                    alignment: start;
                    Spinner {
                        y: 6px;
                        size: 12px;
                        color: Theme.subtle;
                    }
                    Text {
                        text: c.text;
                        font-size: 13px;
                        color: Theme.subtle;
                        vertical-alignment: center;
                    }
                }
                if c.kind != "space" && c.kind != "status" && c.kind != "earlier": CardView {
                    card: c;
                    avail: root.column;
                    running: root.running;
                    act(seq, a) => {
                        root.act(seq, a);
                    }
                    open-media(p) => {
                        root.open-media(p);
                    }
                    toggle(seq) => {
                        root.toggle(seq);
                    }
                    link(u) => {
                        root.link(u);
                    }
                    open-url(u) => {
                        root.open-url(u);
                    }
                }
            }
        }
    }
}
