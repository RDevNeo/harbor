                                    // A 32px row in egui, and its frame's stroke drawn outside it.
                                    Text {
                                        min-height: 34px;
                                        horizontal-stretch: 1;
                                        text: root.read-only-text;
                                        font-size: 14px;
                                        color: Theme.subtle;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                    if root.read-only-action != "": VerticalLayout {
                                        alignment: center;
                                        Btn {
                                            icon: Icons.compose;
                                            text: root.read-only-action;
                                            size: xs;
                                            variant: primary;
                                            clicked => {
                                                root.read-only-act();
                                            }
                                        }
                                    }
                                }
                            }
                            composer-el := Composer {
                                visible: !root.read-only;
                                height: root.read-only ? 0px : self.preferred-height;
                                text <=> root.draft;
                                state: root.composer;
                                voice: root.voice;
                                voice-level: root.voice-level;
                                voice-time: root.voice-time;
                                voice-note: root.voice-note;
                                mic-tip: root.mic-tip;
                                logo: root.model-logo;
                                files: root.files;
                                menu: root.menu;
                                menu-selected: root.menu-selected;
                                open-popup: root.pop-id;
                                max-h: min(14 * 20px, root.height * 0.45);
                                edited(t) => {
                                    root.edited(t);
                                }
                                key(e) => {
                                    return root.key(e);
                                }
                                send => {
                                    root.send();
                                }
                                resume-reply => {
                                    root.resume-reply();
                                }
                                stop => {
                                    root.stop();
                                }
                                attach => {
                                    root.attach();
                                }
                                mic => {
                                    root.mic();
                                }
                                remove-file(i) => {
                                    root.remove-file(i);
                                }
                                menu-pick(i) => {
                                    root.menu-pick(i);
                                }
                                menu-hover(i) => {
