                            }
                            if it.kind == "separator" && !root.pop-native && root.pop-spacing == 0px: MenuSeparator { }
                            if it.kind == "separator" && !root.pop-native && root.pop-spacing > 0px: Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                            // egui's menu separator: 6px between rows that keep their 8px gap.
                            if it.kind == "separator" && root.pop-native: Rectangle {
                                height: 14px;
                                    Rectangle {
                                    y: 4px;
                                    height: 1px;
                                    background: Theme.border;
                                }
                            }
                            if it.kind == "usage-account": HorizontalLayout {
                                height: 30px;
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text {
                                    text: it.label;
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Theme.fg;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                if it.badge != "": VerticalLayout {
                                    alignment: center;
                                    Badge {
                                        text: it.badge;
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                                if it.desc != "": TipArea {
                                    width: seen.preferred-width;
                                    tip: "When these numbers were last read";
                                    seen := Text {
                                        text: it.desc;
                                        font-size: 12px;
                                        color: Theme.subtle;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            if it.kind == "usage-window": VerticalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 4px;
                                HorizontalLayout {
                                    Text {
                                        text: it.label;
                                        font-size: 12px;
                                        color: Theme.subtle;
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: it.desc;
                                        font-size: 12px;
                                        color: Theme.subtle;
                                    }
                                }
                                Meter {
                                    frac: it.value;
                                }
                            }
                            if it.kind == "usage-note": Text {
                                height: 26px;
                                x: 8px;
                                text: it.label;
                                font-size: 13px;
                                color: Theme.subtle;
                                vertical-alignment: center;
                            }
                            if it.kind == "header": Text {
                                height: 26px;
                                x: 10px;
                                text: it.label;
                                font-size: 12.5px;
                                color: Theme.subtle;
                                vertical-alignment: center;
                            }
                            if it.kind == "gap": Rectangle {
                                height: 6px;
                            }
                            if it.kind == "rule": Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                            // devices.rs "Text to clipboard": four rows of text, Ctrl+Enter or Send.
                            if it.kind == "textbox": VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    height: 4 * 18px + 8px;
                                    background: Theme.bg100;
                                    border-width: 1px;
                                    border-color: box.has-focus ? Theme.gray-700 : Theme.border;
                                    border-radius: Theme.radius-md;
                                    box := TextInput {
                                        x: 6px;
                                        y: 4px;
                                        width: parent.width - 12px;
                                        height: parent.height - 8px;
                                        text <=> root.pop-input;
                                        font-size: 14px;
                                        color: Theme.fg;
                                        wrap: word-wrap;
                                        single-line: false;
                                        init => {
                                            self.focus();
                                        }
                                        edited => {
                                            root.pop-input-edited(self.text);
                                        }
                                        key-pressed(e) => {
                                            if e.modifiers.control && e.text == "\n" && self.text != "" {
                                                root.pop-input-accept();
                                                return accept;
                                            }
                                            reject
                                        }
                                    }
                                    if root.pop-input == "": Text {
                                        x: 6px;
                                        y: 4px;
                                        text: it.desc;
                                        font-size: 14px;
                                        color: Theme.subtle;
                                    }
                                }
                                HorizontalLayout {
                                    Text {
                                        text: "Ctrl+Enter";
                                        font-size: 12px;
                                        color: Theme.subtle;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                    Btn {
                                        text: it.label;
                                        size: xs;
                                        variant: primary;
                                        enabled: root.pop-input != "";
                                        clicked => {
                                            root.pop-input-accept();
                                        }
                                    }
                                }
                            }
                            if it.kind == "input": VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 4px;
                                    Input {
                                        hint: it.label;
                                        text <=> root.pop-input;
                                        edited(t) => {
                                            root.pop-input-edited(t);
                                        }
                                        accepted => {
                                            root.pop-input-accept();
                                        }
                                    }
                                    Btn {
                                        icon: Icons.check;
                                        size: icon;
                                        variant: ghost-muted;
                                        enabled: root.pop-input-ok;
                                        tip: it.desc;
                                        clicked => {
                                            root.pop-input-accept();
                                        }
                                    }
                                }
                                if root.pop-input-note != "": Text {
                                    x: 8px;
                                    text: root.pop-input-note;
                                    font-size: 12px;
                                    color: Theme.subtle;
                                }
                            }
                            if it.kind == "choice": ChoiceRow {
                                item: it;
                                clicked => {
                                    root.pop-pick(root.pop-id, i);
                                }
                            }
                            // An egui menu button with widgets.rs `menu_pad`: 32px, 8px apart; `badge` "submenu" draws its arrow, `desc` is its tip.
                            if it.kind == "native": Rectangle {
                                height: 40px;
                                min-width: native-label.preferred-width + (it.icon != "" ? 20px : 0px) + (it.badge == "submenu" ? 37px : 16px);
                                Rectangle {
                                    y: 0;
                                    height: 32px;
                                    border-radius: 4px;
                                    background: (native-area.has-hover || root.sub-row == i) && it.enabled ? Theme.accent : transparent;
                                    if it.icon != "": Glyph {
                                        x: 9px;
                                        width: 14px;
                                        icon: it.icon;
                                        size: 14px;
                                        color: native-label.color;
                                    }
                                    native-label := Text {
                                        x: it.icon != "" ? 29px : 9px;
                                        text: it.label;
                                        font-size: 14px;
                                        color: it.enabled ? Theme.fg : Theme.gray-700;
                                        vertical-alignment: center;
                                    }
                                    if it.badge == "submenu": Path {
                                        x: parent.width - 19px;
                                        y: 12.5px;
                                        width: 7px;
                                        height: 7px;
                                        viewbox-width: 7;
                                        viewbox-height: 7;
                                        commands: "M 0 0 L 7 3.5 L 0 7 Z";
                                        fill: native-label.color;
                                    }
                                    native-area := TipArea {
                                        tip: it.desc;
                                        changed has-hover => {
                                            if self.has-hover {
                                                root.pop-hover(i, self.absolute-position.y);
                                            }
                                        }
                                        clicked => {
                                            if it.enabled {
                                                root.pop-pick(root.pop-id, i);
                                            }
                                        }
                                    }
                                }
                            }
                            if it.kind == "item": MenuItem {
                                icon: it.icon;
                                label: it.label;
                                desc: it.desc;
                                checked: it.checked;
                                enabled: it.enabled;
                                clicked => {
                                    root.pop-pick(root.pop-id, i);
                                }
                            }
                        }
                    }
                }
            }

            // A cascading submenu: right of the menu with its top on the hovered row, flipped left at the window's edge, shifted up at its bottom.
            if root.sub-row >= 0: PopoverFrame {
                width: root.sub-w + 10px;
                height: min(sub-list.preferred-height + 10px, root.height);
                x: pop.x + pop.width + 2px + self.width <= root.width - 4px ? pop.x + pop.width + 2px : max(4px, pop.x - self.width - 2px);
                y: max(0px, min(root.sub-row-y - 5px, root.height - self.height - 4px));
                // Holds the rows, so it sees the pointer over them too (the grace delay ends on entering).
                TouchArea {
                    changed has-hover => {
                        if self.has-hover {
                            root.sub-enter();
                        }
                    }
                    Flickable {
                        x: 5px;
                        y: 5px;
                        width: parent.width - 10px;
                        height: parent.height - 10px;
                        sub-list := VerticalLayout {
                            alignment: start;
                            spacing: 8px;
                            for it[i] in root.sub-items: VerticalLayout {
                                if it.kind == "label": MenuLabel {
                                    text: it.label;
                                }
                                if it.kind == "caption": Text {
                                    height: 16px;
                                    x: 7px;
                                    text: it.label;
                                    font-size: 12px;
                                    color: Theme.subtle;
                                    vertical-alignment: center;
                                }
                                if it.kind == "separator": Rectangle {
                                    height: 1px;
                                    background: Theme.border;
                                }
                                if it.kind == "item": MenuItem {
                                    icon: it.icon;
                                    label: it.label;
                                    desc: it.desc;
                                    checked: it.checked;
                                    enabled: it.enabled;
                                    clicked => {
                                        root.sub-pick(i);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // pages.rs `dialogs`: egui's Modal, 512px of content for forms and 448 for confirms, 24px margins,
        // a 20px title, the close button in its corner; egui's 8px item spacing comes on top of each gap.
        if root.dialog-id != "": Rectangle {
            background: black.with-alpha(0.5);
            TouchArea { }
            Rectangle {
                width: min((root.dialog-has-input ? 512px : 448px) + 50px, root.width - 32px);
                height: dialog-body.preferred-height;
                background: Theme.bg100;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: Theme.radius-xl;
                drop-shadow-offset-y: 12px;
                drop-shadow-blur: 28px;
                drop-shadow-color: black.with-alpha(Theme.dark ? 56 / 255 : 20 / 255);
                dialog-body := VerticalLayout {
                    padding: 25px;
                    Text {
                        text: root.dialog-title;
                        font-size: 20px;
                        font-weight: 600;
                        letter-spacing: -0.4px;
                        color: Theme.fg;
                    }
                    if root.dialog-text != "" || root.dialog-has-input: Rectangle {
                        height: root.dialog-has-input ? 20px : 12px;
                    }
                    if root.dialog-text != "": Text {
                        text: root.dialog-text;
                        font-size: 14px;
                        color: Theme.subtle;
                        wrap: word-wrap;
                    }
                    if root.dialog-has-input: dialog-field := Input {
                        text <=> root.dialog-input;
                        accepted => {
                            root.dialog-done(root.dialog-id, true);
                        }
                        init => {
                            self.focus-field();
                        }
                    }
                    Rectangle {
                        height: 24px;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Btn {
                            text: "Cancel";
                            size: root.dialog-stop ? BtnSize.sm : BtnSize.normal;
                            clicked => {
                                root.dialog-done(root.dialog-id, false);
                            }
                        }
                        Btn {
                            text: root.dialog-ok;
                            size: root.dialog-stop ? BtnSize.sm : BtnSize.normal;
                            variant: root.dialog-stop ? Variant.stop : root.dialog-danger ? Variant.destructive : Variant.primary;
                            clicked => {
                                root.dialog-done(root.dialog-id, true);
                            }
                        }
                    }
                }
                close-x := TouchArea {
                    x: parent.width - 37px;
                    y: 17px;
                    width: 28px;
                    height: 28px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.dialog-done(root.dialog-id, false);
                    }
                    Glyph {
                        icon: Icons.x;
                        size: 16px;
                        color: close-x.has-hover ? Theme.fg : Theme.fg.with-alpha(0.7);
                    }
                }
            }
        }

        if root.lb-open: Lightbox {
            width: root.width;
            height: root.height;
            data: root.lb-data;
            close => {
                root.lb-close();
            }
            go(i) => {
                root.lb-go(i);
            }
            copy-image => {
                root.lb-copy-image();
            }
            copy-path => {
                root.lb-copy-path();
            }
        }

        if root.vid-open: VideoView {
            width: root.width;
            height: root.height;
            data: root.vid-data;
            frame: root.vid-frame;
            toggle => {
                root.vid-toggle();
            }
            fullscreen => {
                root.vid-fullscreen();
            }
            mute => {
                root.vid-mute();
            }
            volume(v) => {
                root.vid-volume(v);
            }
            seek(v) => {
                root.vid-seek(v);
            }
            release-seek => {
                root.vid-release-seek();
            }
            moved => {
                root.vid-moved();
            }
            over-bar(o) => {
                root.vid-over-bar(o);
            }
            close => {
                root.lb-close();
            }
            copy-path => {
                root.lb-copy-path();
            }
            open-external => {
                root.vid-open-external();
            }
            go(i) => {
                root.lb-go(i);
            }
        }
        if root.cap-open && root.cap-shown: CaptchaView {
            width: root.width;
            height: root.height;
            data: root.cap-data;
            pointer(kind, x, y) => {
                root.cap-pointer(kind, x, y);
            }
            wheel(x, y, dy) => {
                root.cap-wheel(x, y, dy);
            }
            hide => {
                root.cap-show(false);
            }
            cancel => {
                root.cap-cancel();
            }
        }
        if root.cap-open && !root.cap-shown: CaptchaPill {
            x: root.width - self.width - 16px;
            y: root.height - self.height - 56px;
            guild: root.cap-data.guild;
            show => {
                root.cap-show(true);
            }
        }

        // chat.rs `mention_selection_button`: above the selected text, kept in the transcript.
        if root.sel-shown && root.view == "chat": Rectangle {
            x: max(root.left-edge + 8px, min(root.sel-x, root.width - root.right-shown - self.width - 8px));
            // Rust anchors it at the pointer, about a line below the block's top.
            y: max(root.sel-y + 10px - 28px - 10px, 52px);
            width: sel-btn.preferred-width;
            height: sel-btn.preferred-height;
            sel-btn := Btn {
                icon: Icons.at-sign;
                text: "Mention selection";
                size: xs;
            }
            // It acts on the press: the press also ends the text's selection.
            TouchArea {
                mouse-cursor: pointer;
                changed has-hover => {
                    root.sel-hover(self.has-hover);
                }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        root.sel-mention();
                    }
                }
            }
        }

        if root.toast != "": PopoverFrame {
            x: (root.width - self.width) / 2;
            y: root.height - 24px - self.height;
            width: toast-text.width + 10px;
            height: toast-text.preferred-height + 10px;
            toast-text := Text {
                x: 5px;
                y: 5px;
                width: min(self.preferred-width, 586px);
                wrap: word-wrap;
                text: root.toast;
                font-size: 14px;
                color: Theme.fg;
            }
        }

        if root.palette-open: PaletteOverlay {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            init => {
                self.focus-field();
            }
        }

        if root.add-project-open: AddProjectOverlay {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            init => {
                self.focus-field();
            }
        }

        TipLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            window-width: root.width;
        }
    }
}
