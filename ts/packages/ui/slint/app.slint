            width: root.width - root.left-edge - (root.pane-max == "bottom" ? 0px : root.right-shown);
            height: root.pane-max == "bottom" ? root.height : root.bottom-shown - 1px;
            visible: root.bottom-open && (root.pane-max == "" || root.pane-max == "bottom");
            tabs: root.bottom-tabs;
            active: root.bottom-active;
            maximized: root.pane-max == "bottom";
