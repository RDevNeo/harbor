            }
            browser: root.right-browser;
            servers: root.browser-servers;
            browser-nav(a) => {
                root.browser-nav("right", a);
            }
            browser-go(u) => {
                root.browser-go("right", u);
            }
            browser-missing => {
                root.browser-missing("right");
