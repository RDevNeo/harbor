export { Theme, Icons, Spin, Ui, SideRow, CardData, ComposerState, MenuEntry, MdBlock, AgentRow, WakeRow, HookRow, RailItem, ModelRow, StripRow, ProcItem, EarlierChat, SettingsBus, PrsBus, IssuesBus, PaletteBus, AddProjectBus }

export struct PopItem {
    kind: string,
    icon: string,
    label: string,
    desc: string,
    checked: bool,
    enabled: bool,
    badge: string,
    value: float,
}

component ChoiceRow inherits TouchArea {
    in property <PopItem> item;
    mouse-cursor: pointer;
    min-height: self.item.desc == "" ? 34px : 38px + desc.preferred-height;
    preferred-height: self.min-height;
    Rectangle {
        y: 1px;
        height: parent.height - 2px;
        border-radius: Theme.radius-md;
        background: root.item.checked ? Theme.gray-200 : root.has-hover ? Theme.gray-100 : transparent;
    }
    label := Text {
        x: 10px;
        y: root.item.desc == "" ? (parent.height - self.preferred-height) / 2 : 8px;
        text: root.item.label;
        font-size: 14.5px;
        color: Theme.fg;
    }
    if root.item.badge != "": Rectangle {
        x: 18px + label.preferred-width;
        y: label.y + 1px;
        width: badge.preferred-width + 10px;
        height: badge.preferred-height + 4px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.gray-100;
        badge := Text {
            text: root.item.badge;
            font-size: 11px;
            font-weight: 500;
            color: Theme.subtle;
        }
    }
    desc := Text {
        visible: root.item.desc != "";
        x: 10px;
        y: 30px;
        width: parent.width - 20px;
        text: root.item.desc;
        font-size: 12.5px;
        color: Theme.subtle;
        wrap: word-wrap;
        overflow: elide;
        max-height: 2 * 17px;
    }
}

export struct Crumbs {
    icon: string,
    project: string,
    parent: string,
    title: string,
    branch: string,
}

component TopBar {
    in property <Crumbs> crumbs;
    in property <bool> sidebar-open;
    in property <bool> team-enabled;
    in property <bool> team-on;
    in property <bool> right-on;
    in property <bool> bottom-on;
    callback show-sidebar();
    callback close-window();
    callback team();
    callback pane(string);
    callback project-clicked(length, length);
    callback parent-clicked();
    height: 46px;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 6px;
        if !root.sidebar-open: Btn {
            y: 1px;
            icon: Icons.panel-left;
            size: icon-xs;
            variant: ghost-muted;
            tip: "Show sidebar (Ctrl+B)";
            clicked => {
                root.show-sidebar();
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            Rectangle {
                width: min(project.preferred-width + 22px, 280px);
                Glyph {
                    x: 0;
                    width: 14px;
                    icon: root.crumbs.icon;
                    size: 14px;
                    color: Theme.subtle;
                }
                project := Text {
                    x: 22px;
                    width: parent.width - 22px;
                    text: root.crumbs.project;
                    font-size: 14px;
                    color: Theme.subtle;
                    overflow: elide;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.project-clicked(self.absolute-position.x, self.absolute-position.y + self.height);
                    }
                }
            }
            Text {
                text: "/";
                font-size: 14px;
                color: Theme.gray-600;
                vertical-alignment: center;
            }
            if root.crumbs.parent != "": Text {
                max-width: 200px;
                text: root.crumbs.parent;
                font-size: 14px;
                color: Theme.subtle;
                overflow: elide;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.parent-clicked();
                    }
                }
            }
            if root.crumbs.parent != "": Text {
                text: "/";
                font-size: 14px;
                color: Theme.gray-600;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 0;
                min-width: 24px;
                max-width: self.preferred-width;
                text: root.crumbs.title;
                font-size: 14px;
                color: Theme.fg;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.crumbs.branch != "": Glyph {
                width: 13px;
                icon: Icons.branch;
                size: 13px;
                color: Theme.subtle;
            }
            if root.crumbs.branch != "": Text {
                max-width: 160px;
                text: root.crumbs.branch;
                font-family: "Geist Mono";
                font-size: 13px;
                color: Theme.subtle;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 4px;
            Btn {
                y: 1px;
                icon: Icons.square-menu;
                size: icon-xs;
                variant: ghost-muted;
                enabled: root.team-enabled;
                pressed: root.team-enabled && root.team-on;
                tip: "Team: agents, processes, wake-ups, webhooks (Ctrl+J)";
                clicked => {
                    root.team();
                }
            }
            Btn {
                y: 1px;
                icon: Icons.panel-bottom;
                size: icon-xs;
                variant: ghost-muted;
                pressed: root.bottom-on;
                tip: "Bottom panel";
                clicked => {
                    root.pane("bottom");
                }
            }
            Btn {
                y: 1px;
                icon: Icons.panel-right;
                size: icon-xs;
                variant: ghost-muted;
                pressed: root.right-on;
                tip: "Right panel";
                clicked => {
                    root.pane("right");
                }
            }
            Btn {
                y: 1px;
                icon: Icons.x;
                size: icon-xs;
                variant: ghost;
                tip: "Close Harbor";
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}

component Hero {
    in property <string> subtitle;
    in property <bool> subtitle-link;
    in property <string> note;
    callback subtitle-clicked(length, length);
    VerticalLayout {
        spacing: 0px;
        Text {
            text: "What should we work on?";
            font-size: 32px;
            font-weight: 600;
            letter-spacing: -1.28px;
            color: Theme.fg;
            horizontal-alignment: center;
        }
        Rectangle {
            height: 14px;
        }
        HorizontalLayout {
            alignment: center;
            sub := Rectangle {
                width: sub-text.preferred-width;
                height: sub-text.preferred-height + 4px;
                property <color> c: root.subtitle-link && sub-area.has-hover ? Theme.fg : Theme.subtle;
                sub-text := Text {
                    y: 0;
                    text: root.subtitle;
                    font-size: root.subtitle-link ? 15px : 14px;
                    color: sub.c;
                }
                if root.subtitle-link: Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    for i in Math.ceil(sub.width / 6px): Rectangle {
                        x: i * 6px;
                        y: 0;
                        width: min(4px, sub.width - i * 6px);
                        height: 1px;
                        background: sub.c;
                    }
                }
                sub-area := TouchArea {
                    enabled: root.subtitle-link;
                    mouse-cursor: root.subtitle-link ? pointer : default;
                    clicked => {
                        root.subtitle-clicked(self.absolute-position.x, self.absolute-position.y + self.height);
                    }
                }
            }
        }
        if root.note != "": Rectangle {
            height: 10px;
        }
        if root.note != "": Text {
            text: root.note;
            font-size: 13px;
            color: Theme.subtle;
            horizontal-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    // HARBOR_WINDOW_TITLE (scripts/preview: "Harbor preview · …"), so a preview is never taken for the real window.
    in property <string> window-title: "Harbor";
    title: root.window-title;
    icon: @image-url("");
    preferred-width: 1400px;
    preferred-height: 900px;
    // The smallest window stays the same on the screen whatever the zoom.
    min-width: 480px / root.zoom-level;
    min-height: 360px / root.zoom-level;
    background: Theme.bg100;
    default-font-family: "Geist";
    default-font-size: 14px;

    in-out property <bool> dark <=> Theme.dark;
    in-out property <bool> compact <=> Theme.compact;
    in property <string> view: "draft";
    in property <bool> palette-open;
    in property <bool> add-project-open;
    in-out property <bool> sidebar-open: true;
    out property <bool> narrow: root.width < 768px;

    in property <[SideRow]> side-rows;
    in property <[SideRow]> side-settled;
    in property <int> settled-count;
    in-out property <bool> settled-open;
    in-out property <string> search;
    in property <string> side-empty;
    in property <string> side-empty-desc;
    in property <bool> side-ws;
    in property <bool> side-ws-on;
    in property <string> side-ws-tip;
    in property <bool> side-drag;
    callback open-chat(int);
    callback open-project(int);
    callback new-chat(int);
    callback new-thread();
    callback add-project();
    callback settle(int, bool);
    callback settle-project(int, bool);
    callback snooze(string, length, length);
    callback chat-menu(int, length, length);
    callback project-menu(int, length, length);
    callback searched(string);
    callback palette();
    callback filter(length, length);
    callback usage(length, length);
    callback ws-filter(length, length);
    callback ws-all();
    callback reorder(int, int, bool);
    in property <bool> sel-shown;
    in property <length> sel-x;
    in property <length> sel-y;
    callback sel-mention();
    callback sel-hover(bool);
    in property <[DeviceRow]> devices;
    in property <string> devices-summary;
    in property <[TransferRow]> transfers;
    in property <bool> transfers-clearable;
    callback device-send(string, length, length);
    callback device-files(string, string);
    callback device-terminal(string, string);
    callback device-settings();
    callback transfers-clear();
    in property <FilesData> right-files;
    in property <[FileRow]> right-file-rows;
    in property <[TransferRow]> right-file-transfers;
    in property <bool> right-file-clearable;
    in property <FilesData> bottom-files;
    in property <[FileRow]> bottom-file-rows;
    in property <[TransferRow]> bottom-file-transfers;
    in property <bool> bottom-file-clearable;
    callback files-act(string, string, int);
    callback files-go(string, string);
    in property <BrowserData> right-browser;
    in property <BrowserData> bottom-browser;
    in property <[string]> browser-servers;
    callback browser-nav(string, string);
    callback browser-go(string, string);
    callback browser-missing(string);
    callback browser-resized(string, float, float);
    callback browser-pointer(string, string, float, float, int);
    callback browser-wheel(string, float, float, float, float);
    callback browser-key(string, string, bool, bool, bool, bool, bool);
    callback settings();
    callback prs();
    callback issues();
    callback leave-page();
    callback refresh();

    in property <Crumbs> crumbs;
    in property <bool> team-enabled;
    in property <bool> team-on;
    in property <[AgentRow]> team-agents;
    in property <[AgentRow]> team-settled;
    in property <[WakeRow]> team-wakeups;
    in property <[HookRow]> team-hooks;
    in property <[ProcItem]> team-procs;
    in property <[EarlierChat]> team-earlier;
    callback proc-stop(int);
    callback proc-toggle(int);
    callback proc-open(string);
    in property <bool> team-has-project;
    in-out property <bool> team-settled-open;
    callback team();
    callback open-agent(int);
    callback settle-agent(int, bool);
    callback stop-agent(int);
    callback cancel-wakeup(int);
    callback wake-now(int);
    callback copy-hook(string);
    callback delete-hook(int);
    callback team-settled-toggled(bool);
    callback project-clicked(length, length);
    callback parent-clicked();
    callback close-window();

    in property <string> hero-subtitle;
    in property <bool> hero-link;
    in property <string> hero-note;
    in property <bool> hero;
    in property <[CardData]> cards;
    in property <[MdBlock]> live-blocks;
    in property <int> live-seq: -1;
    in property <bool> chat-running;
    in property <bool> read-only;
    in property <string> read-only-text;
    in property <string> read-only-action;
    callback read-only-act();
    callback toggle(int);
    callback transcript-near-top();
    callback link(string);
    callback open-url(string);
    callback card-act(int, string);
    callback queue-menu(int, length, length);
    callback open-media(string);

    in-out property <string> draft;
    in property <ComposerState> composer;
    in property <image> model-logo;
    // Set and read back by the shell: pixels go in, a native image comes out, which models then share
    // instead of each copying the pixels (`MediaRows`).
    in-out property <image> image-scratch;
    in property <[FileItem]> files;
    in property <[MenuEntry]> menu;
    in property <int> menu-selected;
    out property <int> cursor: composer-el.cursor;
    out property <int> cursor-anchor: composer-el.anchor;
    callback edited(string);
    callback key(KeyEvent) -> bool;
    callback send();
    callback stop();
    callback attach();
    callback resume-reply();
    callback mic();
    callback remove-file(int);
    callback menu-pick(int);
    callback menu-hover(int);
    callback popup(string, length, length);

    in property <bool> untrusted;
    callback trust();
    in property <[MentionChip]> mentions;
    callback remove-mention(int);
    callback note-edited(int, string);
    in property <[StripRow]> strip-rows;
    in property <string> strip-title;
    in property <string> strip-names;
    in property <bool> strip-header;
    in property <bool> strip-folded;
    in property <bool> strip-open;
    in property <int> strip-asking;
    callback strip-open-agent(int);
    callback strip-ask-stop(int);
    callback strip-stop(int);
    callback strip-cancel();
    callback strip-head();
    callback strip-stop-all();

    in property <string> pop-id;
    in property <[PopItem]> pop-items;
    in property <length> pop-x;
    in property <length> pop-y;
    in property <length> pop-w: 240px;
    in property <bool> pop-above;
    // egui's own context menu (a chat row's right click): at the pointer, as wide as its rows.
    in property <bool> pop-native;
    in property <string> voice;
    in property <float> voice-level;
    in property <string> voice-time;
    in property <string> voice-note;
    in property <string> mic-tip: "Dictate (Ctrl+Shift+Space)";
    // picker.rs `toast`: a message over the bottom edge for a few seconds.
    in property <string> toast;
    // A Discord join waits on a captcha (`cap-open`), shown over everything (`cap-shown`) or as a pill.
    in property <bool> cap-open;
    in property <bool> cap-shown;
    in property <CaptchaData> cap-data;
    callback cap-pointer(string, float, float);
    callback cap-wheel(float, float, float);
    callback cap-show(bool);
    callback cap-cancel();
    // The open chat's captcha card: its newest frame (chatcaptcha.ts), and what the person does on it.
    in property <ChatCaptchaData> chat-cap;
    in property <image> chat-cap-frame;
    callback chat-cap-seen(string, bool, float);
    callback chat-cap-pointer(string, string, float, float);
    callback chat-cap-cancel(string);
    in property <bool> lb-open;
    in property <LightboxData> lb-data;
    callback lb-close();
    callback lb-go(int);
    callback lb-copy-image();
    callback lb-copy-path();
    in property <bool> vid-open;
    in property <VideoData> vid-data;
    in property <image> vid-frame;
    callback vid-toggle();
    callback vid-fullscreen();
    callback vid-mute();
    callback vid-volume(float);
    callback vid-seek(float);
    callback vid-release-seek();
    callback vid-moved();
    callback vid-over-bar(bool);
    callback vid-open-external();
    // egui's item spacing in a popover: 8px, or 0 where the Rust menu sets it (the effort menu).
    in property <length> pop-spacing: 8px;
    callback pop-pick(string, int);
    callback pop-close();
    // A native popup row's cascading submenu (shell.ts `openSub`): beside the parent row `sub-row` (-1: none), its top at `sub-row-y`.
    callback pop-hover(int, length);
    in property <int> sub-row: -1;
    in property <length> sub-row-y;
    in property <[PopItem]> sub-items;
    in property <length> sub-w: 240px;
    callback sub-enter();
    callback sub-pick(int);
    in-out property <string> pop-input;
    in property <string> pop-input-note;
    in property <bool> pop-input-ok;
    callback pop-input-edited(string);
    callback pop-input-accept();

    in property <[RailItem]> picker-rail;
    in property <bool> picker-favorites;
    in property <[ModelRow]> picker-rows;
    in-out property <int> picker-hover;
    in property <string> picker-more-label;
    in property <int> picker-more-count;
    in property <bool> picker-in-more;
    in property <string> picker-empty;
    in-out property <string> picker-search;
    callback picker-rail-pick(string);
    callback picker-pick(int);
    callback picker-star(int);
    callback picker-more();
    callback picker-back();
    callback picker-searched(string);
    callback picker-key(KeyEvent) -> bool;

    in property <string> dialog-id;
    in property <string> dialog-title;
    in property <string> dialog-text;
    in-out property <string> dialog-input;
    in property <bool> dialog-has-input;
    // undo.rs `stop_all_dialog`: small buttons, the red Stop one.
    in property <bool> dialog-stop;
    in property <string> dialog-ok;
    in property <bool> dialog-danger;
    callback dialog-done(string, bool);

    callback global-key(KeyEvent) -> bool;
    // Alt+Up / Alt+Down (previous / next chat), before any widget sees the key; true = taken.
    callback nav-key(KeyEvent) -> bool;
    // The sidebar row Alt+Up / Alt+Down last opened ("kind:id"), scrolled into view.
    in property <string> side-reveal;

    public function focus-composer() {
        composer-el.focus-text();
    }
    public function set-cursor(at: int) {
        composer-el.set-cursor(at);
    }
    public function scroll-to-end() {
        transcript.scroll-to-end();
    }
    public function transcript-key(k: string) {
        if k == "up" {
            transcript.page(1);
        } else if k == "down" {
            transcript.page(-1);
        } else if k == "home" {
            transcript.scroll-to-top();
        } else {
            transcript.scroll-to-end();
        }
    }
    public function copy-text(t: string) {
        composer-el.copy-text(t);
    }
    out property <bool> at-end: transcript.at-end;
    out property <length> transcript-height: transcript.content-height;
    // The screen's pixels per logical pixel (1.25 on a 125% display): images are decoded to the size drawn.
    out property <float> scale-factor: 1px / 1phx;
    // Browser-style zoom: the level (1 = 100%),
    // a zoom key (1 in, -1 out, 0 back to 100%), and a scale set by the display (another screen, a new setting).
    in property <float> zoom-level: 1;
    callback zoom(int);
    callback scale-changed(float);
    changed scale-factor => {
        root.scale-changed(self.scale-factor);
    }
    public function transcript-grew-above(before: length) {
        transcript.grew-above(before);
    }
    public function transcript-anchor-off() {
        transcript.anchor-off();
    }

    property <length> content-w: 760px;
    // app.rs `sidebar_narrow`: a right pane at its minimum leaves the chat its 440px, or the sidebar becomes a drawer.
    property <bool> docked: root.sidebar-open && !root.narrow && !(root.right-open && root.pane-max == "" && root.width < 256px + 320px + 440px);
    in property <bool> right-open;
    in property <bool> bottom-open;
    in property <string> pane-max;
    in-out property <length> right-w: 620px;
    in-out property <length> bottom-h: 300px;
    in property <[SurfaceTab]> right-tabs;
    in property <[SurfaceTab]> bottom-tabs;
    in property <int> right-active;
    in property <int> bottom-active;
    in property <TermScreen> right-screen;
    in property <TermScreen> bottom-screen;
    callback pane-toggle(string);
    callback pane-add(string);
    callback pane-open(string, int);
    callback pane-close(string, int);
    callback pane-max-toggle(string);
    callback pane-hide(string);
    callback pane-pick(string, string);
    callback pane-recent(string, length, length);
    callback term-key(string, TermKey, string, bool, bool, bool);
    callback term-paste(string);
    callback term-wheel(string, int);
    callback term-resized(string, length, length, length, length);
    public function focus-pane(dock: string, terminal: bool) {
        if dock == "right" && terminal {
            right-pane.focus-terminal();
        } else if dock == "right" {
            right-pane.focus-chooser();
        } else if terminal {
            bottom-pane.focus-terminal();
        } else {
            bottom-pane.focus-chooser();
        }
    }
    changed docked => {
        if !root.docked && root.pop-id == "usage" {
            root.pop-close();
        }
        PrsBus.docked = root.docked;
        IssuesBus.docked = root.docked;
    }
    property <length> left-edge: root.docked ? 256px : 0px;
    property <length> right-shown: root.right-open && root.pane-max == "" ? max(320px, min(root.right-w, root.width - root.left-edge - 440px)) : 0px;
    property <length> bottom-shown: root.bottom-open && root.pane-max == "" ? max(140px, min(root.bottom-h, root.height - 120px)) : 0px;

    // Browser-style zoom, as Chrome does it: Ctrl+= or Ctrl++ (keypad too) in, Ctrl+- out, Ctrl+0 back to 100%.
    // It wraps everything so the key is caught before any widget (the composer, a terminal) sees it.
    FocusScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(e) => {
            if (e.modifiers.alt || e.modifiers.control) && root.nav-key(e) {
                return accept;
            }
            if e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                if e.text == "=" || e.text == "+" {
                    root.zoom(1);
                    return accept;
                }
                if e.text == "-" {
                    root.zoom(-1);
                    return accept;
                }
                if e.text == "0" {
                    root.zoom(0);
                    return accept;
                }
            }
            reject
        }

        keys := FocusScope {
            key-pressed(e) => {
                if root.global-key(e) {
                    return accept;
                }
                reject
            }
            Rectangle {
                if root.docked: Sidebar {
                    x: 0;
                    y: 0;
                    width: 256px;
                    height: root.height;
                    rows: root.side-rows;
                    reveal: root.side-reveal;
                    settled: root.side-settled;
                    settled-count: root.settled-count;
                    settled-open <=> root.settled-open;
                    search <=> root.search;
                    empty-kind: root.side-empty;
                    empty-desc: root.side-empty-desc;
                    workspaces: root.side-ws;
                    ws-on: root.side-ws-on;
                    ws-tip: root.side-ws-tip;
                    pop-id: root.pop-id;
                    can-drag: root.side-drag;
                    pages-back: root.view == "prs" || root.view == "issues";
                    open-chat(id) => {
                        root.open-chat(id);
                    }
                    open-project(id) => {
                        root.open-project(id);
                    }
                    new-chat(id) => {
                        root.new-chat(id);
                    }
                    new-thread => {
                        root.new-thread();
                    }
                    add-project => {
                        root.add-project();
                    }
                    settle(id, on) => {
