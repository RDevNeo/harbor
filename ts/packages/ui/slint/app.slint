import "fonts/Geist-Regular.ttf";
import "fonts/Geist-Medium.ttf";
import "fonts/Geist-SemiBold.ttf";
import "fonts/GeistMono-Regular.ttf";
import "fonts/lucide.ttf";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Ui, Btn, Glyph, TipLayer, TipArea, MenuItem, MenuLabel, MenuSeparator, PopoverFrame, Separator, Input, Badge } from "widgets.slint";
import { Sidebar, SideRow } from "sidebar.slint";
import { Transcript, CardData } from "chat.slint";
import { Composer, ComposerState, MenuEntry, StripRow, FileItem, MentionChip } from "composer.slint";
import { MdBlock } from "markdown.slint";
import { TeamPanel, AgentRow, WakeRow, HookRow, ProcItem, EarlierChat } from "team.slint";
import { ModelPicker, RailItem, ModelRow } from "picker.slint";

export { Theme, Icons, Ui, SideRow, CardData, ComposerState, MenuEntry, MdBlock, AgentRow, WakeRow, HookRow, RailItem, ModelRow, StripRow, ProcItem, EarlierChat }

export struct PopItem {
    kind: string,
    icon: string,
    label: string,
    desc: string,
    checked: bool,
    enabled: bool,
    badge: string,
}

component ChoiceRow inherits TouchArea {
    in property <PopItem> item;
    mouse-cursor: pointer;
    min-height: self.item.desc == "" ? 34px : 38px + desc.preferred-height;
    preferred-height: self.min-height;
    Rectangle {
        y: 1px;
        height: parent.height - 2px;
        border-radius: Theme.radius-md;
        background: root.item.checked ? Theme.gray-200 : root.has-hover ? Theme.gray-100 : transparent;
    }
    label := Text {
        x: 10px;
        y: root.item.desc == "" ? (parent.height - self.preferred-height) / 2 : 8px;
        text: root.item.label;
        font-size: 14.5px;
        color: Theme.fg;
    }
    if root.item.badge != "": Rectangle {
        x: 18px + label.preferred-width;
        y: label.y + 1px;
        width: badge.preferred-width + 10px;
        height: badge.preferred-height + 4px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.gray-100;
        badge := Text {
            text: root.item.badge;
            font-size: 11px;
            font-weight: 500;
            color: Theme.subtle;
        }
    }
    desc := Text {
        visible: root.item.desc != "";
        x: 10px;
        y: 30px;
        width: parent.width - 20px;
        text: root.item.desc;
        font-size: 12.5px;
        color: Theme.subtle;
        wrap: word-wrap;
        overflow: elide;
        max-height: 2 * 17px;
    }
}

export struct Crumbs {
    icon: string,
    project: string,
    parent: string,
    title: string,
    branch: string,
    changed: int,
}

component TopBar {
    in property <Crumbs> crumbs;
    in property <bool> sidebar-open;
    in property <bool> team-enabled;
    in property <bool> team-on;
    callback show-sidebar();
    callback close-window();
    callback team();
    callback project-clicked(length, length);
    callback parent-clicked();
    height: 46px;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 6px;
        if !root.sidebar-open: Btn {
            y: 1px;
            icon: Icons.panel-left;
            size: icon-xs;
            variant: ghost-muted;
            tip: "Show sidebar (Ctrl+B)";
            clicked => {
                root.show-sidebar();
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            Rectangle {
                width: min(project.preferred-width + 22px, 280px);
                Glyph {
                    x: 0;
                    width: 14px;
                    icon: root.crumbs.icon;
                    size: 14px;
                    color: Theme.subtle;
                }
                project := Text {
                    x: 22px;
                    width: parent.width - 22px;
                    text: root.crumbs.project;
                    font-size: 14px;
                    color: Theme.subtle;
                    overflow: elide;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.project-clicked(self.absolute-position.x, self.absolute-position.y + self.height);
                    }
                }
            }
            Text {
                text: "/";
                font-size: 14px;
                color: Theme.gray-600;
                vertical-alignment: center;
            }
            if root.crumbs.parent != "": Text {
                max-width: 200px;
                text: root.crumbs.parent;
                font-size: 14px;
                color: Theme.subtle;
                overflow: elide;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.parent-clicked();
                    }
                }
            }
            if root.crumbs.parent != "": Text {
                text: "/";
                font-size: 14px;
                color: Theme.gray-600;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 0;
                min-width: 24px;
                max-width: self.preferred-width;
                text: root.crumbs.title;
                font-size: 14px;
                color: Theme.fg;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.crumbs.branch != "": Glyph {
                width: 13px;
                icon: Icons.branch;
                size: 13px;
                color: Theme.subtle;
            }
            if root.crumbs.branch != "": Text {
                max-width: 160px;
                text: root.crumbs.branch;
                font-family: "Geist Mono";
                font-size: 13px;
                color: Theme.subtle;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.crumbs.branch != "" && root.crumbs.changed > 0: Badge {
                y: 4px;
                text: root.crumbs.changed + " changed";
                tone: amber;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 4px;
            Btn {
                y: 1px;
                icon: Icons.square-menu;
                size: icon-xs;
                variant: ghost-muted;
                enabled: root.team-enabled;
                pressed: root.team-enabled && root.team-on;
                tip: "Team: agents, processes, wake-ups, webhooks (Ctrl+J)";
                clicked => {
                    root.team();
                }
            }
            Btn {
                y: 1px;
                icon: Icons.panel-bottom;
                size: icon-xs;
                variant: ghost-muted;
                enabled: false;
                tip: "Bottom panel: not in the TypeScript app yet";
            }
            Btn {
                y: 1px;
                icon: Icons.panel-right;
                size: icon-xs;
                variant: ghost-muted;
                enabled: false;
                tip: "Right panel: not in the TypeScript app yet";
            }
            Btn {
                y: 1px;
                icon: Icons.x;
                size: icon-xs;
                variant: ghost;
                tip: "Close Harbor";
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}

component Hero {
    in property <string> subtitle;
    in property <bool> subtitle-link;
    in property <string> note;
    callback subtitle-clicked(length, length);
    VerticalLayout {
        spacing: 0px;
        Text {
            text: "What should we work on?";
            font-size: 32px;
            font-weight: 600;
            letter-spacing: -1.28px;
            color: Theme.fg;
            horizontal-alignment: center;
        }
        Rectangle {
            height: 14px;
        }
        HorizontalLayout {
            alignment: center;
            sub := Rectangle {
                width: sub-text.preferred-width;
                height: sub-text.preferred-height + 4px;
                property <color> c: root.subtitle-link && sub-area.has-hover ? Theme.fg : Theme.subtle;
                sub-text := Text {
                    y: 0;
                    text: root.subtitle;
                    font-size: root.subtitle-link ? 15px : 14px;
                    color: sub.c;
                }
                if root.subtitle-link: Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    for i in Math.ceil(sub.width / 6px): Rectangle {
                        x: i * 6px;
                        y: 0;
                        width: min(4px, sub.width - i * 6px);
                        height: 1px;
                        background: sub.c;
                    }
                }
                sub-area := TouchArea {
                    enabled: root.subtitle-link;
                    mouse-cursor: root.subtitle-link ? pointer : default;
                    clicked => {
                        root.subtitle-clicked(self.absolute-position.x, self.absolute-position.y + self.height);
                    }
                }
            }
        }
        if root.note != "": Rectangle {
            height: 10px;
        }
        if root.note != "": Text {
            text: root.note;
            font-size: 13px;
            color: Theme.subtle;
            horizontal-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "Harbor";
    icon: @image-url("");
    preferred-width: 1400px;
    preferred-height: 900px;
    min-width: 480px;
    min-height: 360px;
    background: Theme.bg100;
    default-font-family: "Geist";
    default-font-size: 14px;

    in-out property <bool> dark <=> Theme.dark;
    in-out property <bool> compact <=> Theme.compact;
    in property <string> view: "draft";
    in-out property <bool> sidebar-open: true;
    out property <bool> narrow: root.width < 768px;

    in property <[SideRow]> side-rows;
    in property <[SideRow]> side-settled;
    in property <int> settled-count;
    in-out property <bool> settled-open;
    in-out property <string> search;
    in property <int> running;
    in property <string> side-empty;
    callback open-chat(int);
    callback open-project(int);
    callback new-chat(int);
    callback new-thread();
    callback add-project();
    callback settle(int, bool);
    callback snooze(string, length, length);
    callback chat-menu(int, length, length);
    callback project-menu(int, length, length);
    callback searched(string);
    callback palette();
    callback filter(length, length);
    callback settings();
    callback prs();
    callback issues();
    callback refresh();

    in property <Crumbs> crumbs;
    in property <bool> team-enabled;
    in property <bool> team-on;
    in property <[AgentRow]> team-agents;
    in property <[AgentRow]> team-settled;
    in property <[WakeRow]> team-wakeups;
    in property <[HookRow]> team-hooks;
    in property <[ProcItem]> team-procs;
    in property <[EarlierChat]> team-earlier;
    callback proc-stop(int);
    callback proc-toggle(int);
    callback proc-open(string);
    in property <bool> team-has-project;
    in-out property <bool> team-settled-open;
    callback team();
    callback open-agent(int);
    callback settle-agent(int, bool);
    callback stop-agent(int);
    callback cancel-wakeup(int);
    callback wake-now(int);
    callback copy-hook(string);
    callback delete-hook(int);
    callback team-settled-toggled(bool);
    callback project-clicked(length, length);
    callback parent-clicked();
    callback close-window();

    in property <string> hero-subtitle;
    in property <bool> hero-link;
    in property <string> hero-note;
    in property <bool> hero;
    in property <[CardData]> cards;
    in property <bool> chat-running;
    in property <bool> read-only;
    in property <string> read-only-text;
    in property <string> read-only-action;
    callback read-only-act();
    callback toggle(int);
    callback link(string);
    callback open-url(string);
    callback card-act(int, string);
    callback queue-menu(int, length, length);
    callback open-media(string);

    in-out property <string> draft;
    in property <ComposerState> composer;
    in property <image> model-logo;
    in property <[FileItem]> files;
    in property <[MenuEntry]> menu;
    in property <int> menu-selected;
    out property <int> cursor: composer-el.cursor;
    callback edited(string);
    callback key(KeyEvent) -> bool;
    callback send();
    callback stop();
    callback attach();
    callback mic();
    callback remove-file(int);
    callback menu-pick(int);
    callback menu-hover(int);
    callback popup(string, length, length);

    in property <bool> untrusted;
    callback trust();
    in property <[MentionChip]> mentions;
    callback remove-mention(int);
    in property <[StripRow]> strip-rows;
    in property <string> strip-title;
    in property <string> strip-names;
    in property <bool> strip-header;
    in property <bool> strip-folded;
    in property <bool> strip-open;
    in property <int> strip-asking;
    callback strip-open-agent(int);
    callback strip-ask-stop(int);
    callback strip-stop(int);
    callback strip-cancel();
    callback strip-head();
    callback strip-stop-all();

    in property <string> pop-id;
    in property <[PopItem]> pop-items;
    in property <length> pop-x;
    in property <length> pop-y;
    in property <length> pop-w: 240px;
    in property <bool> pop-above;
    // egui's own context menu (a chat row's right click): at the pointer, as wide as its rows.
    in property <bool> pop-native;
    // egui's item spacing in a popover: 8px, or 0 where the Rust menu sets it (the effort menu).
    in property <length> pop-spacing: 8px;
    callback pop-pick(string, int);
    callback pop-close();
    in-out property <string> pop-input;
    in property <string> pop-input-note;
    in property <bool> pop-input-ok;
    callback pop-input-edited(string);
    callback pop-input-accept();

    in property <[RailItem]> picker-rail;
    in property <bool> picker-favorites;
    in property <[ModelRow]> picker-rows;
    in-out property <int> picker-hover;
    in property <string> picker-more-label;
    in property <int> picker-more-count;
    in property <bool> picker-in-more;
    in property <string> picker-empty;
    in-out property <string> picker-search;
    callback picker-rail-pick(string);
    callback picker-pick(int);
    callback picker-star(int);
    callback picker-more();
    callback picker-back();
    callback picker-searched(string);
    callback picker-key(KeyEvent) -> bool;

    in property <string> dialog-id;
    in property <string> dialog-title;
    in property <string> dialog-text;
    in-out property <string> dialog-input;
    in property <bool> dialog-has-input;
    in property <string> dialog-ok;
    in property <bool> dialog-danger;
    callback dialog-done(string, bool);

    callback global-key(KeyEvent) -> bool;

    public function focus-composer() {
        composer-el.focus-text();
    }
    public function set-cursor(at: int) {
        composer-el.set-cursor(at);
    }
    public function scroll-to-end() {
        transcript.scroll-to-end();
    }
    public function copy-text(t: string) {
        composer-el.copy-text(t);
    }
    out property <bool> at-end: transcript.at-end;

    property <length> content-w: 760px;
    property <bool> docked: root.sidebar-open && !root.narrow;

    keys := FocusScope {
        key-pressed(e) => {
            if root.global-key(e) {
                return accept;
            }
            reject
        }
        Rectangle {
            if root.docked: Sidebar {
                x: 0;
                y: 0;
                width: 256px;
                height: root.height;
                rows: root.side-rows;
                settled: root.side-settled;
                settled-count: root.settled-count;
                settled-open <=> root.settled-open;
                search <=> root.search;
                running: root.running;
                empty-kind: root.side-empty;
                pages-back: root.view == "prs" || root.view == "issues";
                open-chat(id) => {
                    root.open-chat(id);
                }
                open-project(id) => {
                    root.open-project(id);
                }
                new-chat(id) => {
                    root.new-chat(id);
                }
                new-thread => {
                    root.new-thread();
                }
                add-project => {
                    root.add-project();
                }
                settle(id, on) => {
                    root.settle(id, on);
                }
                snooze(k, x, y) => {
                    root.snooze(k, x, y);
                }
                chat-menu(id, x, y) => {
                    root.chat-menu(id, x, y);
                }
                project-menu(id, x, y) => {
                    root.project-menu(id, x, y);
                }
                searched(t) => {
                    root.searched(t);
                }
                hide => {
                    root.sidebar-open = false;
                }
                palette => {
                    root.palette();
                }
                filter(x, y) => {
                    root.filter(x, y);
                }
                settings => {
                    root.settings();
                }
                prs => {
                    root.prs();
                }
                issues => {
                    root.issues();
                }
                back => {
                    root.new-thread();
                }
                refresh => {
                    root.refresh();
                }
            }
            main := VerticalLayout {
                x: root.docked ? 256px : 0px;
                y: 0;
                width: root.width - self.x;
                height: root.height;
                if root.view == "draft" || root.view == "chat": TopBar {
                    crumbs: root.crumbs;
                    sidebar-open: root.docked;
                    team-enabled: root.team-enabled;
                    team-on: root.team-on;
                    show-sidebar => {
                        root.sidebar-open = true;
                    }
                    close-window => {
                        root.close-window();
                    }
                    team => {
                        root.team();
                    }
                    project-clicked(x, y) => {
                        root.project-clicked(x, y);
                    }
                    parent-clicked => {
                        root.parent-clicked();
                    }
                }
                if root.view == "draft" || root.view == "chat": Separator { }
                body := Rectangle {
                    vertical-stretch: 1;
                    // chat.rs: the panel docks while the chat keeps its 440px minimum.
                    property <bool> team-docked: root.view == "chat" && root.team-enabled && root.team-on && self.width - 300px >= 440px;
                    property <length> room: self.width - (team-docked ? 300px : 0px);
                    property <length> side: max((room - root.content-w) / 2, room < 520px ? 12px : 24px);
                    property <length> column: max(0px, room - 2 * side);
                    property <bool> centred: root.view == "draft" || root.hero;
                    // chat.rs: (h/2 - 170 - growth) with the text area's 220px of room to grow.
                    property <length> hero-top: max(self.height * 0.5 - 390px, 24px) + 22px;
                    if body.team-docked: TeamPanel {
                        x: body.room;
                        y: 9px;
                        width: 300px;
                        height: parent.height - 9px;
                        agents: root.team-agents;
                        settled: root.team-settled;
                        wakeups: root.team-wakeups;
                        hooks: root.team-hooks;
                        procs: root.team-procs;
                        earlier: root.team-earlier;
                        open-chat(id) => {
                            root.open-chat(id);
                        }
                        proc-stop(id) => {
                            root.proc-stop(id);
                        }
                        proc-toggle(id) => {
                            root.proc-toggle(id);
                        }
                        proc-open(u) => {
                            root.proc-open(u);
                        }
                        has-project: root.team-has-project;
                        settled-open <=> root.team-settled-open;
                        open-agent(id) => {
                            root.open-agent(id);
                        }
                        settle-agent(id, on) => {
                            root.settle-agent(id, on);
                        }
                        stop-agent(id) => {
                            root.stop-agent(id);
                        }
                        cancel-wakeup(id) => {
                            root.cancel-wakeup(id);
                        }
                        wake-now(id) => {
                            root.wake-now(id);
                        }
                        copy-hook(u) => {
                            root.copy-hook(u);
                        }
                        delete-hook(id) => {
                            root.delete-hook(id);
                        }
                        settled-toggled(on) => {
                            root.team-settled-toggled(on);
                        }
                    }
                    transcript := Transcript {
                        visible: root.view == "chat" && !root.hero;
                        x: 0;
                        y: 0;
                        width: body.room;
                        height: parent.height - composer-box.height;
                        cards: root.cards;
                        running: root.chat-running;
                        content-w: root.content-w;
                        toggle(seq) => {
                            root.toggle(seq);
                        }
                        link(u) => {
                            root.link(u);
                        }
                        open-url(u) => {
                            root.open-url(u);
                        }
                        act(seq, a) => {
                            root.card-act(seq, a);
                        }
                        queue-menu(seq, x, y) => {
                            root.queue-menu(seq, x, y);
                        }
                        open-media(p) => {
                            root.open-media(p);
                        }
                        copy-text(t) => {
                            root.copy-text(t);
                        }
                    }
                    if body.centred: Hero {
                        x: body.side;
                        y: body.hero-top;
                        width: body.column;
                        subtitle: root.hero-subtitle;
                        subtitle-link: root.hero-link;
                        note: root.hero-note;
                        subtitle-clicked(x, y) => {
                            root.project-clicked(x, y);
                        }
                    }
                    composer-box := VerticalLayout {
                        x: body.side;
                        y: body.centred ? floor((body.hero-top + 106px + (root.hero-note != "" ? 28px : 0px)) / 1px) * 1px : parent.height - self.height;
                        width: body.column;
                        height: self.preferred-height;
                        padding-top: body.centred ? 0px : 8px;
                        padding-bottom: body.centred ? 0px : 16px;
                        visible: root.view == "draft" || root.view == "chat";
                        if root.read-only: Rectangle {
                            background: Theme.bg200;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: 16px;
                            HorizontalLayout {
                                padding: 16px;
                                spacing: 12px;
                                // A 32px row in egui, and its frame's stroke drawn outside it.
                                Text {
                                    min-height: 34px;
                                    horizontal-stretch: 1;
                                    text: root.read-only-text;
                                    font-size: 14px;
                                    color: Theme.subtle;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }
                                if root.read-only-action != "": VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        icon: Icons.compose;
                                        text: root.read-only-action;
                                        size: xs;
                                        variant: primary;
                                        clicked => {
                                            root.read-only-act();
                                        }
                                    }
                                }
                            }
                        }
                        composer-el := Composer {
                            visible: !root.read-only;
                            height: root.read-only ? 0px : self.preferred-height;
                            text <=> root.draft;
                            state: root.composer;
                            logo: root.model-logo;
                            files: root.files;
                            menu: root.menu;
                            menu-selected: root.menu-selected;
                            open-popup: root.pop-id;
                            max-h: min(14 * 20px, root.height * 0.45);
                            compact: body.column - 32px < 560px;
                            tiny: body.column - 32px < 460px;
                            edited(t) => {
                                root.edited(t);
                            }
                            key(e) => {
                                return root.key(e);
                            }
                            send => {
                                root.send();
                            }
                            stop => {
                                root.stop();
                            }
                            attach => {
                                root.attach();
                            }
                            mic => {
                                root.mic();
                            }
                            remove-file(i) => {
                                root.remove-file(i);
                            }
                            menu-pick(i) => {
                                root.menu-pick(i);
                            }
                            menu-hover(i) => {
                                root.menu-hover(i);
                            }
                            popup(id, x, y) => {
                                root.popup(id, x, y);
                            }
                            untrusted: root.untrusted;
                            mentions: root.mentions;
                            remove-mention(i) => {
                                root.remove-mention(i);
                            }
                            trust => {
                                root.trust();
                            }
                            strip-rows: root.strip-rows;
                            strip-title: root.strip-title;
                            strip-names: root.strip-names;
                            strip-header: root.strip-header;
                            strip-folded: root.strip-folded;
                            strip-open: root.strip-open;
                            strip-asking: root.strip-asking;
                            strip-open-agent(id) => {
                                root.strip-open-agent(id);
                            }
                            strip-ask-stop(id) => {
                                root.strip-ask-stop(id);
                            }
                            strip-stop(id) => {
                                root.strip-stop(id);
                            }
                            strip-cancel => {
                                root.strip-cancel();
                            }
                            strip-head => {
                                root.strip-head();
                            }
                            strip-stop-all => {
                                root.strip-stop-all();
                            }
                        }
                    }
                }
            }
        }
    }

    if root.pop-id == "model": TouchArea {
        clicked => {
            root.pop-close();
        }
        picker := ModelPicker {
            x: max(4px, min(root.pop-x, root.width - self.width - 4px));
            y: max(0px, root.pop-y - self.height - 6px);
            rail: root.picker-rail;
            favorites-active: root.picker-favorites;
            rows: root.picker-rows;
            hover <=> root.picker-hover;
            more-label: root.picker-more-label;
            more-count: root.picker-more-count;
            in-more: root.picker-in-more;
            empty: root.picker-empty;
            search <=> root.picker-search;
            init => {
                self.focus-search();
            }
            rail-pick(id) => {
                root.picker-rail-pick(id);
            }
            pick(i) => {
                root.picker-pick(i);
            }
            star(i) => {
                root.picker-star(i);
            }
            more => {
                root.picker-more();
            }
            back => {
                root.picker-back();
            }
            searched(t) => {
                root.picker-searched(t);
            }
            key(e) => {
                return root.picker-key(e);
            }
        }
    }

    if root.pop-id != "" && root.pop-id != "model": TouchArea {
        clicked => {
            root.pop-close();
        }
        pop := PopoverFrame {
            x: max(4px, min(root.pop-x, root.width - self.width - 4px));
            // widgets.rs `popover`: `pop-w` of content, 4px margins and the stroke outside; kept inside the window.
            y: root.pop-native ? min(root.pop-y, root.height - self.height - 4px) : root.pop-above ? max(0px, root.pop-y - self.height - 6px) : min(root.pop-y + 6px, root.height - self.height);
            width: root.pop-native ? pop-list.preferred-width + 10px : root.pop-w + 10px;
            height: min(pop-list.preferred-height + (root.pop-native ? 2px : 10px), root.height);
            TouchArea { }
            Flickable {
                x: root.pop-native ? 4px : 5px;
                y: root.pop-native ? 4px : 5px;
                width: parent.width - 2 * self.x;
                height: parent.height - 2 * self.y;
                pop-list := VerticalLayout {
                    alignment: start;
                    spacing: root.pop-native ? 0px : root.pop-spacing;
                    for it[i] in root.pop-items: VerticalLayout {
                        if it.kind == "label": MenuLabel {
                            text: it.label;
                        }
                        // widgets.rs `subtle(ui, "  Access", "label-12")`: a 12px line over a popover's rows.
                        if it.kind == "caption": Text {
                            height: 16px;
                            x: 7px;
                            text: it.label;
                            font-size: 12px;
                            color: Theme.subtle;
                            vertical-alignment: center;
                        }
                        if it.kind == "separator" && !root.pop-native && root.pop-spacing == 0px: MenuSeparator { }
                        if it.kind == "separator" && !root.pop-native && root.pop-spacing > 0px: Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                        // egui's menu separator: 6px between rows that keep their 8px gap.
                        if it.kind == "separator" && root.pop-native: Rectangle {
                            height: 14px;
                                Rectangle {
                                y: 4px;
                                height: 1px;
                                background: Theme.border;
                            }
                        }
                        if it.kind == "header": Text {
                            height: 26px;
                            x: 10px;
                            text: it.label;
                            font-size: 12.5px;
                            color: Theme.subtle;
                            vertical-alignment: center;
                        }
                        if it.kind == "gap": Rectangle {
                            height: 6px;
                        }
                        if it.kind == "rule": Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                        if it.kind == "input": VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 4px;
                                Input {
                                    hint: it.label;
                                    text <=> root.pop-input;
                                    edited(t) => {
                                        root.pop-input-edited(t);
                                    }
                                    accepted => {
                                        root.pop-input-accept();
                                    }
                                }
                                Btn {
                                    icon: Icons.check;
                                    size: icon;
                                    variant: ghost-muted;
                                    enabled: root.pop-input-ok;
                                    tip: it.desc;
                                    clicked => {
                                        root.pop-input-accept();
                                    }
                                }
                            }
                            if root.pop-input-note != "": Text {
                                x: 8px;
                                text: root.pop-input-note;
                                font-size: 12px;
                                color: Theme.subtle;
                            }
                        }
                        if it.kind == "choice": ChoiceRow {
                            item: it;
                            clicked => {
                                root.pop-pick(root.pop-id, i);
                            }
                        }
                        // An egui menu button: 32px, 8px apart; `badge` "submenu" draws its arrow, `desc` is its tip.
                        if it.kind == "native": Rectangle {
                            height: 40px;
                            min-width: native-label.preferred-width + (it.icon != "" ? 20px : 0px) + (it.badge == "submenu" ? 25px : 4px);
                            Rectangle {
                                y: 0;
                                height: 32px;
                                border-radius: 4px;
                                background: native-area.has-hover && it.enabled ? Theme.accent : transparent;
                                if it.icon != "": Glyph {
                                    x: 3px;
                                    width: 14px;
                                    icon: it.icon;
                                    size: 14px;
                                    color: native-label.color;
                                }
                                native-label := Text {
                                    x: it.icon != "" ? 23px : 3px;
                                    text: it.label;
                                    font-size: 14px;
                                    color: it.enabled ? Theme.fg : Theme.gray-700;
                                    vertical-alignment: center;
                                }
                                if it.badge == "submenu": Path {
                                    x: parent.width - 13px;
                                    y: 12.5px;
                                    width: 7px;
                                    height: 7px;
                                    viewbox-width: 7;
                                    viewbox-height: 7;
                                    commands: "M 0 0 L 7 3.5 L 0 7 Z";
                                    fill: native-label.color;
                                }
                                native-area := TipArea {
                                    tip: it.desc;
                                    clicked => {
                                        if it.enabled {
                                            root.pop-pick(root.pop-id, i);
                                        }
                                    }
                                }
                            }
                        }
                        if it.kind == "item": MenuItem {
                            icon: it.icon;
                            label: it.label;
                            desc: it.desc;
                            checked: it.checked;
                            enabled: it.enabled;
                            clicked => {
                                root.pop-pick(root.pop-id, i);
                            }
                        }
                    }
                }
            }
        }
    }

    if root.dialog-id != "": Rectangle {
        background: black.with-alpha(0.5);
        TouchArea { }
        Rectangle {
            width: min(440px, root.width - 32px);
            height: dialog-body.preferred-height;
            background: Theme.bg100;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-xl;
            drop-shadow-offset-y: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: black.with-alpha(Theme.dark ? 56 / 255 : 20 / 255);
            dialog-body := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: root.dialog-title;
                    font-size: 16px;
                    font-weight: 600;
                    letter-spacing: -0.32px;
                    color: Theme.fg;
                }
                if root.dialog-text != "": Text {
                    text: root.dialog-text;
                    font-size: 14px;
                    color: Theme.subtle;
                    wrap: word-wrap;
                }
                if root.dialog-has-input: dialog-field := Input {
                    text <=> root.dialog-input;
                    accepted => {
                        root.dialog-done(root.dialog-id, true);
                    }
                    init => {
                        self.focus-field();
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Btn {
                        text: "Cancel";
                        clicked => {
                            root.dialog-done(root.dialog-id, false);
                        }
                    }
                    Btn {
                        text: root.dialog-ok;
                        variant: root.dialog-danger ? destructive : primary;
                        clicked => {
                            root.dialog-done(root.dialog-id, true);
                        }
                    }
                }
            }
        }
    }

    TipLayer {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        window-width: root.width;
    }
}
