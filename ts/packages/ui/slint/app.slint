            }
            browser-key(t, d, c, sh, a, m) => {
                root.browser-key("right", t, d, c, sh, a, m);
            }
            term-resized(w, h) => {
                root.term-resized("right", w, h, self.cell-w, self.cell-h);
            }
        }
        if root.bottom-open && root.pane-max == "": Rectangle {
            x: root.left-edge;
            y: root.height - root.bottom-shown;
            width: root.width - root.left-edge - root.right-shown;
            height: 1px;
            background: Theme.border;
        }
        if root.bottom-open && root.pane-max == "": TouchArea {
            x: root.left-edge;
            y: root.height - root.bottom-shown - 3px;
            width: root.width - root.left-edge - root.right-shown;
