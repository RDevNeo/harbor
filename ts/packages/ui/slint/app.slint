                    }
                    chat-menu(id, x, y) => {
                        root.chat-menu(id, x, y);
                    }
                    project-menu(id, x, y) => {
                        root.project-menu(id, x, y);
                    }
                    searched(t) => {
                        root.searched(t);
                    }
                    hide => {
                        root.sidebar-open = false;
                    }
                    palette => {
                        root.palette();
                    }
                    filter(x, y) => {
                        root.filter(x, y);
                    }
                    usage(x, y) => {
                        root.usage(x, y);
                    }
                    ws-filter(x, y) => {
                        root.ws-filter(x, y);
                    }
                    ws-all => {
                        root.ws-all();
                    }
                    reorder(id, target, above) => {
                        root.reorder(id, target, above);
                    }
                    settings => {
                        root.settings();
                    }
                    prs => {
                        root.prs();
                    }
                    issues => {
                        root.issues();
                    }
                    back => {
                        root.leave-page();
                    }
                    refresh => {
                        root.refresh();
                    }
                }
                main := VerticalLayout {
                    x: root.left-edge;
                    y: 0;
                    width: root.width - self.x - root.right-shown;
                    height: root.height - root.bottom-shown;
                    if root.view == "draft" || root.view == "chat": TopBar {
                        crumbs: root.crumbs;
                        sidebar-open: root.docked;
                        team-enabled: root.team-enabled;
                        team-on: root.team-on;
                        right-on: root.right-open;
                        bottom-on: root.bottom-open;
                        pane(d) => {
                            root.pane-toggle(d);
                        }
                        show-sidebar => {
                            root.sidebar-open = true;
                        }
                        close-window => {
                            root.close-window();
                        }
                        team => {
                            root.team();
                        }
                        project-clicked(x, y) => {
                            root.project-clicked(x, y);
                        }
                        parent-clicked => {
                            root.parent-clicked();
                        }
                    }
                    if root.view == "draft" || root.view == "chat": Separator { }
                    body := Rectangle {
                        vertical-stretch: 1;
                        // chat.rs: the panel docks while the chat keeps its 440px minimum.
                        property <bool> team-docked: root.view == "chat" && root.team-enabled && root.team-on && self.width - 300px >= 440px;
                        property <length> room: self.width - (team-docked ? 300px : 0px);
                        property <length> side: max((room - root.content-w) / 2, room < 520px ? 12px : 24px);
                        property <length> column: max(0px, room - 2 * side);
                        property <bool> centred: root.view == "draft" || root.hero;
                        // chat.rs: (h/2 - 170 - growth), clamped at 24px; fitted to the Rust app at 853 and 553px.
                        property <length> hero-top: max(self.height * 0.5 - 375px, 24px) + 7px;
                        if body.team-docked: TeamPanel {
                            x: body.room;
                            y: 9px;
                            width: 300px;
                            height: parent.height - 9px;
                            agents: root.team-agents;
                            settled: root.team-settled;
                            wakeups: root.team-wakeups;
                            hooks: root.team-hooks;
                            procs: root.team-procs;
                            earlier: root.team-earlier;
                            open-chat(id) => {
