                                strip-title: root.strip-title;
                                strip-names: root.strip-names;
                                strip-header: root.strip-header;
                                strip-folded: root.strip-folded;
                                strip-open: root.strip-open;
                                strip-asking: root.strip-asking;
                                strip-open-agent(id) => {
                                    root.strip-open-agent(id);
                                }
                                strip-ask-stop(id) => {
                                    root.strip-ask-stop(id);
                                }
                                strip-stop(id) => {
                                    root.strip-stop(id);
                                }
                                strip-cancel => {
                                    root.strip-cancel();
                                }
                                strip-head => {
                                    root.strip-head();
                                }
                                strip-stop-all => {
                                    root.strip-stop-all();
                                }
                            }
                        }
                    }
                }
                if root.view == "settings": Rectangle {
                    x: 0;
                    y: 0;
                    width: root.width;
                    height: root.height;
                    background: Theme.bg100;
                    init => {
                        keys.focus();
                    }
                    TouchArea { }
                    SettingsPage {
                        width: parent.width;
                        height: parent.height;
                    }
                }
                if root.view == "prs": Rectangle {
                    x: root.docked ? 256px : 0px;
                    y: 0;
                    width: root.width - self.x;
                    height: root.height;
                    background: Theme.bg100;
                    init => {
                        keys.focus();
                    }
                    TouchArea { }
                    PrsPage {
                        width: parent.width;
                        height: parent.height;
                    }
                    if !root.docked: Btn {
                        x: 10px;
                        y: 10px;
                        icon: Icons.panel-left;
                        size: icon-xs;
                        variant: ghost-muted;
                        tip: "Show sidebar (Ctrl+B)";
                        clicked => {
                            root.sidebar-open = true;
                        }
                    }
                }
                if root.view == "issues": Rectangle {
                    x: root.docked ? 256px : 0px;
                    y: 0;
                    width: root.width - self.x;
                    height: root.height;
                    background: Theme.bg100;
                    TouchArea { }
                    IssuesPage {
                        width: parent.width;
                        height: parent.height;
                    }
                    if !root.docked: Btn {
                        x: 10px;
                        y: 10px;
                        icon: Icons.panel-left;
                        size: icon-xs;
                        variant: ghost-muted;
                        tip: "Show sidebar (Ctrl+B)";
                        clicked => {
                            root.sidebar-open = true;
                        }
                    }
                }
            }
        }

        if root.right-open && root.pane-max == "": Rectangle {
            x: root.width - root.right-shown;
            y: 0;
            width: 1px;
            height: root.height;
            background: Theme.border;
        }
        if root.right-open && root.pane-max == "": TouchArea {
            x: root.width - root.right-shown - 3px;
            y: 0;
            width: 6px;
            height: root.height;
