import { Theme } from "theme.slint";
import { Icons } from "icons.slint";

export global Ui {
    // `a` moved `t` of the way to `b` (widgets.rs `mix`); Slint's own `mix` weighs the other way.
    public pure function mix(a: color, b: color, t: float) -> color {
        return a.mix(b, 1 - t);
    }
    // The tooltip under the pointer, drawn by the window's one `TipLayer`.
    in-out property <string> tip;
    in-out property <length> tip-x;
    in-out property <length> tip-y;
    in-out property <length> tip-below;
}

export enum Variant { primary, secondary, outline, ghost, ghost-muted, destructive, ghost-destructive, stop }

export enum BtnSize { normal, sm, xs, icon, icon-sm, icon-xs }

export enum Tone { gray, blue, green, amber, red, muted, blue-solid, green-solid, amber-solid, red-solid }

export component Glyph inherits Text {
    in property <string> icon;
    in property <length> size: 16px;
    text: icon;
    font-family: "lucide";
    font-size: size;
    horizontal-alignment: center;
    vertical-alignment: center;
}

export component TipArea inherits TouchArea {
    in property <string> tip;
    mouse-cursor: pointer;
    timer := Timer {
        interval: 600ms;
        running: root.has-hover && root.tip != "" && !root.pressed;
        triggered => {
            Ui.tip = root.tip;
            Ui.tip-x = root.absolute-position.x + root.width / 2;
            Ui.tip-y = root.absolute-position.y;
            Ui.tip-below = root.absolute-position.y + root.height;
            self.running = false;
        }
    }
    changed has-hover => {
        if !self.has-hover && Ui.tip == root.tip {
            Ui.tip = "";
        }
    }
    changed pressed => {
        Ui.tip = "";
    }
}

// Goes last in the window, over everything.
export component TipLayer {
    in property <length> window-width;
    property <length> w: min(measure.preferred-width, 280px) + 16px;
    property <bool> above: Ui.tip-y > 40px;
    measure := Text {
        visible: false;
        text: Ui.tip;
        font-size: 12px;
    }
    Rectangle {
        visible: Ui.tip != "";
        x: max(4px, min(Ui.tip-x - root.w / 2, root.window-width - root.w - 4px));
        y: root.above ? Ui.tip-y - self.height - 6px : Ui.tip-below + 6px;
        width: root.w;
        height: label.preferred-height + 6px;
        background: Theme.gray-1000;
        border-radius: Theme.radius-md;
        label := Text {
            x: 8px;
            width: root.w - 16px;
            text: Ui.tip;
            wrap: word-wrap;
            font-size: 12px;
            color: Theme.bg100;
            vertical-alignment: center;
        }
    }
}

export component Btn {
    in property <string> text;
    in property <string> icon;
    in property <string> trailing;
    in property <Variant> variant: outline;
    in property <BtnSize> size: normal;
    in property <bool> enabled: true;
    in property <bool> pressed;
    in property <string> tip;
    in property <bool> full-width;
    out property <bool> hovered: area.has-hover;
    callback clicked;
    property <bool> square: size == BtnSize.icon || size == BtnSize.icon-sm || size == BtnSize.icon-xs;
    property <length> h: size == BtnSize.normal || size == BtnSize.icon ? 36px : size == BtnSize.sm || size == BtnSize.icon-sm ? 32px : 28px;
    property <length> pad: size == BtnSize.normal ? 16px : size == BtnSize.sm ? 12px : size == BtnSize.xs ? 10px : 0px;
    property <length> font: size == BtnSize.xs ? 12px : 14px;
    property <length> glyph: square ? (size == BtnSize.icon-xs ? 14px : 16px) : font;
    property <bool> hover: enabled && area.has-hover;
    property <bool> down: enabled && area.pressed;
    property <color> outline-rest: Theme.dark ? Ui.mix(Theme.bg100, Theme.border, 0.3) : Theme.bg100;
    property <color> outline-on: Theme.dark ? Ui.mix(Theme.bg100, Theme.border, 0.5) : Theme.accent;
    property <color> destructive-base: Theme.dark ? Theme.destructive.with-alpha(0.6) : Theme.destructive;
    property <color> fill: variant == Variant.primary ? (hover ? Ui.mix(Theme.primary, Theme.bg100, 0.10) : Theme.primary)
        : variant == Variant.secondary ? (down ? Theme.gray-300 : hover ? Theme.gray-200 : Theme.gray-100)
        : variant == Variant.outline ? (hover || pressed ? outline-on : outline-rest)
        : variant == Variant.ghost || variant == Variant.ghost-muted ? (hover || pressed ? Theme.accent : transparent)
        : variant == Variant.destructive ? (hover ? destructive-base.with-alpha(destructive-base.alpha / 255 * 0.9) : destructive-base)
        : variant == Variant.stop ? (down ? Ui.mix(Theme.destructive, black, 0.25) : hover ? Ui.mix(Theme.destructive, black, 0.12) : Theme.destructive)
        : (hover ? Theme.destructive.with-alpha(Theme.dark ? 0.2 : 0.1) : transparent);
    property <color> fg: variant == Variant.primary ? Theme.on-primary
        : variant == Variant.ghost-muted ? (hover ? Theme.fg : Theme.subtle)
        : variant == Variant.destructive || variant == Variant.stop ? white
        : variant == Variant.ghost-destructive ? Theme.red-900
        : Theme.fg;
    height: h;
    min-width: square ? h : row.preferred-width + 2 * pad;
    max-width: square ? h : full-width ? 100000px : row.preferred-width + 2 * pad;
    preferred-width: square ? h : row.preferred-width + 2 * pad;
    horizontal-stretch: full-width ? 1 : 0;
    opacity: enabled ? 1 : 0.5;
    Rectangle {
        background: root.fill;
        border-radius: Theme.radius-md;
        border-width: root.variant == Variant.outline ? 1px : 0px;
        border-color: Theme.border;
    }
    row := HorizontalLayout {
        alignment: center;
        spacing: (root.icon != "" || root.trailing != "") && root.text != "" ? 6px : 0px;
        if root.icon != "": Glyph {
            icon: root.icon;
            size: root.glyph;
            color: root.fg;
        }
        if root.text != "": Text {
            text: root.text;
            font-size: root.font;
            font-weight: 500;
            color: root.fg;
            vertical-alignment: center;
        }
        if root.trailing != "": Glyph {
            icon: root.trailing;
            size: root.glyph;
            color: root.fg;
        }
    }
    area := TipArea {
        enabled: root.enabled;
        tip: root.tip;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

export component RoundButton {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked;
    width: 34px;
    height: 34px;
    Rectangle {
        border-radius: 17px;
        background: (root.enabled && area.has-hover ? Ui.mix(Theme.primary, Theme.bg100, 0.12) : Theme.primary).with-alpha(root.enabled ? 1 : 0.4);
    }
    Glyph {
        icon: root.icon;
        size: 16px;
        color: Theme.on-primary.with-alpha(root.enabled ? 1 : 0.8);
    }
    area := TipArea {
        enabled: root.enabled;
        tip: root.tip;
        clicked => {
            root.clicked();
        }
    }
}

export component StopButton {
    in property <string> tip;
    callback clicked;
    width: 34px;
    height: 34px;
    Rectangle {
        border-radius: 17px;
        background: area.pressed ? Ui.mix(Theme.destructive, black, 0.25) : area.has-hover ? Ui.mix(Theme.destructive, black, 0.12) : Theme.destructive;
    }
    Glyph {
        icon: Icons.stop;
        size: 16px;
        color: white;
    }
    area := TipArea {
        tip: root.tip;
        clicked => {
            root.clicked();
        }
    }
}

export component MenuRow {
    in property <bool> active;
    in property <string> icon;
    in property <string> label;
    in property <string> right;
    in property <color> right-color: Theme.subtle;
    callback clicked;
    height: Theme.row-h;
    Rectangle {
        background: root.active || area.has-hover ? Theme.accent : transparent;
        border-radius: Theme.radius-md;
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        if root.icon != "": Glyph {
            width: 16px;
            icon: root.icon;
            size: 14px;
            color: root.active ? Theme.fg : Theme.subtle;
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            font-size: 14px;
            font-weight: root.active ? 500 : 400;
            color: Theme.fg;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.right != "": Text {
            text: root.right;
            font-family: "Geist Mono";
            font-size: 12px;
            color: root.right-color;
            vertical-alignment: center;
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Steps every 500 ms, not every frame, like the Rust app's spinner.
// widgets.rs `spinner`: 8 dashes on a ring of `radius`, a 15° step every 500ms.
// While turns run, the window steps every spinner at once, so they draw in the same frames.
export global Spin {
    in-out property <bool> driven;
    in-out property <int> tick;
}

export component Spinner {
    in property <color> color: Theme.subtle;
    in property <length> radius: 5px;
    width: radius * 2.4;
    height: radius * 2.4;
    property <int> own;
    property <int> tick: Spin.driven ? Spin.tick : own;
    Timer {
        interval: 500ms;
        running: !Spin.driven;
        triggered => {
            root.own = Math.mod(root.own + 1, 24);
        }
    }
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.color;
        stroke-width: 1.5px;
        commands: "M 22.00 12.00 A 10 10 0 0 1 21.08 16.19 M 19.07 19.07 A 10 10 0 0 1 15.46 21.38 M 12.00 22.00 A 10 10 0 0 1 7.81 21.08 M 4.93 19.07 A 10 10 0 0 1 2.62 15.46 M 2.00 12.00 A 10 10 0 0 1 2.92 7.81 M 4.93 4.93 A 10 10 0 0 1 8.54 2.62 M 12.00 2.00 A 10 10 0 0 1 16.19 2.92 M 19.07 4.93 A 10 10 0 0 1 21.38 8.54";
        transform-rotation: root.tick * 15deg;
    }
}

export struct StatusData {
    kind: string,
    text: string,
    icon: string,
    color: color,
}

export component StatusView {
    in property <StatusData> status;
    property <color> shade: status.kind == "working" ? Theme.blue-900 : status.kind == "done" ? Theme.green-900 : status.kind == "failed" ? Theme.red-900 : status.color;
    property <string> label: status.kind == "working" ? "Working " + status.text : status.kind == "failed" ? "Failed" : status.text;
    HorizontalLayout {
        alignment: end;
        spacing: 6px;
        if root.status.kind == "done": Rectangle {
            width: 10px;
            Rectangle {
                x: 2px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.blue-700;
            }
        }
        // widgets.rs: in a 13px icon box, radius 13/2 - 0.5 (egui's feathered stroke reads half a pixel wider).
        if root.status.kind == "working": Rectangle {
            width: 13px;
            Spinner {
                radius: 6.5px;
                color: root.shade;
            }
        }
        if root.status.kind == "failed": Glyph {
            icon: Icons.circle-x;
            size: 13px;
            color: root.shade;
        }
        if root.status.kind == "text" && root.status.icon != "": Glyph {
            icon: root.status.icon;
            size: 13px;
            color: root.shade;
        }
        if root.status.kind != "done" && root.label != "": Text {
            text: root.label;
            font-size: 12.5px;
            color: root.shade;
            vertical-alignment: center;
        }
    }
}

export component Card inherits Rectangle {
    background: Theme.bg100;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-lg;
}

export component Well inherits Rectangle {
    background: Theme.bg200;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-lg;
}

export component Badge {
    in property <string> text;
    in property <Tone> tone: gray;
    property <color> bg: tone == Tone.gray ? Theme.gray-200 : tone == Tone.blue ? Theme.blue-200 : tone == Tone.green ? Theme.green-200
        : tone == Tone.amber ? Theme.amber-200 : tone == Tone.red ? Theme.red-200 : tone == Tone.muted ? Theme.gray-100
        : tone == Tone.blue-solid ? Theme.blue-800 : tone == Tone.green-solid ? Theme.green-800 : tone == Tone.amber-solid ? Theme.amber-800 : Theme.red-800;
    property <color> line: tone == Tone.gray ? Theme.gray-400 : tone == Tone.blue ? Theme.blue-400 : tone == Tone.green ? Theme.green-400
        : tone == Tone.amber ? Theme.amber-400 : tone == Tone.red ? Theme.red-400 : transparent;
    property <color> fg: tone == Tone.gray ? Theme.gray-1000 : tone == Tone.blue ? Theme.blue-900 : tone == Tone.green ? Theme.green-900
        : tone == Tone.amber ? Theme.amber-900 : tone == Tone.red ? Theme.red-900 : tone == Tone.muted ? Theme.gray-900
        : tone == Tone.amber-solid ? (Theme.dark ? Theme.bg100 : Theme.gray-1000) : white;
    height: 22px;
    width: label.preferred-width + 18px;
    Rectangle {
        background: root.bg;
        border-width: 1px;
        border-color: root.line;
        border-radius: 11px;
    }
    label := Text {
        text: root.text;
        font-size: 12px;
        font-weight: 500;
        color: root.fg;
    }
}

export component Dot {
    in property <color> color;
    width: 10px;
    height: 10px;
    Rectangle {
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: root.color;
    }
}

export component Separator inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component VSep {
    in property <length> h: 18px;
    width: 9px;
    height: h;
    Rectangle {
        width: 1px;
        background: Theme.gray-500;
    }
}

export component FocusRing inherits Rectangle {
    in property <length> radius: Theme.radius-md;
    border-width: 3px;
    border-color: Theme.gray-1000.with-alpha(0.5);
    border-radius: radius + 2px + 3px;
}

export component Input {
    in-out property <string> text <=> field.text;
    in property <string> hint;
    in property <bool> mono;
    in property <bool> password;
    out property <bool> focused: field.has-focus;
    callback accepted(string);
    callback edited(string);
    public function focus-field() {
        field.focus();
    }
    height: 36px;
    Rectangle {
        background: Theme.bg100;
        border-width: 1px;
        border-color: field.has-focus ? Theme.gray-1000 : Theme.border;
        border-radius: Theme.radius-md;
    }
    if field.has-focus: FocusRing {
        x: -4.5px;
        y: -4.5px;
        width: root.width + 9px;
        height: root.height + 9px;
    }
    if field.text == "": Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.hint;
        font-size: root.mono ? 13px : 14px;
        font-family: "Geist";
        color: Theme.gray-900;
        vertical-alignment: center;
        overflow: elide;
    }
    field := TextInput {
        x: 12px;
        width: parent.width - 24px;
        font-size: root.mono ? 13px : 14px;
        font-family: root.mono ? "Geist Mono" : "Geist";
        color: Theme.fg;
        vertical-alignment: center;
        single-line: true;
        input-type: root.password ? InputType.password : InputType.text;
        selection-background-color: Theme.dark ? Theme.blue-500 : Theme.blue-400;
        selection-foreground-color: Theme.fg;
        accepted => {
            root.accepted(self.text);
        }
        edited => {
            root.edited(self.text);
        }
    }
}

export component SearchField {
    in-out property <string> text <=> field.text;
    out property <bool> focused: field.has-focus;
    in property <string> hint: "Search";
    callback edited(string);
    callback key(KeyEvent) -> EventResult;
    public function focus-field() {
        field.focus();
    }
    height: 32px;
    Glyph {
        x: 3px;
        width: 16px;
        icon: Icons.search;
        size: 16px;
        color: Theme.subtle;
    }
    if field.text == "": Text {
        x: 26px;
        text: root.hint;
        font-size: 14px;
        color: Theme.subtle;
        vertical-alignment: center;
    }
    FocusScope {
        x: 0;
        width: parent.width;
        capture-key-pressed(e) => {
            return root.key(e);
        }
        field := TextInput {
            x: 26px;
            width: parent.width - 30px;
            font-size: 14px;
            color: Theme.fg;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: Theme.dark ? Theme.blue-500 : Theme.blue-400;
            selection-foreground-color: Theme.fg;
            edited => {
                root.edited(self.text);
            }
        }
    }
}

export component PopoverFrame inherits Rectangle {
    background: Theme.bg100;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-lg;
    drop-shadow-offset-y: 8px;
    drop-shadow-blur: 20px;
    drop-shadow-color: black.with-alpha(Theme.dark ? 40 / 255 : 16 / 255);
}

export component MenuLabel {
    in property <string> text;
    height: 28px;
    Text {
        x: 8px;
        text: root.text;
        font-size: 12px;
        color: Theme.subtle;
        vertical-alignment: center;
    }
}

export component MenuSeparator {
    height: 9px;
    Rectangle {
        x: -4px;
        width: parent.width + 8px;
        height: 1px;
        background: Theme.border;
    }
}

export component MenuItem {
    in property <string> icon;
    in property <string> label;
    in property <string> desc;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked;
    height: (desc != "" ? 44px : 32px) - (Theme.compact ? 4px : 0px);
    opacity: enabled ? 1 : 0.5;
    Rectangle {
        background: area.has-hover && root.enabled ? Theme.accent : transparent;
        border-radius: 4px;
    }
    if root.icon != "": Glyph {
        x: 8px;
        y: 8px - (Theme.compact ? 2px : 0px);
        width: 16px;
        height: 16px;
        icon: root.icon;
        size: 16px;
        color: Theme.subtle;
    }
    Text {
        x: root.icon != "" ? 32px : 8px;
        y: 7px - (Theme.compact ? 2px : 0px);
        width: parent.width - self.x - (root.checked ? 32px : 8px);
        text: root.label;
        font-size: 14px;
        color: Theme.fg;
        overflow: elide;
    }
    if root.desc != "": Text {
        x: root.icon != "" ? 32px : 8px;
        y: 25px - (Theme.compact ? 2px : 0px);
        width: parent.width - self.x - 8px;
        text: root.desc;
        font-size: 12px;
        color: Theme.subtle;
        overflow: elide;
    }
    if root.checked: Glyph {
        x: parent.width - 24px;
        y: 8px - (Theme.compact ? 2px : 0px);
        width: 16px;
        height: 16px;
        icon: Icons.check;
        size: 16px;
        color: Theme.fg;
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component AccountMark {
    in property <image> logo;
    in property <string> badge;
    in property <color> tint: transparent;
    Image {
        x: parent.width * 0.12 - 1.5px;
        y: parent.height * 0.12 - 1.5px;
        width: parent.width * 0.76;
        height: parent.height * 0.76;
        source: root.logo;
        colorize: root.tint;
    }
    if root.badge != "": Rectangle {
        x: parent.width - self.width + 4px;
        y: parent.height - self.height + 3px;
        width: badge-text.preferred-width + 5px;
        height: badge-text.preferred-height + 1px;
        border-radius: 3px;
        background: Theme.gray-300;
        badge-text := Text {
            text: root.badge;
            font-size: 8.5px;
            font-weight: 600;
            color: Theme.fg;
        }
    }
}

export component Trigger {
    in property <string> icon;
    in property <image> logo;
    in property <bool> has-logo;
    in property <string> badge;
    in property <string> label;
    in property <bool> open;
    in property <string> tip;
    // The most the label may take; a longer one elides (the composer's footer shrinks it when short of room).
    in property <length> label-max: 100000px;
    callback clicked;
    property <bool> hover: area.has-hover || open;
    property <color> fg: hover ? Theme.fg : Theme.subtle;
    height: 30px;
    width: 8px + 18px + 6px + (label != "" ? text.width + 4px : 0px) + 14px + 6px;
    Rectangle {
        background: root.hover ? Theme.accent : transparent;
        border-radius: Theme.radius-md;
    }
    if !root.has-logo: Glyph {
        x: 9px;
        width: 16px;
        icon: root.icon;
        size: 15px;
        color: root.fg;
    }
    if root.has-logo: AccountMark {
        x: 7px;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        logo: root.logo;
        badge: root.badge;
    }
    text := Text {
        x: 31px;
        width: min(self.preferred-width, root.label-max);
        text: root.label;
        font-size: 14px;
        color: root.fg;
        vertical-alignment: center;
        overflow: elide;
    }
    Glyph {
        x: 31px + (root.label != "" ? text.width + 4px : 0px);
        y: 1px;
        height: parent.height;
        width: 14px;
        icon: Icons.down;
        size: 13px;
        color: root.fg;
    }
    area := TipArea {
        tip: root.tip;
        clicked => {
            root.clicked();
        }
    }
}

export component KeyCap {
    in property <string> text;
    height: 22px;
    width: max(label.preferred-width, 8px) + 12px;
    Rectangle {
        border-radius: 4px;
        background: Theme.border;
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 3px;
            border-radius: 3px;
            background: Theme.gray-100;
        }
    }
    label := Text {
        y: 0px;
        height: root.height;
        vertical-alignment: center;
        text: root.text;
        font-family: "Geist Mono";
        font-size: 12px;
        color: Theme.subtle;
    }
}

export component KbdCombo {
    in property <[string]> caps;
    HorizontalLayout {
        spacing: 4px;
        for c in root.caps: KeyCap {
            text: c;
        }
    }
}

export component FileChip {
    in property <string> name;
    in property <bool> image;
    callback remove;
    height: 26px;
    width: label.preferred-width + 52px;
    Rectangle {
        background: Theme.gray-100;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius-md;
    }
    Glyph {
        x: 6.5px;
        width: 13px;
        icon: root.image ? Icons.image : Icons.clip;
        size: 13px;
        color: Theme.subtle;
    }
    label := Text {
        x: 24px;
        text: root.name;
        font-size: 12.5px;
        color: Theme.fg;
        vertical-alignment: center;
    }
    Rectangle {
        x: parent.width - 22px;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        background: x-area.has-hover ? Theme.gray-300 : transparent;
        Glyph {
            icon: Icons.x;
            size: 12px;
            color: Theme.subtle;
        }
        x-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.remove();
            }
        }
    }
}

export component Meter {
    in property <float> frac;
    in property <float> amber-at: 0.6;
    in property <float> red-at: 0.85;
    property <float> f: max(0, min(1, frac));
    height: 6px;
    Rectangle {
        border-radius: 3px;
        background: Theme.gray-200;
    }
    if root.f > 0: Rectangle {
        x: 0;
        width: parent.width * root.f;
        border-radius: 3px;
        background: root.f > root.red-at ? Theme.red-800 : root.f > root.amber-at ? Theme.amber-800 : Theme.gray-1000;
    }
}

export component Tabs {
    in property <[string]> labels;
    in-out property <int> selected;
    callback picked(int);
    height: 36px;
    Rectangle {
        background: Theme.gray-100;
        border-radius: Theme.radius-lg;
    }
    HorizontalLayout {
        padding: 3px;
        for l[i] in root.labels: Rectangle {
            property <bool> active: i == root.selected;
            width: tab-text.preferred-width + 20px;
            background: active ? (Theme.dark ? Ui.mix(Theme.bg100, Theme.border, 0.3) : Theme.bg100) : transparent;
            border-width: active && Theme.dark ? 1px : 0px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            tab-text := Text {
                text: l;
                font-size: 14px;
                font-weight: 500;
                color: active || tab-area.has-hover ? Theme.fg : Theme.subtle;
            }
            tab-area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if !active {
                        root.selected = i;
                        root.picked(i);
                    }
                }
            }
        }
    }
}

export component Empty {
    in property <string> icon;
    in property <string> title;
    in property <string> desc;
    in property <string> action;
    callback act;
    VerticalLayout {
        alignment: start;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                background: Theme.gray-100;
                border-radius: Theme.radius-lg;
                Glyph {
                    icon: root.icon;
                    size: 24px;
                    color: Theme.fg;
                }
            }
        }
        Rectangle {
            height: 16px;
        }
        Text {
            text: root.title;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: -0.32px;
            color: Theme.fg;
            horizontal-alignment: center;
        }
        if root.desc != "": Rectangle {
            height: 4px;
        }
        if root.desc != "": HorizontalLayout {
            alignment: center;
            Text {
                max-width: 360px;
                text: root.desc;
                font-size: 14px;
                color: Theme.subtle;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
        if root.action != "": Rectangle {
            height: 16px;
        }
        if root.action != "": HorizontalLayout {
            alignment: center;
            Btn {
                text: root.action;
                variant: primary;
                clicked => {
                    root.act();
                }
            }
        }
    }
}

export component Toggle {
    in-out property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 32px;
    height: 20px;
    opacity: enabled ? 1 : 0.5;
    property <float> k: on ? 1 : 0;
    animate k { duration: 120ms; }
    Rectangle {
        height: 18px;
        border-radius: 9px;
        background: Ui.mix(area.has-hover ? Theme.gray-500 : Theme.gray-400, Theme.primary, root.k);
    }
    Rectangle {
        x: 1px + 14px * root.k;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Ui.mix(Theme.dark ? Theme.fg : Theme.bg100, Theme.on-primary, root.k);
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

export component SettingRow {
    in property <string> title;
    in property <string> desc;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: Theme.compact ? 8px : 12px;
        padding-bottom: Theme.compact ? 8px : 12px;
        spacing: 12px;
        // widgets.rs `setting_row`: the text takes 60% or all but 260px, whichever is more, and leaves 60px.
        property <length> inner: root.width - 32px;
        VerticalLayout {
            width: min(max(parent.inner * 0.6, parent.inner - 260px), parent.inner - 60px);
            spacing: 2px;
            Text {
                min-height: 20px;
                text: root.title;
                font-size: 14px;
                font-weight: 500;
                color: Theme.fg;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            if root.desc != "": Text {
                text: root.desc;
                font-size: 13px;
                color: Theme.subtle;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: end;
            VerticalLayout {
                alignment: start;
                @children
            }
        }
    }
}
