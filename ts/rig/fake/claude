#!/usr/bin/python3
# Same bytes for both apps: 40 text deltas a second for HTS_STREAM_S seconds.
import json, os, sys, time, uuid
if '--version' in sys.argv: print('2.1.311 (Claude Code)'); sys.exit()
if '-p' not in sys.argv: sys.exit(0)
try: stdin=sys.stdin.readline()
except Exception: stdin=''
sid=str(uuid.uuid4())
out=lambda o:(sys.stdout.write(json.dumps(o)+'\n'),sys.stdout.flush())
out({"type":"system","subtype":"init","session_id":sid,"mcp_servers":[]})
secs=float(os.environ.get('HTS_STREAM_S','30'))
words="the quick brown fox jumps over the lazy dog while **harbor** keeps `every` chat in sync across all the machines on this mesh".split()
if os.environ.get('HTS_FAKE_TOOL'):
    out({"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_1","name":"Bash","input":{"command":"sleep 600"}}]},"parent_tool_use_id":None,"session_id":sid})
    time.sleep(secs)
    out({"type":"result","subtype":"success","is_error":False,"result":"","duration_ms":int(secs*1000),"num_turns":1,"total_cost_usd":0.0,"usage":{"input_tokens":10,"output_tokens":1},"session_id":sid})
    sys.exit()
text=''; t0=time.time(); i=0
while time.time()-t0<secs:
    d=words[i%len(words)]+' '
    if i%60==59: d+='\n\n'
    if i%300==299: d+='```\nsome code here\n```\n\n'
    text+=d; i+=1
    out({"type":"stream_event","event":{"type":"content_block_delta","delta":{"type":"text_delta","text":d}},"parent_tool_use_id":None,"session_id":sid})
    time.sleep(0.025)
out({"type":"assistant","message":{"content":[{"type":"text","text":text}]},"parent_tool_use_id":None,"session_id":sid})
out({"type":"result","subtype":"success","is_error":False,"result":text,"duration_ms":int(secs*1000),"num_turns":1,"total_cost_usd":0.0,"usage":{"input_tokens":10,"output_tokens":i},"session_id":sid})
